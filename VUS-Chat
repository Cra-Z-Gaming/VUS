function updateSendButtonState() {
  const elapsed = Date.now() - lastSentAt;
  const remaining = currentMessageCooldownMs() - elapsed;
  if (remaining > 0) {
    $sendBtn.disabled = true;
    $sendBtn.classList.add("cooldown");
    $sendBtn.textContent = Math.ceil(remaining / 1000) + "s";
    clearTimeout(cooldownTimer);
    cooldownTimer = setTimeout(updateSendButtonState, 250);
  } else {
    $sendBtn.disabled = false;
    $sendBtn.classList.remove("cooldown");
    $sendBtn.textContent = "Send";
  }
}

function updateComposerLockState() {
  if (isSpectatorName(myName)) {
    $msgInput.disabled = true;
    $msgInput.placeholder = "Rename to chat — you're spectating";
    $sendBtn.disabled = false;
    $sendBtn.classList.remove("cooldown");
    $sendBtn.textContent = "Rename to chat";
  } else if (myTimeoutRemainingMs > 0) {
    $msgInput.disabled = true;
    $msgInput.placeholder = "Timed out — try again in " + formatCountdown(myTimeoutRemainingMs);
    $sendBtn.disabled = true;
    $sendBtn.classList.add("cooldown");
    $sendBtn.textContent = formatCountdown(myTimeoutRemainingMs);
  } else {
    $msgInput.disabled = false;
    $msgInput.placeholder = "Type a message… (@ to mention someone)";
    updateSendButtonState();
  }
}

// Live-watches this browser's OWN timeout status in the current room so the
// composer locks/unlocks the moment an owner issues or a timeout expires,
// without the person needing to send a message to find out. Re-subscribes
// whenever we (re)claim presence under a name or switch rooms — see the
// call sites in attemptJoin / joinAsSpectatorAuto / joinRoomByCode /
// switchToMainRoom.
function watchMyTimeout() {
  if (unwatchMyTimeout) { unwatchMyTimeout(); unwatchMyTimeout = null; }
  clearInterval(myTimeoutCountdownTimer);
  if (!myLoginId || isSpectatorName(myName)) { myTimeoutRemainingMs = 0; return; }

  unwatchMyTimeout = ChatBackend.watchTimeout(myLoginId, (remainingMs) => {
    myTimeoutRemainingMs = remainingMs;
    updateComposerLockState();
    clearInterval(myTimeoutCountdownTimer);
    if (remainingMs > 0) {
      myTimeoutCountdownTimer = setInterval(() => {
        myTimeoutRemainingMs = Math.max(0, myTimeoutRemainingMs - 1000);
        updateComposerLockState();
        if (myTimeoutRemainingMs <= 0) clearInterval(myTimeoutCountdownTimer);
      }, 1000);
    }
  });
}

function watchMyBan() {
  if (unwatchMyBan) { unwatchMyBan(); unwatchMyBan = null; }
  if (!myLoginId) return;
  unwatchMyBan = ChatBackend.watchBan(myLoginId, ban => {
    if (!ban || !myName) return;
    ChatBackend.releasePresenceSilently();
    myName = "";
    myLoginId = "";
    isSpectator = false;
    $chatScreen.style.display = "none";
    $joinScreen.style.display = "flex";
    renderDmLoginPrompt("This account was banned from VUS Chat.");
  });
}

function parseModerationDuration(value) {
  const match = String(value || "").trim().match(/^(\d+(?:\.\d+)?)(s|m|h|d|w)?$/i);
  if (!match) return 0;
  const unitMs = { s: 1000, m: 60000, h: 3600000, d: 86400000, w: 604800000 };
  return Number(match[1]) * (unitMs[(match[2] || "m").toLowerCase()] || 60000);
}

/* ══════════════════════════════════════════════════════════
   SLASH COMMANDS
   One table drives everything: the "/" list, tab-autofill, the ghost hint,
   and the unknown-command check. `minRank` hides a command from anyone who
   can't use it. `insert` is what gets typed when you pick it.
   ══════════════════════════════════════════════════════════ */
const SLASH_COMMANDS = [
  { name: "/timeout", args: "time username",         desc: "Temporarily mute a user (1m\u20131h for mods, 1m\u201330d for admins+).", minRank: ROLES.mod.rank,   insert: "/timeout " },
  { name: "/kick",    args: "username",              desc: "Remove a user from the current private room.",        minRank: ROLES.admin.rank,   insert: "/kick " },
  { name: "/ban",     args: "username",              desc: "Permanently ban a logged-in user.",                   minRank: ROLES.admin.rank,   insert: "/ban " },
  { name: "/tempban", args: "time username",         desc: "Temporarily ban a user (1m\u201330d), e.g. 2h.",       minRank: ROLES.admin.rank,   insert: "/tempban " },
  { name: "/grant",   args: "rank [time] username",  desc: "Give a rank (below yours), permanent unless a time (1m\u201330d) is given. normie/mod/admin/coowner.", minRank: ROLES.admin.rank,   insert: "/grant " },
  { name: "/remove",  args: "rank username",         desc: "Remove a rank (below yours).",                        minRank: ROLES.admin.rank,   insert: "/remove " },
  { name: "/image",   args: "on|off username",       desc: "Give or take away image access for a user.",          minRank: ROLES.admin.rank,   insert: "/image " },
  { name: "/unban",   args: "username|id",           desc: "Remove a ban by username or 6-digit login ID.",       minRank: ROLES.crown.rank,   insert: "/unban " },
  { name: "/close",   args: "",                      desc: "Remove everyone from VUS Chat.",                      minRank: ROLES.crown.rank,   insert: "/close" }
];

function availableSlashCommands() {
  const rank = myRank();
  return SLASH_COMMANDS.filter(c => rank >= c.minRank);
}

function findModerationTarget(name) {
  const wanted = String(name || "").trim().toLowerCase();
  return latestPresenceList.find(entry => entry.name.toLowerCase() === wanted) || null;
}

async function handleModerationCommand(text) {
  if (!text.startsWith("/")) return false;
  const parts = text.trim().split(/\s+/);
  const command = parts[0].toLowerCase();
  // Rank-based. Only the Owner can /close and /unban; Admin and above can use
  // everything except /timeout, and can only grant/remove ranks strictly
  // below their own. Mods can only use /timeout (capped at
  // MOD_TIMEOUT_MAX_MS) — everything else still routes through the Mod Menu.
  const rank = myRank();
  const isOwner = rank >= ROLES.crown.rank;
  const isAdmin = rank >= ROLES.admin.rank;
  const isMod = rank >= ROLES.mod.rank;

  const commandDef = SLASH_COMMANDS.find(c => c.name === command);
  if (!commandDef) {
    showComposerNotice("Unknown command. Type / to see the list.");
    return true;
  }
  const canModerate = rank >= commandDef.minRank;
  if (!canModerate) {
    showComposerNotice("You do not have permission to use that command.");
    return true;
  }
  ChatBackend.logCommand(text);

  if (command === "/close") {
    if (!isOwner || parts.length !== 1) {
      showComposerNotice("Only the owner can use /close.");
      return true;
    }
    await ChatBackend.setChatClosed(true);
    showComposerNotice("VUS Chat was closed for everyone.");
    return true;
  }

  if (command === "/unban") {
    if (!isOwner) {
      showComposerNotice("Only the owner can use /unban.");
      return true;
    }
    if (parts.length !== 2) {
      showComposerNotice("Use /unban username or /unban loginID");
      return true;
    }
    try {
      const loginId = await ChatBackend.unbanUser(parts[1]);
      showComposerNotice("Unbanned login ID #" + loginId + ".");
    } catch (e) {
      showComposerNotice("Couldn't unban that user: " + (e && e.message ? e.message : "check your connection") + ".");
    }
    return true;
  }

  if (command === "/image") {
    const mode = (parts[1] || "").toLowerCase();
    if (parts.length < 3 || !["on", "off"].includes(mode)) {
      showComposerNotice("Use /image on username or /image off username");
      return true;
    }
    const imgTarget = findModerationTarget(parts.slice(2).join(" "));
    if (!imgTarget || !imgTarget.loginId) {
      showComposerNotice("That user must be online and logged in.");
      return true;
    }
    // You can only change image access for someone ranked below you.
    if (rankOfLoginId(imgTarget.loginId) >= myRank()) {
      showComposerNotice("You can only change image access for ranks below your own.");
      return true;
    }
    try {
      await ChatBackend.setImageAccess(imgTarget.loginId, mode === "on");
      showComposerNotice((mode === "on" ? "Gave" : "Removed") + " image access " + (mode === "on" ? "to " : "from ") + imgTarget.name + ".");
    } catch (e) {
      showComposerNotice("Couldn't update image access: " + (e && e.message ? e.message : "check your connection") + ".");
    }
    return true;
  }

  let targetName;
  let durationMs = 0;
  if (command === "/kick") {
    if (parts.length !== 2 || !currentRoomCode) {
      showComposerNotice("Use /kick name inside a private room.");
      return true;
    }
    targetName = parts[1];
    const target = findModerationTarget(targetName);
    if (!target || !target.loginId) {
      showComposerNotice("That user must be online and logged in.");
      return true;
    }
    await RoomManager.kickFromRoom(currentRoomCode, target.loginId);
    showComposerNotice("Removed " + target.name + " from the room.");
    return true;
  } else if (command === "/timeout") {
    if (parts.length !== 3) {
      showComposerNotice("Use /timeout time name, such as /timeout 10m alex");
      return true;
    }
    durationMs = parseModerationDuration(parts[1]);
    targetName = parts.slice(2).join(" ");
    // Admins+ can go up to the full 30-day cap; mods are capped the same as
    // the Mod Menu's Timeout button.
    const myTimeoutCapMs = isAdmin ? TIMEOUT_MAX_MS : MOD_TIMEOUT_MAX_MS;
    if (!durationMs || durationMs > myTimeoutCapMs) {
      showComposerNotice(isAdmin
        ? "Timeout time must be between 1 minute and 30 days."
        : "Timeout time must be between 1 minute and " + formatCountdown(MOD_TIMEOUT_MAX_MS) + ".");
      return true;
    }
    const target = findModerationTarget(targetName);
    if (!target || !target.loginId) {
      showComposerNotice("That user must be online and logged in.");
      return true;
    }
    // Mods, like the Mod Menu button, can only time out ranks below their own.
    if (!isAdmin && rankOfLoginId(target.loginId) >= rank) {
      showComposerNotice("You can only timeout ranks below your own.");
      return true;
    }
    await ChatBackend.setTimeout_(target.loginId, durationMs, myLoginId);
    showComposerNotice("Timed out " + target.name + " for " + formatCountdown(durationMs) + ".");
    return true;
  } else if (command === "/ban") {
    if (parts.length !== 2) {
      showComposerNotice("Use /ban name");
      return true;
    }
    targetName = parts[1];
  } else if (command === "/tempban") {
    if (parts.length !== 3) {
      showComposerNotice("Use /tempban time name, such as /tempban 2h alex");
      return true;
    }
    durationMs = parseModerationDuration(parts[1]);
    targetName = parts[2];
    if (!durationMs || durationMs > TIMEOUT_MAX_MS) {
      showComposerNotice("Tempban time must be between 1 minute and 30 days.");
      return true;
    }
  } else if (command === "/remove") {
    if (parts.length !== 3) {
      showComposerNotice("Use /remove mod/admin username");
      return true;
    }
    const rankName = parts[1].toLowerCase();
    targetName = parts.slice(2).join(" ");
    const roleToRemove = ROLES[rankName];
    if (!roleToRemove || roleToRemove.implicit || roleToRemove.id === "crown") {
      showComposerNotice("Rank must be one of: normie, mod, admin, coowner.");
      return true;
    }
    // You can only take away a rank strictly below your own.
    if (roleToRemove.rank >= myRank()) {
      showComposerNotice("You can only remove ranks below your own.");
      return true;
    }
    const target = findModerationTarget(targetName);
    if (!target || !target.loginId) {
      showComposerNotice("That user must be online and logged in.");
      return true;
    }
    try {
      await ChatBackend.removeRoleFromId(roleToRemove.id, target.loginId);
      showComposerNotice("Removed " + roleToRemove.label + " from " + target.name + ".");
    } catch (e) {
      showComposerNotice("Couldn't remove " + roleToRemove.label + ": " + (e && e.message ? e.message : "check your connection") + ".");
    }
    return true;
  } else {
    if (parts.length !== 3 && parts.length !== 4) {
      showComposerNotice("Use /grant rank username or /grant rank time username");
      return true;
    }
    const rankName = parts[1].toLowerCase();
    const hasDuration = parts.length === 4;
    durationMs = hasDuration ? parseModerationDuration(parts[2]) : 0;
    targetName = hasDuration ? parts.slice(3).join(" ") : parts.slice(2).join(" ");
    const roleToGrant = ROLES[rankName];
    if (!roleToGrant || roleToGrant.implicit || roleToGrant.id === "crown") {
      showComposerNotice("Rank must be one of: normie, mod, admin, coowner.");
      return true;
    }
    if (hasDuration && (!durationMs || durationMs > TIMEOUT_MAX_MS)) {
      showComposerNotice("Time must be between 1 minute and 30 days.");
      return true;
    }
    // You can only hand out ranks strictly below your own.
    if (roleToGrant.rank >= myRank()) {
      showComposerNotice("You can only grant ranks below your own.");
      return true;
    }
    const target = findModerationTarget(targetName);
    if (!target || !target.loginId) {
      showComposerNotice("That user must be online and logged in.");
      return true;
    }
    if (holdsRoleId(roleToGrant.id, target.loginId)) {
      showComposerNotice(target.name + " already has that rank.");
      return true;
    }
    try {
      if (durationMs) {
        await ChatBackend.grantTemporaryRoleToId(roleToGrant.id, target.loginId, durationMs, myLoginId);
        showComposerNotice("Granted temporary " + roleToGrant.label + " to " + target.name + ".");
      } else {
        await ChatBackend.grantRoleToId(roleToGrant.id, target.loginId);
        showComposerNotice("Granted permanent " + roleToGrant.label + " to " + target.name + ".");
      }
    } catch (e) {
      showComposerNotice("Couldn't grant " + roleToGrant.label + ": " + (e && e.message ? e.message : "check your connection") + ".");
    }
    return true;
  }

  const target = findModerationTarget(targetName);
  if (!target || !target.loginId) {
    showComposerNotice("That user must be online and logged in.");
    return true;
  }
  if (target.name === myName) {
    showComposerNotice("You cannot moderate yourself.");
    return true;
  }
  openBanConfirm(target, durationMs);
  return true;
}

async function sendMessage() {
  const text = $msgInput.value.trim();

  const mentionTarget = currentMentionTarget;

  // Moderation commands must run before timeout and send-cooldown guards so
  // an Owner/Admin can always issue them and receives a useful response.
  if (await handleModerationCommand(text)) {
    $msgInput.value = "";
    updateCharCounter();
    autosizeInput();
    return;
  }

  if (isSpectatorName(myName)) {
    openChangeName();
    return;
  }
  if (myTimeoutRemainingMs > 0) {
    showComposerNotice("You're timed out for " + formatCountdown(myTimeoutRemainingMs) + " more.");
    return;
  }
  // Text and images each respect their own per-rank delay. Tell the person how
  // long is left instead of silently swallowing the Enter key.
  const textWait = currentMessageCooldownMs() - (Date.now() - lastSentAt);
  if (!pendingImageDataUrl && textWait > 0) {
    showComposerNotice("Slow down — wait " + Math.ceil(textWait / 1000) + "s before sending again (your rank's delay is " + Math.round(currentMessageCooldownMs() / 1000) + "s).");
    return;
  }

  if (pendingImageDataUrl) {
    // Enforce, don't just hide the button: the pending image could have been
    // staged before access was revoked.
    if (!canPostImages()) {
      clearPendingImage();
      showComposerNotice("You don't have image access. Ask an Admin or higher.");
      return;
    }
    const imgWait = currentImageCooldownMs() - (Date.now() - lastImageSentAt);
    if (imgWait > 0) {
      showComposerNotice("Images have a " + Math.round(currentImageCooldownMs() / 1000) + "s delay for your rank — wait " + Math.ceil(imgWait / 1000) + "s.");
      return;
    }
    const imageToSend = pendingImageDataUrl;
    clearPendingImage();

    lastSentAt = Date.now();
    lastImageSentAt = Date.now();
    updateSendButtonState();
    stopTyping();

    ChatBackend.sendImage(myName, imageToSend, myLoginId)
      .then(() => {
        if (text) {
          return ChatBackend.send(myName, text, null, myLoginId);
        }
      })
      .then(() => {
        $msgInput.value = "";
        autosizeInput();
        updateCharCounter();
        autoScroll = true;
        setAutoScrollUI();
      })
      .catch(() => {
        $connError.textContent = "Image failed to send — check your connection.";
        $connError.style.display = "block";
      })
      .finally(() => { $msgInput.focus(); });
    return;
  }

  if (!text && !mentionTarget) return;

  if (mentionTarget) {
    $sendBtn.disabled = true;
    ChatBackend.tryStartAtPingCooldown(mentionTarget).then(result => {
      $sendBtn.disabled = false;
      if (!result.ok) {
        const secs = Math.ceil(result.remainingMs / 1000);
        showComposerNotice(mentionTarget + " was just pinged — wait " + secs + "s before pinging them again.");
        return;
      }
      finalizeSend(text, { name: mentionTarget });
    }).catch(() => {
      $sendBtn.disabled = false;
      showComposerNotice("Couldn't check ping cooldown — try again.");
    });
    return;
  }

  finalizeSend(text, null);
}

function finalizeSend(text, mention) {
  lastSentAt = Date.now();
  updateSendButtonState();
  stopTyping();

  ChatBackend.send(myName, text, mention, myLoginId)
    .then(() => {
      $msgInput.value = "";
      clearMention();
      autosizeInput();
      updateCharCounter();
      autoScroll = true;
      setAutoScrollUI();
    })
    .catch(error => {
      $connError.textContent = "Message failed to send — check your connection.";
      $connError.style.display = "block";
    })
    .finally(() => { $msgInput.focus(); });
}

