<!--
  ═══════════════════════════════════════════════════════════
  FIREBASE SETUP REQUIRED — read this before this chat will work
  ═══════════════════════════════════════════════════════════
  1. Go to https://console.firebase.google.com and create a free project.
  2. In the project, go to "Build" → "Realtime Database" → "Create Database".
     Start in TEST MODE for now (anyone can read/write — fine for a small
     public chat room, but you can lock it down later with Firebase rules).
  3. Go to Project Settings (gear icon) → General → "Your apps" → click the
     "</>" web icon to register a web app. It'll give you a config object
     that looks like the FIREBASE_CONFIG placeholder below.
  4. Copy that object and paste it in place of FIREBASE_CONFIG below.
  5. That's it — no server to run, this connects directly from the browser.

  Room name: change ROOM_ID below if you want multiple separate chat rooms
  (e.g. one for VUS Hub, one for VUSL) using the same Firebase project.
  ═══════════════════════════════════════════════════════════
-->
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script>
/* ── Fill this in with your real Firebase project config ── */
const FIREBASE_CONFIG = {
  apiKey: "AIzaSyDxMfGQ_xk-au8YgOvaFO2R9LxAe-pa9Rg",
  authDomain: "vus-chat.firebaseapp.com",
  databaseURL: "https://vus-chat-default-rtdb.firebaseio.com",
  projectId: "vus-chat",
  storageBucket: "vus-chat.firebasestorage.app",
  messagingSenderId: "134456894391",
  appId: "1:134456894391:web:bdf28487bf2b2eae593e32"
};

/* Change this to run multiple separate chat rooms off one Firebase project */
const MAIN_ROOM_ID = "vus-hub-main";

/* ── Custom room system ── */
const ROOM_DURATION_MS = 15 * 60 * 1000;      // rooms live 15 minutes
const ROOM_WARNING_MS = 60 * 1000;            // extend-prompt appears with 1 min left
const ROOM_EXTEND_MS = 10 * 60 * 1000;        // "+10 minutes" button adds this much
const ROOM_CREATE_COOLDOWN_MS = 60 * 1000;    // 1 minute between room creations, per person
const ROOM_CODE_DEFAULT_LENGTH = 4;
const ROOM_CODE_MAX_LENGTH = 20;
const ROOM_NAME_MAX_LENGTH = 30;
const ROOM_CREATE_COOLDOWN_KEY = "vusChatLastRoomCreate";

/* Only keep the most recent N messages loaded/rendered, to keep things fast
   even after thousands of messages accumulate over time. */
const MAX_MESSAGES = 200;

const MAX_CHARS = 500;

/* ── Ping You (Discord webhook) ──
   EASY TO EDIT: just change this URL if you need a different webhook. */
const PING_YOU_WEBHOOK_URL = "https://discord.com/api/webhooks/1536853718564216842/VZYgEyf5yEzMs03g-hbWIZRS90oNKrVh_LBN1eHv3ZVplCOUlKeRDTWKIAyolYjIshHa";
const PING_YOU_COOLDOWN_MS = 30 * 1000; // per-person (this browser), not global
const PING_YOU_STORAGE_KEY = "vusChatLastPingYou";

/* ── @Ping (in-chat, live sound + notification) ──
   Cooldown is per-TARGET, global: once anyone pings a person, nobody can
   ping that same person again until it expires — doesn't matter who tries. */
const AT_PING_COOLDOWN_MS = 30 * 1000;

/* Placeholder sound — swap to "https://raw.githubusercontent.com/Cra-Z-Gaming/VUS/refs/heads/main/ping.mp3"
   once that real file exists on GitHub. Fetched once and cached as a Blob
   URL below so playback is instant with no per-ping network delay. */
const PING_SOUND_URL = "https://raw.githubusercontent.com/Cra-Z-Gaming/VUS/refs/heads/main/moannnnnygs727272.mp3";

/* ── Crown (verified owner badge) ──
   Global code system, redeemed via the mod menu. Code defaults to "0000"
   (always inert). Requesting a code posts it to CROWN_WEBHOOK_URL — only
   you have access to that Discord server — and the code expires after
   CROWN_CODE_LIFESPAN_MS. The crown itself lives on the live presence
   session (see ChatBackend.claimPresence), so it never survives a
   disconnect, rename, or someone else later using the same name — a
   fresh code redemption is required every single join. */
const CROWN_CODE_LIFESPAN_MS = 3 * 60 * 1000; // 3 minutes — more room to check Discord and type it in
const CROWN_REQUEST_COOLDOWN_MS = 30 * 1000;
const CROWN_REQUEST_COOLDOWN_KEY = "vusChatLastCrownRequest";
const CROWN_WEBHOOK_URL = "https://discord.com/api/webhooks/1542708447991037953/Ge705Wa_quPVC-2pFhttHYNuA4-FI5ZDRIn5VwjQ059SwT0ZRCrqmVLMofb8oJhsLFFJ";

/* ══════════════════════════════════════════════════════════
   Backend abstraction layer.
   Every actual Firebase call is isolated in this one object so
   that swapping to a different backend later (Supabase, a custom
   server, etc.) only means rewriting the functions below —
   nothing in the UI code below needs to change.
   ══════════════════════════════════════════════════════════ */
const ChatBackend = {
  _db: null,
  _ref: null,
  _typingRef: null,
  _myTypingRef: null,
  _connectedRef: null,
  _presenceRef: null,
  _myPresenceRef: null,
  _myLeaveEventRef: null,
  _nameColorsRef: null,
  _atPingCooldownRef: null,
  _leaveEventsRef: null,
  _crownedRef: null,
  _crownMetaRef: null,
  _myCrownRef: null,
  currentRoomId: null,

  init() {
    firebase.initializeApp(FIREBASE_CONFIG);
    this._db = firebase.database();
    this._connectedRef = this._db.ref(".info/connected");
    this.initCrowns();
    this.bindToRoom(MAIN_ROOM_ID);
  },

  // Crown paths are GLOBAL (not per-room, not rebuilt by bindToRoom) —
  // being crowned should mean the same thing everywhere in the app.
  initCrowns() {
    this._crownedRef = this._db.ref("crowned");
    this._crownMetaRef = this._db.ref("crownMeta");
  },

  watchCrownedNames(onChange) {
    this._crownedRef.on("value", snap => {
      const val = snap.val() || {};
      onChange(new Set(Object.keys(val)));
    });
  },

  _randomCrownCode() {
    const chars = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
    let out = "";
    for (let i = 0; i < 4; i++) out += chars[Math.floor(Math.random() * chars.length)];
    return out;
  },

  // Generates a fresh code, writes it to Firebase with a 60s expiry, and
  // posts it to the private Discord webhook. The code is meaningless to
  // anyone who can't read that webhook's channel.
  async generateCrownCode() {
    const code = this._randomCrownCode();
    const expiresAt = Date.now() + CROWN_CODE_LIFESPAN_MS;
    await this._crownMetaRef.set({ code, expiresAt });
    let webhookOk = false;
    try {
      const res = await fetch(CROWN_WEBHOOK_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ content: "👑 Crown code: **" + code + "** (expires in " + Math.round(CROWN_CODE_LIFESPAN_MS / 1000) + "s)" })
      });
      webhookOk = res.ok; // catches bad/expired webhook URLs, rate limits, etc — not just network errors
    } catch (e) {
      webhookOk = false;
    }
    // Code is still live in Firebase either way — caller decides what to
    // show based on webhookOk, since a failed post means the code exists
    // but nobody can actually see it to redeem it.
    return { code, webhookOk };
  },

  // Atomic + single-use via transaction: only commits if the submitted
  // code still matches AND hasn't expired, and resets to "0000" in the
  // same write — so the same code can never be redeemed twice, and two
  // near-simultaneous submissions can't both succeed.
  //
  // Also does a plain (non-transactional) read FIRST, purely to produce a
  // specific reason for the UI ("wrong" vs "expired" vs "none") — this read
  // is diagnostic only and never used to decide the actual claim; the
  // transaction below is still the sole source of truth for that.
  async redeemCrownCode(inputCode) {
    const clean = (inputCode || "").trim().toUpperCase();
    if (!clean || clean === "0000") return { ok: false, reason: "none" };

    let diagnosticReason = "wrong";
    try {
      const snap = await this._crownMetaRef.get();
      const current = snap.val();
      if (current && current.code === clean) {
        diagnosticReason = (!current.expiresAt || Date.now() > current.expiresAt) ? "expired" : "wrong-but-matched"; // shouldn't happen if not expired — transaction will clarify
      }
    } catch (e) { /* diagnostic only — fall through to the real transaction either way */ }

    const tx = await this._crownMetaRef.transaction(current => {
      if (!current || current.code !== clean) return; // abort — wrong/no code
      if (!current.expiresAt || Date.now() > current.expiresAt) return; // abort — expired
      return { code: "0000", expiresAt: 0 };
    });

    if (!tx.committed) return { ok: false, reason: diagnosticReason };

    if (this._myCrownRef) {
      await this._myCrownRef.set(true);
    }
    return { ok: true };
  },

  // Rebuilds every per-room ref to point at a new room, and detaches all
  // listeners from whichever room was previously bound (if any) so old-room
  // updates can never leak into the new room's UI after switching. Presence/
  // typing for the OLD room are also explicitly released here, since
  // switching rooms should always mean fully leaving the previous one.
  bindToRoom(roomId) {
    if (this.currentRoomId === roomId) return;

    if (this.currentRoomId) {
      this.releasePresence();
      this.clearTyping();
      this.detachAllListeners();
    }

    this.currentRoomId = roomId;
    this._ref = this._db.ref("rooms/" + roomId + "/messages");
    this._typingRef = this._db.ref("rooms/" + roomId + "/typing");
    this._presenceRef = this._db.ref("rooms/" + roomId + "/presence");
    this._nameColorsRef = this._db.ref("rooms/" + roomId + "/nameColors");
    this._atPingCooldownRef = this._db.ref("rooms/" + roomId + "/atPingCooldowns");
    this._leaveEventsRef = this._db.ref("rooms/" + roomId + "/leaveEvents");
  },

  // Detaches every listener this object has ever attached to a per-room
  // ref (messages, typing, presence, leave events). Does NOT touch
  // .info/connected, which is global and stays attached across room
  // switches. Safe to call even if some of these were never attached.
  detachAllListeners() {
    if (this._ref) this._ref.off();
    if (this._typingRef) this._typingRef.off();
    if (this._presenceRef) this._presenceRef.off();
    if (this._leaveEventsRef) this._leaveEventsRef.off();
  },

  // Calls onStatus(true/false) whenever the connection state changes
  watchConnection(onStatus) {
    this._connectedRef.on("value", snap => onStatus(snap.val() === true));
  },

  // Calls onMessage(msgObject) for every existing + new message
  watchMessages(onMessage) {
    this._ref.limitToLast(MAX_MESSAGES).on("child_added", snap => {
      onMessage({ id: snap.key, ...snap.val() });
    });
  },

  // Sends an already-compressed base64 data URL as a message. No Firebase
  // Storage involved — this stays on the free Spark plan, at the cost of
  // bulkier message payloads than a real file host would give you. The
  // image is compressed/resized client-side (see compressImageFile)
  // before this is ever called, to keep that payload size reasonable.
  async sendImage(name, dataUrl) {
    const color = await this.getNameColor(name);
    return this._ref.push({
      name: name,
      imageData: dataUrl,
      ts: firebase.database.ServerValue.TIMESTAMP,
      ...(color ? { bubble: color.bubble, textColor: color.text } : {})
    });
  },

  // Sends one message. If this name has a locked-in color, it's baked
  // into the message itself at send time — so changing your color later
  // only affects messages sent after the change, never past ones.
  // `mention` (optional): { name: "TargetName" } — when present, the
  // message is rendered with a highlighted @mention chip and triggers a
  // live ping (sound + notification) for the target, handled separately
  // by sendAtPing() below — this just tags the message itself.
  async send(name, text, mention) {
    const color = await this.getNameColor(name);
    return this._ref.push({
      name: name,
      text: text,
      ts: firebase.database.ServerValue.TIMESTAMP,
      ...(mention ? { mention: mention.name } : {}),
      ...(color ? { bubble: color.bubble, textColor: color.text } : {})
    });
  },

  // ── Per-name bubble color (write-once) ──
  async getNameColor(name) {
    const snap = await this._nameColorsRef.child(this._safeKey(name)).get();
    return snap.exists() ? snap.val() : null;
  },

  async claimColor(name, bubble, text) {
    const key = this._safeKey(name);
    const ref = this._nameColorsRef.child(key);
    const existing = await ref.get();
    if (existing.exists()) {
      return { ok: false, reason: "already-set" };
    }
    await ref.set({ bubble, text });
    return { ok: true };
  },

  // ── Presence / name reservation ──
  async isNameTaken(name) {
    const snap = await this._presenceRef.get();
    const val = snap.val() || {};
    const key = this._safeKey(name);
    return Object.prototype.hasOwnProperty.call(val, key);
  },

  // Posts join/leave messages to the room feed itself (not just updating
  // presence data), so they show up inline in the chat like any other
  // message — just rendered without a bubble via msg.system.
  // `silent` (spectator mode) skips the join/leave feed messages entirely,
  // while still claiming presence so the online count/list stays accurate.
  claimPresence(name, silent) {
    this.releasePresence();
    this._myPresenceRef = this._presenceRef.child(this._safeKey(name));
    this._silentSession = !!silent;

    const leaveEventRef = this._leaveEventsRef.push();
    if (!this._silentSession) {
      leaveEventRef.onDisconnect().set({ name, ts: firebase.database.ServerValue.TIMESTAMP });
    }
    this._myLeaveEventRef = leaveEventRef;

    this._myPresenceRef.onDisconnect().remove();
    this._myPresenceRef.set({ joinedAt: firebase.database.ServerValue.TIMESTAMP });

    // Crown: always start crown-less on every (re)join/rename/room-switch —
    // this same code path runs for all of those — and strip it the instant
    // this session disconnects for any reason, so it can never linger on a
    // name after the crowned person leaves, and nobody else re-using that
    // name later inherits it.
    const crownRef = this._crownedRef.child(this._safeKey(name));
    crownRef.remove();
    crownRef.onDisconnect().remove();
    this._myCrownRef = crownRef;

    if (!this._silentSession) {
      this._ref.push({
        system: true,
        text: name + " joined",
        ts: firebase.database.ServerValue.TIMESTAMP
      });
    }
  },

  // Drops presence right now without ever posting a "left" message,
  // regardless of whether this session was silent/spectator or normal.
  // Used by the "Leave Silently" mod-menu action.
  releasePresenceSilently() {
    if (this._myLeaveEventRef) {
      this._myLeaveEventRef.onDisconnect().cancel();
      this._myLeaveEventRef = null;
    }
    if (this._myPresenceRef) {
      this._myPresenceRef.onDisconnect().cancel();
      this._myPresenceRef.remove();
      this._myPresenceRef = null;
    }
    if (this._myCrownRef) {
      this._myCrownRef.onDisconnect().cancel();
      this._myCrownRef.remove();
      this._myCrownRef = null;
    }
  },

  releasePresence() {
    if (this._myPresenceRef) {
      this._myPresenceRef.remove();
      this._myPresenceRef = null;
    }
    if (this._myLeaveEventRef) {
      this._myLeaveEventRef.onDisconnect().cancel();
      this._myLeaveEventRef = null;
    }
    if (this._myCrownRef) {
      this._myCrownRef.onDisconnect().cancel();
      this._myCrownRef.remove();
      this._myCrownRef = null;
    }
  },

  watchLeaveEvents() {
    this._leaveEventsRef.on("child_added", snap => {
      const val = snap.val();
      if (!val) return;
      this._ref.push({
        system: true,
        text: val.name + " left",
        ts: firebase.database.ServerValue.TIMESTAMP
      });
      snap.ref.remove();
    });
  },

  watchPresenceCount(onCount) {
    this._presenceRef.on("value", snap => {
      const val = snap.val() || {};
      onCount(Object.keys(val).length);
    });
  },

  // Calls onList(array of {name, joinedAt}) any time presence changes.
  // Reuses the same presence/ node as everything else here, so this is
  // exactly the set of currently-connected names, each with the server
  // timestamp of when they claimed presence (may be null very briefly
  // right after joining, before the server timestamp round-trips back).
  watchPresenceList(onList) {
    this._presenceRef.on("value", snap => {
      const val = snap.val() || {};
      const list = Object.entries(val).map(([key, v]) => ({
        name: key,
        joinedAt: (v && typeof v === "object") ? (v.joinedAt || null) : null
      }));
      onList(list);
    });
  },

  // ── Typing presence ──
  setTyping(name) {
    if (!this._myTypingRef) {
      this._myTypingRef = this._typingRef.child(this._safeKey(name));
      this._myTypingRef.onDisconnect().remove();
    }
    this._myTypingRef.set({ name: name, ts: firebase.database.ServerValue.TIMESTAMP });
  },

  clearTyping() {
    if (this._myTypingRef) this._myTypingRef.remove();
    this._myTypingRef = null;
  },

  watchTyping(onChange, excludeNameFn) {
    this._typingRef.on("value", snap => {
      const val = snap.val() || {};
      const currentExclude = excludeNameFn();
      const entries = Object.values(val)
        .filter(e => e && e.name !== currentExclude)
        .sort((a, b) => (a.ts || 0) - (b.ts || 0))
        .map(e => e.name);
      onChange(entries);
    });
  },

  // ── @Ping cooldown (per-target, global — see AT_PING_COOLDOWN_MS above) ──
  // Uses a Firebase transaction so two people pinging the same target in
  // the same instant can't both "win" — only one write succeeds as the
  // real cooldown-setter, the loser sees committed:false and treats it as
  // already-on-cooldown.
  async tryStartAtPingCooldown(targetName) {
    const key = this._safeKey(targetName);
    const ref = this._atPingCooldownRef.child(key);
    const now = Date.now();
    let resultRemainingMs = 0;
    const txResult = await ref.transaction(current => {
      if (current && typeof current === "number" && (now - current) < AT_PING_COOLDOWN_MS) {
        return; // abort — still on cooldown, don't overwrite the existing timestamp
      }
      return now;
    });
    if (!txResult.committed) {
      const snap = await ref.get();
      const existing = snap.val();
      const elapsed = existing ? (now - existing) : AT_PING_COOLDOWN_MS;
      resultRemainingMs = Math.max(0, AT_PING_COOLDOWN_MS - elapsed);
      return { ok: false, remainingMs: resultRemainingMs };
    }
    return { ok: true };
  },

  _safeKey(name) {
    return name.replace(/[.#$\[\]/]/g, "_");
  }
};

/* ══════════════════════════════════════════════════════════
   Room Manager — custom room lifecycle: creation, metadata,
   expiry/extension, public/private visibility, ownership,
   kicking, and ownership-transfer offers.

   Stored under /roomsMeta/{code} in the SAME Firebase database
   ChatBackend uses, but as its own top-level path — deliberately
   separate from /rooms/{code}/... (the actual chat data:
   messages/presence/typing/etc, which ChatBackend already
   manages generically for whatever room it's bound to).

   /roomsMeta/{code} shape:
     {
       name: "Movie Night" | null,      // optional display name
       ownerName: "Alice",              // current owner's display name
       isPublic: false,
       createdAt: <server ts>,
       expiresAt: <server ts + duration>,
       kicked: { "Bob": true, ... }     // names currently kicked from THIS room
     }

   Transfer offers live at /roomsMeta/{code}/transferOffer:
     { toName: "Bob", fromName: "Alice" } | null
   ══════════════════════════════════════════════════════════ */
const RoomManager = {
  _db: null,
  _metaRootRef: null,
  _publicListRef: null,

  init(db) {
    this._db = db;
    this._metaRootRef = db.ref("roomsMeta");
  },

  _safeCode(code) {
    return String(code).replace(/[.#$\[\]/]/g, "_");
  },

  // Generates a random room code of the given length using an
  // unambiguous character set (no 0/O/1/I confusion).
  _randomCode(length) {
    const chars = "ABCDEFGHJKMNPQRSTUVWXYZ23456789";
    let out = "";
    for (let i = 0; i < length; i++) {
      out += chars[Math.floor(Math.random() * chars.length)];
    }
    return out;
  },

  async _isCodeTaken(code) {
    const snap = await this._metaRootRef.child(this._safeCode(code)).get();
    return snap.exists();
  },

  // Finds an unused default-length code, retrying on the rare collision.
  async _generateUniqueCode() {
    for (let attempt = 0; attempt < 12; attempt++) {
      const candidate = this._randomCode(ROOM_CODE_DEFAULT_LENGTH);
      if (!(await this._isCodeTaken(candidate))) return candidate;
    }
    // Extremely unlikely fallback: widen the code by a couple chars.
    return this._randomCode(ROOM_CODE_DEFAULT_LENGTH + 2);
  },

  /**
   * Creates a new room and returns its metadata (including the generated
   * code). Does NOT check the 1-minute creation cooldown — that's tracked
   * client-side in localStorage and checked by the caller before this runs.
   * @param {string} ownerName
   * @param {string} [roomName] - optional display name, max ROOM_NAME_MAX_LENGTH
   * @returns {Promise<{code: string}>}
   */
  async createRoom(ownerName, roomName) {
    const code = await this._generateUniqueCode();
    const now = Date.now();
    const meta = {
      name: (roomName || "").trim().slice(0, ROOM_NAME_MAX_LENGTH) || null,
      ownerName: ownerName,
      isPublic: false,
      createdAt: firebase.database.ServerValue.TIMESTAMP,
      expiresAt: now + ROOM_DURATION_MS, // client-estimated; fine for a countdown display
      kicked: {}
    };
    await this._metaRootRef.child(this._safeCode(code)).set(meta);
    return { code };
  },

  async getRoomMeta(code) {
    const snap = await this._metaRootRef.child(this._safeCode(code)).get();
    return snap.exists() ? { code, ...snap.val() } : null;
  },

  // Live subscription to one room's metadata (owner, expiry, public/private,
  // transfer offers, kick list) — used while actively inside that room.
  watchRoomMeta(code, callback) {
    const ref = this._metaRootRef.child(this._safeCode(code));
    const unsubscribe = ref.on("value", snap => {
      callback(snap.exists() ? { code, ...snap.val() } : null);
    });
    return () => ref.off("value", unsubscribe);
  },

  // Live subscription to every PUBLIC room's metadata, for the sidebar's
  // "Chat Rooms" list. Expired rooms are filtered out client-side (the
  // actual deletion/cleanup is handled by whoever's timer fires first —
  // see checkAndHandleExpiry below — this filter just avoids a flash of a
  // stale room between expiry and cleanup completing).
  watchPublicRooms(callback) {
    const unsubscribe = this._metaRootRef.on("value", snap => {
      const val = snap.val() || {};
      const now = Date.now();
      const list = Object.entries(val)
        .filter(([code, meta]) => meta && meta.isPublic)
        .map(([code, meta]) => ({ code, ...meta }));
      callback(list);
    });
    return () => this._metaRootRef.off("value", unsubscribe);
  },

  async setPublic(code, isPublic) {
    await this._metaRootRef.child(this._safeCode(code)).child("isPublic").set(!!isPublic);
  },

  async extendRoom(code) {
    const ref = this._metaRootRef.child(this._safeCode(code)).child("expiresAt");
    await ref.transaction(current => (current || Date.now()) + ROOM_EXTEND_MS);
  },

  // Changes a room's join code. The room's chat data itself
  // (messages/presence/etc, under /rooms/{oldCode}/...) is NOT migrated —
  // changing the code effectively starts a fresh room history under the
  // new code, which also means anyone still using the old code can no
  // longer find it. This matches "owner can change room code" being the
  // deliberate mechanism for invalidating old access without a formal ban.
  async changeCode(oldCode, newCode, ownerName) {
    const safeNew = this._safeCode(newCode.trim().slice(0, ROOM_CODE_MAX_LENGTH));
    if (!safeNew) return { ok: false, reason: "empty" };
    if (safeNew === this._safeCode(oldCode)) return { ok: false, reason: "same" };

    const taken = await this._isCodeTaken(safeNew);
    if (taken) return { ok: false, reason: "taken" };

    const oldRef = this._metaRootRef.child(this._safeCode(oldCode));
    const snap = await oldRef.get();
    if (!snap.exists()) return { ok: false, reason: "gone" };
    const meta = snap.val();
    if (meta.ownerName !== ownerName) return { ok: false, reason: "not-owner" };

    await this._metaRootRef.child(safeNew).set(meta);
    await oldRef.remove();
    return { ok: true, newCode: safeNew };
  },

  // Marks a name as kicked from this specific room. Kicking is NOT a ban —
  // it just removes them right now and (for private rooms) drops it off
  // their personal sidebar list client-side; they can rejoin immediately
  // if they still have valid access (the code, or it's public).
  async kickFromRoom(code, targetName) {
    await this._metaRootRef.child(this._safeCode(code)).child("kicked").child(this._safeKeyName(targetName)).set(true);
  },

  _safeKeyName(name) {
    return name.replace(/[.#$\[\]/]/g, "_");
  },

  // ── Ownership transfer (requires accept/decline from the target) ──
  async offerTransfer(code, fromName, toName) {
    await this._metaRootRef.child(this._safeCode(code)).child("transferOffer").set({ fromName, toName });
  },

  async cancelTransferOffer(code) {
    await this._metaRootRef.child(this._safeCode(code)).child("transferOffer").remove();
  },

  async acceptTransfer(code, newOwnerName) {
    await this._metaRootRef.child(this._safeCode(code)).update({
      ownerName: newOwnerName,
      transferOffer: null
    });
  },

  async declineTransfer(code) {
    await this._metaRootRef.child(this._safeCode(code)).child("transferOffer").remove();
  },

  // Force-transfers ownership with no accept/decline step — used only when
  // the current owner disconnects/leaves and exactly one other person
  // remains in the room (see the presence-list watcher in the UI layer).
  async forceTransferOwnership(code, newOwnerName) {
    await this._metaRootRef.child(this._safeCode(code)).update({
      ownerName: newOwnerName,
      transferOffer: null
    });
  },

  // Deletes a room's metadata AND its chat data (messages/presence/typing/
  // etc under /rooms/{code}/...). Called once, by whichever client's
  // countdown timer reaches 0 first for that room — see the expiry-check
  // logic in the UI layer. Firebase writes are idempotent here (deleting
  // an already-deleted path is a harmless no-op), so it's fine if more
  // than one client's timer fires at nearly the same moment.
  async deleteRoom(code) {
    const safe = this._safeCode(code);
    await this._metaRootRef.child(safe).remove();
    await this._db.ref("rooms/" + safe).remove();
  }
};

