function handleMentionTrigger() {
  const cursor = $msgInput.selectionStart;
  const charBeforeCursor = $msgInput.value.slice(cursor - 1, cursor);
  if (charBeforeCursor === "@") {
    openMentionDropdown(cursor - 1);
  }
