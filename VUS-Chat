/* ── State ── */
const JOINED_ROOMS_STORAGE_KEY = "vusChatJoinedRooms"; // private rooms this browser has joined, until X'd out
const ROOM_PING_BADGE_KEY = "vusChatRoomPingBadges";   // codes with an unread @ping, per this browser

let currentRoomCode = null;    // null while in the main room
let currentRoomMeta = null;    // live metadata of whatever room we're in (main room has none)
let unsubscribeRoomMeta = null;
let publicRoomsList = [];
let joinedPrivateRoomCodes = new Set(); // loaded from localStorage
let roomPingBadges = new Set();          // loaded from localStorage
let extendPromptShownForCode = null;     // avoid re-showing the same room's prompt repeatedly
let pendingKickTarget = null;
let sidebarCountdownTimer = null;
let topBarCountdownTimer = null;

function loadJoinedRoomsFromStorage() {
  try {
    const raw = localStorage.getItem(JOINED_ROOMS_STORAGE_KEY);
