function renderModMenuLogin() {
  $globalClearPanel.innerHTML = "";

  renderPreCodeActions($globalClearPanel);

  const label = document.createElement("div");
  label.textContent = "Enter code:";
  label.style.marginBottom = "6px";
  label.style.color = "#94a3b8";

  const input = document.createElement("input");
  input.type = "password";
  input.inputMode = "numeric";
  input.style.cssText = "width:100%;padding:8px 10px;background:#0f172a;border:1.5px solid #334155;border-radius:8px;color:#f1f5f9;font-size:15px;outline:none;margin-bottom:8px";

  const err = document.createElement("div");
  err.style.cssText = "color:#ef4444;font-size:13.5px;min-height:18px;margin-bottom:4px";

  const row = document.createElement("div");
  row.style.cssText = "display:flex;gap:6px";

  const submitBtn = document.createElement("button");
  submitBtn.textContent = "Submit";
  submitBtn.className = "toolbar-btn";
  submitBtn.style.flex = "1";

  const cancelBtn = document.createElement("button");
  cancelBtn.textContent = "Cancel";
  cancelBtn.className = "toolbar-btn";
  cancelBtn.style.flex = "1";

  const trySubmit = async () => {
    submitBtn.disabled = true;
    let configuredCode = modMenuCode;
    try { configuredCode = (await ChatBackend.getModMenuCode()) || DEFAULT_MOD_MENU_CODE; } catch (e) {}
    modMenuCode = configuredCode;
    if (input.value === configuredCode) {
      modMenuUnlocked = true;
      updateUploadButtonVisibility();
