let dmAuthDb = null;
let legacyDmAuthDb = null;

function initDmAuthDatabase() {
  const appName = "vusDmAuth";
  const legacyAppName = "legacyVusDmAuth";

  if (!firebase.apps.some(app => app.name === appName)) {
    firebase.initializeApp(DM_AUTH_CONFIG, appName);
  }
  if (!firebase.apps.some(app => app.name === legacyAppName)) {
    firebase.initializeApp(LEGACY_DM_AUTH_CONFIG, legacyAppName);
  }

  dmAuthDb = firebase.database(firebase.app(appName));
  legacyDmAuthDb = firebase.database(firebase.app(legacyAppName));
}

async function lookupAccountByIdentifier(database, identifier) {
  const clean = (identifier || "").trim();
  if (!clean) return null;

  const usernameKey = clean.toLowerCase();

  try {
    const usernameSnap = await database.ref("usernameIndex/" + usernameKey).get();
    if (usernameSnap.exists()) return { accountKey: usernameSnap.val(), source: "username" };
  } catch (e) {}

  if (/^[0-9]{6}$/.test(clean)) {
    try {
      const idSnap = await database.ref("idIndex/" + clean).get();
      if (idSnap.exists()) return { accountKey: idSnap.val(), source: "id" };
    } catch (e) {}
  }

  try {
    const userMatchesSnap = await database.ref("users").orderByChild("usernameLower").equalTo(usernameKey).limitToFirst(1).get();
    const matches = userMatchesSnap.val();
    if (matches) {
      const [accountKey] = Object.keys(matches);
      if (accountKey) return { accountKey, source: "fallback" };
    }
  } catch (e) {}

  return null;
}

async function loginFromChat(identifier, password) {
  const clean = identifier.trim();
  if (!clean || !password) return { ok: false, error: "Enter your username/ID and password." };

  let foundAccount = false;
  for (const database of [dmAuthDb, legacyDmAuthDb]) {
    if (!database) continue;
    try {
      const accountInfo = await lookupAccountByIdentifier(database, clean);
      if (!accountInfo) continue;
      foundAccount = true;
      const accountSnapshot = await database.ref("users/" + accountInfo.accountKey).get();
      const account = accountSnapshot.val();
      if (account && account.password === password) {
        return { ok: true, accountKey: accountSnapshot.key, username: account.username, id: account.id };
      }
    } catch (e) {
      continue;
    }
  }
  return { ok: false, error: foundAccount ? "Incorrect password." : "No account found with that username or ID." };
}

async function createAccountFromChat(username, password, confirmation) {
  const cleanUsername = username.trim();
  const usernameKey = cleanUsername.toLowerCase();
  if (!/^[a-zA-Z0-9_]{3,24}$/.test(cleanUsername)) {
    return { ok: false, error: "Username must be 3-24 letters, numbers, or underscores." };
  }
  if (!password || password.length < 4) {
    return { ok: false, error: "Password must be at least 4 characters." };
  }
  if (password !== confirmation) {
    return { ok: false, error: "Passwords do not match." };
  }

  const existingUsername = await dmAuthDb.ref("usernameIndex/" + usernameKey).get();
  if (existingUsername.exists()) return { ok: false, error: "That username is already taken." };

  let id;
  for (let attempt = 0; attempt < 15; attempt++) {
    const candidate = String(Math.floor(100000 + Math.random() * 900000));
    if (!(await dmAuthDb.ref("idIndex/" + candidate).get()).exists()) {
      id = candidate;
      break;
    }
  }
  if (!id) return { ok: false, error: "Could not create an ID right now — try again." };

  const accountRef = dmAuthDb.ref("users").push();
  const account = {
    username: cleanUsername,
    usernameLower: usernameKey,
    id,
    password,
    createdAt: firebase.database.ServerValue.TIMESTAMP,
    friends: {},
    friendRequestsIncoming: {},
    friendRequestsOutgoing: {},
    blockedUsers: {}
  };
  await dmAuthDb.ref().update({
    ["users/" + accountRef.key]: account,
    ["usernameIndex/" + usernameKey]: accountRef.key,
    ["idIndex/" + id]: accountRef.key
  });
  return { ok: true, accountKey: accountRef.key, username: cleanUsername, id };
}

