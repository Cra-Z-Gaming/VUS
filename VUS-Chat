  row.appendChild(submitBtn);
  row.appendChild(cancelBtn);
  $globalClearPanel.appendChild(label);
  $globalClearPanel.appendChild(input);
  $globalClearPanel.appendChild(err);
  $globalClearPanel.appendChild(row);
