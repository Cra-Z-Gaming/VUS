function saveDmSession(session) {
  const payload = JSON.stringify({ accountKey: session.accountKey, username: session.username, id: session.id });
  try { localStorage.setItem(CHAT_ACCOUNT_KEY, payload); } catch (e) {}
  try { sessionStorage.setItem(DM_SESSION_STORAGE_KEY, payload); } catch (e) {}
}

// Full sign-out of the stored account. Only used when the saved account is
// no longer valid (deleted / password-changed) -- NOT by the Log out button.
function clearSavedAccount() {
  try { localStorage.removeItem(CHAT_ACCOUNT_KEY); } catch (e) {}
  try { sessionStorage.removeItem(DM_SESSION_STORAGE_KEY); } catch (e) {}
}

async function validateDmSession(session) {
  if (!session || !session.accountKey || !session.username || !session.id) return false;
  for (const database of [dmAuthDb, legacyDmAuthDb]) {
    if (!database) continue;
    try {
      const snapshot = await database.ref("users/" + session.accountKey).get();
      const account = snapshot.val();
      if (account && account.username === session.username && String(account.id) === String(session.id)) {
        return true;
      }
    } catch (e) {}
  }
  return false;
}

async function loadDmAvatar(session) {
  for (const database of [dmAuthDb, legacyDmAuthDb]) {
    if (!database) continue;
    try {
      const snapshot = await database.ref("users/" + session.accountKey + "/avatar").get();
      if (snapshot.exists()) return snapshot.val() || null;
    } catch (e) {}
  }
  return null;
}

