  } catch (e) { /* ignore quota errors — non-critical */ }
}

function loadPingBadgesFromStorage() {
  try {
    const raw = localStorage.getItem(ROOM_PING_BADGE_KEY);
    roomPingBadges = new Set(raw ? JSON.parse(raw) : []);
