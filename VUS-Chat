<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VUS Chat</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    background: #0f172a;
    color: #f1f5f9;
    font-family: Arial, sans-serif;
    display: flex;
    flex-direction: column;
  }
  .chat-header {
    padding: 18px 21px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 24px;
    font-weight: 500;
    border-bottom: 1.5px solid #1f2937;
    flex-shrink: 0;
  }
  .chat-header .room-name { color: #94a3b8; font-size: 18px; font-weight: 400; }
  .you-avatar { width: 27px; height: 27px; border-radius: 50%; background: #334155; color: #f1f5f9; display: inline-flex; align-items: center; justify-content: center; overflow: hidden; font-size: 13px; font-weight: 700; flex-shrink: 0; }
  .you-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .chat-online-dot {
    display: inline-block;
    width: 10.5px;
    height: 10.5px;
    border-radius: 50%;
    background: #22c55e;
    margin-right: 7.5px;
  }
  .chat-online-dot.offline { background: #ef4444; }
  #joinScreen {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  #joinCard {
    width: 100%;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .auth-eyebrow { color: #4ade80; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .auth-title { font-size: 24px !important; font-weight: 700 !important; }
  .auth-subtitle { max-width: 300px; }
  .auth-form { gap: 12px !important; }
  .auth-field { display: flex; flex-direction: column; gap: 5px; width: 100%; }
  .auth-field label { color: #cbd5e1; font-size: 12.5px; font-weight: 600; }
  .auth-input { width: 100%; padding: 11px 13px; background: #1e293b; border: 1.5px solid #334155; border-radius: 9px; color: #f1f5f9; font-size: 15px; outline: none; }
  .auth-input:focus { border-color: #22c55e; }
  .auth-error { color: #f87171; font-size: 13px; min-height: 18px; text-align: center; }
  .auth-submit { margin-top: 2px; }
  .auth-switch { border: none; padding: 5px; }
  #joinScreen h2 { font-size: 19px; font-weight: 500; margin-bottom: 2px; text-align: center; }
  #joinScreen p { font-size: 13.5px; color: #94a3b8; text-align: center; margin-bottom: 4px; line-height: 1.4; }
  #nameInput {
    width: 100%;
    padding: 10px 13px;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 9px;
    color: #f1f5f9;
    font-size: 15px;
    outline: none;
  }
  #nameInput:focus { border-color: #22c55e; }
  #joinBtn {
    width: 100%;
    padding: 10px 13px;
    background: #22c55e;
    border: none;
    border-radius: 9px;
    color: #000;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
  }
  #joinBtn:hover { background: #4ade80; }
  #joinBtn:disabled { opacity: .5; cursor: not-allowed; }
  #joinError { font-size: 13px; color: #ef4444; min-height: 18px; }
  .join-secondary-btn {
    width: 100%;
    padding: 9px 13px;
    background: transparent;
    border: 1.5px solid #334155;
    border-radius: 9px;
    color: #94a3b8;
    font-size: 14px;
    cursor: pointer;
  }
  .join-secondary-btn:hover { color: #f1f5f9; border-color: #475569; }
  .join-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    color: #475569;
    font-size: 12px;
  }
  .join-divider::before, .join-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #334155;
  }
  #chatScreen { display: none; flex: 1; flex-direction: column; min-height: 0; }
  #messages {
    flex: 1;
    overflow-y: auto;
    padding: 18px 21px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #messages::-webkit-scrollbar { width: 7.5px; }
  #messages::-webkit-scrollbar-thumb { background: #334155; border-radius: 4.5px; }
  .msg { max-width: 82%; display: flex; flex-direction: column; gap: 3px; }
  .msg.mine { align-self: flex-end; align-items: flex-end; }
  .msg-meta { font-size: 16.5px; color: #64748b; padding: 0 6px; }
  .msg-bubble {
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 15px;
    padding: 12px 16.5px;
    font-size: 20.2px;
    line-height: 1.4;
    word-break: break-word;
    white-space: pre-wrap;
  }
  .msg.mine .msg-bubble { background: #14532d; border-color: #166534; }
  .msg.system { align-self: center; max-width: 100%; }
  .msg.system .msg-bubble {
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 17.2px;
    font-style: italic;
    padding: 3px;
  }
  .msg-bubble .mention-chip-inline {
    color: #4ade80;
    font-weight: 700;
  }
  .crown-bubble {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #78350f;
    border: 1.5px solid #b45309;
    color: #fde68a;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 14px;
    font-weight: 700;
    align-self: flex-start;
  }
  .msg.mine .crown-bubble { align-self: flex-end; }
  .mod-bubble {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #1e3a5f;
    border: 1.5px solid #2563eb;
    color: #93c5fd;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 14px;
    font-weight: 700;
    align-self: flex-start;
  }
  .msg.mine .mod-bubble { align-self: flex-end; }
  .admin-bubble {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: #164e63;
    border: 1.5px solid #0891b2;
    color: #a5f3fc;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 14px;
    font-weight: 700;
    align-self: flex-start;
  }
  .msg.mine .admin-bubble { align-self: flex-end; }
  .role-bubble-row { display: flex; gap: 4px; flex-wrap: wrap; }
  .msg.mine .role-bubble-row { justify-content: flex-end; }
  #emptyState {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    font-size: 19.5px;
    text-align: center;
    padding: 30px;
  }
  #toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 9px;
    padding: 9px 21px;
    border-top: 1.5px solid #1f2937;
    flex-shrink: 0;
    flex-wrap: wrap;
  }
  .toolbar-btn {
    background: transparent;
    border: 1.5px solid #334155;
    color: #94a3b8;
    font-size: 15.8px;
    padding: 6px 12px;
    border-radius: 9px;
    cursor: pointer;
  }
  .toolbar-btn:hover { color: #f1f5f9; border-color: #475569; }
  .toolbar-btn.active {
    background: rgba(34,197,94,.12);
    border-color: #22c55e;
    color: #4ade80;
  }

  /* ── Settings button + panel (moved from the header dot) ── */
  #settingsBtn {
    flex-shrink: 0;
    width: 51px;
    height: 51px;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 12px;
    color: #94a3b8;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }
  #settingsBtn:hover { color: #f1f5f9; border-color: #475569; }
  #settingsBtn.open { border-color: #22c55e; color: #4ade80; background: rgba(34,197,94,.12); }
  #globalClearPanel {
    position: absolute;
    bottom: 100%;
    left: 18px;
    margin-bottom: 8px;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 10px;
    padding: 12px;
    z-index: 30;
    width: 260px;
    max-height: 70vh;
    overflow-y: auto;
    font-size: 15px;
    font-weight: 400;
  }
  /* ── Slash command list + ghost autocomplete ── */
  #inputStack { position: relative; flex: 1; min-width: 120px; display: flex; }
  #inputStack #msgInput { position: relative; z-index: 1; width: 100%; }
  #commandGhost {
    position: absolute;
    inset: 0;
    z-index: 0;
    padding: 7.5px 4px;
    font-size: 20.2px;
    font-family: inherit;
    line-height: normal;
    white-space: pre-wrap;
    overflow: hidden;
    pointer-events: none;
    color: transparent;
  }
  #commandGhost .ghost-hint { color: rgba(148,163,184,.45); }
  #commandGhost .ghost-tab {
    display: inline-block;
    margin-left: 8px;
    font-size: 11px;
    letter-spacing: .04em;
    color: rgba(148,163,184,.55);
    border: 1px solid rgba(148,163,184,.35);
    border-radius: 4px;
    padding: 0 5px;
    vertical-align: middle;
  }
  #commandList {
    display: none;
    position: absolute;
    bottom: 100%;
    left: 18px;
    margin-bottom: 8px;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 10px;
    padding: 6px;
    width: 340px;
    max-width: calc(100vw - 36px);
    max-height: 260px;
    overflow-y: auto;
    z-index: 25;
  }
  .command-option {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    color: #f1f5f9;
    padding: 8px 10px;
    border-radius: 7px;
    cursor: pointer;
  }
  .command-option:hover, .command-option.active { background: rgba(255,255,255,.07); }
  .command-option .cmd-name { color: #4ade80; font-family: monospace; font-size: 14.5px; font-weight: 700; }
  .command-option .cmd-args { color: #64748b; font-family: monospace; font-size: 13px; margin-left: 6px; }
  .command-option .cmd-desc { display: block; color: #94a3b8; font-size: 12.5px; margin-top: 2px; }
  .command-empty { color: #64748b; font-size: 13.5px; padding: 8px 10px; }
  /* ── New role bubbles ── */
  .unranked-bubble, .normie-bubble, .coowner-bubble {
    display: inline-flex; align-items: center; gap: 4px;
    border-radius: 10px; padding: 3px 10px; font-size: 14px; font-weight: 700;
    align-self: flex-start;
  }
  .unranked-bubble { background: #14532d; border: 1.5px solid #22c55e; color: #bbf7d0; }
  .normie-bubble   { background: #334155; border: 1.5px solid #64748b; color: #e2e8f0; }
  .coowner-bubble  { background: #4c1d95; border: 1.5px solid #8b5cf6; color: #ddd6fe; }
  .msg.mine .unranked-bubble, .msg.mine .normie-bubble, .msg.mine .coowner-bubble { align-self: flex-end; }
  #jumpToBottomBtn {
    display: none;
    background: #1e293b;
    border: 1.5px solid #334155;
    color: #f1f5f9;
    font-size: 15.8px;
    padding: 6px 14px;
    border-radius: 20px;
    cursor: pointer;
    align-self: center;
    margin: 0 auto 6px auto;
  }
  #jumpToBottomBtn:hover { border-color: #475569; }
  #pingYouBtn {
    background: transparent;
    border: 1.5px solid #f59e0b;
    color: #f59e0b;
  }
  #pingYouBtn:hover { background: rgba(245,158,11,.12); }
  #pingYouBtn:disabled { opacity: .5; cursor: not-allowed; border-color: #334155; color: #64748b; background: transparent; }
  #pingYouPanel {
    display: none;
    position: absolute;
    bottom: 100%;
    left: 0;
    margin-bottom: 8px;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 10px;
    padding: 12px;
    width: 260px;
    z-index: 20;
  }
  #pingYouPanel textarea {
    width: 100%;
    padding: 8px 10px;
    background: #0f172a;
    border: 1.5px solid #334155;
    border-radius: 8px;
    color: #f1f5f9;
    font-size: 14px;
    font-family: inherit;
    resize: none;
    outline: none;
    margin-bottom: 8px;
    max-height: 80px;
  }
  #pingYouPanel textarea:focus { border-color: #22c55e; }
  #composer {
    display: flex;
    gap: 12px;
    padding: 15px 18px;
    border-top: 1.5px solid #1f2937;
    flex-shrink: 0;
    align-items: flex-end;
    position: relative;
  }
  #composerInputWrap {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 12px;
  }
  #composerInputWrap:focus-within { border-color: #22c55e; }
  #mentionChip {
    display: none;
    align-items: center;
    gap: 4px;
    background: rgba(34,197,94,.15);
    border: 1.5px solid #22c55e;
    color: #4ade80;
    font-size: 15px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 8px;
    cursor: pointer;
    flex-shrink: 0;
    white-space: nowrap;
  }
  #mentionChip:hover { background: rgba(34,197,94,.25); }
  #msgInput {
    padding: 7.5px 4px;
    background: transparent;
    border: none;
    color: #f1f5f9;
    font-size: 20.2px;
    outline: none;
    resize: none;
    max-height: 135px;
    font-family: inherit;
    flex: 1;
    min-width: 120px;
  }
  #charCounter {
    font-size: 14.5px;
    color: #64748b;
  }
  #charCounter.warn { color: #f59e0b; }
  #charCounter.limit { color: #ef4444; }
  #sendBtn {
    padding: 0 24px;
    height: 51px;
    background: #22c55e;
    border: none;
    border-radius: 12px;
    color: #000;
    font-weight: 600;
    font-size: 19.5px;
    cursor: pointer;
    flex-shrink: 0;
  }
  #sendBtn:hover { background: #4ade80; }
  #sendBtn:disabled { opacity: .5; cursor: not-allowed; }
  #mentionDropdown {
    display: none;
    position: absolute;
    bottom: 100%;
    left: 18px;
    margin-bottom: 8px;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 10px;
    padding: 6px;
    width: 220px;
    max-height: 220px;
    overflow-y: auto;
    z-index: 25;
  }
  .mention-option {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    color: #f1f5f9;
    font-size: 15px;
    padding: 8px 10px;
    border-radius: 7px;
    cursor: pointer;
  }
  .mention-option:hover { background: rgba(255,255,255,.06); }
  .mention-empty {
    color: #64748b;
    font-size: 13.5px;
    padding: 8px 10px;
  }
  #connError {
    display: none;
    padding: 12px 21px;
    background: rgba(239,68,68,.1);
    border-top: 1.5px solid rgba(239,68,68,.3);
    color: #ef4444;
    font-size: 17.2px;
    flex-shrink: 0;
  }
  #composerNotice {
    display: none;
    padding: 8px 21px;
    background: rgba(245,158,11,.1);
    border-top: 1.5px solid rgba(245,158,11,.3);
    color: #f59e0b;
    font-size: 14.5px;
    flex-shrink: 0;
  }
  #changeNameBtn:hover { color: #f1f5f9 !important; border-color: #475569 !important; }
  #sendBtn.cooldown { background: #334155; color: #64748b; cursor: not-allowed; }
  #pingToast {
    display: none;
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    background: #1e293b;
    border: 1.5px solid #22c55e;
    border-radius: 12px;
    padding: 12px 18px;
    max-width: 320px;
    z-index: 200;
    box-shadow: 0 8px 32px rgba(0,0,0,.4);
  }
  #pingToast .ping-toast-title { color: #4ade80; font-weight: 700; font-size: 15px; margin-bottom: 4px; }
  #pingToast .ping-toast-body { color: #f1f5f9; font-size: 14px; line-height: 1.4; }
  #roomsToggleBtn {
    background: transparent;
    border: 1.5px solid #334155;
    color: #94a3b8;
    font-size: 14.5px;
    padding: 5px 11px;
    border-radius: 9px;
    cursor: pointer;
    position: relative;
  }
  #roomsToggleBtn:hover { color: #f1f5f9; border-color: #475569; }
  #roomsToggleBtn .rooms-badge-dot {
    display: none;
    position: absolute;
    top: -3px; right: -3px;
    width: 9px; height: 9px;
    border-radius: 50%;
    background: #ef4444;
    border: 1.5px solid #0f172a;
  }
  #roomsSidebarOverlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.5);
    z-index: 140;
  }
  #roomsSidebar {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: 300px;
    max-width: 88vw;
    background: #111827;
    border-left: 1.5px solid #1f2937;
    z-index: 141;
    display: flex;
    flex-direction: column;
    box-shadow: -16px 0 48px rgba(0,0,0,.4);
    transform: translateX(100%);
    transition: transform 0.25s ease;
  }
  #roomsSidebar.open {
    transform: translateX(0);
  }
  #roomsSidebarHeader {
    padding: 16px 18px;
    border-bottom: 1.5px solid #1f2937;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }
  #roomsSidebarHeader h3 { font-size: 16.5px; font-weight: 600; }
  #roomsSidebarClose {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 22px;
    cursor: pointer;
    line-height: 1;
    padding: 4px 8px;
  }
  #roomsSidebarClose:hover { color: #f1f5f9; }
  #roomsSidebarBody {
    flex: 1;
    overflow-y: auto;
    padding: 14px 16px;
  }
  .rooms-section-title {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .5px;
    color: #64748b;
    font-weight: 700;
    margin: 14px 0 8px 0;
  }
  .rooms-section-title:first-child { margin-top: 0; }
  .room-card {
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 11px;
    padding: 11px 13px;
    margin-bottom: 8px;
    cursor: pointer;
    position: relative;
  }
  .room-card:hover { border-color: #475569; }
  .room-card.active { border-color: #22c55e; background: rgba(34,197,94,.08); }
  .room-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .room-card-name {
    font-size: 14.5px;
    font-weight: 600;
    color: #f1f5f9;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .room-card-code {
    font-size: 11.5px;
    color: #64748b;
    font-family: monospace;
    margin-top: 2px;
  }
  .room-card-timer {
    font-size: 12px;
    font-family: monospace;
    color: #94a3b8;
    flex-shrink: 0;
  }
  .room-card-timer.urgent { color: #f59e0b; font-weight: 700; }
  .room-card-close {
    position: absolute;
    top: 6px; right: 6px;
    width: 20px; height: 20px;
    border-radius: 50%;
    background: transparent;
    border: none;
    color: #64748b;
    font-size: 15px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .room-card-close:hover { background: rgba(255,255,255,.08); color: #f1f5f9; }
  .room-card-dot {
    display: inline-block;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #ef4444;
    margin-left: 4px;
    flex-shrink: 0;
  }
  .room-card-pinned {
    font-size: 10.5px;
    color: #4ade80;
    background: rgba(34,197,94,.12);
    border-radius: 5px;
    padding: 1px 6px;
    margin-left: 6px;
  }
  .rooms-empty {
    color: #64748b;
    font-size: 13px;
    padding: 6px 2px 14px 2px;
    line-height: 1.5;
  }
  #roomsSidebarFooter {
    padding: 14px 16px;
    border-top: 1.5px solid #1f2937;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  #joinByCodeInput {
    padding: 8px 11px;
    background: #0f172a;
    border: 1.5px solid #334155;
    border-radius: 9px;
    color: #f1f5f9;
    font-size: 14px;
    outline: none;
    text-transform: uppercase;
  }
  #joinByCodeInput:focus { border-color: #22c55e; }
  .rooms-footer-row { display: flex; gap: 8px; }
  .rooms-footer-row button { flex: 1; }
  #createRoomBtn, #joinByCodeBtn {
    padding: 9px 12px;
    background: #22c55e;
    border: none;
    border-radius: 9px;
    color: #000;
    font-weight: 600;
    font-size: 13.5px;
    cursor: pointer;
  }
  #createRoomBtn:hover, #joinByCodeBtn:hover { background: #4ade80; }
