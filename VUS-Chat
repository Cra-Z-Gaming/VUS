let myName = "";
let messageCount = 0;
let autoScroll = true;
let isSpectator = false; // this session joined silently (no join/leave log)
let crownedNames = new Set(); // safe-keyed names currently holding the crown

const NAME_STORAGE_KEY = "vusChatName";
// Placeholder name coming from VUS Hub's Settings (Display Name), read via
// localStorage since Hub and Chat are same-origin when Chat loads inside
// Hub's sidebar iframe or is opened via the same site. This is ONLY ever
// used as a text-field placeholder — never auto-fills or auto-joins, per
// the "must still choose guest/spectator deliberately" requirement.
const HUB_DISPLAY_NAME_KEY = "vus_hub_display_name";

const SEND_COOLDOWN_MS = 3000;
let lastSentAt = 0;
let cooldownTimer = null;

let isCurrentlyTyping = false;
let typingStopTimer = null;

function esc(s = "") {
  return String(s)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function formatTime(ts) {
  if (!ts) return "";
  const d = new Date(ts);
  return d.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
}

function isNearBottom() {
  return $messages.scrollHeight - $messages.scrollTop - $messages.clientHeight < 120;
}

function scrollToBottom() {
  requestAnimationFrame(() => { $messages.scrollTop = $messages.scrollHeight; });
  $jumpToBottomBtn.style.display = "none";
}

function renderMessage(msg) {
  $emptyState.style.display = "none";

  if (msg.system) {
    const sysEl = document.createElement("div");
    sysEl.className = "msg system";
    const sysBubble = document.createElement("div");
    sysBubble.className = "msg-bubble";
    sysBubble.textContent = msg.text;
    sysEl.appendChild(sysBubble);
    $messages.appendChild(sysEl);
    messageCount++;
    if (autoScroll) scrollToBottom();
    return;
  }

  const mine = msg.name === myName;
  const el = document.createElement("div");
  el.className = "msg" + (mine ? " mine" : "");

  const meta = document.createElement("div");
  meta.className = "msg-meta";
  meta.textContent = (mine ? "You" : esc(msg.name)) + (msg.ts ? " · " + formatTime(msg.ts) : "");
  el.appendChild(meta);

  // Crown bubble: its own small bubble, ABOVE the message bubble, only for
  // senders who are crowned RIGHT NOW (live presence-based, not baked into
  // the message at send time — so it always reflects current status).
  const isCrowned = crownedNames.has(ChatBackend._safeKey(msg.name));
  if (isCrowned) {
    const crownBubble = document.createElement("div");
    crownBubble.className = "crown-bubble";
    crownBubble.textContent = "👑";
    el.appendChild(crownBubble);
  }

  const bubble = document.createElement("div");
  bubble.className = "msg-bubble";

  if (msg.imageData) {
    const link = document.createElement("a");
    link.href = msg.imageData;
    link.target = "_blank";
    link.rel = "noopener noreferrer";
    const img = document.createElement("img");
    img.src = msg.imageData;
    img.alt = "Shared image";
    img.style.cssText = "max-width:100%;max-height:280px;border-radius:10px;display:block";
    link.appendChild(img);
    bubble.appendChild(link);
    bubble.style.padding = "6px";
  } else if (msg.mention) {
    // Render the @mention as a highlighted inline chip, followed by the
    // rest of the message text (if any).
    const chip = document.createElement("span");
    chip.className = "mention-chip-inline";
    chip.textContent = "@" + msg.mention;
    bubble.appendChild(chip);
    if (msg.text) {
      bubble.appendChild(document.createTextNode(" " + msg.text));
    }
  } else {
    bubble.textContent = msg.text;
  }

  if (!msg.imageData) {
    if (msg.bubble) bubble.style.background = msg.bubble;
    if (msg.textColor) bubble.style.color = msg.textColor;
  }

  el.appendChild(bubble);
  $messages.appendChild(el);

  messageCount++;
  while (messageCount > MAX_MESSAGES) {
    const first = $messages.querySelector(".msg");
    if (!first) break;
    first.remove();
    messageCount--;
  }

  if (autoScroll && (isNearBottom() || mine)) {
    scrollToBottom();
  } else if (!isNearBottom()) {
    $jumpToBottomBtn.style.display = "block";
  }

  // If this message @mentions the person currently using this tab, and it
  // wasn't sent by them (no self-pinging), trigger the live ping: sound +
  // in-page toast + browser notification (if permitted).
  if (msg.mention && msg.mention === myName && msg.name !== myName) {
    triggerIncomingPing(msg.name, msg.text);
  }
}

function setConnectionStatus(isOnline) {
  $onlineDot.className = "chat-online-dot" + (isOnline ? "" : " offline");
  if (isOnline) {
    $connError.style.display = "none";
  } else {
    $connError.textContent = "Disconnected — trying to reconnect…";
    $connError.style.display = "block";
  }
}

function randomGuestName() {
  const n = Math.floor(Math.random() * 999) + 1;
  return "Guest " + n;
}

function randomSpectatorName() {
  const n = Math.floor(Math.random() * 999) + 1;
  return "Spectator #" + n;
}

// True if a name contains "spectator" anywhere, case-insensitive — used to
// mute chat for auto-assigned spectators AND anyone who manually renames
// into something containing that word.
function isSpectatorName(name) {
  return /spectator/i.test(name || "");
}

async function attemptJoin(rawName, isRename, errEl, submitBtn, joinSilently) {
  const name = rawName.trim().replace(/ {2,}/g, " ");
  if (!name) {
    errEl.textContent = "Enter a name to continue.";
    return;
  }
  if (name.length > 24) {
    errEl.textContent = "Name is too long (max 24 characters).";
    return;
  }

  if (isRename && name === myName) {
    $chatScreen.style.display = "flex";
    $joinScreen.style.display = "none";
    return;
  }

  if (submitBtn) submitBtn.disabled = true;
  errEl.textContent = "";
  try {
    const taken = await ChatBackend.isNameTaken(name);
    if (taken) {
      errEl.textContent = "That name is already used.";
      if (submitBtn) submitBtn.disabled = false;
      return;
    }
  } catch (e) {
    errEl.textContent = "Couldn't check name availability — try again.";
    if (submitBtn) submitBtn.disabled = false;
    return;
  }
  if (submitBtn) submitBtn.disabled = false;

  if (isRename && isCurrentlyTyping) {
    ChatBackend.clearTyping();
    isCurrentlyTyping = false;
  }
  ChatBackend._myTypingRef = null;

  myName = name;
  isSpectator = !!joinSilently;
  localStorage.setItem(NAME_STORAGE_KEY, name);
  ChatBackend.claimPresence(myName, isSpectator);
  requestNotificationPermissionIfNeeded();
  $youAre.textContent = "You: " + name + (isSpectator ? " (spectating)" : "");
  $changeNameBtn.style.display = "inline-block";
  $joinScreen.style.display = "none";
  $chatScreen.style.display = "flex";
  updateComposerLockState();
  if (!isSpectatorName(myName)) $msgInput.focus();
  scrollToBottom();
}

// Reads the Hub-set display name (if any) to use as a join-screen
// placeholder. Never auto-fills the field's value and never auto-joins —
// this is purely a hint the person can see and choose to type/click.
function getHubDisplayNamePlaceholder() {
  try {
    const name = localStorage.getItem(HUB_DISPLAY_NAME_KEY);
    return (name && name.trim()) ? name.trim() : "";
  } catch (e) {
    return "";
  }
}

function renderJoinReturning(savedName) {
  $joinCard.innerHTML = "";

  const h2 = document.createElement("h2");
  h2.textContent = "Welcome back";
  const p = document.createElement("p");
  p.textContent = "Continue as \u201c" + savedName + "\u201d?";

  const errEl = document.createElement("div");
  errEl.id = "joinError";

  const yesBtn = document.createElement("button");
  yesBtn.id = "joinBtn";
  yesBtn.textContent = "Continue as " + savedName;
  yesBtn.addEventListener("click", () => attemptJoin(savedName, false, errEl, yesBtn));

  const noBtn = document.createElement("button");
  noBtn.className = "join-secondary-btn";
  noBtn.textContent = "No, use a different name";
  noBtn.addEventListener("click", () => renderJoinNameEntry());

  $joinCard.appendChild(h2);
  $joinCard.appendChild(p);
  $joinCard.appendChild(yesBtn);
  $joinCard.appendChild(noBtn);
  $joinCard.appendChild(errEl);
}

function renderJoinNameEntry(isRename) {
  $joinCard.innerHTML = "";

  const h2 = document.createElement("h2");
  h2.textContent = isRename ? "Change your name" : "Join the chat";
  const p = document.createElement("p");
  p.textContent = "Pick a display name. Anyone here can see your messages in real time.";

  const input = document.createElement("input");
  input.id = "nameInput";
  input.type = "text";
  // Hub-set display name (if any) shows as a placeholder only — never
  // auto-filled as a value, so joining still requires a deliberate choice
  // (including choosing Guest/Spectator instead).
  input.placeholder = getHubDisplayNamePlaceholder() || "Your name…";
  input.maxLength = 24;
  input.autocomplete = "off";
  if (isRename) input.value = myName;

  const errEl = document.createElement("div");
  errEl.id = "joinError";

  const joinBtn = document.createElement("button");
  joinBtn.id = "joinBtn";
  joinBtn.textContent = isRename ? "Save" : "Join Chat";

  const submit = () => attemptJoin(input.value, !!isRename, errEl, joinBtn);
  joinBtn.addEventListener("click", submit);
  input.addEventListener("keydown", e => { if (e.key === "Enter") submit(); });

  $joinCard.appendChild(h2);
  $joinCard.appendChild(p);
  $joinCard.appendChild(input);
  $joinCard.appendChild(errEl);
  $joinCard.appendChild(joinBtn);

  if (!isRename) {
    const divider = document.createElement("div");
    divider.className = "join-divider";
    divider.textContent = "or";

    const guestBtn = document.createElement("button");
    guestBtn.className = "join-secondary-btn";
    guestBtn.textContent = "Join as Guest";
    guestBtn.addEventListener("click", () => {
      const guestName = randomGuestName();
      input.value = guestName;
      submit();
    });

    $joinCard.appendChild(divider);
    $joinCard.appendChild(guestBtn);
  }

  input.focus();
  if (isRename) input.select();
}

function openChangeName() {
  $chatScreen.style.display = "none";
  $joinScreen.style.display = "flex";
  renderJoinNameEntry(true);
}

function updateSendButtonState() {
  const elapsed = Date.now() - lastSentAt;
  const remaining = SEND_COOLDOWN_MS - elapsed;
  if (remaining > 0) {
    $sendBtn.disabled = true;
    $sendBtn.classList.add("cooldown");
    $sendBtn.textContent = Math.ceil(remaining / 1000) + "s";
    clearTimeout(cooldownTimer);
    cooldownTimer = setTimeout(updateSendButtonState, 250);
  } else {
    $sendBtn.disabled = false;
    $sendBtn.classList.remove("cooldown");
    $sendBtn.textContent = "Send";
  }
}

// Locks the composer whenever the current name contains "spectator"
// (case-insensitive) — covers auto-assigned spectators AND anyone who
// manually renames into something with that word in it. Swaps the
// placeholder/button to prompt a rename instead of silently no-opping.
function updateComposerLockState() {
  if (isSpectatorName(myName)) {
    $msgInput.disabled = true;
    $msgInput.placeholder = "Rename to chat — you're spectating";
    $sendBtn.disabled = false; // stays clickable so it can open rename
    $sendBtn.classList.remove("cooldown");
    $sendBtn.textContent = "Rename to chat";
  } else {
    $msgInput.disabled = false;
    $msgInput.placeholder = "Type a message… (@ to mention someone)";
    updateSendButtonState();
  }
}

function sendMessage() {
  if (isSpectatorName(myName)) {
    openChangeName();
    return;
  }
  if (Date.now() - lastSentAt < SEND_COOLDOWN_MS) return;

  const text = $msgInput.value.trim();
  const mentionTarget = currentMentionTarget; // captured before we clear it below

  // A staged image takes priority: send it now. If there's also caption
  // text typed in, send that as a separate follow-up message right after,
  // so neither gets silently dropped.
  if (pendingImageDataUrl) {
    const imageToSend = pendingImageDataUrl;
    clearPendingImage();

    lastSentAt = Date.now();
    updateSendButtonState();
    stopTyping();

    ChatBackend.sendImage(myName, imageToSend)
      .then(() => {
        if (text) {
          return ChatBackend.send(myName, text);
        }
      })
      .then(() => {
        $msgInput.value = "";
        autosizeInput();
        updateCharCounter();
        autoScroll = true;
        setAutoScrollUI();
      })
      .catch(() => {
        $connError.textContent = "Image failed to send — check your connection.";
        $connError.style.display = "block";
      })
      .finally(() => { $msgInput.focus(); });
    return;
  }

  if (!text && !mentionTarget) return;

  // If there's a mention chip active, this send attempt needs to pass the
  // per-target @Ping cooldown check first (Firebase transaction — see
  // tryStartAtPingCooldown). A normal message with no mention skips this
  // entirely and sends immediately like before.
  if (mentionTarget) {
    $sendBtn.disabled = true;
    ChatBackend.tryStartAtPingCooldown(mentionTarget).then(result => {
      $sendBtn.disabled = false;
      if (!result.ok) {
        const secs = Math.ceil(result.remainingMs / 1000);
        showComposerNotice(mentionTarget + " was just pinged — wait " + secs + "s before pinging them again.");
        return;
      }
      finalizeSend(text, { name: mentionTarget });
    }).catch(() => {
      $sendBtn.disabled = false;
      showComposerNotice("Couldn't check ping cooldown — try again.");
    });
    return;
  }

  finalizeSend(text, null);
}

function finalizeSend(text, mention) {
  lastSentAt = Date.now();
  updateSendButtonState();
  stopTyping();

  ChatBackend.send(myName, text, mention)
    .then(() => {
      $msgInput.value = "";
      clearMention();
      autosizeInput();
      updateCharCounter();
      autoScroll = true;
      setAutoScrollUI();
    })
    .catch(() => {
      $connError.textContent = "Message failed to send — check your connection.";
      $connError.style.display = "block";
    })
    .finally(() => { $msgInput.focus(); });
}

