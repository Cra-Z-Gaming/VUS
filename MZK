// ---------- player ----------
function playList(list,i){ queue=list.slice(); load(i); }
function load(i){
  const t=queue[i]; if(!t) return;
  qi=i; audio.src=t.url; audio.play().catch(()=>{});
  $("now").textContent=t.title; $("sub").textContent=t.group||"Single"; $("art").hidden=true;
  document.title=t.title+" · mzk"; markPlaying();
  if("mediaSession" in navigator) navigator.mediaSession.metadata=new MediaMetadata({title:t.title,artist:t.group||"",album:t.group||"mzk"});
  getMeta(t).then(m=>{
    if(queue[qi]!==t||!m) return;
    if(m.art){ $("art").src=m.art; $("art").hidden=false; }
    if(m.artist) $("sub").textContent=m.artist+(m.album?" · "+m.album:"");
    if("mediaSession" in navigator) navigator.mediaSession.metadata=new MediaMetadata({title:m.title||t.title,artist:m.artist||t.group||"",album:m.album||t.group||"mzk",artwork:m.art?[{src:m.art}]:[]});
