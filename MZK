  .chip input:checked + span { background:var(--raised); color:var(--accent); border-color:var(--accent); }
  .chip input:focus-visible + span { outline:2px solid var(--accent); outline-offset:2px; }
  #content { padding:6px 24px 32px; }

  h2.title { font:700 2rem/1.15 Georgia,serif; margin:8px 0 2px; letter-spacing:-.02em; }
  .stat { color:var(--dim); margin:0; }
  .label { margin:28px 0 12px; font:700 1.15rem Georgia,serif; }
