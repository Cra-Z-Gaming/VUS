function next(auto){
  if(!queue.length) return;
  if(auto&&repeat===2){ audio.currentTime=0; audio.play(); return; }
  let n;
  if(shuffle&&queue.length>1){ do{ n=Math.floor(Math.random()*queue.length); }while(n===qi); } else n=qi+1;
  if(n>=queue.length){ if(repeat===1||!auto) n=0; else { audio.pause(); return; } }
  load(n);
}
function prev(){ if(!queue.length) return; if(audio.currentTime>3){ audio.currentTime=0; return; } load((qi-1+queue.length)%queue.length); }
function toggle(){ if(qi<0){ const l=data[activeTab].tracks; if(l.length) playList(l,0); return; } audio.paused?audio.play():audio.pause(); }

audio.addEventListener("ended",()=>next(true));
audio.addEventListener("play",updatePP); audio.addEventListener("pause",updatePP);
