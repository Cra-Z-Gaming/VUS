<script>
const OWNER="Cra-Z-Gaming", REPO="mzk", BRANCH="main";

// ---- Accounts (optional): paste your Firebase web app config here to turn on Google/email sign-in + sync ----
// const FIREBASE_CONFIG = { apiKey:"...", authDomain:"...", projectId:"...", appId:"..." };
