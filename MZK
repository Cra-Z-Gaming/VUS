  .tile:hover .tmore, .tile:focus-within .tmore { opacity:1; }
  @media (hover:none) { .tmore { opacity:1; } }
  .pill.primary { background:var(--accent); color:var(--accent-ink); border-color:transparent; }
  .pill.danger { background:#d84a4a; color:#fff; border-color:transparent; }
  #ctx { position:fixed; z-index:50; min-width:220px; max-width:290px; max-height:calc(100vh - 16px); overscroll-behavior:contain; overflow-y:auto; background:var(--raised); border:1px solid var(--line); border-radius:12px; padding:6px; box-shadow:var(--shadow); }
  .mi { display:flex; align-items:center; gap:10px; width:100%; padding:8px 12px; border-radius:8px; text-align:left; font-size:.9rem; }
  .mi:hover, .mi:focus-visible { background:var(--line); outline:none; }
  .mi.danger { color:#ff7a7a; } .mi.dim { color:var(--dim); }
  .mi .arrow { margin-left:auto; opacity:.6; }
  .msep { height:1px; background:var(--line); margin:5px 4px; }
  dialog.modal input.txt { width:100%; padding:10px 14px; border-radius:10px; border:1px solid var(--line); background:var(--raised); color:var(--text); font:inherit; margin-bottom:16px; }
  .btnrow { display:flex; gap:10px; justify-content:center; }

  #queuePanel { position:fixed; right:16px; bottom:112px; width:min(380px,calc(100% - 32px)); max-height:min(60vh,520px); overflow-y:auto; background:var(--raised); border:1px solid var(--line); border-radius:16px; box-shadow:var(--shadow); padding:12px; z-index:30; }
  .qhead { display:flex; align-items:center; gap:8px; margin-bottom:6px; }
  .qhead h3 { margin:0; flex:1; font:700 1.1rem Georgia,serif; }
  .qlabel { margin:10px 8px 4px; color:var(--dim); font-size:.72rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
  .qrow { display:flex; align-items:center; gap:8px; padding:6px 6px 6px 10px; border-radius:10px; cursor:pointer; }
  .qrow:hover { background:var(--line); }
  .qrow.now { color:var(--accent); cursor:default; }
  .qrow .qt { flex:1; min-width:0; }
  .qrow .qt span { display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .qrow .qt small { display:block; color:var(--dim); font-size:.76rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .qnote { color:var(--dim); font-size:.82rem; padding:6px 10px; }
  #qbtn.on { color:var(--accent); }

  #loadbar { position:fixed; top:14px; left:50%; transform:translateX(-50%); width:min(420px,calc(100% - 28px)); height:34px; border-radius:99px; background:var(--raised); border:1px solid var(--line); overflow:hidden; cursor:pointer; z-index:40; box-shadow:var(--shadow); }
  #loadbar .fill { position:absolute; top:0; bottom:0; left:0; width:0; background:var(--accent); opacity:.4; transition:width .25s; }
  #loadbar .txt { position:relative; display:block; text-align:center; line-height:32px; font-size:.82rem; }
  #loadbar.ind .fill { width:35%; animation:ind 1.1s ease-in-out infinite alternate; }
  @keyframes ind { from { left:0; } to { left:65%; } }
  @media (prefers-reduced-motion:reduce) { #loadbar.ind .fill { animation:none; width:100%; opacity:.2; } }

  .nav img { width:22px; height:22px; border-radius:50%; object-fit:cover; flex:none; }
  #opts.on { color:var(--accent); }
  .err { color:#ff7a7a; min-height:1.3em; margin:0 0 10px; font-size:.85rem; }
  .linkbtn { color:var(--dim); font-size:.82rem; margin-top:12px; text-decoration:underline; }
  .linkbtn:hover { color:var(--text); }
  dialog.modal .stack { display:flex; flex-direction:column; gap:10px; margin:12px 0; }
  dialog.modal .stack input.txt { margin:0; }
  .or { color:var(--dim); font-size:.8rem; margin:12px 0 0; }

  /* ---------- polish ---------- */
  #content { max-width:1180px; }
  .topbar { padding:16px 24px 8px; gap:8px 14px; }
  .searchbox { position:relative; flex:1 1 280px; max-width:440px; }
  .searchbox svg { position:absolute; left:14px; top:50%; transform:translateY(-50%); width:20px; height:20px; color:var(--dim); pointer-events:none; }
  #q { width:100%; max-width:none; padding:11px 18px 11px 44px; background:var(--raised); border-color:transparent; }
  #q:focus { outline:2px solid var(--accent); outline-offset:0; border-color:transparent; }
  .scopes { display:none; align-items:center; }
  .topbar:focus-within .scopes, .scopes.show { display:flex; }
  .sin { color:var(--dim); font-size:.78rem; margin-right:2px; }
  h2.title { font-size:2.2rem; margin-top:14px; }
  .tile { padding:10px; }
  .tile h3 { margin-top:10px; }
  li { padding:8px 8px 8px 12px; }
  li .heart:not(.on), li .more, li .plus { opacity:0; transition:opacity .12s; }
  li:hover .heart, li:hover .more, li:hover .plus, li:focus-within .heart, li:focus-within .more, li:focus-within .plus, li.playing .heart, li.playing .more, li.playing .plus { opacity:1; }
  @media (hover:none) { li .heart, li .more, li .plus { opacity:1 !important; } }
  .nav { transition:background .12s,color .12s; }

  /* ---------- player ---------- */
  #player { grid-template-columns:minmax(0,1fr) minmax(320px,2.2fr) minmax(0,1fr); grid-template-areas:"np ctr vol"; padding:12px 20px; border:1px solid var(--line); }
  .np { grid-area:np; } .center { grid-area:ctr; gap:6px; } .vol { grid-area:vol; gap:2px; }
  .ctrls { gap:10px; align-items:center; }
  .ctrls .ib { width:36px; height:36px; }
  #shuf svg, #rep svg { width:19px; height:19px; }
  #prev, #next { width:42px; height:42px; color:var(--text); }
  #prev svg, #next svg { width:26px; height:26px; }
  #prev:hover, #next:hover { background:var(--raised); }
  #pp { width:50px; height:50px; transition:transform .12s; }
  #pp:hover { transform:scale(1.06); }
  #pp svg { width:24px; height:24px; }
  .seek { gap:12px; max-width:560px; font-size:.74rem; }
  .seek span { width:2.6em; }
  .seek span:last-child { text-align:left; }

  input.rng { -webkit-appearance:none; appearance:none; background:transparent; height:18px; cursor:pointer; --p:0%; margin:0; }
  input.rng::-webkit-slider-runnable-track { height:4px; border-radius:99px; background:linear-gradient(to right,var(--accent) var(--p),var(--line) var(--p)); }
  input.rng::-moz-range-track { height:4px; border-radius:99px; background:var(--line); }
  input.rng::-moz-range-progress { height:4px; border-radius:99px; background:var(--accent); }
  input.rng::-webkit-slider-thumb { -webkit-appearance:none; width:13px; height:13px; border-radius:50%; background:var(--text); margin-top:-4.5px; border:0; opacity:0; transition:opacity .12s; }
  input.rng::-moz-range-thumb { width:13px; height:13px; border-radius:50%; background:var(--text); border:0; opacity:0; transition:opacity .12s; }
  input.rng:hover::-webkit-slider-thumb, input.rng:focus-visible::-webkit-slider-thumb, input.rng:active::-webkit-slider-thumb { opacity:1; }
  input.rng:hover::-moz-range-thumb, input.rng:focus-visible::-moz-range-thumb, input.rng:active::-moz-range-thumb { opacity:1; }
  @media (hover:none) { input.rng::-webkit-slider-thumb, input.rng::-moz-range-thumb { opacity:1; } }
  input.rng:focus-visible { outline:2px solid var(--accent); outline-offset:3px; border-radius:99px; }
  #volume { width:96px; }

  .lhb { display:flex; gap:2px; }
  .pill:disabled { opacity:.45; cursor:not-allowed; }
  .sharebox { margin:18px 0 8px; padding:16px 18px; border:1px solid var(--line); border-radius:14px; background:var(--raised); }
  .sharebox h4 { margin:0 0 4px; font:700 1.05rem Georgia,serif; }
  .sharebox .stat { margin:0 0 10px; font-size:.88rem; }
  .srow { display:flex; align-items:center; gap:12px; padding:10px 0; border-top:1px solid var(--line); flex-wrap:wrap; }
  .srow .scode { font:700 1.5rem ui-monospace,Menlo,Consolas,monospace; letter-spacing:.25em; }
  .srow .left { flex:1; color:var(--dim); font-size:.85rem; min-width:80px; }
  dialog.modal input.codein { text-align:center; letter-spacing:.4em; font:700 1.6rem ui-monospace,Menlo,Consolas,monospace; text-transform:uppercase; }

  .dlmark { display:inline-grid; place-items:center; width:18px; height:18px; border-radius:50%; background:#2fbf71; color:#fff; flex:none; }
  .dlmark svg { width:12px; height:12px; }
  .dlbadge { position:absolute; left:8px; top:8px; width:24px; height:24px; border-radius:50%; background:#2fbf71; color:#fff; display:grid; place-items:center; z-index:1; box-shadow:0 2px 8px rgba(0,0,0,.35); }
  .dlbadge svg { width:15px; height:15px; }
  .dlfull { display:inline-flex; align-items:center; gap:6px; color:#2fbf71; font-size:.85rem; font-weight:600; margin-top:6px; }
  .dlfull svg { width:16px; height:16px; background:#2fbf71; color:#fff; border-radius:50%; padding:2px; }

  :root[data-theme=dark] { --bg:#0a0a0c; --surface:#151518; --raised:#202026; --line:#2b2b33; --text:#f3f1f6; --dim:#9d9aa8; --accent:#8fe3d0; --accent-ink:#0c2420; --shadow:0 12px 40px rgba(0,0,0,.5); color-scheme:dark; }
  :root[data-theme=light] { --bg:#e8e6ee; --surface:#fff; --raised:#f0eef5; --line:#e0dce8; --text:#1d1a24; --dim:#74708a; --accent:#0e7c6b; --accent-ink:#fff; --shadow:0 12px 40px rgba(60,40,90,.18); color-scheme:light; }
  .setcard { margin:18px 0; padding:8px 20px 12px; border:1px solid var(--line); border-radius:14px; background:var(--raised); max-width:720px; }
  .setcard h3 { margin:12px 0 4px; font:700 1.1rem Georgia,serif; }
  .setrow { display:flex; align-items:center; justify-content:space-between; gap:12px 18px; flex-wrap:wrap; padding:12px 0; border-top:1px solid var(--line); }
  .setcard h3 + .setrow { border-top:0; }
  .setrow .lbl { font-weight:600; } .setrow .d { color:var(--dim); font-size:.85rem; font-weight:400; display:block; }
  .seg { display:inline-flex; background:var(--surface); border:1px solid var(--line); border-radius:99px; padding:3px; }
  .seg button { padding:6px 14px; border-radius:99px; color:var(--dim); font-size:.88rem; }
  .seg button[aria-pressed=true] { background:var(--accent); color:var(--accent-ink); }
