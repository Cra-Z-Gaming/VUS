// ---------- queue ----------
function queueAdd(tracks){
  if(qi<0||!queue[qi]){ queue=[tracks[0]]; userQ.push(...tracks.slice(1)); load(0); toast("Playing "+plural(tracks.length,"song")); return; }
  userQ.push(...tracks); renderQueue(); toast("Added "+plural(tracks.length,"song")+" to queue");
}
function queueNext(tracks){
  if(qi<0||!queue[qi]){ queueAdd(tracks); return; }
  userQ.unshift(...tracks); renderQueue(); toast("Playing next");
}

// ---------- dialogs ----------
function modal(build){
  return new Promise(res=>{
    const d=$("dlg2"); d.innerHTML=""; let settled=false;
    const done=v=>{ if(settled) return; settled=true; res(v); if(d.open) d.close(); };
    d.onclose=()=>{ if(!d.open) done(null); }; d.onclick=e=>{ if(e.target===d) done(null); };   // ignore the previous dialog's late "close" event
    build(d,done); d.showModal();
  });
}
function inputDialog(title,value,ok){
  return modal((d,done)=>{
    d.append(el("h2",null,title));
    const inp=el("input","txt"); inp.type="text"; inp.value=value; inp.maxLength=80; inp.setAttribute("aria-label",title);
    inp.onkeydown=e=>{ if(e.key==="Enter"){ e.preventDefault(); done(inp.value); } };
    const okb=pill("",ok,()=>done(inp.value)); okb.classList.add("primary");
    const row=el("div","btnrow"); row.append(pill("","Cancel",()=>done(null)),okb);
    d.append(inp,row); setTimeout(()=>{ inp.focus(); inp.select(); },0);
  });
}
async function confirmDialog(title,text,ok,safe){
  return (await modal((d,done)=>{
    d.append(el("h2",null,title),el("p","note",text));
    const okb=pill("",ok,()=>done(true)); okb.classList.add(safe?"primary":"danger");
    const row=el("div","btnrow"); row.append(pill("","Cancel",()=>done(false)),okb); d.append(row);
  }))===true;
}

// ---------- context menus ----------
let menuEl=null;
function closeMenu(){ if(menuEl){ menuEl.remove(); menuEl=null; } }
function showMenu(items,x,y){
  closeMenu(); menuEl=el("div"); menuEl.id="ctx"; menuEl.setAttribute("role","menu"); menuEl._pos=[x,y];
  document.body.append(menuEl); fillMenu(items.filter(Boolean));
}
function placeMenu(){
  const [x,y]=menuEl._pos;
  menuEl.style.left=x+"px"; menuEl.style.top=y+"px"; menuEl.style.maxHeight=(innerHeight-16)+"px";
  const r=menuEl.getBoundingClientRect(); let l=r.left, t=r.top;
  if(r.right>innerWidth-8) l=innerWidth-r.width-8;
  if(r.bottom>innerHeight-8) t=innerHeight-r.height-8;
  menuEl.style.left=Math.max(8,l)+"px"; menuEl.style.top=Math.max(8,t)+"px";
}
function fillMenu(items,back){
  menuEl.innerHTML="";
  if(back){ const b=el("button","mi dim","‹ Back"); b.setAttribute("role","menuitem"); b.onclick=back; menuEl.append(b,el("div","msep")); }
  items.forEach(it=>{
    if(it.sep){ menuEl.append(el("div","msep")); return; }
    const b=el("button","mi"+(it.danger?" danger":"")); b.setAttribute("role","menuitem"); b.append(el("span",null,it.label));
    if(it.sub) b.append(el("span","arrow","›"));
    b.onclick=()=>{ if(it.sub) fillMenu(it.sub().filter(Boolean),()=>fillMenu(items,back)); else { closeMenu(); it.fn(); } };
    menuEl.append(b);
  });
  placeMenu();
}
