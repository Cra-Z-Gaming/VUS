  measurementId: "G-VYTSYM4VN2"
};

const TABS=["All","Singles","Albums","Downloaded","Settings"], DATA_TABS=["Singles","Albums"];
const AUDIO=/\.(mp3|wav|ogg|flac|m4a|aac|opus|weba)$/i;
const enc=p=>p.split("/").map(encodeURIComponent).join("/");
const rawUrl=p=>`https://github.com/${OWNER}/${REPO}/raw/refs/heads/${BRANCH}/`+enc(p);   // streaming + raw links
const dlUrl=p=>`https://raw.githubusercontent.com/${OWNER}/${REPO}/${BRANCH}/`+enc(p);      // CORS-friendly, for downloads/tags
const clean=f=>f.replace(/\.[^.]+$/,"").replace(/_/g," ");
const $=id=>document.getElementById(id);
const audio=$("audio");
const ICON={
  dl:'<svg viewBox="0 0 24 24"><path d="M5 20h14v-2H5v2zM19 9h-4V3H9v6H5l7 7 7-7z"/></svg>',
  play:'<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>',
  info:'<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>',
  back:'<svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6V6z"/></svg>',
  rep:'<svg viewBox="0 0 24 24"><path d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"/></svg>',
  rep1:'<svg viewBox="0 0 24 24"><path d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4zm-4-2V9h-1l-2 1v1h1.5v4H13z"/></svg>'
};
$("rep").innerHTML=ICON.rep;

// data[tab] = { groups:[{name,tab,loose,tracks}], tracks:[] }
const data={All:{groups:[],tracks:[]},Singles:{groups:[],tracks:[]},Albums:{groups:[],tracks:[]},Downloaded:{groups:[],tracks:[]}};
let userQ=[], pendingSeek=0, lastSave=0, sleepEnd=false, activeTab="All", openGroup=null, activeList=null, queue=[], qi=-1, shuffle=false, repeat=0, busy=false;
const albumCount=()=>data.Albums.groups.filter(g=>!g.loose).length;

const fmt=s=>{ if(!isFinite(s)) return "0:00"; s=Math.floor(s); return Math.floor(s/60)+":"+String(s%60).padStart(2,"0"); };
const fmtSize=b=>!b?"":b>=1048576?(b/1048576).toFixed(1)+" MB":Math.max(1,Math.round(b/1024))+" KB";
const plural=(n,w)=>n+" "+w+(n===1?"":"s");
let toastTimer;
function toast(msg,sticky){ const t=$("toast"); t.textContent=msg; t.style.display="block"; clearTimeout(toastTimer); if(!sticky) toastTimer=setTimeout(()=>t.style.display="none",3000); }
function el(tag,cls,text){ const e=document.createElement(tag); if(cls) e.className=cls; if(text!=null) e.textContent=text; return e; }

// ---------- downloads ----------
function saveBlob(blob,name){ const a=document.createElement("a"); a.href=URL.createObjectURL(blob); a.download=name; document.body.append(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(a.href),10000); }
const safe=s=>s.replace(/[\\/:*?"<>|]+/g,"-").trim()||"mzk";
async function downloadOne(t){
  try{ toast("Downloading "+t.title+"…",true); const r=await fetch(t.dl); if(!r.ok) throw new Error(r.status); saveBlob(await r.blob(),t.file); toast("Saved "+t.file); }
  catch(e){ toast("Download failed. Opening the file instead."); window.open(t.url,"_blank"); }
}
async function downloadZip(items,zipName){
  if(busy){ toast("Another download is running"); return; }
  if(!window.JSZip){ toast("Zip library didn't load. Check your connection."); return; }
  busy=true;
  try{
    const zip=new JSZip(); let done=0, idx=0;
    toast(`Zipping 0/${items.length}…`,true);
    const worker=async()=>{ while(idx<items.length){ const it=items[idx++]; const r=await fetch(it.dl); if(!r.ok) throw new Error(it.zipPath+" ("+r.status+")"); zip.file(it.zipPath,await r.blob()); toast(`Zipping ${++done}/${items.length}…`,true); } };
    await Promise.all([worker(),worker(),worker(),worker()]);
    toast("Building zip…",true);
    saveBlob(await zip.generateAsync({type:"blob",compression:"STORE"}),safe(zipName)+".zip"); toast("Saved "+safe(zipName)+".zip");
  }catch(e){ toast("Zip failed: "+e.message); } finally{ busy=false; }
}
const zipGroup=g=>downloadZip(g.tracks.map(t=>({dl:t.dl,zipPath:t.file})),g.name||g.tab);
const zipTab=()=>downloadZip(data[activeTab].tracks.map(t=>({dl:t.dl,zipPath:(activeTab==="Singles"||activeTab==="Albums")?t.rel:t.path})),activeTab);

// ---------- metadata (ID3 / MP4 / FLAC tags, read lazily) ----------
let active=0; const waiting=[];
function pump(){ while(active<2&&waiting.length) waiting.shift()(); }
function parseTag(tag){
  const g=tag.tags||{}, pic=g.picture; let comment=g.comment; if(comment&&typeof comment==="object") comment=comment.text;
  return { title:g.title, artist:g.artist, album:g.album, year:g.year, genre:g.genre, track:g.track, comment,
    art:pic&&pic.data?URL.createObjectURL(new Blob([new Uint8Array(pic.data)],{type:pic.format||"image/jpeg"})):null };
}
function getMeta(t){
  if(t._m) return t._m;
  t._m=new Promise(resolve=>{
    waiting.push(()=>{
      active++; const done=m=>{ active--; resolve(m); setTimeout(pump,100); };
      if(!window.jsmediatags) return done(null);
      try{ jsmediatags.read(t.dl,{onSuccess:tag=>done(parseTag(tag)),onError:()=>done(null)}); }catch(e){ done(null); }
    });
    pump();
  }).then(m=>{ t.meta=m; document.querySelectorAll("li").forEach(li=>{ if(li._t===t) applyRow(li,t); }); return m; });
  return t._m;
}
function applyRow(li,t){
  const m=t.meta;
  if(m&&m.art&&!li.querySelector(".th")){ const im=el("img","th"); im.alt=""; im.loading="lazy"; im.src=m.art; li.insertBefore(im,li.querySelector(".n")); }
  const text=(m&&m.artist)||(li._sg?t.group:"");
  if(text){ let sm=li.querySelector("small"); if(!sm){ sm=el("small"); li.querySelector(".n").append(sm); } sm.textContent=text; }
}
async function ensureCover(g){
  if(!g.cover){ for(const t of g.tracks.slice(0,4)){ const m=await getMeta(t); if(m&&m.art){ g.cover=m.art; break; } } }
  return g.cover||null;
}
function placeholder(name){ let h=0; for(const c of name) h=(h*31+c.charCodeAt(0))%360; return `linear-gradient(135deg,hsl(${h} 45% 38%),hsl(${(h+50)%360} 50% 24%))`; }
function makeArt(g){
  const a=el("div","art",(g.name||"♪").trim().charAt(0).toUpperCase()); a.style.background=placeholder(g.name||"mzk");
  const paint=src=>{ if(a.querySelector("img")) return; const im=el("img"); im.alt=""; im.src=src; a.append(im); };
  if(g.cover) paint(g.cover); else { a._paint=paint; a._g=g; io.observe(a); }
  return a;
}
const io=new IntersectionObserver(es=>es.forEach(e=>{
  if(!e.isIntersecting) return; io.unobserve(e.target);
  if(e.target._t) getMeta(e.target._t);
  if(e.target._g) ensureCover(e.target._g).then(src=>{ if(src) e.target._paint(src); });
}),{rootMargin:"200px"});

// ---------- info dialog ----------
const dlg=$("info");
dlg.addEventListener("click",e=>{ if(e.target===dlg) dlg.close(); });
function fillDialog(title,cover,rows,loading){
  dlg.innerHTML="";
  if(cover){ const im=el("img","big"); im.alt=""; im.src=cover; dlg.append(im); }
  dlg.append(el("h2",null,title));
  const shown=rows.filter(r=>r[1]);
  if(loading||(!shown.some(r=>r[2])&&!cover)) dlg.append(el("p","note",loading?"Reading tags…":"No embedded tags or artwork found."));
  const dl=el("dl","meta");
  shown.forEach(r=>{ dl.append(el("dt",null,r[0]),el("dd",null,r[1])); });
  dlg.append(dl);
  const c=pill("","Close",()=>dlg.close()); dlg.append(c);
}
async function showTrackInfo(t){
  fillDialog(t.title,null,[],true); dlg.showModal();
  const m=await getMeta(t)||{};
  fillDialog(m.title||t.title,m.art,[["Title",m.title,1],["Artist",m.artist,1],["Album",m.album,1],["Year",m.year,1],["Genre",m.genre,1],["Track",m.track,1],["Comment",m.comment,1],["File",t.file],["Folder",t.group],["Size",fmtSize(t.size)]]);
}
const uniq=(g,k)=>[...new Set(g.tracks.map(t=>t.meta&&t.meta[k]).filter(Boolean))].join(", ");
async function showAlbumInfo(g){
  fillDialog(g.name,g.cover,[],true); dlg.showModal();
  await Promise.all(g.tracks.map(getMeta));
  const cover=await ensureCover(g);
  fillDialog(g.name,cover,[["Album",uniq(g,"album"),1],["Artist",uniq(g,"artist"),1],["Year",uniq(g,"year"),1],["Genre",uniq(g,"genre"),1],["Tracks",String(g.tracks.length)],["Total size",fmtSize(g.tracks.reduce((n,t)=>n+(t.size||0),0))]]);
}

// ---------- player ----------
function playList(list,i){ queue=list.slice(); load(i); }
function load(i,opts){
  const t=queue[i]; if(!t) return;
  qi=i;
  if(opts&&opts.paused) pendingSeek=opts.seek||0;
  setSource(t,!!(opts&&opts.paused));
  $("now").textContent=t.title; $("sub").textContent=t.group||"Single"; $("art").hidden=true;
  document.title=t.title+" · mzk"; markPlaying(); renderQueue();
  if("mediaSession" in navigator) navigator.mediaSession.metadata=new MediaMetadata({title:t.title,artist:t.group||"",album:t.group||"mzk"});
  getMeta(t).then(m=>{
    renderQueue();
    if(queue[qi]!==t||!m) return;
    if(m.art){ $("art").src=m.art; $("art").hidden=false; }
    if(m.artist) $("sub").textContent=m.artist+(m.album?" · "+m.album:"");
    if("mediaSession" in navigator) navigator.mediaSession.metadata=new MediaMetadata({title:m.title||t.title,artist:m.artist||t.group||"",album:m.album||t.group||"mzk",artwork:m.art?[{src:m.art}]:[]});
  });
}
function markPlaying(){
  document.querySelectorAll("li").forEach(li=>{
    const on=queue[qi]&&li.dataset.url===queue[qi].url;
    li.classList.toggle("playing",on); li.querySelector(".i").textContent=on?"▶":li.dataset.n;
  });
  refreshHearts();
}
function next(auto){
  if(!queue.length) return;
  if(auto&&repeat===2){ audio.currentTime=0; audio.play(); return; }
  if(userQ.length){ const q=userQ.shift(); queue.splice(qi+1,0,q); load(qi+1); return; }   // queued songs go before "next up"
  let n;
  if(shuffle&&queue.length>1){ do{ n=Math.floor(Math.random()*queue.length); }while(n===qi); } else n=qi+1;
  if(n>=queue.length){ if(repeat===1||!auto) n=0; else { audio.pause(); return; } }
  load(n);
}
function prev(){ if(!queue.length) return; if(audio.currentTime>3){ audio.currentTime=0; return; } load((qi-1+queue.length)%queue.length); }
function toggle(){ if(qi<0){ const l=(data[activeTab]||data.All).tracks; if(l.length) playList(l,0); return; } audio.paused?audio.play():audio.pause(); }

audio.addEventListener("ended",()=>{ if(sleepEnd){ sleepEnd=false; paintOpts(); toast("Sleep timer: stopped after this song"); return; } next(true); });
audio.addEventListener("play",updatePP); audio.addEventListener("pause",()=>{ updatePP(); saveResume(); });
audio.addEventListener("error",()=>{ if(qi>=0) $("sub").textContent="Couldn't play this file"; });
function updatePP(){ $("ppi").setAttribute("d",audio.paused?"M8 5v14l11-7z":"M6 5h4v14H6zm8 0h4v14h-4z"); $("pp").setAttribute("aria-label",audio.paused?"Play":"Pause"); }
let scrubbing=false;
audio.addEventListener("timeupdate",()=>{ if(Date.now()-lastSave>5000) saveResume(); $("cur").textContent=fmt(audio.currentTime); if(!scrubbing&&audio.duration){ $("seek").value=audio.currentTime/audio.duration*1000; setFill($("seek")); } });
audio.addEventListener("loadedmetadata",()=>{ $("dur").textContent=fmt(audio.duration); if(pendingSeek){ audio.currentTime=pendingSeek; pendingSeek=0; } });
$("seek").addEventListener("input",e=>{ scrubbing=true; setFill(e.target); if(audio.duration) $("cur").textContent=fmt(e.target.value/1000*audio.duration); });
$("seek").addEventListener("change",e=>{ if(audio.duration) audio.currentTime=e.target.value/1000*audio.duration; scrubbing=false; });
$("pp").onclick=toggle; $("next").onclick=()=>next(false); $("prev").onclick=prev;
function paintShuffle(){ $("shuf").classList.toggle("on",shuffle); $("shuf").title="Shuffle "+(shuffle?"on":"off")+" (S)"; }
$("shuf").onclick=()=>{ shuffle=!shuffle; paintShuffle(); savePrefs(); renderQueue(); };
