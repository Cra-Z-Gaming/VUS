const SORTS={default:"Default",name:"A–Z",nameDesc:"Z–A",count:"Most tracks",sizeDesc:"Largest",sizeAsc:"Smallest"};
const sortOpts=tab=>tab==="Albums"?["default","name","nameDesc","count","sizeDesc"]:["default","name","nameDesc","sizeDesc","sizeAsc"];
const SORT_ICON='<svg viewBox="0 0 24 24"><path d="M3 18h6v-2H3v2zM3 6v2h18V6H3zm0 7h12v-2H3v2z"/></svg>';
const gSize=g=>g.tracks.reduce((n,t)=>n+(t.size||0),0);
const nameCmp=(x,y)=>x.localeCompare(y,undefined,{numeric:true,sensitivity:"base"});
function sortGroups(arr,k){
  const a=arr.slice();
  if(k==="name") a.sort((x,y)=>nameCmp(x.name,y.name));
  else if(k==="nameDesc") a.sort((x,y)=>nameCmp(y.name,x.name));
  else if(k==="count") a.sort((x,y)=>y.tracks.length-x.tracks.length||nameCmp(x.name,y.name));
  else if(k==="sizeDesc") a.sort((x,y)=>gSize(y)-gSize(x));
  else if(k==="sizeAsc") a.sort((x,y)=>gSize(x)-gSize(y));
  return a;
}
function sortTracks(arr,k){
  const a=arr.slice();
  if(k==="name") a.sort((x,y)=>nameCmp(x.title,y.title));
  else if(k==="nameDesc") a.sort((x,y)=>nameCmp(y.title,x.title));
  else if(k==="sizeDesc") a.sort((x,y)=>(y.size||0)-(x.size||0));
  else if(k==="sizeAsc") a.sort((x,y)=>(x.size||0)-(y.size||0));
  return a;
}
function renderBrowse(c){
  const d=data[activeTab], isAlb=activeTab==="Albums";
  c.append(el("h2","title",activeTab));
  if(!d.tracks.length){ c.append(el("p","stat",activeTab==="Downloaded"?"Nothing downloaded yet. Open a playlist and press Download to browser.":"Nothing here yet.")); return; }
  c.append(el("p","stat",isAlb?`${plural(albumCount(),"album")} · ${plural(d.tracks.length,"track")} total`:plural(d.tracks.length,"track")));
  let k=(prefs.sort&&prefs.sort[activeTab])||"default"; if(!sortOpts(activeTab).includes(k)) k="default";
  const named=sortGroups(d.groups.filter(g=>g.name!==""),k), loose=d.groups.find(g=>g.name==="");
  const looseTracks=loose?sortTracks(loose.tracks,k):[];
  const order=[...named.flatMap(g=>g.tracks),...looseTracks];
  const acts=el("div","actions");
  const sp=pill(SORT_ICON,"Sort: "+SORTS[k],()=>{
    const r=sp.getBoundingClientRect();
    showMenu(sortOpts(activeTab).map(o=>({label:(o===k?"✓ ":"\u2003")+SORTS[o],fn:()=>{ prefs.sort=prefs.sort||{}; prefs.sort[activeTab]=o; savePrefs(); render(false); }})),r.left,r.bottom+4);
  });
  acts.append(bigPlay(()=>playList(order,0),"Play all"),pill(ICON.dl,"Save all as .zip",zipTab),sp);
  c.append(acts);
  if(named.length){ const gr=el("div","grid"); c.append(gr); chunked(named,g=>tile(g),gr); }
  if(looseTracks.length){ if(named.length) c.append(el("div","label","Tracks")); c.append(trackList(looseTracks,looseTracks,activeTab==="All"||activeTab==="Downloaded")); }
}

