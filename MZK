  const hb=iconBtn("","",()=>toggleLike(t)); hb.classList.add("heart"); hb._t=t; paintHeart(hb,t);
  const dm=el("span","dlmark"); dm.innerHTML=CHECK; dm.title="Downloaded to this browser"; dm.hidden=!isDl(t);
  li.append(dm,hb,plusBtn(()=>[t]),moreBtn(()=>trackMenu(t,ctx)));
  li._ctx=()=>trackMenu(t,ctx);
  const on=queue[qi]&&queue[qi].url===t.url;
  li.classList.toggle("playing",!!on); li.querySelector(".i").textContent=on?"▶":i+1;
  applyRow(li,t); io.observe(li);
  const run=()=>playList(queueList,queueList.indexOf(t));
  li.onclick=run; li.onkeydown=e=>{ if(e.key==="Enter"&&e.target===li){ e.preventDefault(); run(); } };
  return li;
}
