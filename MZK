async function ensureShared(p){
  const body={owner:fbUser.uid,name:p.name,tracks:p.tracks.slice(0,MAX_PER_PLAYLIST)};
  await db.collection("shared").doc(p.sid).set({...body,updated:firebase.firestore.FieldValue.serverTimestamp()});
