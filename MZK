function schedulePush(){ if(!fbUser||!db) return; clearTimeout(pushTimer); pushTimer=setTimeout(pushNow,800); }
function pushNow(){
  clearTimeout(pushTimer); pushTimer=null; if(!fbUser||!db) return;
  if(JSON.stringify({l:store.likes,p:store.playlists}).length>900000){ toast("Your library is too large to sync. Remove some playlists."); return; }
  db.collection("users").doc(fbUser.uid).set({likes:store.likes,playlists:store.playlists,updated:firebase.firestore.FieldValue.serverTimestamp()})
    .catch(e=>toast("Sync failed: "+(e.code||e.message)));
  pushSharedAll();
}
function refreshAfterSync(){ renderSidebar(); refreshHearts(); if(activeList) render(false); }
function mergeWithCloud(cloud){
  const likes=[...(cloud.likes||[])]; store.likes.forEach(k=>{ if(!likes.includes(k)) likes.push(k); });
  const pls=(cloud.playlists||[]).map(p=>({...p,tracks:[...(p.tracks||[])]}));
  store.playlists.forEach(lp=>{ const cp=pls.find(p=>p.id===lp.id); if(!cp) pls.push(lp); else lp.tracks.forEach(k=>{ if(!cp.tracks.includes(k)) cp.tracks.push(k); }); });
  store={likes,playlists:pls}; saveLocal(); refreshAfterSync(); pushNow();
}
function onUser(u){
  fbUser=u; renderAccount();
  if(unsubDoc){ unsubDoc(); unsubDoc=null; }
  if(!u){
    if(wasSignedIn){ // signing out clears this browser's copy
      wasSignedIn=false; store={likes:[],playlists:[]}; saveLocal(); try{ localStorage.removeItem("mzk:syncuid"); }catch(e){}
      refreshAfterSync(); if(activeList) go(activeTab); toast("Signed out");
    }
    setTimeout(refreshJoined,800);
    return;
  }
  wasSignedIn=true; let first=true;
  unsubDoc=db.collection("users").doc(u.uid).onSnapshot(snap=>{
    if(snap.metadata.hasPendingWrites||pushTimer) return;
    const cloud=snap.exists?snap.data():null;
    if(first){
      first=false;
      const synced=localStorage.getItem("mzk:syncuid")===u.uid;
      try{ localStorage.setItem("mzk:syncuid",u.uid); }catch(e){}
      setTimeout(refreshJoined,1200);
      if(!cloud){ pushNow(); toast("Signed in. Syncing your library"); }
      else if(synced){ store={likes:cloud.likes||[],playlists:cloud.playlists||[]}; saveLocal(); refreshAfterSync(); }
      else{ mergeWithCloud(cloud); toast("Signed in. Library merged"); }
    }else if(cloud){
      const next={likes:cloud.likes||[],playlists:cloud.playlists||[]};
      if(JSON.stringify(next)!==JSON.stringify({likes:store.likes,playlists:store.playlists})){ store=next; saveLocal(); refreshAfterSync(); }
