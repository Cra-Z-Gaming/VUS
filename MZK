const CODE_ALPHA="ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
const sharedCache=new Map(); let myCodes=[], refreshing=false;
function rndStr(n,alpha){ const a=new Uint32Array(n); crypto.getRandomValues(a); return [...a].map(x=>alpha[x%alpha.length]).join(""); }
