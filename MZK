// ---------- preferences + resume ----------
let prefs={sort:{},rate:1,vol:1,shuffle:false,repeat:0};
try{ Object.assign(prefs,JSON.parse(localStorage.getItem("mzk:prefs"))||{}); }catch(e){}
function savePrefs(){ prefs.shuffle=shuffle; prefs.repeat=repeat; try{ localStorage.setItem("mzk:prefs",JSON.stringify(prefs)); }catch(e){} }
let rate=prefs.rate||1;
function inkFor(hex){ const n=parseInt(hex.slice(1),16), r=n>>16, g=(n>>8)&255, b=n&255; return (0.299*r+0.587*g+0.114*b)/255>0.6?"#0c1a17":"#ffffff"; }
function applyAppearance(){
  const root=document.documentElement;
  if(prefs.theme==="dark"||prefs.theme==="light") root.dataset.theme=prefs.theme; else delete root.dataset.theme;
  if(/^#[0-9a-f]{6}$/i.test(prefs.accent||"")){ root.style.setProperty("--accent",prefs.accent); root.style.setProperty("--accent-ink",inkFor(prefs.accent)); }
  else{ root.style.removeProperty("--accent"); root.style.removeProperty("--accent-ink"); }
}
function applyPrefs(){
  applyAppearance();
  shuffle=!!prefs.shuffle; repeat=prefs.repeat|0; paintShuffle(); paintRepeat();
  audio.volume=Math.min(1,Math.max(0,+prefs.vol)); $("volume").value=audio.volume;
  audio.defaultPlaybackRate=rate; audio.playbackRate=rate;
  setFill($("volume")); setFill($("seek")); paintMute();
}
applyPrefs();
function saveResume(){
  lastSave=Date.now();
  if(qi<0||!queue[qi]) return;
  const start=Math.max(0,qi-20), part=queue.slice(start,start+500);
  try{ localStorage.setItem("mzk:resume",JSON.stringify({q:part.map(t=>t.path),i:qi-start,u:userQ.map(t=>t.path),t:pendingSeek||audio.currentTime||0})); }catch(e){}
}
function restoreResume(){
  try{
    const r=JSON.parse(localStorage.getItem("mzk:resume")); if(!r||!r.q) return;
    const cur=r.q[r.i], list=resolve(r.q), idx=list.findIndex(t=>t.path===cur);
    if(idx<0) return;
    queue=list; userQ=resolve(r.u||[]); load(idx,{paused:true,seek:r.t||0});
  }catch(e){}
}
document.addEventListener("visibilitychange",()=>{ if(document.hidden) saveResume(); });
window.addEventListener("pagehide",saveResume);

// ---------- playback speed + sleep timer ----------
let sleepTimer=null, sleepAt=0;
function paintOpts(){ $("opts").classList.toggle("on",rate!==1||sleepEnd||!!sleepAt); }
function setRate(r){ rate=r; prefs.rate=r; audio.defaultPlaybackRate=r; audio.playbackRate=r; savePrefs(); paintOpts(); toast(r+"× speed"); }
function setSleep(mode){
  clearTimeout(sleepTimer); sleepTimer=null; sleepEnd=false; sleepAt=0;
  if(mode==="end"){ sleepEnd=true; toast("Will stop after this song"); }
  else if(mode>0){ sleepAt=Date.now()+mode*60000; sleepTimer=setTimeout(sleepFire,mode*60000); toast("Sleep timer: "+mode+" min"); }
  else toast("Sleep timer off");
  paintOpts();
}
function sleepFire(){
  sleepTimer=null; sleepAt=0; const v=audio.volume; let k=0;
  const iv=setInterval(()=>{ k++; audio.volume=Math.max(0,v*(1-k/20)); if(k>=20){ clearInterval(iv); audio.pause(); audio.volume=v; paintOpts(); toast("Sleep timer: stopped"); } },200);
}
function playerOptions(){
  const sl=sleepEnd?"Sleep timer (end of song)":sleepAt?`Sleep timer (${Math.max(1,Math.ceil((sleepAt-Date.now())/60000))} min left)`:"Sleep timer";
  const mark=on=>on?"✓ ":"\u2003";
  return [
    {label:`Playback speed (${rate}×)`,sub:()=>[0.5,0.75,1,1.25,1.5,2].map(r=>({label:mark(r===rate)+r+"×"+(r===1?" (normal)":""),fn:()=>setRate(r)}))},
    {label:sl,sub:()=>[
      {label:mark(!sleepEnd&&!sleepAt)+"Off",fn:()=>setSleep(0)},
      ...[15,30,45,60].map(m=>({label:"\u2003"+m+" minutes",fn:()=>setSleep(m)})),
      {label:mark(sleepEnd)+"End of this song",fn:()=>setSleep("end")}
    ]}
  ];
}
$("opts").onclick=()=>{ const r=$("opts").getBoundingClientRect(); showMenu(playerOptions(),r.left,r.top-120); };
paintOpts();

