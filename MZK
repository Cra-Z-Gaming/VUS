const MAX_PLAYLISTS=50, MAX_PER_PLAYLIST=500, MAX_CODES=5, CODE_MINUTES=60;
function addToPlaylist(pid,tracks){
  const p=getPl(pid); if(!p) return;
  if(p.from){ toast("Shared playlists can't be edited"); return; }
  let n=0, full=false;
  tracks.forEach(t=>{ if(p.tracks.includes(t.path)) return; if(p.tracks.length>=MAX_PER_PLAYLIST){ full=true; return; } p.tracks.push(t.path); n++; });
  saveStore(); libChanged(pid);
  toast(full?`Playlists hold up to ${MAX_PER_PLAYLIST} songs. Added ${n}.`:n?`Added ${plural(n,"song")} to ${p.name}`:`Already in ${p.name}`);
}
function removeFromPlaylist(pid,t){ const p=getPl(pid); if(!p) return; p.tracks=p.tracks.filter(k=>k!==t.path); saveStore(); libChanged(pid); toast("Removed from "+p.name); }
async function newPlaylistFlow(tracks){
  if(store.playlists.length>=MAX_PLAYLISTS){ toast(`You can have up to ${MAX_PLAYLISTS} playlists. Delete one first.`); return; }
  const name=await inputDialog("New playlist","Playlist "+(store.playlists.length+1),"Create"); if(name===null) return;
