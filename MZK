async function joinWithCode(raw){
  const code=(raw||"").trim().toUpperCase();
  if(!/^[A-Z0-9]{4}$/.test(code)) throw new Error("Codes are 4 letters or numbers.");
  if(!db) throw new Error("Sharing isn't available right now.");
  let x,sh;
  try{
    const c=await db.collection("codes").doc(code).get();
    if(!c.exists) throw 0; x=c.data(); if(x.expires.toMillis()<Date.now()) throw 0;
    sh=await db.collection("shared").doc(x.sid).get(); if(!sh.exists) throw 0;
  }catch(e){ throw new Error(NOT_FOUND); }
  if(store.playlists.some(p=>p.sid===x.sid)) throw new Error("That's your own playlist.");
  const had=store.playlists.find(p=>p.from===x.sid); if(had) return had;
  if(store.playlists.length>=MAX_PLAYLISTS) throw new Error(`You can have up to ${MAX_PLAYLISTS} playlists. Delete one first.`);
  const d=sh.data(), p={id:newId(),name:d.name||"Shared playlist",tracks:(d.tracks||[]).slice(0,MAX_PER_PLAYLIST),from:x.sid};
  store.playlists.push(p); saveStore(); renderSidebar(); return p;
}
