let scrubbing=false;
audio.addEventListener("timeupdate",()=>{ $("cur").textContent=fmt(audio.currentTime); if(!scrubbing&&audio.duration) $("seek").value=audio.currentTime/audio.duration*1000; });
audio.addEventListener("loadedmetadata",()=>$("dur").textContent=fmt(audio.duration));
$("seek").addEventListener("input",e=>{ scrubbing=true; if(audio.duration) $("cur").textContent=fmt(e.target.value/1000*audio.duration); });
$("seek").addEventListener("change",e=>{ if(audio.duration) audio.currentTime=e.target.value/1000*audio.duration; scrubbing=false; });
$("pp").onclick=toggle; $("next").onclick=()=>next(false); $("prev").onclick=prev;
$("shuf").onclick=()=>{ shuffle=!shuffle; $("shuf").classList.toggle("on",shuffle); $("shuf").title="Shuffle "+(shuffle?"on":"off")+" (S)"; };
$("rep").onclick=()=>{ repeat=(repeat+1)%3; $("rep").classList.toggle("on",repeat>0); $("rep").innerHTML=repeat===2?ICON.rep1:ICON.rep; $("rep").title="Repeat "+["off","all","one"][repeat]+" (R)"; };
$("volume").addEventListener("input",e=>{ audio.volume=e.target.value; audio.muted=false; $("mute").classList.remove("on"); });
