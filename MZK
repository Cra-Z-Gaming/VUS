function build(files,tab){
  const prefix=tab+"/", by=new Map();
  files.filter(f=>f.path.startsWith(prefix)).sort((a,b)=>a.path.localeCompare(b.path,undefined,{numeric:true})).forEach(f=>{
    const rel=f.path.slice(prefix.length), parts=rel.split("/"), file=parts.pop(), group=parts.join(" / ");
    const t={url:rawUrl(f.path),dl:dlUrl(f.path),path:f.path,tab,size:f.size,file,rel,title:clean(file),group};
    if(!by.has(group)) by.set(group,[]); by.get(group).push(t);
  });
  const d=data[tab];
  [...by.keys()].sort((a,b)=>a===""?-1:b===""?1:a.localeCompare(b,undefined,{numeric:true})).forEach(n=>{
    const tracks=by.get(n), loose=n===""&&tab==="Albums";
    d.groups.push({name:loose?"Loose tracks":n,tab,loose,tracks}); d.tracks.push(...tracks);
  });
}
