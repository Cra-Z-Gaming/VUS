<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>mzk</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jsmediatags/3.9.5/jsmediatags.min.js"></script>
<style>
  :root {
    --bg:#0a0a0c; --surface:#151518; --raised:#202026; --line:#2b2b33;
    --text:#f3f1f6; --dim:#9d9aa8; --accent:#8fe3d0; --accent-ink:#0c2420;
    --shadow:0 12px 40px rgba(0,0,0,.5);
  }
  @media (prefers-color-scheme: light) {
    :root { --bg:#e8e6ee; --surface:#fff; --raised:#f0eef5; --line:#e0dce8; --text:#1d1a24; --dim:#74708a; --accent:#0e7c6b; --accent-ink:#fff; --shadow:0 12px 40px rgba(60,40,90,.18); }
  }
  * { box-sizing:border-box; }
  [hidden] { display:none !important; }
  html { color-scheme:dark light; }
  html,body { height:100%; margin:0; }
  body { background:var(--bg); color:var(--text); font:15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif; -webkit-font-smoothing:antialiased; }
  button { font:inherit; color:inherit; background:none; border:0; cursor:pointer; }
  :focus-visible { outline:2px solid var(--accent); outline-offset:2px; }
  svg { fill:currentColor; width:18px; height:18px; flex:none; }
  ::-webkit-scrollbar { width:10px; } ::-webkit-scrollbar-thumb { background:var(--line); border-radius:99px; border:2px solid var(--surface); }

  /* ---------- layout ---------- */
  .app { display:grid; grid-template-columns:230px minmax(0,1fr); grid-template-rows:minmax(0,1fr) auto; gap:8px; padding:8px; height:100vh; height:100dvh; }
  aside { background:var(--surface); border-radius:14px; padding:22px 12px 14px; display:flex; flex-direction:column; gap:4px; }
  .logo { font:700 1.7rem Georgia,"Times New Roman",serif; letter-spacing:-.03em; padding:0 12px 14px; }
  .nav { display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:10px; color:var(--dim); font-weight:600; text-align:left; width:100%; }
  .nav:hover { color:var(--text); }
  .nav[aria-current=true] { color:var(--text); background:var(--raised); }
  .nav small { margin-left:auto; font-weight:500; opacity:.8; }
  .spacer { flex:1; }
  a.pill { color:inherit; text-decoration:none; }
  main { background:var(--surface); border-radius:14px; overflow-y:auto; position:relative; }
  .topbar { position:sticky; top:0; z-index:5; background:var(--surface); padding:14px 24px 10px; display:flex; flex-wrap:wrap; align-items:center; gap:10px 14px; }
  #q { flex:1 1 260px; max-width:420px; padding:10px 18px; border-radius:99px; border:1px solid var(--line); background:var(--raised); color:var(--text); font:inherit; }
  #q::placeholder { color:var(--dim); }
  .scopes { display:flex; gap:6px; flex-wrap:wrap; }
  .chip { cursor:pointer; }
  .chip input { position:absolute; opacity:0; pointer-events:none; }
  .chip span { display:inline-block; padding:4px 12px; border-radius:99px; font-size:.8rem; color:var(--dim); border:1px solid var(--line); }
  .chip input:checked + span { background:var(--raised); color:var(--accent); border-color:var(--accent); }
  .chip input:focus-visible + span { outline:2px solid var(--accent); outline-offset:2px; }
  #content { padding:6px 24px 32px; }

  h2.title { font:700 2rem/1.15 Georgia,serif; margin:8px 0 2px; letter-spacing:-.02em; }
  .stat { color:var(--dim); margin:0; }
  .label { margin:28px 0 12px; font:700 1.15rem Georgia,serif; }
  .msg { color:var(--dim); padding:60px 0; text-align:center; }

  .pill { display:inline-flex; align-items:center; gap:8px; padding:8px 16px; border-radius:99px; background:var(--raised); border:1px solid var(--line); font-weight:500; font-size:.9rem; }
  .pill:hover { filter:brightness(1.15); }
  .bigplay { width:54px; height:54px; border-radius:50%; background:var(--accent); color:var(--accent-ink); display:grid; place-items:center; flex:none; }
  .bigplay:hover { transform:scale(1.05); filter:brightness(1.08); }
  .bigplay svg { width:26px; height:26px; }
  .actions { display:flex; align-items:center; gap:14px; margin:18px 0 6px; flex-wrap:wrap; }

  /* ---------- tiles ---------- */
  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(165px,1fr)); gap:14px; margin-top:16px; }
  .tile { padding:12px; border-radius:12px; cursor:pointer; background:transparent; transition:background .15s; text-align:left; }
  .tile:hover, .tile:focus-visible { background:var(--raised); }
  .art { position:relative; aspect-ratio:1; border-radius:8px; overflow:hidden; display:grid; place-items:center; font:700 2.6rem Georgia,serif; color:rgba(255,255,255,.75); }
  .art img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; }
  .tile .pl { position:absolute; right:8px; bottom:8px; width:42px; height:42px; border-radius:50%; background:var(--accent); color:var(--accent-ink); display:grid; place-items:center; opacity:0; transform:translateY(6px); transition:.15s; box-shadow:0 6px 16px rgba(0,0,0,.4); z-index:1; }
  .tile:hover .pl, .tile:focus-within .pl { opacity:1; transform:none; }
  @media (hover:none) { .tile .pl { opacity:1; transform:none; } }
  .tile h3 { margin:10px 0 0; font-size:.95rem; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .tile p { margin:0; color:var(--dim); font-size:.82rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

  /* ---------- album detail ---------- */
  .back { margin:8px 0 4px; color:var(--dim); padding:6px 10px 6px 4px; border-radius:99px; display:inline-flex; align-items:center; gap:4px; }
  .back:hover { color:var(--text); }
  .dhead { display:flex; align-items:flex-end; gap:24px; margin-top:8px; }
  .dhead .art { width:200px; flex:none; font-size:4rem; box-shadow:var(--shadow); }
  .dhead .kind { font-size:.75rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--dim); }
  .dhead h1 { font:700 clamp(1.8rem,5vw,3.4rem)/1.05 Georgia,serif; margin:4px 0 8px; letter-spacing:-.03em; overflow-wrap:anywhere; }
  @media (max-width:560px) { .dhead { flex-direction:column; align-items:center; text-align:center; } .dhead .art { width:180px; } }

  /* ---------- track rows ---------- */
  ul { list-style:none; margin:10px 0 0; padding:0; }
  li { display:flex; align-items:center; gap:12px; padding:7px 8px 7px 12px; border-radius:10px; cursor:pointer; }
  li:hover { background:var(--raised); }
  li.playing { color:var(--accent); }
  li .i { width:1.6em; color:var(--dim); font-size:.85rem; text-align:center; font-variant-numeric:tabular-nums; flex:none; }
  li.playing .i { color:var(--accent); }
  li .n { flex:1; min-width:0; overflow-wrap:anywhere; }
  li .n small { display:block; color:var(--dim); font-size:.78rem; line-height:1.3; }
  .th { width:40px; height:40px; border-radius:6px; object-fit:cover; flex:none; }
  .ib { width:34px; height:34px; border-radius:50%; display:grid; place-items:center; color:var(--dim); flex:none; }
  .ib:hover { color:var(--text); background:var(--line); }
  .ib.on { color:var(--accent); }

  /* ---------- player ---------- */
  #player { grid-column:1 / -1; background:var(--surface); border-radius:14px; padding:10px 18px; display:grid; grid-template-columns:minmax(0,1fr) minmax(300px,2fr) minmax(0,1fr); align-items:center; gap:16px; }
  .np { display:flex; align-items:center; gap:12px; min-width:0; }
  #art { width:56px; height:56px; border-radius:8px; object-fit:cover; flex:none; }
  .npt { min-width:0; }
  #now { font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  #sub { color:var(--dim); font-size:.8rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .center { display:flex; flex-direction:column; align-items:center; gap:2px; min-width:0; }
  .ctrls { display:flex; align-items:center; gap:6px; }
  #pp { width:44px; height:44px; background:var(--accent); color:var(--accent-ink); }
  #pp:hover { background:var(--accent); color:var(--accent-ink); filter:brightness(1.1); }
  #pp svg { width:22px; height:22px; }
  .seek { width:100%; display:flex; align-items:center; gap:10px; font-size:.75rem; color:var(--dim); font-variant-numeric:tabular-nums; }
  .seek input { flex:1; }
  .seek span { width:3em; } .seek span:first-child { text-align:right; }
  .vol { display:flex; align-items:center; justify-content:flex-end; gap:4px; }
  #volume { width:100px; }
  input[type=range] { accent-color:var(--accent); height:20px; cursor:pointer; }

  #toast { position:fixed; left:50%; bottom:118px; transform:translateX(-50%); background:var(--text); color:var(--bg); padding:8px 18px; border-radius:99px; font-size:.85rem; box-shadow:var(--shadow); display:none; max-width:calc(100% - 24px); text-align:center; z-index:20; }

  dialog.modal { background:var(--surface); color:var(--text); border:1px solid var(--line); border-radius:20px; padding:22px; width:min(420px,calc(100% - 32px)); box-shadow:var(--shadow); text-align:center; }
  dialog.modal::backdrop { background:rgba(0,0,0,.55); }
  dialog.modal h2 { font:700 1.2rem Georgia,serif; margin:0 0 14px; overflow-wrap:anywhere; }
  dialog.modal .big { width:220px; height:220px; max-width:100%; object-fit:cover; border-radius:14px; margin:0 auto 14px; display:block; }
  .meta { display:grid; grid-template-columns:auto 1fr; gap:6px 16px; text-align:left; font-size:.88rem; margin:0 0 16px; }
  .meta dt { color:var(--dim); } .meta dd { margin:0; overflow-wrap:anywhere; }
  dialog.modal .note { color:var(--dim); font-size:.85rem; margin:0 0 14px; }

  /* ---------- library, menus, dialogs ---------- */
  .libhead { display:flex; align-items:center; justify-content:space-between; padding:14px 12px 4px; color:var(--dim); font-size:.72rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
  .libhead .ib { width:28px; height:28px; }
  #pls { flex:1; min-height:0; overflow-y:auto; display:flex; flex-direction:column; gap:2px; }
  .nav .name { min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .hint { color:var(--dim); font-size:.85rem; padding:6px 12px; }
  .heart.on { color:var(--accent); }
  .tmore { position:absolute; top:8px; right:8px; width:32px; height:32px; background:rgba(0,0,0,.6); color:#fff; opacity:0; transition:.15s; z-index:1; }
  .tmore:hover { background:rgba(0,0,0,.8); color:#fff; }
  .tile:hover .tmore, .tile:focus-within .tmore { opacity:1; }
  @media (hover:none) { .tmore { opacity:1; } }
  .pill.primary { background:var(--accent); color:var(--accent-ink); border-color:transparent; }
  .pill.danger { background:#d84a4a; color:#fff; border-color:transparent; }
  #ctx { position:fixed; z-index:50; min-width:220px; max-width:290px; max-height:75vh; overflow-y:auto; background:var(--raised); border:1px solid var(--line); border-radius:12px; padding:6px; box-shadow:var(--shadow); }
  .mi { display:flex; align-items:center; gap:10px; width:100%; padding:8px 12px; border-radius:8px; text-align:left; font-size:.9rem; }
  .mi:hover, .mi:focus-visible { background:var(--line); outline:none; }
  .mi.danger { color:#ff7a7a; } .mi.dim { color:var(--dim); }
  .mi .arrow { margin-left:auto; opacity:.6; }
  .msep { height:1px; background:var(--line); margin:5px 4px; }
  dialog.modal input.txt { width:100%; padding:10px 14px; border-radius:10px; border:1px solid var(--line); background:var(--raised); color:var(--text); font:inherit; margin-bottom:16px; }
  .btnrow { display:flex; gap:10px; justify-content:center; }

  /* ---------- mobile ---------- */
  @media (max-width:820px) {
    .app { grid-template-columns:minmax(0,1fr); grid-template-rows:auto minmax(0,1fr) auto; }
    aside { flex-direction:row; align-items:center; padding:8px 10px; gap:4px; overflow-x:auto; }
    .logo { padding:0 10px 0 6px; font-size:1.3rem; }
    .nav { width:auto; padding:7px 12px; white-space:nowrap; }
    .spacer, .hint, #lib1 { display:none; }
    #pls { display:contents; }
    .libhead { padding:0 4px; }
    .libhead span { display:none; }
    aside a.pill { white-space:nowrap; margin-left:auto; padding:6px 12px; }
    .topbar, #content { padding-left:14px; padding-right:14px; }
    #player { grid-template-columns:minmax(0,1fr); gap:6px; padding:10px 14px; }
    .vol { display:none; }
    #art { width:44px; height:44px; }
    #toast { bottom:150px; }
  }
</style>
</head>
<body>
<div class="app">
  <aside>
    <div class="logo">mzk</div>
    <button class="nav" id="n-Singles" aria-current="true"><svg viewBox="0 0 24 24"><path d="M12 3v10.55A4 4 0 1014 17V7h4V3h-6z"/></svg>Singles<small></small></button>
    <button class="nav" id="n-Albums"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 14a4 4 0 110-8 4 4 0 010 8zm0-6a2 2 0 100 4 2 2 0 000-4z"/></svg>Albums<small></small></button>
    <div class="libhead" id="lib1"><span>Library</span></div>
    <button class="nav" id="n-Liked"><svg viewBox="0 0 24 24"><path d="M12 21l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.18L12 21z"/></svg>Liked songs<small></small></button>
    <div class="libhead"><span>Playlists</span><button class="ib" id="newpl" title="New playlist" aria-label="New playlist"><svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg></button></div>
    <div id="pls"></div>
    <a class="pill" href="https://docs.google.com/forms/d/e/1FAIpQLSeSM-moe9C4ZHi--AOR6JSRAn7YfZJ2JR-3mxHFkbuGmnIVEw/viewform" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M9 21h6v-1H9v1zm3-19a7 7 0 00-4 12.7V17h8v-2.3A7 7 0 0012 2z"/></svg>Suggest a song</a>
  </aside>

  <main id="main">
    <div class="topbar">
      <input id="q" type="search" placeholder="Search" aria-label="Search" autocomplete="off">
      <div class="scopes">
        <label class="chip"><input type="checkbox" id="sc-at"><span>Album titles</span></label>
        <label class="chip"><input type="checkbox" id="sc-atr"><span>Album tracks</span></label>
        <label class="chip"><input type="checkbox" id="sc-st"><span>Single tracks</span></label>
      </div>
    </div>
    <div id="content"><div class="msg">Loading…</div></div>
  </main>

  <div id="player">
    <div class="np">
      <img id="art" alt="" hidden>
      <div class="npt"><div id="now">Nothing playing</div><div id="sub">Pick a track to start</div></div>
      <button class="ib heart" id="plike" hidden></button>
    </div>
    <div class="center">
      <div class="ctrls">
        <button class="ib" id="shuf" title="Shuffle (S)" aria-label="Shuffle"><svg viewBox="0 0 24 24"><path d="M17 3l4 4-4 4V8h-2.6l-3.1 4.4L8.9 16H4v-2h3.9l2.4-3.4L7.9 7H4V5h4.9l2.4 3.4L13.7 5H17V3zm0 10l4 4-4 4v-3h-3.3l-2-2.8 1.2-1.7 1.6 2.5H17v-3z"/></svg></button>
        <button class="ib" id="prev" title="Previous (P)" aria-label="Previous"><svg viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg></button>
        <button class="ib" id="pp" title="Play/pause (Space)" aria-label="Play"><svg viewBox="0 0 24 24"><path id="ppi" d="M8 5v14l11-7z"/></svg></button>
        <button class="ib" id="next" title="Next (N)" aria-label="Next"><svg viewBox="0 0 24 24"><path d="M16 6h2v12h-2zM6 18l8.5-6L6 6z"/></svg></button>
        <button class="ib" id="rep" title="Repeat off (R)" aria-label="Repeat"></button>
      </div>
      <div class="seek">
        <span id="cur">0:00</span>
        <input id="seek" type="range" min="0" max="1000" value="0" aria-label="Seek">
        <span id="dur">0:00</span>
      </div>
    </div>
    <div class="vol">
      <button class="ib" id="mute" title="Mute (M)" aria-label="Mute"><svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0014 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg></button>
      <input id="volume" type="range" min="0" max="1" step="0.01" value="1" aria-label="Volume">
    </div>
  </div>
</div>

<div id="toast" role="status"></div>
<dialog id="info" class="modal"></dialog>
<dialog id="dlg2" class="modal"></dialog>
<audio id="audio" preload="metadata"></audio>

<script>
const OWNER="Cra-Z-Gaming", REPO="mzk", BRANCH="main";
const TABS=["Singles","Albums"];
const AUDIO=/\.(mp3|wav|ogg|flac|m4a|aac|opus|weba)$/i;
const enc=p=>p.split("/").map(encodeURIComponent).join("/");
const rawUrl=p=>`https://github.com/${OWNER}/${REPO}/raw/refs/heads/${BRANCH}/`+enc(p);   // streaming + raw links
const dlUrl=p=>`https://raw.githubusercontent.com/${OWNER}/${REPO}/${BRANCH}/`+enc(p);      // CORS-friendly, for downloads/tags
const clean=f=>f.replace(/\.[^.]+$/,"").replace(/_/g," ");
const $=id=>document.getElementById(id);
const audio=$("audio");
const ICON={
  dl:'<svg viewBox="0 0 24 24"><path d="M5 20h14v-2H5v2zM19 9h-4V3H9v6H5l7 7 7-7z"/></svg>',
  play:'<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>',
  info:'<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>',
  back:'<svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6V6z"/></svg>',
  rep:'<svg viewBox="0 0 24 24"><path d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"/></svg>',
  rep1:'<svg viewBox="0 0 24 24"><path d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4zm-4-2V9h-1l-2 1v1h1.5v4H13z"/></svg>'
};
$("rep").innerHTML=ICON.rep;

// data[tab] = { groups:[{name,tab,loose,tracks}], tracks:[] }
const data={Singles:{groups:[],tracks:[]},Albums:{groups:[],tracks:[]}};
let activeTab="Singles", openGroup=null, activeList=null, queue=[], qi=-1, shuffle=false, repeat=0, busy=false;
const albumCount=()=>data.Albums.groups.filter(g=>!g.loose).length;

const fmt=s=>{ if(!isFinite(s)) return "0:00"; s=Math.floor(s); return Math.floor(s/60)+":"+String(s%60).padStart(2,"0"); };
const fmtSize=b=>!b?"":b>=1048576?(b/1048576).toFixed(1)+" MB":Math.max(1,Math.round(b/1024))+" KB";
const plural=(n,w)=>n+" "+w+(n===1?"":"s");
let toastTimer;
function toast(msg,sticky){ const t=$("toast"); t.textContent=msg; t.style.display="block"; clearTimeout(toastTimer); if(!sticky) toastTimer=setTimeout(()=>t.style.display="none",3000); }
function el(tag,cls,text){ const e=document.createElement(tag); if(cls) e.className=cls; if(text!=null) e.textContent=text; return e; }

// ---------- downloads ----------
function saveBlob(blob,name){ const a=document.createElement("a"); a.href=URL.createObjectURL(blob); a.download=name; document.body.append(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(a.href),10000); }
const safe=s=>s.replace(/[\\/:*?"<>|]+/g,"-").trim()||"mzk";
async function downloadOne(t){
  try{ toast("Downloading "+t.title+"…",true); const r=await fetch(t.dl); if(!r.ok) throw new Error(r.status); saveBlob(await r.blob(),t.file); toast("Saved "+t.file); }
  catch(e){ toast("Download failed. Opening the file instead."); window.open(t.url,"_blank"); }
}
async function downloadZip(items,zipName){
  if(busy){ toast("Another download is running"); return; }
  if(!window.JSZip){ toast("Zip library didn't load. Check your connection."); return; }
  busy=true;
  try{
    const zip=new JSZip(); let done=0, idx=0;
    toast(`Zipping 0/${items.length}…`,true);
    const worker=async()=>{ while(idx<items.length){ const it=items[idx++]; const r=await fetch(it.dl); if(!r.ok) throw new Error(it.zipPath+" ("+r.status+")"); zip.file(it.zipPath,await r.blob()); toast(`Zipping ${++done}/${items.length}…`,true); } };
    await Promise.all([worker(),worker(),worker(),worker()]);
    toast("Building zip…",true);
    saveBlob(await zip.generateAsync({type:"blob",compression:"STORE"}),safe(zipName)+".zip"); toast("Saved "+safe(zipName)+".zip");
  }catch(e){ toast("Zip failed: "+e.message); } finally{ busy=false; }
}
const zipGroup=g=>downloadZip(g.tracks.map(t=>({dl:t.dl,zipPath:t.file})),g.name||g.tab);
const zipTab=()=>downloadZip(data[activeTab].tracks.map(t=>({dl:t.dl,zipPath:t.rel})),activeTab);

// ---------- metadata (ID3 / MP4 / FLAC tags, read lazily) ----------
let active=0; const waiting=[];
function pump(){ while(active<3&&waiting.length) waiting.shift()(); }
function parseTag(tag){
  const g=tag.tags||{}, pic=g.picture; let comment=g.comment; if(comment&&typeof comment==="object") comment=comment.text;
  return { title:g.title, artist:g.artist, album:g.album, year:g.year, genre:g.genre, track:g.track, comment,
    art:pic&&pic.data?URL.createObjectURL(new Blob([new Uint8Array(pic.data)],{type:pic.format||"image/jpeg"})):null };
}
function getMeta(t){
  if(t._m) return t._m;
  t._m=new Promise(resolve=>{
    waiting.push(()=>{
      active++; const done=m=>{ active--; resolve(m); pump(); };
      if(!window.jsmediatags) return done(null);
      try{ jsmediatags.read(t.dl,{onSuccess:tag=>done(parseTag(tag)),onError:()=>done(null)}); }catch(e){ done(null); }
    });
    pump();
  }).then(m=>{ t.meta=m; document.querySelectorAll("li").forEach(li=>{ if(li._t===t) applyRow(li,t); }); return m; });
  return t._m;
}
function applyRow(li,t){
  const m=t.meta;
  if(m&&m.art&&!li.querySelector(".th")){ const im=el("img","th"); im.alt=""; im.loading="lazy"; im.src=m.art; li.insertBefore(im,li.querySelector(".n")); }
  const text=(m&&m.artist)||(li._sg?t.group:"");
  if(text){ let sm=li.querySelector("small"); if(!sm){ sm=el("small"); li.querySelector(".n").append(sm); } sm.textContent=text; }
}
async function ensureCover(g){
  if(!g.cover){ for(const t of g.tracks.slice(0,4)){ const m=await getMeta(t); if(m&&m.art){ g.cover=m.art; break; } } }
  return g.cover||null;
}
function placeholder(name){ let h=0; for(const c of name) h=(h*31+c.charCodeAt(0))%360; return `linear-gradient(135deg,hsl(${h} 45% 38%),hsl(${(h+50)%360} 50% 24%))`; }
function makeArt(g){
  const a=el("div","art",(g.name||"♪").trim().charAt(0).toUpperCase()); a.style.background=placeholder(g.name||"mzk");
  const paint=src=>{ if(a.querySelector("img")) return; const im=el("img"); im.alt=""; im.src=src; a.append(im); };
  if(g.cover) paint(g.cover); else { a._paint=paint; a._g=g; io.observe(a); }
  return a;
}
const io=new IntersectionObserver(es=>es.forEach(e=>{
  if(!e.isIntersecting) return; io.unobserve(e.target);
  if(e.target._t) getMeta(e.target._t);
  if(e.target._g) ensureCover(e.target._g).then(src=>{ if(src) e.target._paint(src); });
}),{rootMargin:"200px"});

