  .sw { width:28px; height:28px; border-radius:50%; border:2px solid transparent; box-shadow:inset 0 0 0 1px rgba(0,0,0,.2); }
  .sw[aria-pressed=true] { border-color:var(--text); }
  input.colorin { width:34px; height:34px; padding:0; border:0; background:none; cursor:pointer; }

  /* ---------- mobile ---------- */
  @media (max-width:820px) {
    .app { grid-template-columns:minmax(0,1fr); grid-template-rows:auto minmax(0,1fr) auto; }
    aside { flex-direction:row; align-items:center; padding:8px 10px; gap:4px; overflow-x:auto; }
