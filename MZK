    if(!p.sid||p.from) return;
    const body={name:p.name,tracks:p.tracks.slice(0,MAX_PER_PLAYLIST)}, j=JSON.stringify(body);
    if(sharedCache.get(p.sid)===j) return;
    db.collection("shared").doc(p.sid).set({owner:fbUser.uid,...body,updated:firebase.firestore.FieldValue.serverTimestamp()})
      .then(()=>sharedCache.set(p.sid,j)).catch(e=>toast("Couldn't update the shared copy: "+(e.code||e.message)));
  });
}
async function loadMyCodes(){
  if(!fbUser||!db){ myCodes=[]; return; }
  try{
    const snap=await db.collection("codes").where("owner","==",fbUser.uid).get(), now=Date.now(); myCodes=[];
    snap.forEach(d=>{ const x=d.data(), exp=x.expires.toMillis(); if(exp>now) myCodes.push({code:d.id,sid:x.sid,exp}); else d.ref.delete().catch(()=>{}); });
  }catch(e){ myCodes=[]; }
}
async function makeCode(p,after){
  if(!fbUser||!db) return;
  if(myCodes.filter(c=>c.exp>Date.now()).length>=MAX_CODES){ toast(`All ${MAX_CODES} codes are in use. Disable one first.`); return; }
  if(!p.tracks.length){ toast("Add some songs first"); return; }
  try{
    if(!p.sid){ p.sid=rndStr(20,"abcdefghijklmnopqrstuvwxyz0123456789"); saveStore(); }
    await ensureShared(p);
    const exp=Date.now()+CODE_MINUTES*60000; let code=null;
    for(let i=0;i<10&&!code;i++){
      const c=rndStr(4,CODE_ALPHA);
      try{ await db.collection("codes").doc(c).set({sid:p.sid,owner:fbUser.uid,expires:firebase.firestore.Timestamp.fromMillis(exp),created:firebase.firestore.FieldValue.serverTimestamp()}); code=c; }
      catch(e){ if(e.code!=="permission-denied") throw e; }
    }
    if(!code){ toast("Couldn't create a code. Try again, or check your Firestore rules."); return; }
    myCodes.push({code,sid:p.sid,exp}); after(); toast("New code: "+code);
  }catch(e){ toast("Couldn't create a code: "+(e.code||e.message)); }
}
