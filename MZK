// ---------- downloaded to this browser (download-only; songs are only removed from Settings) ----------
const OFFLINE="mzk-offline-v1", OFF_ICON='<svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 15l-5-5h3V7h4v5h3l-5 5z"/></svg>';
let offlineSet=new Set(), offState={active:false,id:null,done:0,total:0}, srcToken=0, curBlob=null, offChangedTimer=null;
const nd=t=>t._nd||(t._nd=new Request(t.dl).url);
const isDl=t=>offlineSet.has(nd(t));
function listTracks(id){ return resolve(id==="liked"?store.likes:(getPl(id)||{tracks:[]}).tracks); }
function offLabel(id){
  if(offState.active&&offState.id===id) return `Downloading ${offState.done}/${offState.total}…`;
  const tr=listTracks(id); if(!tr.length) return "Download to browser";
