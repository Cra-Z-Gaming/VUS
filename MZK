// plays from the downloaded copy when there is one, otherwise streams from GitHub
function setSource(t,paused){
  const tok=++srcToken;
  const start=url=>{ if(tok!==srcToken) return; audio.src=url; if(!paused) audio.play().catch(()=>{}); };
  const free=()=>{ if(curBlob){ URL.revokeObjectURL(curBlob); curBlob=null; } };
  if(window.caches&&isDl(t)){
    caches.open(OFFLINE).then(c=>c.match(t.dl)).then(r=>r?r.blob():null).then(b=>{
      if(tok!==srcToken) return; free();
      if(b){ curBlob=URL.createObjectURL(b); start(curBlob); } else start(t.url);
    }).catch(()=>start(t.url));
  }else{ free(); start(t.url); }
}
