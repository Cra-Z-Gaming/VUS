  return modal((d,done)=>{
    d.append(el("h2",null,title));
    const inp=el("input","txt"); inp.type="text"; inp.value=value; inp.maxLength=80; inp.setAttribute("aria-label",title);
    inp.onkeydown=e=>{ if(e.key==="Enter"){ e.preventDefault(); done(inp.value); } };
    const okb=pill("",ok,()=>done(inp.value)); okb.classList.add("primary");
    const row=el("div","btnrow"); row.append(pill("","Cancel",()=>done(null)),okb);
    d.append(inp,row); setTimeout(()=>{ inp.focus(); inp.select(); },0);
  });
}
async function confirmDialog(title,text,ok){
  return (await modal((d,done)=>{
    d.append(el("h2",null,title),el("p","note",text));
    const okb=pill("",ok,()=>done(true)); okb.classList.add("danger");
    const row=el("div","btnrow"); row.append(pill("","Cancel",()=>done(false)),okb); d.append(row);
  }))===true;
}

// ---------- context menus ----------
let menuEl=null;
function closeMenu(){ if(menuEl){ menuEl.remove(); menuEl=null; } }
function showMenu(items,x,y){
  closeMenu(); menuEl=el("div"); menuEl.id="ctx"; menuEl.setAttribute("role","menu"); menuEl._pos=[x,y];
  document.body.append(menuEl); fillMenu(items.filter(Boolean));
}
function placeMenu(){
  const [x,y]=menuEl._pos; menuEl.style.left=x+"px"; menuEl.style.top=y+"px";
  const r=menuEl.getBoundingClientRect();
  if(r.right>innerWidth-8) menuEl.style.left=Math.max(8,innerWidth-r.width-8)+"px";
  if(r.bottom>innerHeight-8) menuEl.style.top=Math.max(8,innerHeight-r.height-8)+"px";
}
function fillMenu(items,back){
  menuEl.innerHTML="";
  if(back){ const b=el("button","mi dim","‹ Back"); b.setAttribute("role","menuitem"); b.onclick=back; menuEl.append(b,el("div","msep")); }
  items.forEach(it=>{
    if(it.sep){ menuEl.append(el("div","msep")); return; }
    const b=el("button","mi"+(it.danger?" danger":"")); b.setAttribute("role","menuitem"); b.append(el("span",null,it.label));
    if(it.sub) b.append(el("span","arrow","›"));
    b.onclick=()=>{ if(it.sub) fillMenu(it.sub().filter(Boolean),()=>fillMenu(items,back)); else { closeMenu(); it.fn(); } };
    menuEl.append(b);
  });
  placeMenu();
}
function moreBtn(getItems){
  const b=el("button","ib more"); b.innerHTML=MORE; b.title="More options"; b.setAttribute("aria-label","More options");
  b.onclick=e=>{ e.stopPropagation(); const r=b.getBoundingClientRect(); showMenu(getItems(),r.left,r.bottom+4); };
  return b;
}
document.addEventListener("mousedown",e=>{ if(menuEl&&!menuEl.contains(e.target)) closeMenu(); },true);
document.addEventListener("keydown",e=>{
  if(!menuEl) return;
  if(e.key==="Escape"){ closeMenu(); return; }
  if(e.key==="ArrowDown"||e.key==="ArrowUp"){
    e.preventDefault(); const it=[...menuEl.querySelectorAll(".mi")]; if(!it.length) return;
    let i=it.indexOf(document.activeElement); i=e.key==="ArrowDown"?(i+1)%it.length:(i-1+it.length)%it.length; it[i].focus();
  }
},true);
window.addEventListener("resize",closeMenu); window.addEventListener("blur",closeMenu);
$("main").addEventListener("scroll",closeMenu); $("pls").addEventListener("scroll",closeMenu);

function groupOf(t){ return t.group?data[t.tab].groups.find(g=>g.name===t.group):null; }
function playlistPicker(tracks){
  return [{label:"＋ New playlist…",fn:()=>newPlaylistFlow(tracks)}, store.playlists.length?{sep:1}:null,
    ...store.playlists.map(p=>({label:p.name,fn:()=>addToPlaylist(p.id,tracks)}))];
}
function trackMenu(t,ctx){
  ctx=ctx||{}; const g=groupOf(t), liked=isLiked(t);
  return [
    {label:"Play",fn:()=>ctx.queue&&ctx.queue.includes(t)?playList(ctx.queue,ctx.queue.indexOf(t)):playList([t],0)},
    {label:"Play next",fn:()=>queueNext([t])},
    {label:"Add to queue",fn:()=>queueAdd([t])},
    {sep:1},
    {label:liked?"Remove from Liked songs":"Add to Liked songs",fn:()=>toggleLike(t)},
    {label:"Add to playlist",sub:()=>playlistPicker([t])},
    ctx.playlistId?{label:"Remove from this playlist",fn:()=>removeFromPlaylist(ctx.playlistId,t)}:null,
    {sep:1},
    g&&!(openGroup===g&&!activeList)?{label:"Go to "+(t.tab==="Albums"?"album":"folder"),fn:()=>go(t.tab,g)}:null,
    {label:"Track info",fn:()=>showTrackInfo(t)},
    {label:"Download",fn:()=>downloadOne(t)}
  ];
}
function albumMenu(g){
  const all=g.tracks.every(isLiked);
  return [
    {label:"Play",fn:()=>playList(g.tracks,0)},
    {label:"Play next",fn:()=>queueNext(g.tracks)},
    {label:"Add to queue",fn:()=>queueAdd(g.tracks)},
    {sep:1},
    {label:all?"Remove all from Liked songs":"Add all to Liked songs",fn:()=>all?unlikeTracks(g.tracks):likeTracks(g.tracks)},
    {label:"Add to playlist",sub:()=>playlistPicker(g.tracks)},
    {sep:1},
    openGroup!==g?{label:"Open",fn:()=>go(g.tab,g)}:null,
    {label:"Info",fn:()=>showAlbumInfo(g)},
    {label:"Download (.zip)",fn:()=>zipGroup(g)}
  ];
}
function playlistMenu(p){
  return [
    {label:"Play",fn:()=>{ const tr=resolve(p.tracks); tr.length?playList(tr,0):toast("This playlist is empty"); }},
    {sep:1},
    {label:"Rename",fn:()=>renamePlaylist(p)},
    {label:"Delete",danger:1,fn:()=>deletePlaylist(p)}
  ];
}
function viewTracks(){
  if(activeList==="liked") return resolve(store.likes.slice().reverse());
  if(activeList){ const p=getPl(activeList); return p?resolve(p.tracks):[]; }
  return openGroup?openGroup.tracks:data[activeTab].tracks;
}
function shuffleAll(tracks){ if(!tracks.length) return; shuffle=true; $("shuf").classList.add("on"); playList(tracks,Math.floor(Math.random()*tracks.length)); }
function genericMenu(){
  const tr=viewTracks();
  return [
    tr.length?{label:"Play all",fn:()=>playList(tr,0)}:null,
    tr.length?{label:"Shuffle all",fn:()=>shuffleAll(tr)}:null,
    tr.length?{sep:1}:null,
    {label:"New playlist…",fn:()=>newPlaylistFlow()},
    {sep:1},
    {label:"Reload library",fn:()=>location.reload()}
  ];
}
document.addEventListener("contextmenu",e=>{
  if(e.target.closest("input,textarea,dialog,#ctx")){ if(e.target.closest("#ctx")) e.preventDefault(); return; }
  e.preventDefault(); closeMenu();
  let n=e.target, items=null;
  while(n&&n!==document){ if(n._ctx){ items=n._ctx(); break; } n=n.parentNode; }
  if(!items){
    if(e.target.closest("#pls,.libhead")) items=[{label:"New playlist…",fn:()=>newPlaylistFlow()}];
    else if(e.target.closest("#n-Liked")){ items=[{label:"Play",fn:()=>{ const tr=resolve(store.likes.slice().reverse()); tr.length?playList(tr,0):toast("No liked songs yet"); }}]; }
    else if(e.target.closest("#player")&&queue[qi]) items=trackMenu(queue[qi],{});
    else items=genericMenu();
  }
  showMenu(items,e.clientX,e.clientY);
});
renderSidebar();

function build(files,tab){
  const prefix=tab+"/", by=new Map();
  files.filter(f=>f.path.startsWith(prefix)).sort((a,b)=>a.path.localeCompare(b.path,undefined,{numeric:true})).forEach(f=>{
    const rel=f.path.slice(prefix.length), parts=rel.split("/"), file=parts.pop(), group=parts.join(" / ");
    const t={url:rawUrl(f.path),dl:dlUrl(f.path),path:f.path,tab,size:f.size,file,rel,title:clean(file),group};
    if(!by.has(group)) by.set(group,[]); by.get(group).push(t);
  });
  const d=data[tab];
  [...by.keys()].sort((a,b)=>a===""?-1:b===""?1:a.localeCompare(b,undefined,{numeric:true})).forEach(n=>{
    const tracks=by.get(n), loose=n===""&&tab==="Albums";
    d.groups.push({name:loose?"Loose tracks":n,tab,loose,tracks}); d.tracks.push(...tracks);
  });
}
function counts(){
  $("n-Singles").querySelector("small").textContent=data.Singles.tracks.length||"";
  $("n-Albums").querySelector("small").textContent=albumCount()||"";
}

(async()=>{
  try{
    const res=await fetch(`https://api.github.com/repos/${OWNER}/${REPO}/git/trees/${BRANCH}?recursive=1`);
    if(!res.ok) throw new Error(res.status===403?"GitHub rate limit reached. Try again in a few minutes.":"GitHub returned "+res.status);
    const json=await res.json();
    const files=json.tree.filter(n=>n.type==="blob"&&AUDIO.test(n.path));
    TABS.forEach(t=>build(files,t)); [...data.Singles.tracks,...data.Albums.tracks].forEach(t=>byPath.set(t.path,t)); libReady=true; counts(); renderSidebar(); setDefaults(); render(true);
  }catch(err){ $("content").innerHTML='<div class="msg">Couldn\'t load the library. '+err.message+'</div>'; }
})();
</script>
