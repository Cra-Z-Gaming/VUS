  .pill { display:inline-flex; align-items:center; gap:8px; padding:8px 16px; border-radius:99px; background:var(--raised); border:1px solid var(--line); font-weight:500; font-size:.9rem; }
  .pill:hover { filter:brightness(1.15); }
  .bigplay { width:54px; height:54px; border-radius:50%; background:var(--accent); color:var(--accent-ink); display:grid; place-items:center; flex:none; }
