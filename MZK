// ---------- throttled rendering + loading bar ----------
const BATCH=10, GAP=45;   // items per step, ms between steps
let loadToken=0, loadTotal=0, loadDone=0, throttled=false, chain=Promise.resolve(), barOff=false, barHide;
const bar=$("loadbar");
bar.onclick=()=>{ barOff=true; bar.hidden=true; };   // click anywhere on the bar to dismiss it
function barShow(label,pct){
  if(barOff) return; clearTimeout(barHide); bar.hidden=false;
  bar.classList.toggle("ind",pct==null);
  if(pct!=null) bar.querySelector(".fill").style.width=pct+"%";
  bar.querySelector(".txt").textContent=label;
  bar.setAttribute("aria-valuenow",pct==null?"":Math.round(pct));
}
function barDone(){ if(barOff||bar.hidden) return; bar.classList.remove("ind"); bar.querySelector(".fill").style.width="100%"; bar.querySelector(".txt").textContent="Loaded"; barHide=setTimeout(()=>{ bar.hidden=true; },500); }
function beginLoad(first){ loadToken++; loadTotal=0; loadDone=0; throttled=!!first; chain=Promise.resolve(); }
function loadProgress(){
  if(loadDone>=loadTotal) barDone();
  else if(loadTotal>=30){ const pct=loadDone/loadTotal*100; barShow(`Loading ${Math.round(pct)}% · click to hide`,pct); }
}
// Builds items a few at a time so weaker devices stay responsive; stale renders cancel themselves.
function chunked(items,build,host){
  if(!throttled){ const frag=document.createDocumentFragment(); items.forEach((it,i)=>frag.append(build(it,i))); host.append(frag); return; }  // only the first load is paced
  const my=loadToken; loadTotal+=items.length;
  chain=chain.then(()=>new Promise(res=>{
    let i=0;
    (function step(){
      if(my!==loadToken) return res();
      const end=Math.min(i+BATCH,items.length), frag=document.createDocumentFragment();
      for(;i<end;i++){ frag.append(build(items[i],i)); loadDone++; }
      host.append(frag); loadProgress();
      if(i<items.length) setTimeout(step,GAP); else res();
    })();
  }));
}
function buildRow(t,i,ctx,queueList,showGroup){
  const li=el("li"); li.tabIndex=0; li.dataset.url=t.url; li.dataset.n=i+1; li._t=t; li._sg=showGroup;
