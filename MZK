const XICON='<svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>';
const QMAX=30;
function toggleQueue(){ const qp=$("queuePanel"); qp.hidden=!qp.hidden; $("qbtn").classList.toggle("on",!qp.hidden); renderQueue(); }
$("qbtn").onclick=toggleQueue;
function qRow(t,now,onPlay,onRemove){
  const d=el("div","qrow"+(now?" now":"")), box=el("div","qt");
  box.append(el("span",null,t.title),el("small",null,(t.meta&&t.meta.artist)||t.group||"Single"));
  d.append(box);
  if(!now){
    d.tabIndex=0; d.onclick=onPlay;
    d.onkeydown=e=>{ if(e.key==="Enter"&&e.target===d) onPlay(); };
    d.append(iconBtn(XICON,"Remove from queue",onRemove));
  }
  return d;
}
function playFromUserQ(i){ const t=userQ.splice(i,1)[0]; if(!t) return; queue.splice(qi+1,0,t); load(qi+1); }
function renderQueue(){
  const qp=$("queuePanel"); if(qp.hidden) return;
  qp.innerHTML="";
  const head=el("div","qhead"); head.append(el("h3",null,"Queue"));
  if(userQ.length) head.append(pill("","Clear queue",()=>{ userQ=[]; renderQueue(); toast("Queue cleared"); }));
  head.append(iconBtn(XICON,"Close queue",toggleQueue));
  qp.append(head);
  if(qi<0||!queue[qi]){ qp.append(el("div","qnote","Nothing playing yet. Play a song, or right-click one and choose Add to queue.")); return; }
  qp.append(el("div","qlabel","Now playing"),qRow(queue[qi],true));
  let budget=QMAX;
  if(userQ.length){
    qp.append(el("div","qlabel","Next in queue"));
    const shown=userQ.slice(0,budget);
    shown.forEach((t,i)=>qp.append(qRow(t,false,()=>playFromUserQ(i),()=>{ userQ.splice(i,1); renderQueue(); })));
    budget-=shown.length;
    if(userQ.length>shown.length) qp.append(el("div","qnote","+ "+(userQ.length-shown.length)+" more in queue"));
  }
  const upcoming=queue.slice(qi+1);
  qp.append(el("div","qlabel","Next up"));
  if(!upcoming.length) qp.append(el("div","qnote",userQ.length?"Nothing after your queue.":"Nothing queued next."));
  if(budget>0) upcoming.slice(0,budget).forEach((t,i)=>qp.append(qRow(t,false,()=>load(qi+1+i),()=>{ queue.splice(qi+1+i,1); renderQueue(); })));
  if(upcoming.length>Math.max(0,budget)) qp.append(el("div","qnote","+ "+(upcoming.length-Math.max(0,budget))+" more"));
  if(shuffle) qp.append(el("div","qnote","Shuffle is on, so songs may not play in this order."));
}
