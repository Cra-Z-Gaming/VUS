// Only ever adds songs. Re-checks what's stored first and skips anything already downloaded.
async function downloadPlaylist(id){
  if(!window.caches){ toast("Downloading to the browser isn't supported in this window"); return; }
  if(offState.active){ toast("A download is already running"); return; }
  const tr=listTracks(id);
  if(!tr.length){ toast("Add some songs first"); return; }
  await refreshOfflineSet();
  const fresh=tr.filter(t=>!isDl(t));
  if(!fresh.length){ toast("Everything here is already downloaded"); paintOff(); offChanged(); return; }
  const need=fresh.reduce((n,t)=>n+(t.size||0),0);
  if(need>300*1048576&&!await confirmDialog("Download about "+fmtSize(need)+"?","That's a lot of space on this device. You can clear downloads in Settings.","Download",true)) return;
  try{ if(navigator.storage&&navigator.storage.persist) navigator.storage.persist(); }catch(e){}
  let cache; try{ cache=await caches.open(OFFLINE); }catch(e){ toast("Downloads aren't available in this window"); return; }
  offState={active:true,id,done:0,total:fresh.length}; paintOff();
  const already=tr.length-fresh.length;
  toast(`Downloading ${plural(fresh.length,"new song")}`+(already?` (${already} already downloaded)`:""));
  let i=0, failed=0, full=false;
  const worker=async()=>{
    while(i<fresh.length){
      const t=fresh[i++];
      try{ const r=await fetch(t.dl); if(!r.ok) throw new Error("http"); await cache.put(t.dl,r); offlineSet.add(nd(t)); }
      catch(e){ failed++; if(e&&e.name==="QuotaExceededError") full=true; }
      offState.done++; paintOff(); offChanged();
    }
  };
  await Promise.all([worker(),worker()]);
  offState.active=false; paintOff(); offChanged();
  if(full) toast("Out of space on this device. Some songs weren't downloaded.");
  else if(failed) toast(`${plural(failed,"song")} couldn't be downloaded. Press the button again to retry.`);
  else toast(`${plural(fresh.length,"song")} downloaded to this browser`);
}
