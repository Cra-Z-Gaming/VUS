function renderSearch(q,c){
  const hit=t=>t.title.toLowerCase().includes(q)||t.file.toLowerCase().includes(q);
  const albums=scope.at.checked?data.Albums.groups.filter(g=>g.name.toLowerCase().includes(q)&&(!scope.dl.checked||g.tracks.every(isDl))):[];
  let tracks=[];
  if(scope.atr.checked) tracks.push(...data.Albums.tracks.filter(t=>hit(t)&&(!scope.dl.checked||isDl(t))));
  if(scope.st.checked) tracks.push(...data.Singles.tracks.filter(t=>hit(t)&&(!scope.dl.checked||isDl(t))));
  if(!albums.length&&!tracks.length){
    const any=scope.at.checked||scope.atr.checked||scope.st.checked;
