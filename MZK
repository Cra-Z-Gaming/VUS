async function unshare(sid){
  try{
    if(db&&fbUser){
      const q=await db.collection("codes").where("owner","==",fbUser.uid).where("sid","==",sid).get();
      const bt=db.batch(); q.forEach(d=>bt.delete(d.ref)); bt.delete(db.collection("shared").doc(sid)); await bt.commit();
      sharedCache.delete(sid); myCodes=myCodes.filter(c=>c.sid!==sid);
    }
  }catch(e){ toast("Couldn't remove the shared copy: "+(e.code||e.message)); }
}
async function deletePlaylist(p){
  if(p.from){
    if(!await confirmDialog(`Remove "${p.name}"?`,"It leaves your library. You can join it again with a new code from the owner.","Remove")) return;
  }else{
    if(!await confirmDialog(`Delete "${p.name}"?`,p.sid?"This also deletes it for everyone you shared it with.":"This removes the playlist. The songs themselves aren't touched.","Delete")) return;
    if(!await confirmDialog("Are you sure?","This can't be undone.","Yes, delete it")) return;
    if(p.sid) await unshare(p.sid);
  }
  store.playlists=store.playlists.filter(x=>x!==p); saveStore(); renderSidebar();
  if(activeList===p.id) go(activeTab); toast((p.from?"Removed ":"Deleted ")+p.name);
}
