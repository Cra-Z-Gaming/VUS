<!DOCTYPE html>
<!-- VUSL V17 — game launcher. Pulls games from the Cra-Z-Gaming GitHub repo and caches them for offline reopen.
     Other versions/projects: sites.google.com/view/projexe  |  backup: pastebin.com/raw/RM4T5VqY -->
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://raw.githubusercontent.com" crossorigin>
<title>VUSL V17</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@700;800;900&display=swap" rel="stylesheet">
<style>
/* ══ ROOT ══ */
:root {
  --bg:       #0a0a0d;
  --surface:  #101014;
  --panel:    #141418;
  --border:   #202026;
  --accent:   #00ff88;
  --acc-dim:  rgba(0,255,136,.12);
  --text:     #dcdcee;
  --muted:    #42425a;
  --red:      #ff3355;
  --gold:     #ffcc00;
  --blue:     #4488ff;
  --r:        8px;
  --mono:     'Space Mono', monospace;
  --display:  'Syne', sans-serif;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; overflow: hidden; }
body {
  font-family: var(--mono);
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
}

body::after {
  content: '';
  position: fixed;
  inset: 0;
  background: repeating-linear-gradient(
    0deg, transparent, transparent 3px,
    rgba(0,0,0,.04) 3px, rgba(0,0,0,.04) 4px
  );
  pointer-events: none;
  z-index: 9000;
}

/* ══ TOP BAR ══ */
#topbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 16px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  flex-wrap: wrap;
}

.wordmark {
  font-family: var(--display);
  font-size: 22px;
  font-weight: 900;
  letter-spacing: -2px;
  color: var(--accent);
  text-shadow: 0 0 24px rgba(0,255,136,.5);
  white-space: nowrap;
  margin-right: 2px;
}
.wordmark sup {
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 700;
  color: var(--muted);
  letter-spacing: 1px;
  vertical-align: super;
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 7px 12px;
  border: none;
  border-radius: var(--r);
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
  transition: filter .15s, transform .1s;
}
.btn:hover  { filter: brightness(1.2); }
.btn:active { transform: scale(.96); }
.btn-primary   { background: var(--accent); color: #000; }
.btn-secondary { background: var(--panel); color: var(--text); border: 1px solid var(--border); }
.btn-ghost     { background: transparent; color: var(--muted); border: 1px solid var(--border); }
.btn-ghost:hover { color: var(--text); }
.btn-red       { background: transparent; color: var(--red); border: 1px solid rgba(255,51,85,.2); }
.btn-red:hover { background: rgba(255,51,85,.08); border-color: var(--red); }
.btn:disabled  { opacity: .4; cursor: not-allowed; filter: none; }

#statusLine {
  font-size: 10px;
  color: var(--muted);
  white-space: nowrap;
  margin-left: auto;
}

/* ══ PROGRESS BAR ══ */
#progressWrap {
  height: 3px;
  background: var(--border);
  flex-shrink: 0;
  display: none;
  position: relative;
}
#progressFill {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, var(--accent), #00ffcc);
  transition: width .1s linear;
  box-shadow: 0 0 12px var(--accent);
}

/* ══ PACK TABS ══ */
#packTabs {
  display: flex;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  padding: 0 12px;
  flex-shrink: 0;
  overflow-x: auto;
  scrollbar-width: none;
}
#packTabs::-webkit-scrollbar { display: none; }

.pack-tab {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 10px 16px;
  font-family: var(--display);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--muted);
  border-bottom: 2px solid transparent;
  cursor: pointer;
  white-space: nowrap;
  user-select: none;
  transition: color .15s, border-color .15s;
}
.pack-tab:hover { color: var(--text); }
.pack-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
.pack-tab.pinned-right { margin-left: auto; }
.pack-tab.tab-allgames { color: var(--blue); }
.pack-tab.tab-allgames.active { color: var(--accent); }
.pack-tab.tab-allgames .tab-badge { background: rgba(68,136,255,.14); color: var(--blue); }
.pack-tab.tab-allgames.active .tab-badge { background: var(--acc-dim); color: var(--accent); }

.tab-badge {
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 400;
  background: var(--border);
  color: var(--muted);
  padding: 1px 6px;
  border-radius: 20px;
  transition: background .15s, color .15s;
}
.pack-tab.active .tab-badge {
  background: var(--acc-dim);
  color: var(--accent);
}

/* ══ CONTROLS ══ */
#controls {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
#searchWrap {
  position: relative;
  flex: 1;
  min-width: 120px;
}
#searchWrap .search-icon {
  position: absolute;
  left: 10px;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  color: var(--muted);
  font-size: 12px;
}
#search {
  width: 100%;
  padding: 7px 10px 7px 30px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--r);
  color: var(--text);
  font-family: var(--mono);
  font-size: 11px;
  outline: none;
  transition: border-color .2s;
}
#search:focus { border-color: var(--accent); }
#search::placeholder { color: var(--muted); }

/* ══ GAME AREA ══ */
#gameArea {
  flex: 1;
  overflow-y: auto;
  padding: 14px 16px 24px;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}
#gameArea::-webkit-scrollbar { width: 4px; }
#gameArea::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

.section { margin-bottom: 20px; }
.section-head {
  font-family: var(--display);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--muted);
  padding-bottom: 6px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 9px;
}
.section-head.popular-head {
  color: var(--gold);
  border-bottom-color: rgba(255,204,0,.25);
}

.game-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

/* ══ GAME CARD ══ */
.game-card {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 7px 11px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--r);
  color: var(--text);
  font-family: var(--mono);
  font-size: 11px;
  cursor: pointer;
  user-select: none;
  transition: border-color .15s, color .15s, transform .1s, background .15s;
  max-width: 280px;
}
.game-card:hover:not(.loading) {
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-1px);
  background: rgba(0,255,136,.04);
}
.game-card:active:not(.loading) { transform: scale(.97); }

.game-card.cached  { border-color: rgba(0,255,136,.2); }
.game-card.failed  { border-color: rgba(255,51,85,.25); }
.game-card.failed:hover { border-color: var(--red); color: var(--red); background: rgba(255,51,85,.04); }
.game-card.loading { opacity: .6; cursor: wait; }

.card-status {
  font-size: 10px;
  flex-shrink: 0;
  width: 14px;
  text-align: center;
}
.card-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  min-width: 0;
}
.card-star {
  font-size: 11px;
  flex-shrink: 0;
  color: var(--muted);
  cursor: pointer;
  padding: 0 1px;
  transition: color .15s, transform .15s;
}
.card-star:hover { color: var(--gold); transform: scale(1.25); }
.card-star.on    { color: var(--gold); }

.card-source-tag {
  font-size: 10px;
  flex-shrink: 0;
  opacity: .6;
}

.card-remove {
  font-size: 11px;
  flex-shrink: 0;
  color: var(--muted);
  cursor: pointer;
  padding: 0 1px;
  transition: color .15s, transform .15s;
}
.card-remove:hover { color: var(--red); transform: scale(1.25); }

/* ══ EMPTY STATE ══ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 300px;
  gap: 12px;
  text-align: center;
  padding: 40px;
  color: var(--muted);
}
.empty-state .big  { font-size: 44px; }
.empty-state h2    { font-family: var(--display); font-size: 17px; color: var(--text); font-weight: 800; }
.empty-state p     { font-size: 11px; line-height: 2; max-width: 320px; }

.ext-config {
  display: flex;
  flex-direction: column;
  gap: 10px;
  width: 100%;
  max-width: 420px;
  margin-top: 8px;
}
.ext-upload-row {
  display: flex;
  gap: 8px;
}
.ext-upload-row .btn { flex: 1; justify-content: center; }
.ext-note { font-size: 9px; color: var(--muted); text-align: left; }

/* ══ TOAST ══ */
#toast {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%) translateY(16px);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 7px 18px;
  font-size: 11px;
  color: var(--text);
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  z-index: 9999;
  transition: opacity .22s, transform .22s;
}
#toast.show     { opacity: 1; transform: translateX(-50%) translateY(0); }
#toast.success  { border-color: var(--accent); color: var(--accent); }
#toast.error    { border-color: var(--red);    color: var(--red);    }
#toast.info     { border-color: var(--gold);   color: var(--gold);   }

/* ══ NOTIFICATION BANNER ══ */
#notifBanner {
  display: none;
  position: fixed;
  top: 0; left: 0; right: 0;
  background: rgba(0,255,136,.13);
  border-bottom: 1px solid var(--accent);
  color: var(--accent);
  font-family: var(--display);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1px;
  text-align: center;
  padding: 11px;
  z-index: 8000;
  animation: slideDown .3s ease;
  cursor: pointer;
}
@keyframes slideDown {
  from { transform: translateY(-100%); }
  to   { transform: translateY(0); }
}
@keyframes spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* ══ CONFIRM MODAL (duplicate-upload prompt) ══ */
#confirmModal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.6);
  z-index: 9500;
  align-items: center;
  justify-content: center;
}
#confirmModal .box {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 20px;
  max-width: 340px;
  width: 90%;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
#confirmModal h3 {
  font-family: var(--display);
  font-size: 14px;
  color: var(--text);
}
#confirmModal p {
  font-size: 11px;
  color: var(--muted);
  line-height: 1.7;
}
#confirmModal .row {
  display: flex;
  gap: 8px;
}
#confirmModal .row .btn { flex: 1; justify-content: center; }
</style>
</head>
<body>

<div id="topbar">
  <div class="wordmark">VUSL<sup>V17</sup></div>
  <button class="btn btn-primary"   id="loadAllBtn" onclick="startLoadAll()">⬇ Load All</button>
  <button class="btn btn-ghost"     id="retryBtn"   onclick="retryFailed()" style="display:none">↺ Retry Failed</button>
  <button class="btn btn-secondary" id="refreshBtn" onclick="manualRefresh()">⟳ Refresh</button>
  <button class="btn btn-red"                       onclick="clearCache()">🗑 Clear Cache</button>
  <span id="statusLine">—</span>
</div>

<div id="progressWrap">
  <div id="progressFill"></div>
</div>

<div id="packTabs"></div>

<div id="controls">
  <div id="searchWrap">
    <span class="search-icon">⌕</span>
    <input id="search" type="text" placeholder="Search games in this pack…">
  </div>
  <span id="countLabel" style="font-size:10px;color:var(--muted);white-space:nowrap;flex-shrink:0">0 games</span>
</div>

<div id="gameArea"></div>
<div id="toast"></div>
<div id="notifBanner" onclick="this.style.display='none'"></div>

<div id="confirmModal">
  <div class="box">
    <h3 id="confirmTitle">Duplicate files found</h3>
    <p id="confirmBody"></p>
    <div class="row">
      <button class="btn btn-secondary" id="confirmSkip">Skip duplicates</button>
      <button class="btn btn-red" id="confirmOverwrite">Overwrite</button>
    </div>
  </div>
</div>

<!-- hidden file inputs for external uploads -->
<input type="file" id="fileInputFiles" accept=".html,.htm" multiple style="display:none">
<input type="file" id="fileInputFolder" webkitdirectory directory multiple style="display:none">

<script>
"use strict";
/* ════════════════════════════════════════════════════
   VUSL V17 — Cra-Z-only launcher, click-first loading
   • Single source: Cra-Z-Gaming.
   • Clicked games jump the queue (latest click first) and
     use a dedicated "manual" lane with high fetch priority.
   • Bulk (Load All) uses a low-priority lane and backs off
     to 2 connections while a clicked game is downloading.
   • Window opens synchronously on click (no popup blocking),
     filled when the download lands.
   • Batched IndexedDB writes, fetch timeout + 1 retry,
     auto-retry on reconnect, event-delegated cards.
════════════════════════════════════════════════════ */

const CRA_BASE = "https://raw.githubusercontent.com/Cra-Z-Gaming/VUSL/main/HTML_Games/";
const GAMES = "Blackjack.html 1on1tennis.html 1v1.lol.html 3Dflightsimulator.html 8ballclassic.html 10minutestilldawn.html 12minibattles.html 2048.html 2048cupcakes.html agariolite.html ageofwar.html ageofwar2.html agesofconflict.html Alpha_1.2.6.html amongus.html angrybirds.html angrybirdsshowdown.html angrybirdsspace.html awesometanks.html awesometanks2.html backrooms.html baconmaydie.html badicecream.html badicecream2.html badicecream3.html badparenting.html badpiggies.html baldisbasics.html baseballbros.html basketballlegends.html basketballstars.html basketbros.html basketrandom.html Beta_1.3.html bitlife.html bitplanes.htm blockysnakes.html bloonsTD.html bloonsTD2.html bloonsTD3.html bloonsTD4.html bloonsTD5.html bloxorz.html blumgiracers.html blumgirocket.html bobtherobber.html bobtherobber2.html bobtherobber5.html bouncymotors.html bowmasters.html boxingrandom.htm breakingthebank.html bubbleshooter.html candycrush.html capybaraclicker.html cardrawing.html carkingarena.html chess.html choppyorc.html circloO.html circloO2.html clashofvikings.html cleanupio.html clusterrush.html cookieclicker.htm crazycars.html crazycattle3D.html crazycrashlanding.html crazymotorcycle.html crossyroad.htm cuttherope.html dadish.html dadish2.html dadish3.html deathchase.html deathrun3D.html demolitionderbycrashracing.html doodlejump.html drawclimber.html dreadheadparkour.htm driftboss.htm drivemad.htm ducklife.html ducklife2.html ducklife3.html ducklife4.html ducklife5.html ducklingsio.html eagleride.html earntodie.html earntodie2.html eggycar.html elasticface.htm escaperoad.html escaperoad2.html escapingtheprison.html evilglitch.html fancypantsadventure.html fancypantsadventure2.html fireboyandwatergirl.html fireboyandwatergirl2.html fireboyandwatergirl3.html fireboyandwatergirl4.html flappybird.html floodrunner2.html floodrunner3.html floodrunner4.html fnaf.html fnaf2.html fnaf3.html fnaf4.html footballbros.html footballlegends.html freerider3.html fruitninja.html funnybattle.html funnybattle2.html funnymadracing.html funnyshooter2.html geometrydash.html geometrydashlite.html geometryvibes.html getawayshootout.htm getontop.html gladihoppers.html googlebaseball.html googledino.html granny.html granny2.html guesstheiranswer.html hanger2.html happywheels.html helixjump.html highwaytraffic.html hillclimbracinglite.html holeio.html houseofhazards.html hoverracerdrive.html idlebreakout.html Indev.html ironsnout.html jetpackjoyride.html johnnytrigger.html jumpingshell.html karatebros.html kartbros.html learntofly.html learntofly2.html learntofly3.html learntoflyidle.html leveldevil.html madalinstuntcars2.html melonplayground.html mergeroundracers.html minesweeper.html monkeymart.htm monstertracks.html motox3m.htm motox3m2.html motox3m3.html motox3mpoolparty.html motox3mspookyland.html motox3mwinter.html noobminer.html oppositeday.html ovo.html ovo2.html ovo3dimensions.html pacman.html papasbakeria.html papasburgeria.html papascheeseria.html papascupcakeria.html papasdonuteria.html papasfreezeria.html papashotdoggeria.html papaspancakeria.html papaspastaria.html papaspizzeria.html papasscooperia.html papassushiria.html papastacomia.html papaswingeria.html paperio2.htm parkingfury.html parkingfury2.html parkingfury3.html picosschool.html pingpongchaos.html pixelspeedrun.html plantsvszombies.html plonky.html polytrack.html poorbunny.html pou.html ragdollarchers.htm ragdollhit.html ragdollsoccer.html redball4vol1.html redball4vol2.html redball4vol3.html retrobowl.html retrobowlcollege.html retrohighway.html retropingpong.html riddleschool.html riddleschool2.html riddleschool3.html riddleschool4.html riddleschool5.html riddletransfer.html riddletransfer2.html rocketsoccerderby.html rooftopsnipers.htm rooftopsnipers2.html run.html run2.html run3.html sandgame.html shortlife.html slope.html slope2player.html slope3.html slowroads.html sm63.html sm64.html snowballio.html snowrider.htm snowroad.htm soccerbros.html soccerrandom.htm spacebarclicker.html spaceiskey.html spaceiskey2.html spacewaves.html speedstars.html sprunki.html stack.html stacktris.html stateio.html stickarchersbattle.html stickfighter.html stickmanhook.html stickmerge.html subwaysurfersbeijing.html subwaysurfershavana.html subwaysurferssanfrancisco.html superbikethechampion.html superhot.html superliquidsoccer.html superstarcar.html tabletennisworldtour.html tag.html taproad.html templeofboom.html templerun2.htm territorialio.html theimpossiblequiz.html theimpossiblequiz2.html thereisnog.html theyarecoming.html thisistheonlylevel.html thisistheonlyleveltoo.html timeshooter2.html timeshooter3.htm tinyfishing.html tombofthemask.htm trapthecat.html triviacrack.html tubejumpers.html tunnelrush.html unicyclehero.html vex4.html vex5.html vex6.htm vex7.htm vex8.htm vexx3m.html vexx3m2.html volleyrandom.html wartheknights.html webecomewhatwebehold.html wheeliebike.html wheely.html wheely2.html wheely3.html wheely4.html wheely5.html wheely6.html wheely7.html wheely8.html wordleunlimited.html worldshardestgame.html worldshardestgame2.html worldshardestgame3.html wrestlebros.html zombierush.html 1.5.html 1.8.html 1.12.html 1on1soccer.html".split(" ")
  .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" }));
const GAME_SET = new Set(GAMES);

const POPULAR_GAMES = ["geometrydash.html","slope.html","retrobowl.html","1v1.lol.html","monkeymart.htm","eggycar.html",
  "amongus.html","bloonsTD5.html","polytrack.html","sprunki.html","footballlegends.html","ovo.html"].filter(f => GAME_SET.has(f));

const PACKS = {
  vusl:      { id: "vusl",      label: "VUSL",      emoji: "🎮", games: GAMES },
  allgames:  { id: "allgames",  label: "All Games", emoji: "🗂", games: [], isVirtual: true },
  favorites: { id: "favorites", label: "Favs",      emoji: "⭐", games: [] },
  external:  { id: "external",  label: "External",  emoji: "🌐", games: [] }
};

/* ── Storage helpers (tolerate corrupt localStorage) ── */
const lsGet = (k, d) => { try { const v = JSON.parse(localStorage.getItem(k)); return v == null ? d : v; } catch { return d; } };
const lsSet = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch {} };
const strArr = v => Array.isArray(v) ? v.filter(x => typeof x === "string") : [];
const sleep = ms => new Promise(r => setTimeout(r, ms));

/* ── Keys ─────────────────────────────────────────── */
const SEP = "\u0001";
const idbKey = (p, f) => p + SEP + f;
const splitKey = k => { const i = k.indexOf(SEP); return [k.slice(0, i), k.slice(i + 1)]; };

/* ── State ────────────────────────────────────────── */
let activePack = "vusl";
const favorites = new Set(strArr(lsGet("vusl15-favs", [])));
PACKS.external.games = strArr(lsGet("vusl17-ext-manifest", []));
const saveExternalManifest = () => lsSet("vusl17-ext-manifest", PACKS.external.games);
const saveFavs = () => lsSet("vusl15-favs", [...favorites]);

/* Manually clicked games, latest first. */
let recent = strArr(lsGet("vusl17-recent", []));
let recentIdx = new Map(recent.map((f, i) => [f, i]));
function noteRecent(file) {
  recent = [file, ...recent.filter(f => f !== file)].slice(0, 200);
  recentIdx = new Map(recent.map((f, i) => [f, i]));
  lsSet("vusl17-recent", recent);
}
const rank = f => recentIdx.has(f) ? recentIdx.get(f) : 1e9;
const byRecency = pairs => pairs.sort((a, b) => rank(a[1]) - rank(b[1]));

const statusMap = new Map();          // key → unknown | loading | cached | failed
const cardIndex = new Map();          // key → [card elements] (a game can appear twice)
const notFound  = new Set();          // keys that 404'd — skip in silent auto-retry

/* ── Element refs ─────────────────────────────────── */
const $ = id => document.getElementById(id);
const $statusLine = $("statusLine"), $progressWrap = $("progressWrap"), $progressFill = $("progressFill");
const $retryBtn = $("retryBtn"), $loadAllBtn = $("loadAllBtn"), $refreshBtn = $("refreshBtn");
const $gameArea = $("gameArea"), $countLabel = $("countLabel"), $search = $("search"), $packTabs = $("packTabs");
const $toast = $("toast"), $notifBanner = $("notifBanner");
const $confirmModal = $("confirmModal"), $confirmTitle = $("confirmTitle"), $confirmBody = $("confirmBody");
const $confirmSkip = $("confirmSkip"), $confirmOverwrite = $("confirmOverwrite");
const $fileInputFiles = $("fileInputFiles"), $fileInputFolder = $("fileInputFolder");

/* ── Helpers ──────────────────────────────────────── */
const prettyName = f => f.replace(/\.html?$/i, "").replace(/([A-Za-z])(\d+)$/, "$1 $2");
const statusIcon = s => s === "cached" ? "✔" : s === "loading" ? "⏳" : s === "failed" ? "❌" : "○";
const esc = (s = "") => String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

/* ── IndexedDB ────────────────────────────────────── */
let db = null;
function initDB() {
  return new Promise((res, rej) => {
    const r = indexedDB.open("VUSL_V17_DB", 1);
    r.onupgradeneeded = e => { if (!e.target.result.objectStoreNames.contains("html")) e.target.result.createObjectStore("html"); };
    r.onsuccess = e => { db = e.target.result; res(); };
    r.onerror = () => rej(r.error);
  });
}
/* One helper for every transaction → { ok, v } */
function idb(mode, fn) {
  return new Promise(res => {
    try {
      const tx = db.transaction("html", mode);
      const r = fn(tx.objectStore("html"));
      tx.oncomplete = () => res({ ok: true, v: r && r.result });
      tx.onerror = tx.onabort = () => res({ ok: false });
    } catch { res({ ok: false }); }
  });
}
const dbGet     = async key => (await idb("readonly", s => s.get(key))).v ?? null;
const dbKeys    = async () => (await idb("readonly", s => s.getAllKeys())).v || [];
const dbPutMany = async entries => (await idb("readwrite", s => { for (const [k, h] of entries) s.put(h, k); })).ok;
const dbDelete  = async keys => (await idb("readwrite", s => { for (const k of keys) s.delete(k); })).ok;
const dbClear   = async () => (await idb("readwrite", s => s.clear())).ok;

/* Coalesce writes from many finishing downloads into one transaction. */
let wbuf = [], wtimer = null;
function queueWrite(key, html) {
  return new Promise(res => { wbuf.push([key, html, res]); if (!wtimer) wtimer = setTimeout(flushWrites, 60); });
}
async function flushWrites() {
  wtimer = null;
  const batch = wbuf; wbuf = [];
  const ok = await dbPutMany(batch);
  batch.forEach(b => b[2](ok));
}

/* ── Cache scan ───────────────────────────────────── */
async function scanCache() {
  const keys = new Set(await dbKeys());
  const orphans = [...keys].filter(k => { const [p, f] = splitKey(k); return p === "vusl" && !GAME_SET.has(f); });
  if (orphans.length) dbDelete(orphans);            // purge games from the removed source
  for (const pid of ["vusl", "external"]) {
    for (const fn of PACKS[pid].games) {
      const k = idbKey(pid, fn);
      if (jobs.has(k)) continue;                     // never downgrade in-flight
      statusMap.set(k, keys.has(k) ? "cached" : statusMap.get(k) === "failed" ? "failed" : "unknown");
    }
  }
}

/* ── Overlay / refresh ────────────────────────────── */
let overlayEl = null;
function showOverlay(msg) {
  if (!overlayEl) {
    overlayEl = document.createElement("div");
    overlayEl.style.cssText = "position:fixed;inset:0;background:rgba(10,10,13,.72);display:flex;align-items:center;justify-content:center;z-index:9700;font-family:var(--display);font-size:14px;font-weight:800;letter-spacing:1px;color:var(--accent);flex-direction:column;gap:10px";
    document.body.appendChild(overlayEl);
  }
  overlayEl.innerHTML = `<div style="font-size:26px;animation:spin .8s linear infinite">⟳</div><div>${esc(msg)}</div>`;
  overlayEl.style.display = "flex";
}
const hideOverlay = () => { if (overlayEl) overlayEl.style.display = "none"; };

async function fullScreenRefresh(reason) {
  showOverlay(reason || "Refreshing…");
  await scanCache();
  renderPackTabs(); renderGrid(); refreshStatus();
  await sleep(260);
  hideOverlay();
}
async function manualRefresh() {
  $refreshBtn.disabled = true; $refreshBtn.textContent = "⟳ …";
  await fullScreenRefresh("Refreshing cache status…");
  $refreshBtn.disabled = false; $refreshBtn.textContent = "⟳ Refresh";
  toast("Refreshed cache status", "info", 1400);
}

/* ── Toast / banner / confirm ─────────────────────── */
let toastTmr;
function toast(msg, type = "success", ms = 2400) {
  $toast.textContent = msg; $toast.className = "show " + type;
  clearTimeout(toastTmr); toastTmr = setTimeout(() => { $toast.className = ""; }, ms);
}
let bannerTmr;
function showBanner(msg, ms = 4000) {
  $notifBanner.textContent = msg; $notifBanner.style.display = "block";
  clearTimeout(bannerTmr); bannerTmr = setTimeout(() => { $notifBanner.style.display = "none"; }, ms);
}
function askConfirm(title, body, { confirmLabel = "Overwrite", skipLabel = "Skip duplicates" } = {}) {
  return new Promise(resolve => {
    $confirmTitle.textContent = title; $confirmBody.textContent = body;
    $confirmSkip.textContent = skipLabel; $confirmOverwrite.textContent = confirmLabel;
    $confirmModal.style.display = "flex";
    const done = r => { $confirmModal.style.display = "none"; $confirmSkip.onclick = $confirmOverwrite.onclick = null; resolve(r); };
    $confirmSkip.onclick = () => done("skip");
    $confirmOverwrite.onclick = () => done("overwrite");
  });
}

/* ── Progress / status line ───────────────────────── */
function setProgress(pct) {
  if (pct <= 0) { $progressWrap.style.display = "none"; $progressFill.style.width = "0%"; return; }
  $progressWrap.style.display = "block";
  $progressFill.style.width = Math.min(100, pct).toFixed(1) + "%";
  if (pct >= 100) setTimeout(() => setProgress(0), 600);
}
function refreshStatus() {
  const games = getActiveGames();
  let cached = 0, failed = 0, loading = 0;
  for (const [pid, fn] of games) {
    const s = statusMap.get(idbKey(pid, fn));
    if (s === "cached") cached++; else if (s === "failed") failed++;
  }
  for (const j of jobs.values()) if (j.state === "active") loading++;
  const parts = [`${games.length} games`, `${cached} cached`];
  if (loading) parts.push(`${loading} loading`);
  if (failed) parts.push(`${failed} failed`);
  $statusLine.textContent = parts.join(" · ");
  $retryBtn.style.display = failed > 0 ? "" : "none";
}
let statusQueued = false;
function softStatus() {
  if (statusQueued) return;
  statusQueued = true;
  requestAnimationFrame(() => { statusQueued = false; refreshStatus(); });
}

/* ── Game lists ───────────────────────────────────── */
function validFavs() {
  return [...favorites].filter(k => {
    const [p, f] = splitKey(k);
    return (p === "vusl" && GAME_SET.has(f)) || (p === "external" && PACKS.external.games.includes(f));
  });
}
function getActiveGames() {
  if (activePack === "favorites") return validFavs().map(splitKey);
  if (activePack === "allgames") return [...GAMES.map(f => ["vusl", f]), ...PACKS.external.games.map(f => ["external", f])];
  return (PACKS[activePack]?.games || []).map(f => [activePack, f]);
}

/* ── Tabs ─────────────────────────────────────────── */
function renderPackTabs() {
  const ids = Object.keys(PACKS);
  $packTabs.innerHTML = ids.map((id, i) => {
    const p = PACKS[id];
    const n = id === "favorites" ? validFavs().length : id === "allgames" ? GAMES.length + PACKS.external.games.length : p.games.length;
    const cls = "pack-tab" + (id === activePack ? " active" : "") + (i === ids.length - 1 ? " pinned-right" : "") + (id === "allgames" ? " tab-allgames" : "");
    return `<div class="${cls}" data-id="${id}">${p.emoji} ${esc(p.label)} <span class="tab-badge">${n}</span></div>`;
  }).join("");
}
$packTabs.addEventListener("click", e => {
  const t = e.target.closest(".pack-tab");
  if (t) switchPack(t.dataset.id);
});
function switchPack(id) {
  activePack = id; $search.value = "";
  renderPackTabs(); renderGrid(); refreshStatus();
}

let searchTimer;
$search.addEventListener("input", () => { clearTimeout(searchTimer); searchTimer = setTimeout(renderGrid, 120); });

/* ── Grid ─────────────────────────────────────────── */
function cardHTML(pack, file) {
  const key = idbKey(pack, file), st = statusMap.get(key) || "unknown", fav = favorites.has(key);
  return `<div class="game-card ${st}" data-pack="${pack}" data-file="${esc(file)}">`
    + `<span class="card-status">${statusIcon(st)}</span>`
    + `<span class="card-name" title="${esc(file)}">${esc(prettyName(file))}</span>`
    + (activePack === "allgames" ? `<span class="card-source-tag" title="${esc(PACKS[pack].label)}">${PACKS[pack].emoji}</span>` : "")
    + `<span class="card-star${fav ? " on" : ""}" title="${fav ? "Remove from favorites" : "Add to favorites"}">${fav ? "⭐" : "☆"}</span>`
    + (pack === "external" ? `<span class="card-remove" title="Remove uploaded game">🗑</span>` : "")
    + `</div>`;
}
const sectionHTML = (title, pairs, cls = "") =>
  `<div class="section"><div class="section-head ${cls}">${esc(title)}</div><div class="game-grid">${pairs.map(p => cardHTML(...p)).join("")}</div></div>`;

const extBarHTML = () => `<div class="ext-upload-row" style="margin-bottom:14px">
  <button class="btn btn-secondary" data-act="upFiles">📄 Upload Files</button>
  <button class="btn btn-secondary" data-act="upFolder">📁 Upload Folder</button></div>`;
const extPanelHTML = () => `<div class="empty-state"><div class="big">🌐</div><h2>External Pack</h2>
  <p>Upload your own HTML games from files or an entire folder. They're stored locally and play offline just like the built-in packs.</p>
  <div class="ext-config"><div class="ext-upload-row">
    <button class="btn btn-primary" id="btnUploadFilesEmpty" data-act="upFiles">📄 Upload Files</button>
    <button class="btn btn-primary" id="btnUploadFolderEmpty" data-act="upFolder">📁 Upload Folder</button></div>
  <p class="ext-note">Accepts .html / .htm files. Uploading again later adds new games — it won't erase what's already here.</p></div></div>`;

function renderGrid() {
  const query = $search.value.trim().toLowerCase();
  const setArea = html => { $gameArea.innerHTML = html; indexCards(); };

  if (activePack === "external" && PACKS.external.games.length === 0) {
    $countLabel.textContent = "0 games"; return setArea(extPanelHTML());
  }
  const all = getActiveGames();
  if (activePack === "favorites" && all.length === 0) {
    $countLabel.textContent = "0 games";
    return setArea(`<div class="empty-state"><div class="big">⭐</div><h2>No favorites yet</h2><p>Click the ☆ on any game to star it.<br>Starred games appear here across all packs.</p></div>`);
  }
  const filtered = query ? all.filter(([, f]) => prettyName(f).toLowerCase().includes(query)) : all;
  $countLabel.textContent = filtered.length + " game" + (filtered.length !== 1 ? "s" : "");

  let out = activePack === "external" ? extBarHTML() : "";
  if (!filtered.length) {
    return setArea(out + `<div class="empty-state"><div class="big">🔍</div><h2>No results</h2><p>No games match "<strong>${esc(query)}</strong>"</p></div>`);
  }
  if (activePack === "vusl" && !query && POPULAR_GAMES.length) {
    const pop = new Set(POPULAR_GAMES);
    const pairs = filtered.filter(([, f]) => pop.has(f));
    if (pairs.length) out += sectionHTML("🔥 Popular", pairs, "popular-head");
  }
  const groups = {};
  for (const pair of filtered) {
    const l = (prettyName(pair[1])[0] || "#").toUpperCase();
    (groups[/[A-Z]/.test(l) ? l : "#"] ||= []).push(pair);
  }
  for (const l of Object.keys(groups).sort()) out += sectionHTML(l, groups[l]);
  setArea(out);
}

function indexCards() {
  cardIndex.clear();
  for (const c of $gameArea.querySelectorAll(".game-card")) {
    const k = idbKey(c.dataset.pack, c.dataset.file);
    const arr = cardIndex.get(k);
    arr ? arr.push(c) : cardIndex.set(k, [c]);
  }
}
function paintCard(key) {
  const st = statusMap.get(key) || "unknown";
  for (const c of cardIndex.get(key) || []) {
    c.className = "game-card " + st;
    const si = c.querySelector(".card-status"); if (si) si.textContent = statusIcon(st);
  }
}
function setCardStatus(key, status) { statusMap.set(key, status); paintCard(key); softStatus(); }
function syncCards() { for (const k of cardIndex.keys()) paintCard(k); refreshStatus(); }

/* One delegated listener for every card. */
$gameArea.addEventListener("click", e => {
  const act = e.target.closest("[data-act]");
  if (act) { (act.dataset.act === "upFiles" ? $fileInputFiles : $fileInputFolder).click(); return; }
  const card = e.target.closest(".game-card");
  if (!card) return;
  const { pack, file } = card.dataset;
  if (e.target.closest(".card-star"))   return toggleFav(pack, file);
  if (e.target.closest(".card-remove")) return removeExternalGame(file);
  launchGame(pack, file);
});

/* ── Favorites ────────────────────────────────────── */
function toggleFav(pack, file) {
  const key = idbKey(pack, file);
  if (favorites.delete(key)) toast("Removed from favorites", "info");
  else { favorites.add(key); toast("⭐ Added to favorites", "success"); }
  saveFavs();
  for (const c of cardIndex.get(key) || []) {
    const star = c.querySelector(".card-star"), on = favorites.has(key);
    star.className = "card-star" + (on ? " on" : ""); star.textContent = on ? "⭐" : "☆";
    star.title = on ? "Remove from favorites" : "Add to favorites";
  }
  renderPackTabs();
  if (activePack === "favorites") { renderGrid(); refreshStatus(); }
}

/* ── External uploads ─────────────────────────────── */
async function handleExternalUpload(fileList) {
  const files = [...fileList].filter(f => /\.html?$/i.test(f.name));
  if (!files.length) { toast("No .html/.htm files found in selection", "error"); return; }

  const existing = new Set(PACKS.external.games);
  const dupes = files.filter(f => existing.has(f.name));
  let mode = "skip";
  if (dupes.length) {
    mode = await askConfirm("Duplicate files found",
      `${dupes.length} of ${files.length} file${files.length > 1 ? "s" : ""} share a name with games already uploaded. Skip duplicates (keep existing versions) or overwrite them with the new files?`);
  }
  const toWrite = [], seen = new Set();
  let added = 0, overwritten = 0, skipped = 0;
  for (const f of files) {
    if (seen.has(f.name)) { skipped++; continue; }
    seen.add(f.name);
    const dup = existing.has(f.name);
    if (dup && mode === "skip") { skipped++; continue; }
    toWrite.push(f); dup ? overwritten++ : added++;
  }
  showOverlay(`Storing ${toWrite.length} game${toWrite.length !== 1 ? "s" : ""}…`);
  try {
    const texts = await Promise.all(toWrite.map(f => f.text()));
    const ok = await dbPutMany(toWrite.map((f, i) => [idbKey("external", f.name), texts[i]]));
    if (!ok) throw new Error("write failed");
    for (const f of toWrite) {
      if (!existing.has(f.name)) { existing.add(f.name); PACKS.external.games.push(f.name); }
      statusMap.set(idbKey("external", f.name), "cached");
    }
    saveExternalManifest();
  } catch {
    hideOverlay(); toast("Upload failed — storage may be full", "error", 3200); return;
  }
  await fullScreenRefresh("Finishing up…");
  const parts = [];
  if (added) parts.push(`${added} added`);
  if (overwritten) parts.push(`${overwritten} overwritten`);
  if (skipped) parts.push(`${skipped} skipped`);
  toast(`✔ Upload complete — ${parts.join(", ")}`, "success", 3200);
}
for (const input of [$fileInputFiles, $fileInputFolder]) {
  input.addEventListener("change", e => { if (e.target.files.length) handleExternalUpload(e.target.files); e.target.value = ""; });
}
async function removeExternalGame(file) {
  const key = idbKey("external", file);
  await dbDelete([key]);
  statusMap.delete(key); favorites.delete(key);
  PACKS.external.games = PACKS.external.games.filter(f => f !== file);
  saveExternalManifest(); saveFavs();
  renderPackTabs(); renderGrid(); refreshStatus();
  toast(`Removed "${prettyName(file)}"`, "info");
}

/* ── Windows ──────────────────────────────────────── */
function openBlank() {
  let w = null;
  try { w = window.open("about:blank"); } catch {}
  if (w) { try { w.document.write('<title>Loading…</title><body style="background:#0a0a0d;color:#00ff88;font:14px monospace;padding:24px">Loading game…'); } catch {} }
  return w;
}
const closeWin = w => { try { w && w.close(); } catch {} };
function injectBase(html, base) {
  if (!base) return html;
  const tag = `<base href="${base}">`;
  return /<head[^>]*>/i.test(html) ? html.replace(/<head[^>]*>/i, m => m + tag) : tag + html;
}
function writeGame(w, html, base) {
  try {
    if (!w || w.closed) return;
    w.document.open(); w.document.write(injectBase(html, base)); w.document.close();
  } catch {}
}

/* ── Launch ───────────────────────────────────────── */
async function launchGame(pack, file) {
  const w = openBlank();                       // synchronous → survives popup blockers
  if (!w) toast("Popup blocked — allow popups for this page", "error");
  const key = idbKey(pack, file);

  if (pack === "external") {
    const html = await dbGet(key);
    if (html) { writeGame(w, html, ""); return; }
    closeWin(w); setCardStatus(key, "failed");
    toast("This uploaded game is missing from storage — try re-uploading it", "error");
    return;
  }
  noteRecent(file);
  if (!jobs.has(key)) {
    const cached = await dbGet(key);
    if (cached) { writeGame(w, cached, CRA_BASE); if (statusMap.get(key) !== "cached") setCardStatus(key, "cached"); return; }
  }
  request(file, true, w);
}

/* ══ Download queue: manual lane (clicked) + bulk lane ══ */
const MANUAL_MAX = 6, BULK_MAX = 12, BULK_BUSY = 2, FETCH_TIMEOUT = 25000;
const jobs = new Map();            // key → { key, file, state, lane, manual, wins, ctl, cancelled }
const manualQ = [], bulkQ = [];    // manualQ: latest click first
let manualActive = 0, bulkActive = 0;

function request(file, manual, win) {
  const key = idbKey("vusl", file);
  let job = jobs.get(key);
  if (!job) {
    job = { key, file, state: "queued", lane: null, manual: false, wins: [], ctl: null, cancelled: false };
    jobs.set(key, job);
    setCardStatus(key, "loading");
    bulkQ.push(job);
  }
  if (win) job.wins.push(win);
  if (manual) {
    if (job.state === "queued") {
      for (const q of [manualQ, bulkQ]) { const i = q.indexOf(job); if (i >= 0) q.splice(i, 1); }
      manualQ.unshift(job);                    // latest click goes first
    } else if (job.lane === "bulk") {          // already downloading in bulk: promote its slot
      bulkActive--; manualActive++; job.lane = "manual";
    }
    job.manual = true;
  }
  pump();
  return job;
}

function pump() {
  while (manualActive < MANUAL_MAX && manualQ.length) start(manualQ.shift(), "manual");
  const cap = (manualActive || manualQ.length) ? BULK_BUSY : BULK_MAX;
  while (bulkActive < cap && bulkQ.length) start(bulkQ.shift(), "bulk");
}
function start(job, lane) {
  job.state = "active"; job.lane = lane;
  lane === "manual" ? manualActive++ : bulkActive++;
  softStatus();
  run(job);
}

async function run(job) {
  let html = null, missing = false;
  for (let attempt = 0; attempt < 2 && html == null && !job.cancelled; attempt++) {
    job.ctl = new AbortController();
    const timer = setTimeout(() => job.ctl.abort(), FETCH_TIMEOUT);
    try {
      const r = await fetch(CRA_BASE + job.file, { signal: job.ctl.signal, priority: job.lane === "manual" ? "high" : "low" });
      if (r.status === 404) { missing = true; break; }
      if (!r.ok) throw new Error("HTTP " + r.status);
      html = await r.text();
    } catch {
      if (job.cancelled) break;
      if (attempt === 0) await sleep(600);
    } finally { clearTimeout(timer); }
  }
  job.lane === "manual" ? manualActive-- : bulkActive--;
  jobs.delete(job.key);
  pump();                                       // free the slot before the (batched) cache write

  if (job.cancelled) { job.wins.forEach(closeWin); return; }
  if (html == null) {
    setCardStatus(job.key, "failed");
    job.wins.forEach(closeWin);
    if (missing) notFound.add(job.key); else scheduleAutoRetry();
    if (job.manual) toast("Failed to load — check network connection", "error");
    settle(job.key);
    return;
  }
  notFound.delete(job.key);
  for (const w of job.wins) writeGame(w, html, CRA_BASE);   // open before the cache write completes
  const ok = await queueWrite(job.key, html);
  setCardStatus(job.key, ok ? "cached" : "unknown");
  settle(job.key);
}

/* ── Load All ─────────────────────────────────────── */
let loadingAll = false, loadAllSet = new Set(), loadAllTotal = 0;

function startLoadAll() {
  if (loadingAll) return;
  if (activePack === "external") { toast("External games are already stored locally — nothing to load", "info"); return; }
  const todo = byRecency(getActiveGames().filter(([p, f]) => p === "vusl" && statusMap.get(idbKey(p, f)) !== "cached"));
  if (!todo.length) { toast("✔ All games already cached", "success"); return; }
  loadingAll = true; loadAllTotal = todo.length; loadAllSet = new Set(todo.map(([p, f]) => idbKey(p, f)));
  $loadAllBtn.disabled = true; $loadAllBtn.textContent = "⏳ Loading…";
  setProgress(1);
  for (const [, f] of todo) request(f, false);   // already in most-recently-clicked-first order
}
function settle(key) {
  if (!loadingAll || !loadAllSet.delete(key)) return;
  setProgress(((loadAllTotal - loadAllSet.size) / loadAllTotal) * 100);
  if (!loadAllSet.size) finishLoadAll();
}
function resetLoadAll() {
  loadingAll = false; loadAllSet.clear();
  $loadAllBtn.disabled = false; $loadAllBtn.textContent = "⬇ Load All";
}
function finishLoadAll() {
  resetLoadAll(); setProgress(100);
  const failed = getActiveGames().filter(([p, f]) => statusMap.get(idbKey(p, f)) === "failed").length;
  showBanner(failed ? `Loaded with ${failed} failed — use ↺ Retry Failed` : "✔ All Games Loaded — Offline Ready!", 4500);
  refreshStatus();
}

/* ── Retry ────────────────────────────────────────── */
let retryTimer = null;
function scheduleAutoRetry() { clearTimeout(retryTimer); retryTimer = setTimeout(() => retryFailed(true), 30000); }

function retryFailed(quiet = false) {
  clearTimeout(retryTimer);
  const failed = [];
  for (const [k, s] of statusMap) {
    if (s !== "failed") continue;
    const [p, f] = splitKey(k);
    if (p === "vusl" && !(quiet && notFound.has(k))) failed.push(f);
  }
  if (!failed.length) { if (!quiet) toast("Nothing to retry", "info"); return; }
  const clicked = failed.filter(f => recentIdx.has(f)).sort((a, b) => recentIdx.get(b) - recentIdx.get(a)); // oldest first → newest ends up first
  for (const f of failed) if (!recentIdx.has(f)) request(f, false);
  for (const f of clicked) request(f, true);
  if (!quiet) toast(`↺ Retrying ${failed.length} failed game${failed.length > 1 ? "s" : ""}…`, "info");
}
window.addEventListener("online", () => retryFailed(true));

/* ── Clear cache ──────────────────────────────────── */
function cancelAll() {
  for (const j of [...jobs.values()]) {
    j.cancelled = true; j.wins.forEach(closeWin);
    if (j.state === "active") j.ctl && j.ctl.abort(); else jobs.delete(j.key);
  }
  manualQ.length = 0; bulkQ.length = 0;
  clearTimeout(retryTimer);
  clearTimeout(wtimer); wtimer = null;
  wbuf.forEach(b => b[2](false)); wbuf = [];
  if (loadingAll) { resetLoadAll(); setProgress(0); }
}
async function clearCache() {
  let keepExternal = false;
  if (PACKS.external.games.length) {
    const mode = await askConfirm("Clear cache",
      "This will also permanently delete your uploaded External games, since they can't be re-downloaded. Keep external uploads, or clear everything?",
      { confirmLabel: "Clear everything", skipLabel: "Keep external uploads" });
    keepExternal = mode === "skip";
  }
  cancelAll();
  if (keepExternal) await dbDelete((await dbKeys()).filter(k => splitKey(k)[0] !== "external"));
  else { await dbClear(); PACKS.external.games = []; saveExternalManifest(); }
  statusMap.clear(); notFound.clear();
  await scanCache();
  renderPackTabs(); renderGrid(); refreshStatus();
  toast(keepExternal ? "Cache cleared (external uploads kept)" : "Cache cleared", "info");
}

/* ── Re-sync on tab focus ─────────────────────────── */
document.addEventListener("visibilitychange", () => {
  if (document.visibilityState === "visible") scanCache().then(syncCards);
});

/* ── Init ─────────────────────────────────────────── */
(async function init() {
  try { await initDB(); } catch { db = null; }
  await scanCache();
  renderPackTabs(); renderGrid(); refreshStatus();
})();
</script>
