  const p = PROVIDERS[id];
  const typed = keyInput.value.trim();
  const saved = (lsGet(p.store) || '').trim();

  if (!typed && !saved && !p.shared) { setKeyMsg('Paste your ' + p.name + ' key first.', 'err'); return; }

  if (typed) {
    keySaveBtn.disabled = true;
    setKeyMsg('Checking key...', 'wait');
    try {
      await testKeyValid({ key: typed }, id);
    } catch (e) {
      setKeyMsg(e.status ? p.name + ' rejected that key: ' + e.message : 'Could not reach ' + p.name + ' to check the key.', 'err');
      return;
    } finally {
      keySaveBtn.disabled = false;
    }
    // Closed or switched provider while checking: don't save
    if (!keyModalBg.classList.contains('open') || providerSelect.value !== id) return;
    if (checking || thinking) { setKeyMsg('Busy right now. Wait for it to finish, then save.', 'err'); return; }
    if (!lsSet(p.store, typed)) { setKeyMsg('Could not save: browser storage is blocked.', 'err'); return; }
  }

  if (!lsSet(PROVIDER_STORE, id)) { setKeyMsg('Could not save: browser storage is blocked.', 'err'); return; }
  if (p.shared) lsSet(ONLYMY_STORE, onlyMyKeyBox.checked ? '1' : '0');
  closeKeyModal();

  // The first time a key is added, run one full check with it. After that, just refresh.
  if (typed && !saved) await checkAll();
  else await refreshAll();
}

async function removeMyKey() {
  if (checking || thinking) { setKeyMsg('Busy right now. Wait for it to finish, then remove.', 'err'); return; }
  const p = PROVIDERS[providerSelect.value];
  lsDel(p.store);
  if (p.shared) lsDel(ONLYMY_STORE);
  closeKeyModal();
  await refreshAll();
}

keyModalBg.addEventListener('click', e => { if (e.target === keyModalBg) closeKeyModal(); });
keyInput.addEventListener('keydown', e => {
  if (e.key === 'Enter') { e.preventDefault(); saveMyKey(); }
  if (e.key === 'Escape') closeKeyModal();
});

/* ════════════════════════════════════════
   SEARCH
════════════════════════════════════════ */
let searchMatches = [];
let searchCurrent = -1;

function toggleSearch() {
  const isOpen = searchBar.classList.toggle('open');
  if (isOpen) {
    searchInput.focus();
  } else {
    clearSearch();
  }
}

function clearSearch() {
  searchInput.value = '';
  removeHighlights();
  searchMatches = [];
  searchCurrent = -1;
  searchCount.textContent = '—';
  srchUp.disabled   = true;
  srchDown.disabled = true;
}

searchInput.addEventListener('input', () => runSearch());
searchInput.addEventListener('keydown', e => {
  if (e.key === 'Enter') { e.preventDefault(); stepSearch(e.shiftKey ? -1 : 1); }
  if (e.key === 'Escape') toggleSearch();
});

function removeHighlights() {
  chatEl.querySelectorAll('.hl').forEach(el => {
    el.replaceWith(document.createTextNode(el.textContent));
  });
  // Merge adjacent text nodes
  chatEl.querySelectorAll('.bubble').forEach(b => b.normalize());
}

function runSearch() {
  removeHighlights();
  searchMatches = [];
  searchCurrent = -1;

  const q = searchInput.value.trim();
  if (!q) {
    searchCount.textContent = '—';
    srchUp.disabled   = true;
    srchDown.disabled = true;
    return;
  }

  const regex = new RegExp(escapeRegex(q), 'gi');

  // Walk all text nodes inside bubbles
  chatEl.querySelectorAll('.bubble').forEach(bubble => {
    highlightInNode(bubble, regex);
  });

  searchMatches = Array.from(chatEl.querySelectorAll('.hl'));

  if (searchMatches.length === 0) {
    searchCount.textContent = '0 / 0';
    srchUp.disabled   = true;
    srchDown.disabled = true;
    return;
  }

  srchUp.disabled   = false;
  srchDown.disabled = false;
  stepSearch(1);
}

function highlightInNode(node, regex) {
  if (node.nodeType === Node.TEXT_NODE) {
    const text = node.textContent;
    let match, lastIdx = 0;
    const frag = document.createDocumentFragment();
    regex.lastIndex = 0;
    while ((match = regex.exec(text)) !== null) {
      if (match.index > lastIdx) {
        frag.appendChild(document.createTextNode(text.slice(lastIdx, match.index)));
      }
      const span = document.createElement('span');
      span.className = 'hl';
      span.textContent = match[0];
      frag.appendChild(span);
      lastIdx = regex.lastIndex;
    }
    if (lastIdx < text.length) frag.appendChild(document.createTextNode(text.slice(lastIdx)));
    if (frag.childNodes.length > 1 || (frag.firstChild && frag.firstChild.nodeName === 'SPAN')) {
      node.parentNode.replaceChild(frag, node);
    }
  } else if (node.nodeType === Node.ELEMENT_NODE && node.nodeName !== 'SCRIPT' && node.nodeName !== 'STYLE') {
    Array.from(node.childNodes).forEach(child => highlightInNode(child, regex));
  }
}

function stepSearch(dir) {
  if (searchMatches.length === 0) return;
  if (searchCurrent >= 0) searchMatches[searchCurrent].classList.remove('current');
  searchCurrent = (searchCurrent + dir + searchMatches.length) % searchMatches.length;
  const target = searchMatches[searchCurrent];
  target.classList.add('current');
  searchCount.textContent = (searchCurrent + 1) + ' / ' + searchMatches.length;

  // Scroll into view with padding so it's never clipped
  const chatRect   = chatEl.getBoundingClientRect();
  const targetRect = target.getBoundingClientRect();
  const pad = 60;
  if (targetRect.top < chatRect.top + pad) {
    chatEl.scrollTop -= (chatRect.top + pad - targetRect.top);
  } else if (targetRect.bottom > chatRect.bottom - pad) {
    chatEl.scrollTop += (targetRect.bottom - chatRect.bottom + pad);
  }
}

function escapeRegex(s) {
  return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

/* ════════════════════════════════════════
   INPUT
════════════════════════════════════════ */
inputEl.addEventListener('input', () => {
  inputEl.style.height = 'auto';
  inputEl.style.height = Math.min(inputEl.scrollHeight, 140) + 'px';
});

inputEl.addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
});

/* ════════════════════════════════════════
   MARKDOWN-LITE RENDERER
════════════════════════════════════════ */
function renderText(raw) {
  // Escape everything first, then add formatting. Code is stashed so it is only escaped once.
  const blocks = [];
  const stash = html => '%%VUSBLK' + (blocks.push(html) - 1) + '%%';
  let out = raw.replace(/```(\w*)\n?([\s\S]*?)```/g, (_, _lang, code) =>
    stash(`<pre><code>${escHtml(code.trim())}</code></pre>`)
  );
  out = out.replace(/`([^`]+)`/g, (_, c) => stash(`<code>${escHtml(c)}</code>`));
  out = escHtml(out);
  out = out.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  out = out.replace(/\n/g, '<br>');
  out = out.replace(/%%VUSBLK(\d+)%%/g, (m, i) => blocks[+i] ?? m);
  return out;
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

/* ════════════════════════════════════════
   MESSAGES
════════════════════════════════════════ */
function appendMsg(role, content, isTyping = false) {
  if (welcomeEl && welcomeEl.parentNode === chatEl) chatEl.removeChild(welcomeEl);

  const wrap = document.createElement('div');
  wrap.className = 'msg ' + role;

  const av = document.createElement('div');
  av.className = 'avatar';
  av.textContent = role === 'user' ? 'YOU' : 'AI';

  const bub = document.createElement('div');
  bub.className = 'bubble';

  if (isTyping) {
    bub.innerHTML = '<div class="typing-dots"><span></span><span></span><span></span></div>';
  } else {
    bub.innerHTML = role === 'assistant' ? renderText(content) : escHtml(content);
  }

  wrap.appendChild(av);
  wrap.appendChild(bub);
  chatEl.appendChild(wrap);
  chatEl.scrollTop = chatEl.scrollHeight;

  return { wrap, bub };
}

/* ════════════════════════════════════════
   API CALL
   test=true sends a minimal 1-token probe
   used by checkAll(); test=false sends the
   real conversation.
════════════════════════════════════════ */
async function tryKey(keyObj, modelId, test = false) {
  const p = PROVIDERS[provider];
  const body = test
    ? { model: modelId, max_tokens: 1, messages: [{ role: 'user', content: 'hi' }] }
    : { model: modelId, max_tokens: p.maxTokens, messages: [{ role: 'system', content: SYSTEM_PROMPT }, ...history] };

  const res = await fetch(p.chatUrl, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer ' + keyObj.key
    },
    body: JSON.stringify(body)
  });
  if (!res.ok) throw await apiError(res);
  const data = await res.json();
  // Some providers report a failure inside a normal response
  if (data.error) throw Object.assign(new Error(data.error.message || 'Provider error'), { status: Number(data.error.code) || 502 });
  const choice = data.choices?.[0];
  if (!test && !choice?.message?.content) {
    throw Object.assign(new Error('The model sent back an empty reply'), { status: choice?.finish_reason === 'length' ? 413 : 502 });
  }
  return data;
}

// Works out what actually failed, so a broken model is never blamed on the key
function classifyError(e) {
  const code = String(e.code || '');
  const msg  = e.message || '';
  if (!e.status) return 'network';
  // 'quota' is a limit on the whole account, so changing model won't help
  if (e.status === 429) return /free-models-per/i.test(msg) ? 'quota' : 'limit';
  if (e.status === 402) return 'account';
  if (e.status === 401 || code === 'invalid_api_key' || code === 'organization_restricted') return 'key';
  if (/api[ _]key (not valid|expired)|api_key_invalid/i.test(msg)) return 'key';   // Gemini sends these as 400
  if (e.status === 403 && /moderation|flagged/i.test(msg)) return 'request';
  if (e.status === 404 || code.startsWith('model_') || /decommissioned|does not exist|blocked at the/i.test(msg)) return 'model';
  if (e.status === 403) return 'key';
  if (e.status === 498 || e.status >= 500) return 'server';
  return 'request';
}

// When several keys fail differently, report the most telling one. 'key' is last:
// the key is only blamed if every key was rejected.
function mainFailure(failures) {
  const order = ['quota', 'account', 'limit', 'model', 'server', 'network', 'request', 'key'];
  return [...failures].sort((a, b) => order.indexOf(a.kind) - order.indexOf(b.kind))[0];
}

// Short reasons used in the "switched model" note
const REASONS = { model: 'is unavailable', server: "couldn't answer", limit: 'hit its rate limit', request: 'rejected the request' };

// Problems where trying a different model would not help
const STOP_KINDS = ['key', 'account', 'quota', 'network'];

function failureHtml(failure, model) {
  const who = PROVIDERS[provider].name;
  const name = model.label;
  const text = {
    model:   `⚠ Model unavailable: ${name} can't be used right now. This is a model problem, not a bad key.`,
    server:  `⚠ Model down: ${who} couldn't run ${name}. Try again shortly.`,
    limit:   `⚠ Rate limit reached for ${name}. Wait a moment and try again.`,
    quota:   `⚠ ${who} free limit reached for your account. Wait for it to reset, or switch provider.`,
    account: `⚠ ${who} says your account can't make this request. Check your account or credits.`,
    network: `⚠ Connection problem: couldn't reach ${who}. Check your internet and try again.`,
    request: `⚠ ${who} rejected this request. Try a shorter message or clear the chat.`,
    key:     `⚠ Key problem: ${who} rejected every key. Check your key or run CHECK.`
  }[failure.kind];
  const detail = failure.kind !== 'network' && failure.message ? '\nDetails: ' + failure.message : '';
  return escHtml(text + detail).replace(/\n/g, '<br>');
}

// The message shown when nothing answered
function failedHtml({ failed, refreshed }) {
  const last = failed[failed.length - 1];
  if (failed.length === 1 || [...STOP_KINDS, 'request'].includes(last.failure.kind)) {
    return failureHtml(last.failure, last.model);
  }
  const text = `⚠ No model could answer (${failed.length} tried).`
    + (refreshed ? ' The model list was refreshed.' : '') + ' Try again in a moment.'
    + `\nLast error (${last.model.label}): ${last.failure.message}`;
  return escHtml(text).replace(/\n/g, '<br>');
}

// Tries one model with each key until one answers
async function askModel(model) {
  // The selected key first, then fall back through the rest
  const tryOrder = [selectedKey, ...filledKeys.filter(k => k !== selectedKey)].filter(Boolean);
  const failures = [];

  for (const k of tryOrder) {
    try {
      const data = await tryKey(k, model.id);
      k.status = 'active';
      buildKeyMenu();
      return { data, key: k };
    } catch (e) {
      const kind = classifyError(e);
      failures.push({ kind, message: e.message });
      // Only mark a key bad when the key itself was rejected
      if (kind === 'key') k.status = 'inactive';
      buildKeyMenu();
    }
  }
  return { failure: mainFailure(failures) };
}

// Most models one message will try, so a bad day can't burn through your free limit
const MAX_TRIES = 8;

// The picked model first, then the ones after it, skipping any known to be down
function modelQueue(start) {
  const i = modelsList.indexOf(start);
  const after = [...modelsList.slice(i + 1), ...modelsList.slice(0, Math.max(i, 0))];
  return [start, ...after.filter(m => m.status !== 'inactive')];
}

// Stays on the picked model unless it fails, then moves to the next available one.
// If they all fail, the list is refreshed once and anything not yet tried gets a turn
// (up to MAX_TRIES models per message).
async function askWithFailover(start) {
  const tried = new Set();
  const failed = [];
  const down = new Set();
  let queue = modelQueue(start);
  let refreshed = false;

  while (true) {
    const model = tried.size < MAX_TRIES ? queue.shift() : null;
    if (!model) {
      if (refreshed) break;
      refreshed = true;
      const old = [modelsList, selectedModel];
      await loadModels(true);
      if (modelsLoadError) {   // keep the old list if the refresh itself fails
        [modelsList, selectedModel] = old;
        modelsLoadError = false;
        modelsFetched = true;
      }
      // A refresh shouldn't forget which models just failed
      modelsList.forEach(m => { if (down.has(m.id)) m.status = 'inactive'; });
      buildModelMenu();
      queue = modelsList.filter(m => !tried.has(m.id));
      continue;
    }

    tried.add(model.id);
    const result = await askModel(model);
    if (result.data) {
      model.status = 'active';
      return { ...result, model, failed, refreshed };
    }

    const kind = result.failure.kind;
    if (kind === 'model' || kind === 'server') { model.status = 'inactive'; down.add(model.id); }
    failed.push({ model, failure: result.failure });
    buildModelMenu();
    // Give up early if switching can't help, or three models rejected the same request
    if (STOP_KINDS.includes(kind) || failed.filter(f => f.failure.kind === 'request').length >= 3) break;
  }
  return { failed, refreshed };
}

async function send() {
  const text = inputEl.value.trim();
  if (!text || thinking || checking) return;

  if (keysLoading || modelsLoading) {
    alert('Still loading keys/models, please wait a moment and try again.');
    return;
  }

  if (!PROVIDERS[provider].shared && !myKeyObj) {
    openKeyModal();
    setKeyMsg('Add your ' + PROVIDERS[provider].name + ' key to start chatting.', 'err');
    return;
  }

  if (keysLoadError || filledKeys.length === 0) {
    alert('No API keys available. Could not load keys from the remote source, or none are configured there. You can add your own with the My Key button.');
    return;
  }

  if (modelsLoadError || modelsList.length === 0 || !selectedModel) {
    alert('No model available. Could not load the model list. Press the ↻ button to try again.');
    return;
  }

  thinking = true;
  updateSendAvailability();
  inputEl.value = '';
  inputEl.style.height = 'auto';
  clearSearch();

  appendMsg('user', text);
  history.push({ role: 'user', content: text });

  const { bub: typingBub } = appendMsg('assistant', '', true);

  const picksBefore = modelPicks;
  const result = await askWithFailover(selectedModel);

  if (result.data) {
    const reply = result.data.choices[0].message.content;
    const first = result.failed[0];
    const note = first
      ? `<div class="switch-note">↪ Switched to ${escHtml(result.model.label)}: ${escHtml(first.model.label)} ${REASONS[first.failure.kind]}.</div>`
      : '';
    typingBub.innerHTML = note + renderText(reply);
    history.push({ role: 'assistant', content: reply });
    // Keep using the model that worked, unless you picked another while waiting
    if (modelPicks === picksBefore) {
      selectedModel = result.model;
      lsSet(MODEL_STORE + provider, result.model.id);
    }
    // Keep My Key selected after a one-off fallback, and never reselect a key that was removed mid-reply
    if (!selectedKey?.mine && filledKeys.includes(result.key)) selectedKey = result.key;
    buildKeyMenu();
  } else {
    typingBub.innerHTML = `<span style="color:var(--red)">${failedHtml(result)}</span>`;
  }
  buildModelMenu();

  chatEl.scrollTop = chatEl.scrollHeight;
  thinking = false;
  updateSendAvailability();
  inputEl.focus();
}

/* ════════════════════════════════════════
   INIT — fetch keys and models each time the page opens
════════════════════════════════════════ */
refreshAll();
</script>
