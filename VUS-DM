      btn.textContent = "Pending";
      btn.disabled = true;
    } else if (status === "incoming") {
      btn.textContent = "Respond below";
      btn.disabled = true;
    } else {
      btn.textContent = "Add Friend";
      btn.className = "primary";
      btn.addEventListener("click", async () => {
        btn.disabled = true;
        btn.textContent = "Sending…";
        const result = await sendFriendRequest(person.accountKey, person.username);
        if (!result.ok) {
          showComposerNotice(result.error);
          btn.disabled = false;
          btn.textContent = "Add Friend";
        }
        // On success, the live watchOwnAccount subscription re-renders
        // this button via the next search (button state itself won't
        // auto-update mid-list without a re-search, which is fine here).
      });
    }

    actions.appendChild(btn);
    row.appendChild(actions);
    $searchResults.appendChild(row);
  });
}

function esc(s = "") {
  return String(s)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

// Shared row builder for an incoming request (used for both the normal
// and hidden lists — same actions apply either way, per project decision
// that hidden just changes which bucket it's shown in, not what you can
// do with it).
function buildIncomingRequestRow(fromAccountKey, req) {
  const row = document.createElement("div");
  row.className = "person-row";

  const nameWrap = document.createElement("div");
  nameWrap.className = "person-row-name";
  nameWrap.innerHTML = `<span class="pname">${esc(req.fromUsername)}</span>`;
  row.appendChild(nameWrap);

  const actions = document.createElement("div");
  actions.className = "person-row-actions";

  const acceptBtn = document.createElement("button");
  acceptBtn.className = "primary";
  acceptBtn.textContent = "Accept";
  acceptBtn.addEventListener("click", async () => {
    setRowButtonsDisabled(true);
    const result = await acceptFriendRequest(fromAccountKey, req.fromUsername);
    if (!result.ok) { showComposerNotice(result.error); setRowButtonsDisabled(false); }
  });

  const declineBtn = document.createElement("button");
  declineBtn.className = "danger";
  declineBtn.textContent = "Decline";
  declineBtn.addEventListener("click", async () => {
    setRowButtonsDisabled(true);
    const result = await declineFriendRequest(fromAccountKey);
    if (!result.ok) { showComposerNotice(result.error); setRowButtonsDisabled(false); }
  });

  const blockBtn = document.createElement("button");
  blockBtn.textContent = "Block";
  blockBtn.addEventListener("click", async () => {
    setRowButtonsDisabled(true);
    const result = await blockUser(fromAccountKey, req.fromUsername);
    if (!result.ok) { showComposerNotice(result.error); setRowButtonsDisabled(false); }
  });

  function setRowButtonsDisabled(disabled) {
    acceptBtn.disabled = disabled;
    declineBtn.disabled = disabled;
    blockBtn.disabled = disabled;
  }

  actions.appendChild(acceptBtn);
  actions.appendChild(declineBtn);
  actions.appendChild(blockBtn);
  row.appendChild(actions);
  return row;
}

function renderIncomingRequests(userData) {
  const incoming = (userData && userData.friendRequestsIncoming) || {};
  const visible = Object.entries(incoming).filter(([, req]) => !req.hidden);
  const hidden = Object.entries(incoming).filter(([, req]) => req.hidden);

  $incomingRequestsList.innerHTML = "";
  if (visible.length === 0) {
    $incomingRequestsEmpty.style.display = "block";
    $incomingCountBadge.style.display = "none";
  } else {
    $incomingRequestsEmpty.style.display = "none";
    $incomingCountBadge.style.display = "inline-block";
    $incomingCountBadge.textContent = visible.length;
  }
  visible.forEach(([fromAccountKey, req]) => {
    $incomingRequestsList.appendChild(buildIncomingRequestRow(fromAccountKey, req));
  });

  $hiddenRequestsList.innerHTML = "";
  if (hidden.length === 0) {
    $hiddenRequestsEmpty.style.display = "block";
    $hiddenCountBadge.style.display = "none";
  } else {
    $hiddenRequestsEmpty.style.display = "none";
    $hiddenCountBadge.style.display = "inline-block";
    $hiddenCountBadge.textContent = hidden.length;
  }
  hidden.forEach(([fromAccountKey, req]) => {
    $hiddenRequestsList.appendChild(buildIncomingRequestRow(fromAccountKey, req));
  });
}

function renderOutgoingRequests(userData) {
  const outgoing = (userData && userData.friendRequestsOutgoing) || {};
  const entries = Object.entries(outgoing);

  $outgoingRequestsList.innerHTML = "";
  $outgoingRequestsEmpty.style.display = entries.length === 0 ? "block" : "none";

  entries.forEach(([toAccountKey, req]) => {
    const row = document.createElement("div");
    row.className = "person-row";

    const nameWrap = document.createElement("div");
    nameWrap.className = "person-row-name";
    nameWrap.innerHTML = `<span class="pname">${esc(req.toUsername)}</span><span class="pid">Pending…</span>`;
    row.appendChild(nameWrap);

    const actions = document.createElement("div");
    actions.className = "person-row-actions";

    const cancelBtn = document.createElement("button");
    cancelBtn.textContent = "Cancel";
    cancelBtn.addEventListener("click", async () => {
      cancelBtn.disabled = true;
      const result = await cancelOutgoingRequest(toAccountKey);
      if (!result.ok) {
        showComposerNotice(result.error);
        cancelBtn.disabled = false;
      }
    });

    actions.appendChild(cancelBtn);
    row.appendChild(actions);
    $outgoingRequestsList.appendChild(row);
  });
}

let latestPresenceAccountKeys = new Set(); // kept in sync by watchPresenceList's onList callback, used to show online dots in the chat list

function initialsFor(username) {
  return (username || "?").trim().slice(0, 1).toUpperCase();
}

function renderFriendsList(userData) {
  const friends = (userData && userData.friends) || {};
  const entries = Object.entries(friends);

  $friendsList.innerHTML = "";
  $friendsEmpty.style.display = entries.length === 0 ? "block" : "none";

  entries.forEach(([friendAccountKey, friendData]) => {
    const wrap = document.createElement("div");

    const row = document.createElement("div");
    row.className = "chat-list-row" + (openChatAccountKey === friendAccountKey ? " selected" : "");
    row.addEventListener("click", () => openChatWith(friendAccountKey, friendData.username));

    const avatar = document.createElement("div");
    avatar.className = "chat-list-avatar";
    avatar.textContent = initialsFor(friendData.username);
    row.appendChild(avatar);

    const info = document.createElement("div");
    info.className = "chat-list-info";
    const nameRow = document.createElement("div");
    nameRow.className = "chat-list-name-row";
    const nameEl = document.createElement("span");
    nameEl.className = "chat-list-name";
    nameEl.textContent = friendData.username;
    nameRow.appendChild(nameEl);
    if (latestPresenceAccountKeys.has(friendAccountKey)) {
      const dot = document.createElement("span");
      dot.className = "chat-list-online-dot";
      nameRow.appendChild(dot);
    }
    info.appendChild(nameRow);

    const preview = document.createElement("div");
    preview.className = "chat-list-preview";
    preview.textContent = "Click to open chat";
    info.appendChild(preview);

    row.appendChild(info);

    // Small "⋮" menu button, click stops propagation so it doesn't also
    // open the chat — reveals Unfriend/Block inline underneath rather than
    // cluttering the row with two always-visible buttons.
    const menuBtn = document.createElement("button");
    menuBtn.textContent = "⋮";
    menuBtn.style.cssText = "background:transparent;border:none;color:#64748b;font-size:18px;cursor:pointer;padding:4px 8px;flex-shrink:0";
    menuBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      actionsRow.style.display = actionsRow.style.display === "flex" ? "none" : "flex";
    });
    row.appendChild(menuBtn);

    wrap.appendChild(row);

    const actionsRow = document.createElement("div");
    actionsRow.className = "person-row-actions";
    actionsRow.style.cssText = "display:none;padding:0 8px 8px 58px";

    const unfriendBtn = document.createElement("button");
    unfriendBtn.className = "danger";
    unfriendBtn.textContent = "Unfriend";
    unfriendBtn.addEventListener("click", async (e) => {
      e.stopPropagation();
      unfriendBtn.disabled = true;
      blockBtn.disabled = true;
      const result = await unfriend(friendAccountKey);
      if (!result.ok) {
        showComposerNotice(result.error);
        unfriendBtn.disabled = false;
        blockBtn.disabled = false;
      }
    });
    actionsRow.appendChild(unfriendBtn);

    const blockBtn = document.createElement("button");
    blockBtn.textContent = "Block";
    blockBtn.addEventListener("click", async (e) => {
      e.stopPropagation();
      unfriendBtn.disabled = true;
      blockBtn.disabled = true;
      const result = await blockUser(friendAccountKey, friendData.username);
      if (!result.ok) {
        showComposerNotice(result.error);
        unfriendBtn.disabled = false;
        blockBtn.disabled = false;
      }
    });
    actionsRow.appendChild(blockBtn);

    wrap.appendChild(actionsRow);
    $friendsList.appendChild(wrap);
  });
}

function renderBlockedList(userData) {
  const blocked = (userData && userData.blockedUsers) || {};
  const entries = Object.entries(blocked);

  $blockedList.innerHTML = "";
  $blockedEmpty.style.display = entries.length === 0 ? "block" : "none";

  entries.forEach(([blockedAccountKey, blockedData]) => {
    const row = document.createElement("div");
    row.className = "person-row";

    const nameWrap = document.createElement("div");
    nameWrap.className = "person-row-name";
    nameWrap.innerHTML = `<span class="pname">${esc(blockedData.username)}</span>`;
    row.appendChild(nameWrap);

    const actions = document.createElement("div");
    actions.className = "person-row-actions";

    const unblockBtn = document.createElement("button");
    unblockBtn.textContent = "Unblock";
    unblockBtn.addEventListener("click", async () => {
      unblockBtn.disabled = true;
      const result = await unblockUser(blockedAccountKey);
      if (!result.ok) {
        showComposerNotice(result.error);
        unblockBtn.disabled = false;
      }
    });
    actions.appendChild(unblockBtn);

    row.appendChild(actions);
    $blockedList.appendChild(row);
  });
}

function renderAllRelationshipUI(userData) {
  renderIncomingRequests(userData);
  renderOutgoingRequests(userData);
  renderFriendsList(userData);
  renderBlockedList(userData);
  updateFindTabDot(userData);
  if (lastSearchResults.length > 0) renderSearchResults(lastSearchResults);
}

$searchBtn.addEventListener("click", async () => {
  const query = $searchInput.value;
  $searchBtn.disabled = true;
  try {
    const results = await performSearch(query);
    renderSearchResults(results);
  } catch (e) {
    showComposerNotice("Search failed — try again.");
  } finally {
    $searchBtn.disabled = false;
  }
});
$searchInput.addEventListener("keydown", e => {
  if (e.key === "Enter") { e.preventDefault(); $searchBtn.click(); }
});

// Small notice helper reused from the group chat app's pattern — shows a
// brief inline message for errors that don't belong in the main authError
// box (e.g. an action failing after the user's already logged in).
let composerNoticeTimer = null;
function showComposerNotice(text) {
  // Reuses the authError element as a lightweight toast-ish notice since
  // there's no separate composer/toolbar in this app yet.
  $authError.textContent = text;
  clearTimeout(composerNoticeTimer);
  composerNoticeTimer = setTimeout(() => { $authError.textContent = ""; }, 4000);
}

function showLoggedInState(session) {
  document.body.classList.add("app-mode");
  $sidebarYouText.textContent = session.username + " · ID " + session.id;
}

function showAuthFlow() {
  document.body.classList.remove("app-mode");
  $authFlow.style.display = "block";
}

$sidebarLogoutBtn.addEventListener("click", () => {
  releasePresence();
  unwatchOwnAccount(currentSession && currentSession.accountKey);
  stopWatchingOpenChat();
  currentSession = null;
  clearSession();
  showAuthFlow();
  setMode("login");
  $loginIdentifier.value = "";
  $loginPassword.value = "";
});

$newIdContinueBtn.addEventListener("click", () => {
  $newIdReveal.style.display = "none";
  $authForm.style.display = "flex";
  $authForm.style.flexDirection = "column";
  $authForm.style.gap = "12px";
  setMode("login");
});

$authForm.addEventListener("submit", async (e) => {
  e.preventDefault();
  $authError.textContent = "";
  $authSuccess.style.display = "none";
  $authSubmitBtn.disabled = true;

  try {
    if (mode === "login") {
      const identifier = $loginIdentifier.value;
      const password = $loginPassword.value;
      const result = await login(identifier, password);
      if (!result.ok) {
        $authError.textContent = result.error;
        return;
      }
      saveSession(result.accountKey, result.username, result.id);
      currentSession = result;
      claimPresence(result.accountKey, result.username);
      watchOwnAccount(result.accountKey, renderAllRelationshipUI);
      showLoggedInState(result);
    } else {
      const username = $signupUsername.value;
      const password = $signupPassword.value;
      const confirm = $signupPasswordConfirm.value;

      if (password !== confirm) {
        $authError.textContent = "Passwords don't match.";
        return;
      }

      const result = await createAccount(username, password);
      if (!result.ok) {
        $authError.textContent = result.error;
        return;
      }

      // Show the new ID clearly before dropping them into login.
      $authForm.style.display = "none";
      $revealedId.textContent = result.id;
      $newIdReveal.style.display = "block";

      // Pre-fill login fields so continuing is one click away.
      $loginIdentifier.value = result.username;
      $loginPassword.value = "";

      // Clear signup fields for next time.
      $signupUsername.value = "";
      $signupPassword.value = "";
      $signupPasswordConfirm.value = "";
    }
  } catch (e) {
    console.error("Auth error:", e);
    $authError.textContent = "Error: " + (e && e.message ? e.message : String(e));
  } finally {
    $authSubmitBtn.disabled = false;
  }
});

/* ══════════════════════════════════════════════════════════
   CHAT THREAD UI — opening a friend's thread, rendering messages,
   sending from the composer.
   ══════════════════════════════════════════════════════════ */
let openChatAccountKey = null;
let openChatUsername = null;
let chatMessageCount = 0;

function updateChatThreadHeaderStatus() {
  if (!openChatAccountKey) return;
  const isOnline = latestPresenceAccountKeys.has(openChatAccountKey);
  $chatThreadHeaderStatus.textContent = isOnline ? "Online" : "Offline";
}

function renderChatMessage(msg) {
  const el = document.createElement("div");
  const mine = msg.fromAccountKey === currentSession.accountKey;
  el.className = "chat-msg " + (mine ? "mine" : "theirs");

  const bubble = document.createElement("div");
  bubble.className = "chat-msg-bubble";
  bubble.textContent = msg.text;
  el.appendChild(bubble);

  const meta = document.createElement("div");
  meta.className = "chat-msg-meta";
  meta.textContent = msg.ts ? new Date(msg.ts).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }) : "";
  el.appendChild(meta);

  $chatMessages.appendChild(el);
  chatMessageCount++;
  requestAnimationFrame(() => { $chatMessages.scrollTop = $chatMessages.scrollHeight; });
}

function openChatWith(accountKey, username) {
  openChatAccountKey = accountKey;
  openChatUsername = username;
  chatMessageCount = 0;

  $chatEmptyState.style.display = "none";
  $chatThread.style.display = "flex";
  $chatThreadAvatar.textContent = initialsFor(username);
  $chatThreadHeaderName.textContent = username;
  updateChatThreadHeaderStatus();

  $chatMessages.innerHTML = "";
  watchThreadMessages(accountKey, renderChatMessage);

  // Re-render the friend list so the "selected" highlight moves to this row.
  if (currentUserData) renderFriendsList(currentUserData);

  if (!isSpectatorLikeInput()) $chatMsgInput.focus();
}

function isSpectatorLikeInput() {
  return false; // placeholder hook in case a read-only/spectator mode is added later
}

function sendChatMessage() {
  if (!openChatAccountKey) return;
  const text = $chatMsgInput.value;
  if (!text.trim()) return;

  $chatSendBtn.disabled = true;
  sendDirectMessage(openChatAccountKey, text).then(result => {
    if (!result.ok) {
      showComposerNotice(result.error);
    } else {
      $chatMsgInput.value = "";
      autosizeChatInput();
    }
  }).finally(() => {
    $chatSendBtn.disabled = false;
    $chatMsgInput.focus();
  });
}

function autosizeChatInput() {
  $chatMsgInput.style.height = "auto";
  $chatMsgInput.style.height = Math.min($chatMsgInput.scrollHeight, 120) + "px";
}

$chatSendBtn.addEventListener("click", sendChatMessage);
$chatMsgInput.addEventListener("keydown", e => {
  if (e.key === "Enter" && !e.shiftKey) {
    e.preventDefault();
    sendChatMessage();
  }
});
$chatMsgInput.addEventListener("input", autosizeChatInput);

/* ══════════════════════════════════════════════════════════
   SIDEBAR TAB SWITCHING — Chats / Find / Blocked
   ══════════════════════════════════════════════════════════ */
function setSidebarTab(tab) {
  $tabChats.classList.toggle("active", tab === "chats");
  $tabFind.classList.toggle("active", tab === "find");
  $tabBlocked.classList.toggle("active", tab === "blocked");
  $viewChats.classList.toggle("active", tab === "chats");
  $viewFind.classList.toggle("active", tab === "find");
  $viewBlocked.classList.toggle("active", tab === "blocked");
}
$tabChats.addEventListener("click", () => setSidebarTab("chats"));
$tabFind.addEventListener("click", () => setSidebarTab("find"));
$tabBlocked.addEventListener("click", () => setSidebarTab("blocked"));

// Small red dot on the Find tab when there's something worth noticing
// there (an incoming request) and the person isn't already looking at
// that tab — mirrors the count badges already shown inside the panel
// itself, just visible from the Chats view too.
function updateFindTabDot(userData) {
  const incoming = (userData && userData.friendRequestsIncoming) || {};
  const visibleCount = Object.values(incoming).filter(r => !r.hidden).length;
  $findTabDot.classList.toggle("show", visibleCount > 0);
}

function init() {
  const usingPlaceholderConfig = FIREBASE_CONFIG.apiKey === "PASTE_YOUR_API_KEY_HERE";
  if (usingPlaceholderConfig) {
    document.getElementById("authCard").innerHTML = `
      <h2>Not set up yet</h2>
      <p style="color:#94a3b8;font-size:14px;line-height:1.5;margin-top:8px">
        Fill in FIREBASE_CONFIG near the top of the script with your own
        Firebase project's values before this will work.
      </p>
    `;
    return;
  }

  try {
    initFirebase();
  } catch (e) {
    document.getElementById("authCard").innerHTML =
      `<h2>Couldn't connect</h2><p style="color:#94a3b8;font-size:14px">${(e.message || "Unknown error")}</p>`;
    return;
  }

  const session = loadSession();
  if (session && session.accountKey) {
    currentSession = session;
    claimPresence(session.accountKey, session.username);
    watchOwnAccount(session.accountKey, renderAllRelationshipUI);
    showLoggedInState(session);
  } else {
    showAuthFlow();
    setMode("login");
  }

  // Presence list is watched regardless of login state so the panel is
  // ready the instant showLoggedInState() reveals it, and stays live
  // afterward without needing to be re-subscribed.
  watchPresenceList(renderOnlineList);

  window.addEventListener("beforeunload", () => {
    releasePresence();
  });
}

init();
</script>
