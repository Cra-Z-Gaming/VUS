<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>VUS DM's</title>
</head>
<body>


<div id="appShell">
  <div id="rail">
    <button id="railAvatarBtn" title="Profile"></button>
    <button class="rail-nav-btn active" id="navChats" title="Chats">💬</button>
    <button class="rail-nav-btn" id="navFind" title="Find people">🔍<span class="rail-dot" id="findRailDot"></span></button>
    <button class="rail-nav-btn" id="navBlocked" title="Blocked">⊘</button>
    <button id="railSettingsBtn" title="Settings">⚙</button>
  </div>

  <div id="profilePopover">
    <div class="profile-popover-avatar-wrap">
      <button id="profileAvatarPreviewBtn" title="Change photo">
        <span class="avatar-cam-badge">📷</span>
      </button>
      <input id="profileAvatarFileInput" type="file" accept="image/*">
      <div class="profile-popover-hint">Click to change photo</div>
      <div class="profile-popover-field">
        <label for="profileNameInput">Display name</label>
        <input type="text" id="profileNameInput" maxlength="24">
      </div>
      <button id="profileSaveBtn">Save</button>
      <div id="profilePopoverError"></div>
    </div>
  </div>

  <div id="listPane">
    <div id="listPaneHeader">
      <div id="listPaneYouName"></div>
      <div id="listPaneYouId"></div>
    </div>
    <div id="listPaneBody">

      <div class="list-view active" id="viewChats">
        <div class="list-new-group-row" id="newGroupBtn">+ New group</div>
        <div class="list-section-label">Groups</div>
        <div id="groupsList"></div>
        <div id="groupsEmpty" class="list-empty" style="padding-left:14px">No groups yet.</div>
        <div class="list-section-label">Friends</div>
        <div id="friendsList"></div>
        <div id="friendsEmpty" class="list-empty" style="padding-left:14px">No friends yet — use Find to add someone.</div>
      </div>

      <div class="list-view" id="viewFind">
        <div class="list-section">
          <div class="list-section-title">Find people</div>
          <div class="list-search-row">
            <input type="text" id="searchInput" placeholder="Username or 6-digit ID…" maxlength="24">
            <button id="searchBtn">Go</button>
          </div>
          <div class="list-search-note">Matches the start of a username, or an exact 6-digit ID.</div>
          <div id="searchResults"></div>
          <div id="searchEmpty" class="list-empty" style="display:none">No results.</div>
        </div>

        <div class="list-section">
          <div class="list-section-title">
            <span>Friend requests</span>
            <span class="count-badge" id="incomingCountBadge" style="display:none"></span>
          </div>
          <div id="incomingRequestsList"></div>
          <div id="incomingRequestsEmpty" class="list-empty">No incoming requests.</div>
        </div>

        <div class="list-section">
          <div class="list-section-title">
            <span>Hidden requests</span>
            <span class="count-badge" id="hiddenCountBadge" style="display:none"></span>
          </div>
          <div class="list-search-note">Requests from people you've blocked land here instead.</div>
          <div id="hiddenRequestsList"></div>
          <div id="hiddenRequestsEmpty" class="list-empty">No hidden requests.</div>
        </div>

        <div class="list-section">
          <div class="list-section-title">Sent requests</div>
          <div id="outgoingRequestsList"></div>
          <div id="outgoingRequestsEmpty" class="list-empty">No pending sent requests.</div>
        </div>

        <div class="list-section">
          <div class="list-section-title">
            <span>Online now</span>
            <span id="onlineCountText" style="font-size:10.5px;color:#475569;font-family:ui-monospace,Consolas,monospace"></span>
          </div>
          <div id="onlineList"></div>
          <div id="onlineEmpty" style="display:none" class="list-empty">No one else online right now.</div>
        </div>
      </div>

      <div class="list-view" id="viewBlocked">
        <div class="list-section">
          <div class="list-section-title">Blocked</div>
          <div id="blockedList"></div>
          <div id="blockedEmpty" class="list-empty">No one blocked.</div>
        </div>
      </div>

    </div>
  </div>

  <div id="chatPane">
    <div id="chatEmptyState">Select a friend to start chatting.</div>
    <div id="chatThread">
      <div id="chatThreadHeader">
        <button id="chatBackBtn">←</button>
        <div class="list-row-presence-wrap">
          <div class="list-row-avatar" id="chatThreadAvatar"></div>
          <div class="list-row-presence-dot" id="chatThreadPresenceBadge"></div>
        </div>
        <div>
          <div id="chatThreadHeaderName"></div>
          <div id="chatThreadHeaderStatus"></div>
        </div>
        <button id="groupInfoBtn" style="display:none">Manage</button>
      </div>
      <div id="chatMessages"></div>
      <div id="typingIndicatorBar"></div>
      <div id="replyPreviewBar">
        <div class="reply-preview-text" id="replyPreviewText"></div>
        <button id="cancelReplyBtn" title="Cancel reply">✕</button>
      </div>
      <div id="editingBar">
        <div class="editing-label">Editing message…</div>
        <button id="cancelEditBtn" title="Cancel edit">✕</button>
      </div>
      <div id="pendingImageBar">
        <img id="pendingImagePreview" alt="Pending image">
        <span class="pending-image-label">Image ready — click Send to post it</span>
        <button id="cancelPendingImageBtn">Cancel</button>
      </div>
      <div id="chatComposer">
        <input id="imageFileInput" type="file" accept="image/*" style="display:none">
        <button id="uploadImageBtn" title="Send an image">📎</button>
        <button id="emojiPickerBtn" title="Insert emoji">🙂</button>
        <div id="emojiPickerPopover"></div>
        <textarea id="chatMsgInput" rows="1" placeholder="Message…" maxlength="2000"></textarea>
        <button id="chatSendBtn">SEND</button>
      </div>
    </div>
  </div>
</div>

<div id="authCard">

  <div id="authFlow">
    <div id="authHeader">
      <h1>VUS DM's</h1>
      <p>Log in or create an account to start messaging.</p>
    </div>

    <div class="auth-tabs">
      <button class="auth-tab active" id="tabLogin">Log In</button>
      <button class="auth-tab" id="tabSignup">Sign Up</button>
    </div>

    <div id="newIdReveal">
      <div class="id-label">Your account ID</div>
      <div class="id-value" id="revealedId"></div>
      <div class="id-note">Save this — you (or friends) can use it to log in or add you. You can change it later in settings.</div>
      <button id="newIdContinueBtn">Continue to Log In</button>
    </div>

    <form id="authForm" autocomplete="off">
      <div id="loginFields" style="display:flex;flex-direction:column;gap:12px">
        <div class="auth-field">
          <label for="loginIdentifier">Username or ID</label>
          <input type="text" id="loginIdentifier" placeholder="e.g. alex or 384021" maxlength="24">
        </div>
        <div class="auth-field">
          <label for="loginPassword">Password</label>
          <input type="password" id="loginPassword" placeholder="Password">
        </div>
      </div>

      <div id="signupFields" style="display:none;flex-direction:column;gap:12px">
        <div class="auth-field">
          <label for="signupUsername">Username</label>
          <input type="text" id="signupUsername" placeholder="Pick a username" maxlength="24" autocomplete="off">
          <div class="auth-hint">Letters, numbers, underscores. Must be unique.</div>
        </div>
        <div class="auth-field">
          <label for="signupEmail">Email</label>
          <input type="email" id="signupEmail" placeholder="you@example.com" autocomplete="email" required>
          <div class="auth-hint">One account per email address.</div>
        </div>
        <div class="auth-field">
          <label for="signupPassword">Password</label>
          <input type="password" id="signupPassword" placeholder="Choose a password" autocomplete="new-password">
        </div>
        <div class="auth-field">
          <label for="signupPasswordConfirm">Confirm password</label>
          <input type="password" id="signupPasswordConfirm" placeholder="Retype your password" autocomplete="new-password">
        </div>
      </div>

      <div id="authError"></div>
      <div id="authSuccess"></div>

      <button type="submit" id="authSubmitBtn">Log In</button>
    </form>
  </div>

</div>

<div id="modalOverlay">
  <div class="modal-box" id="modalBox"></div>
</div>

<div id="imageLightbox">
  <img id="imageLightboxImg" alt="Full size image">
</div>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script>
/* ══════════════════════════════════════════════════════════
   EXTERNAL FILE LOADER
   raw.githubusercontent.com serves everything as Content-Type:
   text/plain, so a plain <link rel="stylesheet"> or <script src>
   pointed at it gets silently blocked by the browser's strict
   MIME-type check. Instead we fetch the raw text ourselves and
   inject it: CSS goes into a <style> tag, JS gets wrapped in a
   Blob URL (so it still shows up as a real file in devtools,
   unlike eval/new Function) and loaded as a normal <script src>.
   ══════════════════════════════════════════════════════════ */
(function loadExternalAppFiles() {
  var CSS_URL = "https://raw.githubusercontent.com/Cra-Z-Gaming/VUS/refs/heads/main/other/vusdm/style.css";
  var JS_URL  = "https://raw.githubusercontent.com/Cra-Z-Gaming/VUS/refs/heads/main/other/vusdm/app.js";

  function showLoadError(what, err) {
    document.body.innerHTML =
      "<div style='padding:24px;color:#f1f5f9;font-family:Arial,sans-serif;background:#0f172a;min-height:100vh'>" +
      "<h2>Couldn't load " + what + "</h2>" +
      "<p style='color:#94a3b8;font-size:14px;margin-top:8px;line-height:1.5'>" +
      (err && err.message ? err.message : String(err)) +
      "<br><br>Check that the file exists at the expected GitHub path and the repo/branch is public." +
      "</p></div>";
  }

  function loadCss() {
    return fetch(CSS_URL, { cache: "no-store" })
      .then(function (r) {
        if (!r.ok) throw new Error("HTTP " + r.status + " fetching style.css");
        return r.text();
      })
      .then(function (cssText) {
        var styleEl = document.createElement("style");
        styleEl.textContent = cssText;
        document.head.appendChild(styleEl);
      });
  }

  function loadJs() {
    return fetch(JS_URL, { cache: "no-store" })
      .then(function (r) {
        if (!r.ok) throw new Error("HTTP " + r.status + " fetching app.js");
        return r.text();
      })
      .then(function (jsText) {
        var blob = new Blob([jsText], { type: "application/javascript" });
        var blobUrl = URL.createObjectURL(blob);
        return new Promise(function (resolve, reject) {
          var scriptEl = document.createElement("script");
          scriptEl.src = blobUrl;
          scriptEl.onload = resolve;
          scriptEl.onerror = function () { reject(new Error("Blob script failed to execute — check app.js for syntax errors.")); };
          document.body.appendChild(scriptEl);
        });
      });
  }

  loadCss()
    .catch(function (err) { showLoadError("styles (style.css)", err); throw err; })
    .then(loadJs)
    .catch(function (err) {
      // If loadCss already threw and displayed its own error, don't
      // stomp the message with a second, less specific one.
      if (!document.body.querySelector("h2")) showLoadError("app logic (app.js)", err);
    });
})();
</script>
</body>
</html>
