<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VUS DM's</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    background: #0f172a;
    color: #f1f5f9;
    font-family: Arial, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  body.app-mode {
    align-items: stretch;
    justify-content: stretch;
  }
  body.app-mode #authCard { display: none; }
  #authCard {
    padding: 24px;
    width: 100%;
    max-width: 320px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #authHeader {
    text-align: center;
    margin-bottom: 6px;
  }
  #authHeader h1 {
    font-size: 22px;
    font-weight: 600;
  }
  #authHeader p {
    font-size: 13.5px;
    color: #94a3b8;
    margin-top: 4px;
    line-height: 1.4;
  }
  .auth-tabs {
    display: flex;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 10px;
    padding: 3px;
    margin-bottom: 6px;
  }
  .auth-tab {
    flex: 1;
    padding: 8px;
    text-align: center;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #94a3b8;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .auth-tab.active {
    background: #22c55e;
    color: #000;
  }
  .auth-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .auth-field label {
    font-size: 12.5px;
    color: #94a3b8;
  }
  .auth-field input {
    width: 100%;
    padding: 10px 13px;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 9px;
    color: #f1f5f9;
    font-size: 15px;
    outline: none;
  }
  .auth-field input:focus { border-color: #22c55e; }
  .auth-hint {
    font-size: 12px;
    color: #64748b;
    margin-top: -2px;
  }
  #authError {
    font-size: 13px;
    color: #ef4444;
    min-height: 18px;
    line-height: 1.4;
  }
  #authSuccess {
    font-size: 13px;
    color: #4ade80;
    min-height: 18px;
    line-height: 1.4;
    display: none;
  }
  #authSubmitBtn {
    width: 100%;
    padding: 11px 13px;
    background: #22c55e;
    border: none;
    border-radius: 9px;
    color: #000;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 4px;
  }
  #authSubmitBtn:hover { background: #4ade80; }
  #authSubmitBtn:disabled { opacity: .5; cursor: not-allowed; }

  #newIdReveal {
    display: none;
    background: #1e293b;
    border: 1.5px solid #22c55e;
    border-radius: 10px;
    padding: 14px;
    text-align: center;
  }
  #newIdReveal .id-label {
    font-size: 12.5px;
    color: #94a3b8;
    margin-bottom: 4px;
  }
  #newIdReveal .id-value {
    font-size: 28px;
    font-weight: 700;
    color: #4ade80;
    letter-spacing: 2px;
    font-family: monospace;
  }
  #newIdReveal .id-note {
    font-size: 12px;
    color: #64748b;
    margin-top: 6px;
    line-height: 1.4;
  }
  #newIdReveal button {
    margin-top: 10px;
    width: 100%;
    padding: 9px;
    background: #22c55e;
    border: none;
    border-radius: 9px;
    color: #000;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
  }

  #loggedInCard {
    display: none;
    text-align: center;
  }
  #loggedInCard h2 { font-size: 19px; margin-bottom: 8px; }
  #loggedInCard p { font-size: 14px; color: #94a3b8; margin-bottom: 4px; }
  #loggedInCard .li-id { font-family: monospace; color: #4ade80; }
  #logoutBtn {
    margin-top: 14px;
    width: 100%;
    padding: 10px;
    background: transparent;
    border: 1.5px solid #334155;
    border-radius: 9px;
    color: #94a3b8;
    font-size: 14px;
    cursor: pointer;
  }
  #logoutBtn:hover { color: #f1f5f9; border-color: #475569; }

  #onlinePanel {
    margin-top: 18px;
    text-align: left;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 10px;
    padding: 14px;
  }
  #onlinePanelHeader {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  #onlineDotIndicator {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
  }
  #onlineList {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 200px;
    overflow-y: auto;
  }
  .online-list-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    color: #f1f5f9;
  }
  .online-list-row .you-tag {
    color: #64748b;
    font-size: 12px;
  }
  .online-list-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }
  #onlineEmpty {
    font-size: 13px;
    color: #64748b;
  }

  .app-section {
    margin-top: 18px;
    text-align: left;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 10px;
    padding: 14px;
  }
  .app-section-title {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .app-section-title .count-badge {
    font-size: 12px;
    color: #4ade80;
    background: rgba(34,197,94,.12);
    border-radius: 6px;
    padding: 1px 7px;
  }
  .search-row {
    display: flex;
    gap: 8px;
    margin-bottom: 10px;
  }
  .search-row input {
    flex: 1;
    padding: 9px 12px;
    background: #0f172a;
    border: 1.5px solid #334155;
    border-radius: 8px;
    color: #f1f5f9;
    font-size: 14px;
    outline: none;
  }
  .search-row input:focus { border-color: #22c55e; }
  .search-row button {
    padding: 9px 14px;
    background: #22c55e;
    border: none;
    border-radius: 8px;
    color: #000;
    font-weight: 600;
    font-size: 13.5px;
    cursor: pointer;
  }
  .search-row button:hover { background: #4ade80; }
  .search-row button:disabled { opacity: .5; cursor: not-allowed; }

  .person-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid #273549;
    font-size: 13.5px;
  }
  .person-row:last-child { border-bottom: none; }
  .person-row-name {
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
  }
  .person-row-name .pname { color: #f1f5f9; font-weight: 600; }
  .person-row-name .pid { color: #64748b; font-size: 11.5px; font-family: monospace; }
  .person-row-actions {
    display: flex;
    gap: 6px;
    flex-shrink: 0;
  }
  .person-row-actions button {
    background: transparent;
    border: 1.5px solid #334155;
    color: #94a3b8;
    font-size: 12px;
    padding: 5px 10px;
    border-radius: 7px;
    cursor: pointer;
  }
  .person-row-actions button:hover { color: #f1f5f9; border-color: #475569; }
  .person-row-actions button.primary {
    background: #22c55e;
    border-color: #22c55e;
    color: #000;
    font-weight: 600;
  }
  .person-row-actions button.primary:hover { background: #4ade80; }
  .person-row-actions button.danger {
    border-color: #7f1d1d;
    color: #f87171;
  }
  .person-row-actions button.danger:hover { background: rgba(239,68,68,.1); }
  .person-row-actions button:disabled {
    opacity: .5;
    cursor: not-allowed;
  }
  .section-empty {
    font-size: 13px;
    color: #64748b;
    padding: 4px 0;
  }
  .search-note {
    font-size: 11.5px;
    color: #64748b;
    margin-top: -4px;
    margin-bottom: 10px;
    line-height: 1.4;
  }

  /* ══════════════════════════════════════════════════════════
     APP SHELL — side-by-side sidebar + chat pane, Telegram-style
     layout (structure only; palette matches the rest of the app).
     ══════════════════════════════════════════════════════════ */
  #appShell {
    display: none;
    width: 100%;
    height: 100vh;
  }
  body.app-mode #appShell { display: flex; }

  #sidebar {
    width: 340px;
    min-width: 260px;
    max-width: 400px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: #111827;
    border-right: 1.5px solid #1f2937;
  }
  #sidebarHeader {
    padding: 14px 16px;
    border-bottom: 1.5px solid #1f2937;
    flex-shrink: 0;
  }
  #sidebarHeaderTop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  #sidebarHeaderTop .app-title { font-size: 17px; font-weight: 700; }
  #sidebarYouLine {
    font-size: 12.5px;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  #sidebarOnlineDot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #22c55e;
    display: inline-block;
  }
  #sidebarLogoutBtn {
    background: transparent;
    border: 1.5px solid #334155;
    color: #94a3b8;
    font-size: 12.5px;
    padding: 4px 10px;
    border-radius: 8px;
    cursor: pointer;
  }
  #sidebarLogoutBtn:hover { color: #f1f5f9; border-color: #475569; }

  .sidebar-tabs {
    display: flex;
    gap: 4px;
  }
  .sidebar-tab {
    flex: 1;
    padding: 7px 4px;
    text-align: center;
    background: transparent;
    border: 1.5px solid #334155;
    border-radius: 8px;
    color: #94a3b8;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    position: relative;
  }
  .sidebar-tab.active {
    background: #22c55e;
    border-color: #22c55e;
    color: #000;
  }
  .sidebar-tab .tab-dot {
    position: absolute;
    top: -3px; right: -3px;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #ef4444;
    display: none;
  }
  .sidebar-tab .tab-dot.show { display: block; }

  #sidebarBody {
    flex: 1;
    overflow-y: auto;
    padding: 10px;
  }
  #sidebarBody .app-section {
    margin-top: 0;
    margin-bottom: 14px;
  }
  #sidebarBody .app-section:last-child { margin-bottom: 0; }

  .sidebar-view { display: none; }
  .sidebar-view.active { display: block; }

  .chat-list-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 8px;
    border-radius: 10px;
    cursor: pointer;
  }
  .chat-list-row:hover { background: #1e293b; }
  .chat-list-row.selected { background: rgba(34,197,94,.12); }
  .chat-list-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #334155;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 15px;
    color: #f1f5f9;
    flex-shrink: 0;
  }
  .chat-list-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .chat-list-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }
  .chat-list-name {
    font-size: 14.5px;
    font-weight: 600;
    color: #f1f5f9;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .chat-list-online-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }
  .chat-list-preview {
    font-size: 12.5px;
    color: #64748b;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #chatPane {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  #chatEmptyState {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #475569;
    font-size: 16px;
    text-align: center;
    padding: 30px;
  }
  #chatThread {
    display: none;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }
  #chatThreadHeader {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-bottom: 1.5px solid #1f2937;
    flex-shrink: 0;
  }
  #chatThreadHeader .chat-list-avatar {
    width: 34px; height: 34px; font-size: 13px;
  }
  #chatThreadHeaderName { font-size: 15px; font-weight: 600; }
  #chatThreadHeaderStatus { font-size: 12px; color: #64748b; }

  #chatMessages {
    flex: 1;
    overflow-y: auto;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .chat-msg {
    max-width: 70%;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .chat-msg.mine { align-self: flex-end; align-items: flex-end; }
  .chat-msg.theirs { align-self: flex-start; align-items: flex-start; }
  .chat-msg-bubble {
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 15px;
    padding: 10px 14px;
    font-size: 15px;
    line-height: 1.4;
    word-break: break-word;
    white-space: pre-wrap;
  }
  .chat-msg.mine .chat-msg-bubble {
    background: #14532d;
    border-color: #166534;
  }
  .chat-msg-meta {
    font-size: 11px;
    color: #64748b;
    padding: 0 4px;
  }

  #chatComposer {
    display: flex;
    gap: 10px;
    padding: 14px 18px;
    border-top: 1.5px solid #1f2937;
    flex-shrink: 0;
  }
  #chatMsgInput {
    flex: 1;
    padding: 10px 14px;
    background: #1e293b;
    border: 1.5px solid #334155;
    border-radius: 12px;
    color: #f1f5f9;
    font-size: 15px;
    outline: none;
    resize: none;
    max-height: 120px;
    font-family: inherit;
  }
  #chatMsgInput:focus { border-color: #22c55e; }
  #chatSendBtn {
    padding: 0 22px;
    background: #22c55e;
    border: none;
    border-radius: 12px;
    color: #000;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }
  #chatSendBtn:hover { background: #4ade80; }
  #chatSendBtn:disabled { opacity: .5; cursor: not-allowed; }
</style>
</head>
<body>

<div id="appShell">
  <div id="sidebar">
    <div id="sidebarHeader">
      <div id="sidebarHeaderTop">
        <span class="app-title">VUS DM's</span>
        <button id="sidebarLogoutBtn">Log out</button>
      </div>
      <div id="sidebarYouLine">
        <span id="sidebarOnlineDot"></span>
        <span id="sidebarYouText"></span>
      </div>
      <div class="sidebar-tabs" style="margin-top:10px">
        <button class="sidebar-tab active" id="tabChats">Chats</button>
        <button class="sidebar-tab" id="tabFind">Find<span class="tab-dot" id="findTabDot"></span></button>
        <button class="sidebar-tab" id="tabBlocked">Blocked</button>
      </div>
    </div>

    <div id="sidebarBody">

      <div class="sidebar-view active" id="viewChats">
        <div id="friendsList"></div>
        <div id="friendsEmpty" class="section-empty">No friends yet — use Find to add someone.</div>
      </div>

      <div class="sidebar-view" id="viewFind">
        <div class="app-section">
          <div class="app-section-title">Find people</div>
          <div class="search-row">
            <input type="text" id="searchInput" placeholder="Username or 6-digit ID…" maxlength="24">
            <button id="searchBtn">Search</button>
          </div>
          <div class="search-note">Matches the start of a username, or an exact 6-digit ID. Blocking controls whether requests reach you, not whether you can be found.</div>
          <div id="searchResults"></div>
          <div id="searchEmpty" class="section-empty" style="display:none">No results.</div>
        </div>

        <div class="app-section">
          <div class="app-section-title">
            <span>Friend requests</span>
            <span class="count-badge" id="incomingCountBadge" style="display:none"></span>
          </div>
          <div id="incomingRequestsList"></div>
          <div id="incomingRequestsEmpty" class="section-empty">No incoming requests.</div>
        </div>

        <div class="app-section">
          <div class="app-section-title">
            <span>Hidden requests</span>
            <span class="count-badge" id="hiddenCountBadge" style="display:none"></span>
          </div>
          <div class="search-note">Requests from people you've blocked land here instead.</div>
          <div id="hiddenRequestsList"></div>
          <div id="hiddenRequestsEmpty" class="section-empty">No hidden requests.</div>
        </div>

        <div class="app-section">
          <div class="app-section-title">Sent requests</div>
          <div id="outgoingRequestsList"></div>
          <div id="outgoingRequestsEmpty" class="section-empty">No pending sent requests.</div>
        </div>

        <div class="app-section">
          <div class="app-section-title">
            <span>Online now</span>
            <span id="onlineCountText" style="font-size:12px;color:#64748b"></span>
          </div>
          <div id="onlineList"></div>
          <div id="onlineEmpty" style="display:none">No one else online right now.</div>
        </div>
      </div>

      <div class="sidebar-view" id="viewBlocked">
        <div class="app-section">
          <div class="app-section-title">Blocked</div>
          <div id="blockedList"></div>
          <div id="blockedEmpty" class="section-empty">No one blocked.</div>
        </div>
      </div>

    </div>
  </div>

  <div id="chatPane">
    <div id="chatEmptyState">Select a friend to start chatting.</div>
    <div id="chatThread">
      <div id="chatThreadHeader">
        <div class="chat-list-avatar" id="chatThreadAvatar"></div>
        <div>
          <div id="chatThreadHeaderName"></div>
          <div id="chatThreadHeaderStatus"></div>
        </div>
      </div>
      <div id="chatMessages"></div>
      <div id="chatComposer">
        <textarea id="chatMsgInput" rows="1" placeholder="Type a message…" maxlength="2000"></textarea>
        <button id="chatSendBtn">Send</button>
      </div>
    </div>
  </div>
</div>

<div id="authCard">

  <div id="authFlow">
    <div id="authHeader">
      <h1>VUS DM's</h1>
      <p>Log in or create an account to start messaging.</p>
    </div>

    <div class="auth-tabs">
      <button class="auth-tab active" id="tabLogin">Log In</button>
      <button class="auth-tab" id="tabSignup">Sign Up</button>
    </div>

    <div id="newIdReveal">
      <div class="id-label">Your account ID</div>
      <div class="id-value" id="revealedId"></div>
      <div class="id-note">Save this — you (or friends) can use it to log in or add you. You can change it later in settings.</div>
      <button id="newIdContinueBtn">Continue to Log In</button>
    </div>

    <form id="authForm" autocomplete="off">
      <div id="loginFields" style="display:flex;flex-direction:column;gap:12px">
        <div class="auth-field">
          <label for="loginIdentifier">Username or ID</label>
          <input type="text" id="loginIdentifier" placeholder="e.g. alex or 384021" maxlength="24">
        </div>
        <div class="auth-field">
          <label for="loginPassword">Password</label>
          <input type="password" id="loginPassword" placeholder="Password">
        </div>
      </div>

      <div id="signupFields" style="display:none;flex-direction:column;gap:12px">
        <div class="auth-field">
          <label for="signupUsername">Username</label>
          <input type="text" id="signupUsername" placeholder="Pick a username" maxlength="24" autocomplete="off">
          <div class="auth-hint">Letters, numbers, underscores. Must be unique.</div>
        </div>
        <div class="auth-field">
          <label for="signupPassword">Password</label>
          <input type="password" id="signupPassword" placeholder="Choose a password" autocomplete="new-password">
        </div>
        <div class="auth-field">
          <label for="signupPasswordConfirm">Confirm password</label>
          <input type="password" id="signupPasswordConfirm" placeholder="Retype your password" autocomplete="new-password">
        </div>
      </div>

      <div id="authError"></div>
      <div id="authSuccess"></div>

      <button type="submit" id="authSubmitBtn">Log In</button>
    </form>
  </div>

</div>

<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script>
/* ══════════════════════════════════════════════════════════
   FIREBASE CONFIG
   Same project pattern as the group chat app. Fill in your own
   values below. This app does NOT use Firebase Authentication —
   accounts (username, 6-digit ID, password) are plain records in
   Realtime Database. See the note above AuthBackend for why, and
   what that does and doesn't protect against.
   ══════════════════════════════════════════════════════════ */
const FIREBASE_CONFIG = {
  apiKey: "AIzaSyC_cxqIYzFcQ8nVTo679JuVEgIZDAyrPEQ",
  authDomain: "vus-dm.firebaseapp.com",
  databaseURL: "https://vus-dm-default-rtdb.firebaseio.com",
  projectId: "vus-dm",
  storageBucket: "vus-dm.firebasestorage.app",
