<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Movie Links</title>

    <style>
        body {
            margin: 0;
            padding: 20px;
            background: #111;
            color: white;
            font-family: Arial, sans-serif;
        }

        #refreshBtn {
            width: 100%;
            padding: 14px;
            margin-bottom: 10px;
            border: none;
            border-radius: 8px;
            background: #333;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        #refreshBtn:hover {
            background: #444;
        }

        #search {
            width: 100%;
            box-sizing: border-box;
            padding: 14px;
            margin-bottom: 15px;
            border: none;
            border-radius: 8px;
            background: #222;
            color: white;
            font-size: 15px;
            outline: none;
        }

        #search:focus {
            background: #292929;
        }

        #search::placeholder {
            color: #888;
        }

        #movies {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 10px;
        }

        .movie-btn {
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #222;
            color: white;
            text-align: left;
            font-size: 15px;
            cursor: pointer;
            transition: background 0.15s;
        }

        .movie-btn:hover {
            background: #333;
        }

        #status {
            margin-bottom: 15px;
            color: #aaa;
            font-size: 14px;
        }
    </style>
</head>

<body>

    <button id="refreshBtn">↻ Refresh Movies</button>

    <input
        type="text"
        id="search"
        placeholder="Search movies..."
        autocomplete="off"
    >

    <div id="status">Loading...</div>
    <div id="movies"></div>

    <script>
        const MOVIE_URL =
            "https://raw.githubusercontent.com/Cra-Z-Gaming/VUS/refs/heads/main/Movie-Links";

        const moviesContainer = document.getElementById("movies");
        const status = document.getElementById("status");
        const refreshBtn = document.getElementById("refreshBtn");
        const search = document.getElementById("search");

        async function loadMovies() {
            status.textContent = "Checking for movies...";
            refreshBtn.disabled = true;

            try {
                const response = await fetch(
                    MOVIE_URL + "?t=" + Date.now()
                );

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const text = await response.text();

                const lines = text
                    .split(/\r?\n/)
                    .map(line => line.trim())
                    .filter(Boolean);

                moviesContainer.innerHTML = "";

                for (const line of lines) {
                    const separator = line.indexOf(" — ");

                    if (separator === -1) {
                        continue;
                    }

                    const name = line.slice(0, separator).trim();
                    const url = line.slice(separator + 3).trim();

                    if (!name || !url) {
                        continue;
                    }

                    const button = document.createElement("button");
                    button.className = "movie-btn";
                    button.textContent = name;
                    button.dataset.name = name.toLowerCase();

                    button.addEventListener("click", () => {
                        window.open(url, "_blank", "noopener,noreferrer");
                    });

                    moviesContainer.appendChild(button);
                }

                updateSearch();

            } catch (error) {
                console.error(error);

                status.textContent =
                    "Failed to load movies. Check the console.";
            } finally {
                refreshBtn.disabled = false;
            }
        }

        function updateSearch() {
            const query = search.value.toLowerCase().trim();
            let visible = 0;

            document.querySelectorAll(".movie-btn").forEach(button => {
                const matches = button.dataset.name.includes(query);

                button.style.display = matches ? "" : "none";

                if (matches) {
                    visible++;
                }
            });

            const total = moviesContainer.children.length;

            if (query) {
                status.textContent =
                    `${visible} of ${total} movies match "${search.value}"`;
            } else {
                status.textContent =
                    `${total} movies loaded`;
            }
        }

        search.addEventListener("input", updateSearch);
        refreshBtn.addEventListener("click", loadMovies);

        loadMovies();
    </script>

</body>
</html>
