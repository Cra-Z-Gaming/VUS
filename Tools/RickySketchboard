<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ricky's Sketchboard</title>
  <!-- Import Rubik Font -->
  <link rel="preconnect" href="https://googleapis.com">
  <link rel="preconnect" href="https://gstatic.com" crossorigin>
  <link href="https://googleapis.com/css2?family=Rubik:wght@500;700&display=swap" rel="stylesheet">
  
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    body {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: #1e1e24;
      color: #fff;
      padding: 20px;
    }
    .header-title {
      font-family: 'Rubik', sans-serif;
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 15px;
      letter-spacing: 1px;
      color: #fff;
      text-align: center;
    }
    .toolbar {
      display: flex;
      gap: 15px;
      align-items: center;
      background: rgba(255, 255, 255, 0.1);
      padding: 12px 24px;
      border-radius: 50px;
      backdrop-filter: blur(10px);
      margin-bottom: 20px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.3);
      border: 1px solid rgba(255,255,255,0.1);
    }
    .tool {
      background: none;
      border: none;
      color: #fff;
      cursor: pointer;
      padding: 8px 16px;
      border-radius: 20px;
      font-weight: 500;
      font-size: 14px;
      transition: all 0.2s ease;
    }
    .tool:hover, .tool.active {
      background: #fff;
      color: #1e1e24;
    }
    input[type="color"] {
      -webkit-appearance: none;
      border: none;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      cursor: pointer;
      background: none;
    }
    input[type="color"]::-webkit-color-swatch-wrapper {
      padding: 0;
    }
    input[type="color"]::-webkit-color-swatch {
      border: 2px solid #fff;
      border-radius: 50%;
    }
    .range-group {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      opacity: 0.8;
    }
    canvas {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.5);
      cursor: crosshair;
      touch-action: none;
      max-width: 100%;
    }
  </style>
</head>
<body>

  <h1 class="header-title">Ricky's Sketchboard</h1>

  <div class="toolbar">
    <input type="color" id="colorPicker" value="#1e1e24">
    <div class="range-group">
      <span>Size</span>
      <input type="range" id="sizeSlider" min="1" max="50" value="5">
    </div>
    <button class="tool active" id="brushBtn">Brush</button>
    <button class="tool" id="eraserBtn">Eraser</button>
    <button class="tool" id="clearBtn" style="color: #ff6b6b;">Clear</button>
    <button class="tool" id="downloadBtn" style="background: #4cd137; color: #fff;">Download</button>
  </div>

  <canvas id="artboard" width="800" height="500"></canvas>

  <script>
    const canvas = document.getElementById('artboard');
    const ctx = canvas.getContext('2d');
    const colorPicker = document.getElementById('colorPicker');
    const sizeSlider = document.getElementById('sizeSlider');
    const brushBtn = document.getElementById('brushBtn');
    const eraserBtn = document.getElementById('eraserBtn');
    const clearBtn = document.getElementById('clearBtn');
    const downloadBtn = document.getElementById('downloadBtn');

    let drawing = false;
    let isEraser = false;

    // Initialize Canvas Defaults
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';

    // Get accurate mouse/touch coordinates
    function getCoords(e) {
      const rect = canvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      return {
        x: (clientX - rect.left) * (canvas.width / rect.width),
        y: (clientY - rect.top) * (canvas.height / rect.height)
      };
    }

    function startDrawing(e) {
      drawing = true;
      ctx.beginPath();
      const coords = getCoords(e);
      ctx.moveTo(coords.x, coords.y);
    }

    function draw(e) {
      if (!drawing) return;
      e.preventDefault();
      const coords = getCoords(e);
      ctx.lineWidth = sizeSlider.value;
      ctx.strokeStyle = isEraser ? '#FFFFFF' : colorPicker.value;
      ctx.lineTo(coords.x, coords.y);
      ctx.stroke();
    }

    function stopDrawing() {
      drawing = false;
      ctx.closePath();
    }

    // Event Listeners (Mouse & Touch)
    canvas.addEventListener('mousedown', startDrawing);
    canvas.addEventListener('mousemove', draw);
    window.addEventListener('mouseup', stopDrawing);

    canvas.addEventListener('touchstart', startDrawing, { passive: false });
    canvas.addEventListener('touchmove', draw, { passive: false });
    window.addEventListener('touchend', stopDrawing);

    // Toolbar Logic
    brushBtn.addEventListener('click', () => {
      isEraser = false;
      brushBtn.classList.add('active');
      eraserBtn.classList.remove('active');
    });

    eraserBtn.addEventListener('click', () => {
      isEraser = true;
      eraserBtn.classList.add('active');
      brushBtn.classList.remove('active');
    });

    clearBtn.addEventListener('click', () => {
      if(confirm('Clear your artwork?')) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    });

    downloadBtn.addEventListener('click', () => {
      const link = document.createElement('a');
      link.download = 'artwork.png';
      link.href = canvas.toDataURL();
      link.click();
    });
  </script>
</body>
</html>
