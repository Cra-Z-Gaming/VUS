<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Divinity</title>
<style>
:root{--dock:176px;--accent:#fff;--afg:#000;--fg:var(--accent);--mut:color-mix(in srgb,var(--accent) 55%,#000);--mut2:color-mix(in srgb,var(--accent) 80%,#000);--line:color-mix(in srgb,var(--accent) 16%,transparent);--soft:color-mix(in srgb,var(--accent) 7%,transparent);--hov:color-mix(in srgb,var(--accent) 14%,transparent);--panel:#0b0b0b;--field:#141414;--top:34px}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#000;color:var(--fg);font:13px/1.45 var(--ui,-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Inter,system-ui,sans-serif);-webkit-font-smoothing:antialiased}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer;background:none;border:0}
#bg{position:fixed;inset:0;background:#000 center/cover no-repeat;z-index:0}
#snow{position:fixed;inset:0;pointer-events:none;z-index:1}
#desktop{position:fixed;inset:0;z-index:2;display:none}

/* top bar */
.top{position:absolute;left:0;right:0;top:0;height:var(--top);display:flex;align-items:center;justify-content:space-between;padding:0 14px;z-index:30;background:rgba(0,0,0,.35);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.brand{font-weight:600;letter-spacing:.14em;font-size:12px;text-transform:uppercase}
.tr{display:flex;align-items:center;gap:14px}
#who{color:var(--mut);font-size:12px}
.lk{color:var(--mut);font-size:12px}.lk:hover{color:var(--fg)}
#panic{background:#e5282d;color:#fff;font-weight:600;font-size:11px;letter-spacing:.06em;text-transform:uppercase;padding:4px 12px;border-radius:999px}
#panic:hover{background:#ff3b40}

/* dock */
.dock{position:absolute;left:10px;top:calc(var(--top) + 12px);bottom:52px;width:calc(var(--dock) - 10px);display:flex;flex-direction:column;gap:5px;z-index:20}
.dock .sp{flex:1}
.dk{width:100%;height:38px;border-radius:12px;background:var(--soft);border:1px solid var(--line);display:flex;align-items:center;justify-content:flex-start;gap:10px;padding:0 11px;color:var(--fg);position:relative;transition:background .12s;text-align:left}
.dk:hover{background:var(--hov)}
.dk svg{width:20px;height:20px;flex:none;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
.dk .lb{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.dk.on::before{content:'';position:absolute;left:-6px;top:50%;margin-top:-2px;width:4px;height:4px;border-radius:50%;background:var(--accent)}
@media (max-height:720px){.dk{height:32px;border-radius:10px;padding:0 9px;gap:9px}.dock{gap:4px}.dk svg{width:18px;height:18px}.dk .lb{font-size:11.5px}}
@media (max-height:560px){.dk{height:26px;padding:0 8px;gap:8px}.dock{gap:3px}.dk svg{width:15px;height:15px}.dk .lb{font-size:11px}}
@media (max-width:700px){:root{--dock:56px}.dk{justify-content:center;padding:0}.dk .lb{display:none}}

/* status (bottom-left) */
.stat{position:absolute;left:10px;bottom:10px;z-index:20;display:flex;align-items:center;gap:10px;font-size:11px;color:var(--mut2);background:rgba(0,0,0,.45);border:1px solid var(--line);border-radius:10px;padding:6px 10px;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);font-variant-numeric:tabular-nums}
.bt{display:inline-flex;align-items:center;gap:5px}
.bt .cell{width:20px;height:9px;border:1px solid var(--mut2);border-radius:2px;padding:1px;position:relative}
.bt .cell::after{content:'';position:absolute;right:-3px;top:2px;width:2px;height:3px;background:var(--mut2);border-radius:0 1px 1px 0}
.bt .cell i{display:block;height:100%;background:var(--fg);border-radius:1px}

/* windows */
.home{position:absolute;inset:0;z-index:5;display:grid;place-content:center;text-align:center;pointer-events:none;user-select:none;-webkit-user-select:none}
.home h1{font-size:clamp(32px,7vw,76px);font-weight:300;letter-spacing:.34em;padding-left:.34em;text-transform:uppercase;color:var(--fg);text-shadow:0 0 40px var(--hov)}
.home p{margin-top:14px;color:var(--mut);font-size:clamp(12px,1.6vw,15px);letter-spacing:.06em}
#wins{position:absolute;inset:0;z-index:10}
.win{position:absolute;background:var(--panel);border:1px solid var(--line);border-radius:var(--rad,12px);box-shadow:0 20px 60px rgba(0,0,0,.6);display:flex;flex-direction:column;overflow:hidden;resize:both;min-width:300px;min-height:200px;animation:pop .14s ease-out}
@keyframes pop{from{opacity:0;transform:scale(.97)}}
.win.min{display:none}
.win.full{left:calc(var(--dock) + 16px)!important;top:var(--top)!important;right:0;bottom:0;width:auto!important;height:auto!important;border-radius:0;resize:none}
.bar{display:grid;grid-template-columns:100px 1fr 100px;align-items:center;height:42px;flex:none;border-bottom:1px solid var(--line);background:#101010;cursor:grab;user-select:none;-webkit-user-select:none;touch-action:none}
.bar:active{cursor:grabbing}
.lights{display:flex;gap:10px;padding-left:14px}
.l{width:20px;height:20px;border-radius:50%;border:0;position:relative;display:grid;place-items:center;font-size:15px;line-height:1;font-weight:700;color:rgba(0,0,0,.7);transition:transform .1s,filter .1s}
.l::before{content:'';position:absolute;inset:-4px}
.l.c{background:#ff5f57}.l.m{background:#febc2e}.l.x{background:#28c840}
.l.c::after{content:'\00d7'}.l.m::after{content:'\2212'}.l.x::after{content:'+'}
.l:hover{transform:scale(1.15);filter:brightness(1.12)}
.wt{text-align:center;font-size:12px;color:var(--mut2);letter-spacing:.02em}
.wb{flex:1;min-height:0;display:flex;flex-direction:column;position:relative}
.fr{flex:1;border:0;width:100%;background:#fff}

/* shared ui */
.pad{padding:16px;overflow:auto;flex:1}
.scroll{overflow:auto;scrollbar-width:thin;scrollbar-color:#333 transparent}
.mut{color:var(--mut)}
.err{color:#ff6b6b;font-size:12px;min-height:16px}
.ok{color:#6be38a;font-size:12px}
.pri{background:var(--accent);color:var(--afg);font-weight:600;border-radius:8px;padding:8px 14px}
.pri:hover{filter:brightness(.88)}.pri:disabled{opacity:.5;cursor:default}
.gh{border:1px solid var(--line);border-radius:8px;padding:7px 12px;color:var(--fg)}
.gh:hover{background:var(--soft)}
.gh.danger{color:#ff7a7a}
input,select,textarea{background:var(--field);border:1px solid #262626;border-radius:8px;padding:8px 10px;outline:none;width:100%}
input:focus,select:focus,textarea:focus{border-color:var(--accent)}
textarea{resize:none}
select{appearance:none}
input[type=color]{padding:0;width:36px;height:32px;border-radius:8px;cursor:pointer;flex:none}
input[type=range]{padding:0;accent-color:var(--accent)}
.row{display:flex;gap:8px;align-items:center}
.stack{display:flex;flex-direction:column;gap:10px}
.sec{margin-bottom:20px}
.pg{border:1px solid var(--line);border-radius:10px;margin-bottom:8px;background:var(--soft);overflow:hidden}
.pg summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;padding:11px 14px;user-select:none}
.pg summary::-webkit-details-marker{display:none}
.pg summary span:last-child::after{content:'\25BE';display:inline-block;margin-left:10px;transition:transform .15s}
.pg[open] summary span:last-child::after{transform:rotate(180deg)}
.pg[open] summary{border-bottom:1px solid var(--line)}
.pl{justify-content:space-between;padding:9px 14px}
.pl+.pl{border-top:1px solid var(--line)}
.st{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut);margin-bottom:9px}
.sw{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:9px}
.s{width:24px;height:24px;border-radius:50%;border:1px solid var(--mut)}
.s.on{outline:2px solid var(--fg);outline-offset:2px}
.hx{width:92px;font-family:ui-monospace,Menlo,monospace}
.tg{width:38px;height:22px;border-radius:999px;background:#2a2a2a;position:relative;flex:none}
.tg::after{content:'';position:absolute;left:3px;top:3px;width:16px;height:16px;border-radius:50%;background:var(--fg);transition:.15s}
.tg.on{background:var(--accent)}.tg.on::after{left:19px;background:var(--afg)}
.item{border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-bottom:8px}
.item .meta{display:flex;justify-content:space-between;gap:8px;color:var(--mut);font-size:11px;margin-bottom:3px}
.item p{white-space:pre-wrap;word-break:break-word}
.tag{border:1px solid var(--line);border-radius:999px;padding:1px 8px;font-size:10px;letter-spacing:.06em;text-transform:uppercase;color:var(--fg)}
.tabs{display:flex;gap:4px;margin-bottom:14px}
.tabs button{flex:1;padding:7px;border-radius:8px;color:var(--mut);border:1px solid transparent}
.tabs button.on{color:var(--fg);border-color:var(--line);background:var(--soft)}
.tabs.sm{margin:10px 12px 0}

/* ai */
.chat{flex:1;min-height:0;padding:14px;display:flex;flex-direction:column;gap:10px}
.msg{max-width:86%;white-space:pre-wrap;word-break:break-word;padding:8px 12px;border-radius:12px}
.msg.u{align-self:flex-end;border:1px solid var(--line);background:var(--soft)}
.msg.a{align-self:flex-start;background:#151515}
.compose{display:flex;gap:8px;padding:10px;border-top:1px solid var(--line)}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.chips button{border:1px solid var(--line);border-radius:999px;padding:4px 10px;color:var(--mut2);font-size:12px}
.chips button:hover{background:var(--soft)}

/* auth */
#auth{position:fixed;inset:0;z-index:100;display:grid;place-items:center;padding:16px}
.card{width:340px;max-width:100%;border:1px solid var(--line);background:rgba(8,8,8,.78);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-radius:16px;padding:28px 26px;text-align:center}
.card h1{font-size:22px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;margin-bottom:4px}
.card .sub{color:var(--mut);margin-bottom:18px}
.card form{display:flex;flex-direction:column;gap:10px;margin-bottom:10px;text-align:left}
.fine{color:var(--mut);font-size:11px;margin-top:8px}
</style>
</head>
<body>
<div id="bg"></div>
<canvas id="snow"></canvas>

<div id="auth">
  <div class="card" id="acard">
    <h1>Divinity</h1>
    <p class="sub">A minimal desktop in your browser.</p>
    <div class="tabs" id="atabs"><button data-m="login" class="on">Log in</button><button data-m="signup">Sign up</button></div>
    <form id="af">
      <input id="au" placeholder="Username" maxlength="15" autocomplete="username" spellcheck="false" autocapitalize="off">
      <input id="ap" type="password" placeholder="Password" maxlength="15" autocomplete="current-password">
      <input id="ac" placeholder="Access code" autocomplete="off" style="display:none">
      <div class="err" id="ae"></div>
      <button class="pri" id="as">Log in</button>
    </form>
    <button class="lk" id="ag">Continue as guest</button>
    <p class="fine">Guest mode saves nothing online, only on this device.</p>
  </div>
</div>

<div id="desktop">
  <div class="top">
    <b class="brand">Divinity</b>
    <div class="tr"><span id="who"></span><button class="lk" id="out">Sign out</button><button id="panic" title="Panic">Panic</button></div>
  </div>
  <div class="home"><h1>Divinity</h1><p>A minimal desktop in your browser.</p></div>
  <div class="dock" id="dock"></div>
  <div id="wins"></div>
  <div class="stat"><span id="clk"></span><span class="bt" id="bat"><span class="cell"><i style="width:0"></i></span><span id="batp">--</span></span></div>
</div>

<script>
'use strict';
const LS=(()=>{try{const k='__dv';localStorage.setItem(k,'1');localStorage.removeItem(k);return localStorage}catch{const m={};return{getItem:k=>k in m?m[k]:null,setItem:(k,v)=>{m[k]=String(v)},removeItem:k=>{delete m[k]}}}})();
const $ = (s, r = document) => r.querySelector(s);
// safe DOM builder: all text goes through text nodes, never innerHTML
const h = (tag, props, ...kids) => {
  const e = document.createElement(tag);
  for (const [k, v] of Object.entries(props || {})) {
    if (v == null || v === false) continue;
    if (k === 'class') e.className = v;
    else if (k === 'style') e.style.cssText = v;
    else if (k.startsWith('on')) e.addEventListener(k.slice(2), v);
    else e.setAttribute(k, v === true ? '' : v);
  }
  for (const c of kids.flat()) { if (c == null || c === false) continue; e.append(c.nodeType ? c : document.createTextNode(c)); }
  return e;
};

const ICON = {
  settings: '<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>',
  feedback: '<path d="M4 5h16v11H9l-5 4z"/>',
  community: '<circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.5 3-6 6-6s6 2.5 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14c2.5 0 4 2 4 5"/>',
  updates: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18"/>',
  html: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>',
  credits: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/>',
  owner: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',
  ai: '<path d="M12 3l2.2 6.3L21 12l-6.8 2.7L12 21l-2.2-6.3L3 12l6.8-2.7z"/>',
  movies: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M10 9l5 3-5 3z"/>',
  games: '<rect x="3" y="8" width="18" height="9" rx="4"/><path d="M8 11v3M6.5 12.5h3M16 12h.01M18 13.5h.01"/>',
  proxy: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18"/>',
  files: '<path d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>'
};
const svg = k => { const d = document.createElement('div'); d.innerHTML = '<svg viewBox="0 0 24 24">' + (ICON[k] || ICON.html) + '</svg>'; return d.firstChild; };

addEventListener('unhandledrejection', e => { const r = e.reason; if (r && r.status !== undefined && r.message) alert(r.message); });

/* ---------------- state + api ---------------- */
const S = {
  token: LS.getItem('dv_token') || '', user: '', role: 'user', guest: false,
  device: (() => { let d = LS.getItem('dv_device'); if (!d) { d = (crypto.randomUUID ? crypto.randomUUID() : String(Math.random()).slice(2) + Date.now()); LS.setItem('dv_device', d); } return d; })()
};
/* ===== SHARED SETUP: fill these in to sync everyone through Google Forms/Sheets ===== */
/* Leave them empty and Divinity keeps everything on each person's own device.        */
const SHARED = {
  privateForm: '',     // pre-filled link of your PRIVATE form: feedback + who joined (fields: TYPE, USER, TEXT, DEVICE)
  communityForm: '',   // pre-filled link of your COMMUNITY form (fields: USER, TEXT, DEVICE)
  communitySheet: '',  // link to the Community responses sheet tab (Anyone with the link can view)
  bansSheet: ''        // link to the Bans sheet tab in that same spreadsheet
};
let PENDING = [];
const FORM_CACHE = {};
function parseForm(link, names) {
  try {
    const u = new URL(String(link || '').trim());
    const m = /\/forms\/d\/e\/([\w-]+)/.exec(u.pathname); if (!m) return null;
    const map = {};
    for (const [k, v] of u.searchParams) if (k.startsWith('entry.')) { const n = String(v).trim().toLowerCase(); if (names.includes(n)) map[n] = k; }
    return names.every(n => map[n]) ? { action: 'https://docs.google.com/forms/d/e/' + m[1] + '/formResponse', map } : null;
  } catch { return null; }
}
function formFor(which) {
  if (FORM_CACHE[which] === undefined) {
    FORM_CACHE[which] = which === 'private'
      ? parseForm(SHARED.privateForm, ['type', 'user', 'text', 'device'])
      : parseForm(SHARED.communityForm, ['user', 'text', 'device']);
  }
  return FORM_CACHE[which];
}
function sharedSend(which, data) {
  const f = formFor(which); if (!f) return;
  const body = new URLSearchParams();
  for (const k of Object.keys(f.map)) body.set(f.map[k], String(data[k] == null ? '' : data[k]).slice(0, 1000) || '-');
  fetch(f.action, { method: 'POST', mode: 'no-cors', body }).catch(() => {});
}
function parseSheet(link) {
  link = String(link || '').trim(); if (!link) return '';
  if (/\/spreadsheets\/d\/e\//.test(link)) return link;           // already a "publish to web" CSV link
  const m = /\/spreadsheets\/d\/([\w-]+)/.exec(link); if (!m) return '';
  const g = /[#&?]gid=(\d+)/.exec(link);
  return 'https://docs.google.com/spreadsheets/d/' + m[1] + '/gviz/tq?tqx=out:csv&headers=1' + (g ? '&gid=' + g[1] : '');
}
async function fetchText(url) {
  const c = new AbortController(), t = setTimeout(() => c.abort(), 5000);
  try { const r = await fetch(url, { cache: 'no-store', signal: c.signal }); if (!r.ok) return null; return await r.text(); }
  catch { return null; } finally { clearTimeout(t); }
}
function csvRows(t) {
  const rows = []; let row = [], f = '', q = false;
  for (let i = 0; i < t.length; i++) {
    const c = t[i];
    if (q) { if (c === '"') { if (t[i + 1] === '"') { f += '"'; i++; } else q = false; } else f += c; }
    else if (c === '"') q = true;
    else if (c === ',') { row.push(f); f = ''; }
    else if (c === '\n' || c === '\r') { if (c === '\r' && t[i + 1] === '\n') i++; row.push(f); rows.push(row); row = []; f = ''; }
    else f += c;
  }
  if (f !== '' || row.length) { row.push(f); rows.push(row); }
  return rows;
}
let bansCache = { at: 0, set: new Set() };
async function remoteBans() {
  const url = parseSheet(SHARED.bansSheet); if (!url) return bansCache.set;
  if (Date.now() - bansCache.at < 60000) return bansCache.set;
  bansCache.at = Date.now();
  const t = await fetchText(url);
  if (t && t.trim()[0] !== '<') {
    const s = new Set();
    csvRows(t).slice(1).forEach(r => r.forEach(c => { c = String(c).trim().toLowerCase(); if (c) s.add(c); }));
    bansCache.set = s;
  }
  return bansCache.set;
}
async function remoteCommunity() {
  const url = parseSheet(SHARED.communitySheet); if (!url) return null;
  const t = await fetchText(url); if (!t || t.trim()[0] === '<') return null;
  const rows = csvRows(t); if (!rows.length) return [];
  const head = rows[0].map(c => String(c).toLowerCase());
  const ix = (re, d) => { const i = head.findIndex(c => re.test(c)); return i >= 0 ? i : d; };
  const iT = ix(/time/, 0), iU = ix(/user|name/, 1), iX = ix(/text|post|message/, 2);
  return rows.slice(1).filter(r => (r[iX] || '').trim()).map((r, n) => {
    const at = Date.parse(r[iT]);
    return { id: 'r' + n, user: (r[iU] || 'Guest').trim().slice(0, 40), text: r[iX].trim().slice(0, 500), at: isNaN(at) ? Date.now() : at };
  }).reverse().slice(0, 100);
}
async function communityPosts(d) {
  const remote = await remoteCommunity();
  const local = d.messages.filter(m => m.type === 'community').slice(-100).reverse();
  if (!remote) return local;
  const now = Date.now(); PENDING = PENDING.filter(p => now - p.at < 300000);
  const have = new Set(remote.map(p => p.user.toLowerCase() + '|' + p.text));
  const extra = PENDING.filter(p => !have.has(p.user.toLowerCase() + '|' + p.text)).reverse();
  return [...extra, ...remote].slice(0, 100);
}

/* ---- built-in local backend: everything is saved in THIS browser only ---- */
const OWNERS = ['soccer', 'divinity'];
const lid = () => Math.random().toString(16).slice(2, 14);
const lsave = d => LS.setItem('dv_db', JSON.stringify(d));
function ldb() {
  let d; try { d = JSON.parse(LS.getItem('dv_db') || '{}'); } catch { d = {}; }
  d = Object.assign({ users: {}, sessions: {}, banned: {}, messages: [], updates: [] }, d);
  if (!d.updates.length) { d.updates.push({ id: lid(), title: 'Welcome to Divinity', body: 'New updates show up here every week. Use Feedback or Community to tell us what to add.', at: Date.now() }); lsave(d); }
  return d;
}
const lclean = (s, n) => String(s || '').replace(/[\u0000-\u001f\u007f]/g, ' ').trim().slice(0, n);
function lfail(status, error, extra) { throw Object.assign(new Error(error), { status, data: { error, ...(extra || {}) } }); }
async function lhash(pw, salt) {
  const s = salt + ':' + pw;
  if (window.crypto && crypto.subtle) {
    const b = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
    return [...new Uint8Array(b)].map(x => x.toString(16).padStart(2, '0')).join('');
  }
  let a = 5381, b = 52711; for (const c of s) { a = (a * 33) ^ c.charCodeAt(0); b = (b * 31 + c.charCodeAt(0)) | 0; }
  return (a >>> 0).toString(16) + (b >>> 0).toString(16);
}
function lai(t) {
  t = String(t || '').trim();
  const ex = t.replace(/^(what is|what's|whats|calculate|calc|solve)\s*/i, '').replace(/[?=]+$/, '').replace(/\^/g, '**').replace(/×/g, '*').replace(/÷/g, '/').replace(/(\d)\s*x\s*(\d)/gi, '$1*$2');
