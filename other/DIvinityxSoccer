  APPS[a.id] = { title: a.title, icon: a.icon || 'html', w: 760, h: 520, render: b => b.append(h('iframe', { class: 'fr', src: a.url })) };
  DOCK.push(a.id);
});

/* ---------------- dock, auth, boot ---------------- */
function dkBtn(id) { const b = h('button', { class: 'dk', title: APPS[id].title, 'data-l': APPS[id].title, 'data-id': id, onclick: () => openApp(id) }); b.append(svg(APPS[id].icon), h('span', { class: 'lb' }, APPS[id].title)); return b; }
function buildDock() {
  const d = $('#dock'); d.replaceChildren();
  const ids = [...DOCK]; if (S.role === 'owner') ids.push('owner');
  ids.forEach(id => d.append(dkBtn(id)));
  d.append(h('div', { class: 'sp' }), dkBtn('ai'));
}
function enter() {
  $('#auth').style.display = 'none'; $('#desktop').style.display = 'block';
  $('#who').textContent = S.guest ? 'Guest · saved on this device only' : S.user;
  loadSet(); buildDock(); openApp('updates');
  api('visit', {}).catch(() => {});
}
function showBanned() {
  $('#desktop').style.display = 'none'; $('#auth').style.display = 'grid';
  $('#acard').replaceChildren(h('h1', {}, 'Divinity'), h('p', { class: 'sub', style: 'margin-top:14px' }, 'This device has been banned.'));
}
let mode = 'login';
function setMode(m) {
  mode = m;
  document.querySelectorAll('#atabs button').forEach(b => b.classList.toggle('on', b.dataset.m === m));
  $('#as').textContent = m === 'login' ? 'Log in' : 'Create account';
  $('#ap').autocomplete = m === 'login' ? 'current-password' : 'new-password';
  $('#ae').textContent = '';
}
document.querySelectorAll('#atabs button').forEach(b => b.addEventListener('click', () => setMode(b.dataset.m)));
const LOCK = { n: 0, until: 0 };
$('#af').addEventListener('submit', async e => {
  e.preventDefault();
  const u = $('#au').value.trim(), p = $('#ap').value, err = $('#ae');
  err.textContent = '';
  if (!/^[A-Za-z0-9_-]{1,15}$/.test(u)) return err.textContent = 'Username: 1-15 letters, numbers, _ -';
  if (p.length < 4 || p.length > 15) return err.textContent = 'Password must be 4-15 characters.';
  if (Date.now() < LOCK.until) return err.textContent = 'Too many tries. Wait ' + Math.ceil((LOCK.until - Date.now()) / 1000) + 's.';
  $('#as').disabled = true;
  try {
    const r = await api(mode === 'login' ? 'login' : 'register', { username: u, password: p, code: $('#ac').value.trim() });
    LOCK.n = 0; S.token = r.token; S.user = r.user; S.role = r.role; S.guest = false;
    LS.setItem('dv_token', r.token); enter();
  } catch (x) {
    if (++LOCK.n >= 5) { LOCK.until = Date.now() + 60000; LOCK.n = 0; }
    if (x.data && x.data.needCode) $('#ac').style.display = '';
    if (!(x.data && x.data.banned)) err.textContent = x.message;
  }
  $('#as').disabled = false;
});
$('#ag').addEventListener('click', () => { S.guest = true; S.user = 'Guest'; S.role = 'user'; S.token = ''; enter(); });
$('#out').addEventListener('click', async () => {
  try { await api('logout', {}); } catch {}
  LS.removeItem('dv_token'); location.reload();
});
$('#panic').addEventListener('click', () => {
  const url = 'https://classroom.google.com/h';
  window.open(url, '_blank');
  window.close();                                   // works when this tab was opened by a script/link
  setTimeout(() => location.replace(url), 150);     // fallback: browsers refuse to close other tabs
});

(async function boot() {
  try { await api('hello'); } catch (e) { if (e.data && e.data.banned) return showBanned(); }
  if (S.token) {
    try { const m = await api('me'); S.user = m.user; S.role = m.role; S.guest = false; return enter(); }
    catch (e) { if (e.data && e.data.banned) return showBanned(); if (!e.offline) { LS.removeItem('dv_token'); S.token = ''; } }
  }
  loadSet();
})();
</script>
</body>
</html>
