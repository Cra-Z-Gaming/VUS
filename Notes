<body>

<!-- Sidebar -->
<div id="sidebar">
  <div id="sidebarHeader">
    <button id="newPageBtn">+ New page</button>
  </div>
  <div id="searchWrap">
    <input id="searchInput" type="text" placeholder="Search notes…" autocomplete="off">
  </div>
  <div id="tabList"></div>
  <div id="sidebarFooter">Auto-saved to browser</div>
</div>

<!-- Main -->
<div id="main">
  <div id="topBar">
    <button id="toggleSidebarBtn">☰</button>
    <div id="pageTitle">Untitled</div>
    <div id="charCount">0 chars</div>
  </div>
  <div id="editorWrap">
    <textarea id="editor" placeholder="Start typing…"></textarea>
  </div>
</div>

<!-- Rename Modal -->
<div id="renameModalOverlay">
  <div id="renameModal">
    <h3>Rename page</h3>
    <input id="renameInput" type="text" placeholder="Page name…" autocomplete="off">
    <div class="modal-btns">
      <button class="modal-btn cancel" id="renameCancel">Cancel</button>
      <button class="modal-btn confirm" id="renameConfirm">Rename</button>
    </div>
  </div>
</div>

<div id="ctrlHint">CTRL held — click icons to act on tabs</div>

<script>
const STORAGE_KEY = "vusNotes_v2";
let pages = [];
let activeId = null;
let renameTargetId = null;
let openDropdownId = null;

/* ── DOM refs ── */
const $sidebar = document.getElementById("sidebar");
const $tabList = document.getElementById("tabList");
const $editor = document.getElementById("editor");
const $pageTitle = document.getElementById("pageTitle");
const $charCount = document.getElementById("charCount");
const $searchInput = document.getElementById("searchInput");
const $renameOverlay = document.getElementById("renameModalOverlay");
const $renameInput = document.getElementById("renameInput");
const $renameCancel = document.getElementById("renameCancel");
const $renameConfirm = document.getElementById("renameConfirm");

/* ── Storage ── */
function load() {
  let loaded = false;
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed.pages)) {
        pages = parsed.pages;
        activeId = parsed.activeId || null;
        loaded = true;
      }
    }
  } catch (e) {}

  if (!loaded || pages.length === 0) {
    const id = "p_" + Date.now() + "_" + Math.random().toString(36).slice(2, 6);
    pages = [{
      id,
      name: "Untitled",
      content: "",
      createdAt: Date.now()
    }];
    activeId = id;
    save();
  }

  if (!activeId || !pages.find(p => p.id === activeId)) {
    activeId = pages[0].id;
  }
}

function save() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify({ pages, activeId }));
}

/* ── Page CRUD ── */
function createPage(name, content) {
  const id = "p_" + Date.now() + "_" + Math.random().toString(36).slice(2, 6);
  const page = {
    id,
    name: name || "Untitled",
    content: content || "",
    createdAt: Date.now()
  };
  pages.push(page);
  activeId = id;
  save();
  renderTabs();
  loadPage(id);
  return page;
}

function deletePage(id) {
  pages = pages.filter(p => p.id !== id);
  if (pages.length === 0) {
    createPage("Untitled");
    return;
  }
  if (activeId === id) {
    activeId = pages[pages.length - 1].id;
  }
  save();
  renderTabs();
  loadPage(activeId);
}

function duplicatePage(id) {
  const orig = pages.find(p => p.id === id);
  if (!orig) return;
  createPage(orig.name + " (copy)", orig.content);
}

function renamePage(id, newName) {
  const page = pages.find(p => p.id === id);
  if (page) {
    page.name = newName.trim() || "Untitled";
    save();
    renderTabs();
    if (activeId === id) $pageTitle.textContent = page.name;
  }
}

/* ── Editor ── */
function loadPage(id) {
  const page = pages.find(p => p.id === id);
  if (!page) return;
  activeId = id;
  $editor.value = page.content;
  $pageTitle.textContent = page.name;
  updateCharCount();
  renderTabs();
  save();
  $editor.focus();
}

function updateActiveContent() {
  const page = pages.find(p => p.id === activeId);
  if (page) {
    page.content = $editor.value;
    updateCharCount();
    save();
  }
}

function updateCharCount() {
  $charCount.textContent = $editor.value.length.toLocaleString() + " chars";
}

/* ── Tabs rendering ── */
function renderTabs() {
  const query = $searchInput.value.trim().toLowerCase();
  const filtered = pages.filter(p =>
    p.name.toLowerCase().includes(query) ||
    p.content.toLowerCase().includes(query)
  );

  $tabList.innerHTML = "";

  if (filtered.length === 0) {
    $tabList.innerHTML = `<div style="padding:20px;text-align:center;color:#64748b;font-size:13px">No matches</div>`;
    return;
  }

  filtered.forEach(page => {
    const tab = document.createElement("div");
    tab.className = "tab" + (page.id === activeId ? " active" : "");

    const icon = document.createElement("span");
    icon.className = "tab-icon";
    icon.textContent = "📝";

    const name = document.createElement("span");
    name.className = "tab-name";
    name.textContent = page.name;

    // Inline action buttons (visible on hover or when CTRL held)
    const actions = document.createElement("div");
    actions.className = "tab-actions";

    const renameBtn = document.createElement("button");
    renameBtn.className = "tab-action-btn";
    renameBtn.innerHTML = "✏️";
    renameBtn.title = "Rename";
    renameBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      openRenameModal(page.id);
    });

    const dupeBtn = document.createElement("button");
    dupeBtn.className = "tab-action-btn";
    dupeBtn.innerHTML = "📄";
    dupeBtn.title = "Duplicate";
    dupeBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      duplicatePage(page.id);
    });

    const delBtn = document.createElement("button");
    delBtn.className = "tab-action-btn delete";
    delBtn.innerHTML = "🗑️";
    delBtn.title = "Delete";
    delBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      deletePage(page.id);
    });

    actions.appendChild(renameBtn);
    actions.appendChild(dupeBtn);
    actions.appendChild(delBtn);

    // 3-dot menu fallback
    const menuBtn = document.createElement("button");
    menuBtn.className = "tab-menu-btn";
    menuBtn.innerHTML = "&#x22EE;";
    menuBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleDropdown(page.id, menuBtn);
    });

    tab.appendChild(icon);
    tab.appendChild(name);
    tab.appendChild(actions);
    tab.appendChild(menuBtn);

    tab.addEventListener("click", () => {
      closeDropdown();
      loadPage(page.id);
    });

    $tabList.appendChild(tab);
  });
}

/* ── Dropdown menu (fallback) ── */
function toggleDropdown(pageId, btnEl) {
  if (openDropdownId === pageId) {
    closeDropdown();
    return;
  }
  closeDropdown();
  openDropdownId = pageId;

  const dropdown = document.createElement("div");
  dropdown.className = "tab-dropdown";
  dropdown.id = "activeDropdown";

  const renameItem = document.createElement("div");
  renameItem.className = "tab-dropdown-item";
  renameItem.innerHTML = "✏️ Rename";
  renameItem.addEventListener("click", (e) => {
    e.stopPropagation();
    closeDropdown();
    openRenameModal(pageId);
  });

  const dupeItem = document.createElement("div");
  dupeItem.className = "tab-dropdown-item";
  dupeItem.innerHTML = "📄 Duplicate";
  dupeItem.addEventListener("click", (e) => {
    e.stopPropagation();
    closeDropdown();
    duplicatePage(pageId);
  });

  const delItem = document.createElement("div");
  delItem.className = "tab-dropdown-item delete";
  delItem.innerHTML = "🗑️ Delete";
  delItem.addEventListener("click", (e) => {
    e.stopPropagation();
    closeDropdown();
    deletePage(pageId);
  });

  dropdown.appendChild(renameItem);
  dropdown.appendChild(dupeItem);
  dropdown.appendChild(delItem);

  btnEl.parentElement.appendChild(dropdown);
}

function closeDropdown() {
  const existing = document.getElementById("activeDropdown");
  if (existing) existing.remove();
  openDropdownId = null;
}

/* ── Rename modal ── */
function openRenameModal(pageId) {
  renameTargetId = pageId;
  const page = pages.find(p => p.id === pageId);
  $renameInput.value = page ? page.name : "";
  $renameOverlay.style.display = "flex";
  $renameInput.focus();
  $renameInput.select();
}

function closeRenameModal() {
  $renameOverlay.style.display = "none";
  renameTargetId = null;
}

function confirmRename() {
  if (renameTargetId) {
    renamePage(renameTargetId, $renameInput.value);
  }
  closeRenameModal();
}

/* ── Event listeners ── */
document.getElementById("newPageBtn").addEventListener("click", () => {
  createPage("Untitled");
});

document.getElementById("toggleSidebarBtn").addEventListener("click", () => {
  $sidebar.classList.toggle("collapsed");
});

$editor.addEventListener("input", updateActiveContent);

$searchInput.addEventListener("input", renderTabs);

$renameCancel.addEventListener("click", closeRenameModal);
$renameConfirm.addEventListener("click", confirmRename);
$renameInput.addEventListener("keydown", e => {
  if (e.key === "Enter") confirmRename();
  if (e.key === "Escape") closeRenameModal();
});
$renameOverlay.addEventListener("click", e => {
  if (e.target === $renameOverlay) closeRenameModal();
});

document.addEventListener("click", () => closeDropdown());
document.addEventListener("keydown", e => {
  if (e.key === "Escape") closeDropdown();
});

/* ── CTRL hold for inline actions ── */
document.addEventListener("keydown", e => {
  if (e.key === "Control" && !e.repeat) {
    document.body.classList.add("ctrl-held");
  }
});
document.addEventListener("keyup", e => {
  if (e.key === "Control") {
    document.body.classList.remove("ctrl-held");
  }
});
window.addEventListener("blur", () => {
  document.body.classList.remove("ctrl-held");
});

/* ── Boot ── */
load();
renderTabs();
loadPage(activeId);
</script>
</body>
</html>
