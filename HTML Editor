<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HTML Editor</title>
<style>
*, *::before, *::after { box-sizing: border-box; }
body { margin: 0; font-family: Arial, sans-serif; background: #0f172a; color: white; display: flex; height: 100vh; height: 100dvh; flex-direction: column; overflow: hidden; }

/* TAB BAR */
.tab-bar { display: flex; align-items: stretch; background: #0a1120; border-bottom: 1px solid #334155; flex-shrink: 0; position: relative; }
.tab-scroll { display: flex; align-items: center; flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: thin; scrollbar-color: #334155 transparent; }
.tab-scroll::-webkit-scrollbar { height: 4px; }
.tab-scroll::-webkit-scrollbar-thumb { background: #334155; border-radius: 2px; }
.tab-actions { display: flex; align-items: center; flex-shrink: 0; border-left: 1px solid #1e293b; }
.tab { display: flex; align-items: center; gap: 6px; padding: 0 14px; height: 36px; font-size: 12px; color: #94a3b8; cursor: pointer; border-right: 1px solid #1e293b; border-top: 2px solid transparent; white-space: nowrap; flex-shrink: 0; user-select: none; transition: background .15s; position: relative; }
.tab:hover { background: #1e293b; }
.tab.active { background: #0f172a; color: white; border-top-color: #22c55e; }
.tab.drag-over { background: #1e3a5f; }
.tab .tab-name { max-width: 120px; overflow: hidden; text-overflow: ellipsis; }
.tab .tab-name-input { background: transparent; border: none; border-bottom: 1px solid #22c55e; color: white; font-size: 12px; outline: none; width: 90px; padding: 0; }
.tab .tab-meta { font-size: 10px; color: #475569; }
.tab.active .tab-meta { color: #22c55e; }
.tab .close-btn { font-size: 14px; line-height: 1; color: #64748b; border-radius: 3px; padding: 1px 3px; transition: color .15s, background .15s; }
.tab .close-btn:hover { color: white; background: #ef4444; }
.tab-add-btn { padding: 0 14px; height: 36px; font-size: 18px; color: #64748b; cursor: pointer; display: flex; align-items: center; transition: color .15s; flex-shrink: 0; }
.tab-add-btn:hover { color: #22c55e; }
.tab-search-btn { padding: 0 10px; height: 36px; font-size: 13px; color: #64748b; cursor: pointer; display: flex; align-items: center; transition: color .15s; flex-shrink: 0; border-left: 1px solid #1e293b; }
.tab-search-btn:hover { color: #22c55e; }
.tab-search-dropdown { position: absolute; top: 36px; right: 0; background: #1e293b; border: 1px solid #334155; border-radius: 6px; z-index: 100; min-width: 200px; display: none; flex-direction: column; box-shadow: 0 8px 24px rgba(0,0,0,.5); overflow: hidden; }
.tab-search-dropdown.open { display: flex; }
.tab-search-dropdown input { background: #0f172a; border: none; border-bottom: 1px solid #334155; color: white; padding: 8px 10px; font-size: 12px; outline: none; width: 100%; }
.tab-search-list { max-height: 200px; overflow-y: auto; }
.tab-search-item { padding: 7px 12px; font-size: 12px; cursor: pointer; color: #cbd5e1; transition: background .12s; }
.tab-search-item:hover { background: #334155; color: white; }
.tab-search-item.active-item { color: #22c55e; }
.tab-session-btn { padding: 0 10px; height: 36px; font-size: 11px; color: #64748b; cursor: pointer; display: flex; align-items: center; transition: color .15s; flex-shrink: 0; border-left: 1px solid #1e293b; gap: 4px; }
.tab-session-btn:first-child { border-left: none; }
.tab-session-btn:hover { color: #22c55e; }

/* CONTEXT MENU */
#ctxMenu { position: fixed; background: #1e293b; border: 1px solid #334155; border-radius: 6px; z-index: 9999; display: none; flex-direction: column; min-width: 140px; box-shadow: 0 8px 24px rgba(0,0,0,.6); overflow: hidden; }
#ctxMenu.open { display: flex; }
.ctx-item { padding: 8px 14px; font-size: 12px; cursor: pointer; color: #cbd5e1; transition: background .12s; user-select: none; }
.ctx-item:hover { background: #334155; color: white; }
.ctx-item.danger:hover { background: #7f1d1d; color: #fca5a5; }

/* MAIN LAYOUT */
.main { display: flex; flex: 1; overflow: hidden; position: relative; }
.left { display: flex; flex-direction: column; flex: none; min-width: 80px; overflow: hidden; }
.right { display: flex; flex-direction: column; flex: 1; min-width: 80px; overflow: hidden; }
.divider { width: 5px; background: #334155; cursor: col-resize; flex-shrink: 0; transition: background .15s; position: relative; z-index: 10; }
.divider:hover, .divider.dragging { background: #22c55e; }
.editor-wrap { display: flex; flex: 1; overflow: hidden; }
.line-numbers { background: #0a1120; color: #475569; font-family: monospace; font-size: 13px; line-height: 1.5; padding: 12px 6px 12px 8px; text-align: right; user-select: none; overflow: hidden; min-width: 36px; border-right: 1px solid #1e293b; white-space: pre; }
textarea { flex: 1; min-width: 0; background: #0f172a; color: white; border: none; outline: none; padding: 12px; font-family: monospace; font-size: 13px; line-height: 1.5; resize: none; overflow: auto; tab-size: 2; white-space: pre; }
.status-bar { padding: 4px 10px; font-size: 11px; color: #94a3b8; background: #0a1120; border-top: 1px solid #1e293b; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
iframe { flex: 1; border: none; background: white; }
.bar { display: flex; gap: 8px; padding: 8px; background: #111827; border-bottom: 1px solid #334155; align-items: center; flex-wrap: wrap; }
button { padding: 6px 10px; border: none; border-radius: 6px; cursor: pointer; font-size: 12px; background: #22c55e; color: black; font-weight: bold; touch-action: manipulation; transition: filter .15s, background .15s; }
button:hover { filter: brightness(1.1); }
button:active { transform: translateY(1px); }
button.secondary { background: #1e293b; color: white; border: 1px solid #334155; }
button.secondary:hover { background: #273449; filter: none; }
button:focus-visible, .switch:focus-visible { outline: 2px solid #22c55e; outline-offset: 2px; }
.toggle { padding: 6px 10px; border-radius: 6px; font-size: 12px; cursor: pointer; background: #1e293b; border: 1px solid #334155; user-select: none; }
.on { background: #22c55e !important; color: black; }
.label { font-size: 12px; color: #94a3b8; margin-left: auto; }
#fileInput, #sessionImportInput { display: none; }
.main.is-resizing iframe { pointer-events: none; }

/* HTML / CSS / JS SWITCHER */
.file-switch { display: none; gap: 4px; padding: 6px 8px 0; background: #0a1120; border-bottom: 1px solid #1e293b; flex-shrink: 0; }
.file-switch.show { display: flex; }
.file-pill { padding: 5px 14px; font-size: 12px; color: #94a3b8; cursor: pointer; user-select: none; border-radius: 6px 6px 0 0; border-top: 2px solid transparent; transition: color .15s, background .15s; }
.file-pill:hover { color: white; background: #1e293b; }
.file-pill.active { background: #0f172a; color: white; border-top-color: #22c55e; }

/* OVERLAYS (settings + dialog) */
.overlay { position: fixed; inset: 0; background: rgba(2, 6, 23, .65); display: none; align-items: center; justify-content: center; padding: 16px; }
.overlay.open { display: flex; }
#settingsOverlay { z-index: 10000; }
#dialogOverlay { z-index: 10001; }
.panel, .dialog { background: #1e293b; border: 1px solid #334155; border-radius: 12px; box-shadow: 0 20px 50px rgba(0,0,0,.6); }
.dialog { width: 100%; max-width: 360px; padding: 20px; }
.dialog h3 { margin: 0 0 8px; font-size: 16px; }
.dialog p { margin: 0 0 18px; font-size: 13px; color: #cbd5e1; line-height: 1.5; word-break: break-word; }
.dialog-actions { display: flex; justify-content: flex-end; gap: 8px; }
.dialog-actions button { padding: 9px 16px; font-size: 13px; }
.danger-btn { background: #ef4444; color: white; }
.panel { width: 100%; max-width: 440px; max-height: 90vh; display: flex; flex-direction: column; overflow: hidden; }
.panel-head { display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid #334155; }
.panel-head h2 { margin: 0; font-size: 16px; }
.icon-btn { background: transparent; color: #94a3b8; font-size: 20px; line-height: 1; padding: 2px 8px; }
.icon-btn:hover { color: white; background: #334155; filter: none; }
.panel-body { padding: 4px 18px 14px; overflow-y: auto; }
.group-title { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: #64748b; margin: 16px 0 4px; }
.setting { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid #2a3850; cursor: pointer; }
.group .setting:last-child { border-bottom: none; }
.s-title { display: block; font-size: 13px; color: white; }
.s-desc { display: block; font-size: 11px; color: #94a3b8; margin-top: 2px; line-height: 1.4; }
.switch { appearance: none; -webkit-appearance: none; flex-shrink: 0; width: 40px; height: 22px; margin: 0; border-radius: 11px; background: #334155; position: relative; cursor: pointer; transition: background .2s; }
.switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: white; transition: transform .2s; }
.switch:checked { background: #22c55e; }
.switch:checked::after { transform: translateX(18px); }
.panel-foot { padding: 10px 18px; font-size: 11px; color: #64748b; border-top: 1px solid #334155; }

/* MOBILE */
@media (max-width: 700px) {
  .main { flex-direction: column; }
  .left, .right { width: 100% !important; flex: 1 1 0; min-width: 0; min-height: 0; }
  .divider { display: none; }
  .lbl { display: none; }
  textarea, .line-numbers { font-size: 16px; }
  .tab .close-btn { font-size: 18px; padding: 4px 9px; }
  .overlay { padding: 0; }
  .panel { max-width: none; max-height: none; height: 100%; border-radius: 0; border: none; }
  .dialog { margin: 16px; }
}
</style>
</head>
<body>

<div class="tab-bar" id="tabBar">
  <div class="tab-scroll" id="tabScroll">
    <div class="tab-add-btn" onclick="addTab()" title="New tab">+</div>
  </div>
  <div class="tab-actions">
    <div class="tab-session-btn" onclick="exportSession()" title="Export all tabs as JSON">⬇<span class="lbl"> Export All</span></div>
    <input type="file" id="sessionImportInput" accept=".json" onchange="importSession(event)">
    <label for="sessionImportInput" class="tab-session-btn" title="Import tabs from JSON">⬆<span class="lbl"> Import All</span></label>
    <div class="tab-search-btn" id="tabSearchBtn" onclick="toggleTabSearch()" title="Find tab">🔍</div>
    <div class="tab-session-btn" onclick="openSettings()" title="Settings" style="font-size:14px;">⚙</div>
  </div>
  <div class="tab-search-dropdown" id="tabSearchDropdown">
    <input type="text" id="tabSearchInput" placeholder="Search tabs…" oninput="filterTabSearch()">
    <div class="tab-search-list" id="tabSearchList"></div>
  </div>
</div>

<div id="ctxMenu">
  <div class="ctx-item" onclick="ctxRename()">✏️ Rename</div>
  <div class="ctx-item" onclick="ctxDupe()">⧉ Duplicate</div>
  <div class="ctx-item danger" onclick="ctxClose()">✕ Close</div>
</div>

<div class="main" id="mainArea">
  <div class="left" id="leftPane">
    <div class="bar">
      <button onclick="run()">Run</button>
      <button class="secondary" onclick="openTab()">Open Tab</button>
      <button class="secondary" onclick="resetCode()">Reset</button>
      <button class="secondary" onclick="exportCode()">Export</button>
      <input type="file" id="fileInput" onchange="importCode(event)">
      <label for="fileInput" class="secondary" style="padding:6px 10px;border-radius:6px;cursor:pointer;display:inline-block;border:1px solid #334155;">Import</label>
      <div class="toggle on" id="autoToggle" onclick="toggleAuto()">Auto Refresh</div>
      <div class="label">HTML Editor</div>
    </div>
    <div class="file-switch" id="fileSwitch"></div>
    <div class="editor-wrap">
      <div class="line-numbers" id="lineNumbers">1</div>
      <textarea id="code" wrap="off" spellcheck="false" autocapitalize="off" autocomplete="off" autocorrect="off"></textarea>
    </div>
    <div class="status-bar" id="statusBar"></div>
  </div>
  <div class="divider" id="divider"></div>
  <div class="right" id="rightPane">
    <iframe id="preview"></iframe>
  </div>
</div>

<!-- SETTINGS -->
<div class="overlay" id="settingsOverlay">
  <div class="panel" role="dialog" aria-label="Settings">
    <div class="panel-head">
      <h2>Settings</h2>
      <button class="icon-btn" onclick="closeSettings()" title="Close">×</button>
    </div>
    <div class="panel-body">
      <div class="group">
        <div class="group-title">Editor</div>
        <label class="setting">
          <span><span class="s-title">CSS editor</span><span class="s-desc">Adds a CSS tab. It's applied to the preview automatically, no &lt;link&gt; needed.</span></span>
          <input type="checkbox" class="switch" data-setting="css">
        </label>
        <label class="setting">
          <span><span class="s-title">JS editor</span><span class="s-desc">Adds a JS tab. It runs in the preview automatically, no &lt;script src&gt; needed.</span></span>
          <input type="checkbox" class="switch" data-setting="js">
        </label>
      </div>
      <div class="group">
        <div class="group-title">Confirmations</div>
        <label class="setting">
          <span><span class="s-title">Confirm delete tab</span><span class="s-desc">Ask before closing a tab with the ×.</span></span>
          <input type="checkbox" class="switch" data-setting="confirmDelete">
        </label>
        <label class="setting">
          <span><span class="s-title">Confirm reset</span><span class="s-desc">Ask before the Reset button clears your code.</span></span>
          <input type="checkbox" class="switch" data-setting="confirmReset">
        </label>
      </div>
    </div>
    <div class="panel-foot">Saved in this browser. Turning CSS or JS off hides it but keeps your code.</div>
  </div>
</div>

<!-- CONFIRM / ALERT DIALOG -->
<div class="overlay" id="dialogOverlay">
  <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="dlgTitle" aria-describedby="dlgMsg">
    <h3 id="dlgTitle"></h3>
    <p id="dlgMsg"></p>
    <div class="dialog-actions">
      <button class="secondary" id="dlgCancel">Cancel</button>
      <button id="dlgOk">OK</button>
    </div>
  </div>
</div>

<script>
const $ = id => document.getElementById(id);

/* ELEMENTS + STATE */
const iframe = $('preview');
const codeBox = $('code');
let auto = true;
let tabs = [];
let activeId = null;
let curFile = 'html'; // which file is showing in the editor: html | css | js

const STORAGE_TABS = 'html_editor_tabs';
const STORAGE_ACTIVE = 'html_editor_active';
const STORAGE_SETTINGS = 'html_editor_settings';

const FILES = {
  html: { field: 'code', label: 'HTML', placeholder: '' },
  css:  { field: 'css',  label: 'CSS',  placeholder: '/* Applied to the preview automatically */' },
  js:   { field: 'js',   label: 'JS',   placeholder: '// Runs in the preview automatically' }
};

/* SETTINGS (basic editor by default) */
const DEFAULT_SETTINGS = { css: false, js: false, confirmDelete: true, confirmReset: true };
let settings = { ...DEFAULT_SETTINGS };

function loadSettings() {
  try {
    const raw = JSON.parse(localStorage.getItem(STORAGE_SETTINGS));
    if (raw && typeof raw === 'object') settings = { ...DEFAULT_SETTINGS, ...raw };
  } catch (e) {}
}

function saveSettings() {
  try { localStorage.setItem(STORAGE_SETTINGS, JSON.stringify(settings)); } catch (e) {}
}

function openSettings() {
  document.querySelectorAll('[data-setting]').forEach(cb => { cb.checked = !!settings[cb.dataset.setting]; });
  $('settingsOverlay').classList.add('open');
}
function closeSettings() { $('settingsOverlay').classList.remove('open'); }

document.querySelectorAll('[data-setting]').forEach(cb => {
  cb.addEventListener('change', () => {
    settings[cb.dataset.setting] = cb.checked;
    saveSettings();
    applySettings();
  });
});
$('settingsOverlay').addEventListener('click', e => { if (e.target === e.currentTarget) closeSettings(); });

function applySettings() {
  const hidden = (curFile === 'css' && !settings.css) || (curFile === 'js' && !settings.js);
  if (hidden) {
    flushActiveCode();
    curFile = 'html';
    loadActiveCode();
  }
  renderFileSwitch();
  renderTabs();
  updateLineNumbers();
  run();
}

/* CUSTOM DIALOG (works on mobile, unlike confirm()/alert()) */
let dialogDone = null;

function showDialog({ title, message, confirmText = 'OK', danger = false, alertOnly = false }) {
  return new Promise(resolve => {
    if (dialogDone) dialogDone(false);
    $('dlgTitle').textContent = title;
    $('dlgMsg').textContent = message;
    const ok = $('dlgOk'), cancel = $('dlgCancel');
    ok.textContent = confirmText;
    ok.classList.toggle('danger-btn', danger);
    cancel.style.display = alertOnly ? 'none' : '';
    $('dialogOverlay').classList.add('open');
    dialogDone = v => {
      dialogDone = null;
      $('dialogOverlay').classList.remove('open');
      resolve(v);
    };
    (danger ? cancel : ok).focus();
  });
}

$('dlgOk').addEventListener('click', () => { if (dialogDone) dialogDone(true); });
$('dlgCancel').addEventListener('click', () => { if (dialogDone) dialogDone(false); });
$('dialogOverlay').addEventListener('click', e => { if (e.target === e.currentTarget && dialogDone) dialogDone(false); });

document.addEventListener('keydown', e => {
  if (e.key !== 'Escape') return;
  closeCtxMenu();
  if (dialogDone) dialogDone(false);
  else closeSettings();
});

/* TAB STATE */
function genId() { return 't' + Date.now() + Math.random().toString(36).slice(2, 6); }

function nextTabName() {
  let n = tabs.length + 1;
  while (tabs.some(t => t.name === 'Tab ' + n)) n++;
  return 'Tab ' + n;
}

function normalizeTabs() {
  tabs.forEach(t => { t.code = t.code || ''; t.css = t.css || ''; t.js = t.js || ''; });
}

function saveTabs() {
  try {
    localStorage.setItem(STORAGE_TABS, JSON.stringify(tabs));
    localStorage.setItem(STORAGE_ACTIVE, activeId);
  } catch (e) {}
}

function loadTabs() {
  try {
    const raw = localStorage.getItem(STORAGE_TABS);
    if (raw) {
      tabs = JSON.parse(raw);
      activeId = localStorage.getItem(STORAGE_ACTIVE) || tabs[0]?.id || null;
      if (tabs.length) { normalizeTabs(); return; }
    }
  } catch (e) {}
  const legacy = localStorage.getItem('html_code') || '<h1>Hello World</h1>';
  const id = genId();
  tabs = [{ id, name: 'Tab 1', code: legacy, css: '', js: '' }];
  activeId = id;
  saveTabs();
}

function activeTab() { return tabs.find(t => t.id === activeId) || null; }

/* STATS (lines + chars) */
function statText(code) { return `${code.split('\n').length} L · ${code.length} C`; }

// Size of a whole tab: HTML plus CSS/JS when those editors are enabled
function tabSize(t) {
  const parts = [t.code || ''];
  if (settings.css) parts.push(t.css || '');
  if (settings.js) parts.push(t.js || '');
  return {
    lines: parts.reduce((n, p, i) => n + (i === 0 || p ? p.split('\n').length : 0), 0),
    chars: parts.reduce((n, p) => n + p.length, 0)
  };
}

function tabStatText(t) {
  const s = tabSize(t);
  return `${s.lines} L · ${s.chars} C`;
}

function updateStats() {
  const t = activeTab();
  if (!t) return;
  flushActiveCode();
  const meta = document.querySelector(`.tab[data-id="${t.id}"] .tab-meta`);
  if (meta) meta.textContent = tabStatText(t);
  const total = tabs.reduce((n, x) => n + tabSize(x).chars, 0);
  const multi = settings.css || settings.js;
  $('statusBar').textContent =
    `${t.name}${multi ? ' · ' + FILES[curFile].label : ''}: ${statText(codeBox.value)}  |  All tabs: ${tabs.length} tabs, ${total} chars`;
}

/* TAB UI + DRAG-TO-REORDER */
let dragSrcId = null;

function renderTabs() {
  const bar = $('tabScroll');
  const addBtn = bar.querySelector('.tab-add-btn');
  Array.from(bar.querySelectorAll('.tab')).forEach(el => el.remove());

  tabs.forEach(tab => {
    const el = document.createElement('div');
    el.className = 'tab' + (tab.id === activeId ? ' active' : '');
    el.dataset.id = tab.id;
    el.draggable = true;

    el.addEventListener('dragstart', e => {
      dragSrcId = tab.id;
      e.dataTransfer.effectAllowed = 'move';
      setTimeout(() => el.style.opacity = '0.5', 0);
    });
    el.addEventListener('dragend', () => { el.style.opacity = ''; });
    el.addEventListener('dragover', e => { e.preventDefault(); el.classList.add('drag-over'); });
    el.addEventListener('dragleave', () => el.classList.remove('drag-over'));
    el.addEventListener('drop', e => {
      e.preventDefault();
      el.classList.remove('drag-over');
      if (!dragSrcId || dragSrcId === tab.id) return;
      flushActiveCode();
      const fromIdx = tabs.findIndex(t => t.id === dragSrcId);
      const toIdx = tabs.findIndex(t => t.id === tab.id);
      const [moved] = tabs.splice(fromIdx, 1);
      tabs.splice(toIdx, 0, moved);
      saveTabs();
      renderTabs();
      updateStats();
    });

    const nameSpan = document.createElement('span');
    nameSpan.className = 'tab-name';
    nameSpan.textContent = tab.name;
    nameSpan.title = 'Double-click to rename';
    nameSpan.addEventListener('dblclick', e => { e.stopPropagation(); startRename(tab.id, nameSpan); });

    const meta = document.createElement('span');
    meta.className = 'tab-meta';
    meta.textContent = tabStatText(tab);

    const closeBtn = document.createElement('span');
    closeBtn.className = 'close-btn';
    closeBtn.textContent = '×';
    closeBtn.title = 'Close tab';
    closeBtn.addEventListener('click', e => { e.stopPropagation(); closeTabById(tab.id); });

    el.appendChild(nameSpan);
    el.appendChild(meta);
    if (tabs.length > 1) el.appendChild(closeBtn);

    el.addEventListener('click', () => switchTab(tab.id));
    el.addEventListener('contextmenu', e => openCtxMenu(e, tab.id));

    bar.insertBefore(el, addBtn);
  });

  const activeEl = bar.querySelector('.tab.active');
  if (activeEl) activeEl.scrollIntoView({ inline: 'nearest', block: 'nearest' });
}

function startRename(id, nameSpanOrNull) {
  const tab = tabs.find(t => t.id === id);
  if (!tab) return;
  if (!nameSpanOrNull) {
    const el = document.querySelector(`.tab[data-id="${id}"] .tab-name`);
    if (el) nameSpanOrNull = el; else return;
  }
  const input = document.createElement('input');
  input.className = 'tab-name-input';
  input.value = tab.name;
  nameSpanOrNull.replaceWith(input);
  const tabEl = input.closest('.tab');
  if (tabEl) tabEl.draggable = false;
  input.addEventListener('click', e => e.stopPropagation());
  input.focus();
  input.select();

  function commit() {
    tab.name = input.value.trim() || tab.name;
    saveTabs();
    renderTabs();
    updateStats();
  }
  input.addEventListener('blur', commit);
  input.addEventListener('keydown', e => {
    if (e.key === 'Enter') input.blur();
    if (e.key === 'Escape') { input.value = tab.name; input.blur(); }
  });
}

/* CONTEXT MENU */
let ctxTargetId = null;
const ctxMenu = $('ctxMenu');

function openCtxMenu(e, id) {
  e.preventDefault();
  e.stopPropagation();
  ctxTargetId = id;
  ctxMenu.style.left = e.clientX + 'px';
  ctxMenu.style.top = e.clientY + 'px';
  ctxMenu.classList.add('open');
  const r = ctxMenu.getBoundingClientRect();
  ctxMenu.style.left = Math.max(4, Math.min(e.clientX, innerWidth - r.width - 4)) + 'px';
  ctxMenu.style.top = Math.max(4, Math.min(e.clientY, innerHeight - r.height - 4)) + 'px';
  const closeItem = ctxMenu.querySelectorAll('.ctx-item')[2];
  closeItem.style.opacity = tabs.length <= 1 ? '0.4' : '1';
  closeItem.style.pointerEvents = tabs.length <= 1 ? 'none' : '';
}

function closeCtxMenu() { ctxMenu.classList.remove('open'); ctxTargetId = null; }
document.addEventListener('click', closeCtxMenu);

function ctxRename() { const id = ctxTargetId; closeCtxMenu(); startRename(id, null); }
function ctxDupe() { const id = ctxTargetId; closeCtxMenu(); duplicateTab(id); }
function ctxClose() { const id = ctxTargetId; closeCtxMenu(); closeTabById(id); }

/* TAB OPERATIONS */
function switchTab(id) {
  flushActiveCode();
  activeId = id;
  saveTabs();
  loadActiveCode();
  renderTabs();
  updateLineNumbers();
  run();
}

function addTab() {
  flushActiveCode();
  const id = genId();
  tabs.push({ id, name: nextTabName(), code: '<h1>Hello World</h1>', css: '', js: '' });
  activeId = id;
  saveTabs();
  loadActiveCode();
  renderTabs();
  updateLineNumbers();
  run();
}

function duplicateTab(id) {
  flushActiveCode();
  const src = tabs.find(t => t.id === id);
  if (!src) return;
  const newId = genId();
  const idx = tabs.findIndex(t => t.id === id);
  tabs.splice(idx + 1, 0, { id: newId, name: src.name + ' (copy)', code: src.code, css: src.css || '', js: src.js || '' });
  activeId = newId;
  saveTabs();
  loadActiveCode();
  renderTabs();
  updateLineNumbers();
  run();
}

async function closeTabById(id) {
  if (tabs.length <= 1) return;
  const target = tabs.find(t => t.id === id);
  if (settings.confirmDelete) {
    const ok = await showDialog({
      title: 'Close tab?',
      message: `"${target ? target.name : 'This tab'}" will be deleted. This can't be undone.`,
      confirmText: 'Delete',
      danger: true
    });
    if (!ok) return;
  }
  if (tabs.length <= 1) return;
  flushActiveCode();
  const idx = tabs.findIndex(t => t.id === id);
  if (idx === -1) return;
  tabs.splice(idx, 1);
  if (activeId === id) {
    activeId = tabs[Math.min(idx, tabs.length - 1)].id;
    loadActiveCode();
    run();
  }
  saveTabs();
  renderTabs();
  updateLineNumbers();
}

// Write the editor box back into whichever file (HTML/CSS/JS) is showing
function flushActiveCode() {
  const tab = activeTab();
  if (tab) tab[FILES[curFile].field] = codeBox.value;
}

function loadActiveCode() {
  const tab = activeTab();
  if (tab) codeBox.value = tab[FILES[curFile].field] || '';
}

/* HTML / CSS / JS SWITCHER */
function renderFileSwitch() {
  const sw = $('fileSwitch');
  const avail = ['html'];
  if (settings.css) avail.push('css');
  if (settings.js) avail.push('js');
  sw.classList.toggle('show', avail.length > 1);
  sw.innerHTML = '';
  avail.forEach(f => {
    const pill = document.createElement('div');
    pill.className = 'file-pill' + (f === curFile ? ' active' : '');
    pill.textContent = FILES[f].label;
    pill.addEventListener('click', () => setCurFile(f));
    sw.appendChild(pill);
  });
  codeBox.placeholder = FILES[curFile].placeholder;
}

function setCurFile(f) {
  if (f === curFile) return;
  flushActiveCode();
  curFile = f;
  loadActiveCode();
  codeBox.scrollTop = 0;
  renderFileSwitch();
  updateLineNumbers();
}

/* BUILD PREVIEW / EXPORT OUTPUT: CSS + JS are injected automatically when enabled */
function injectHead(html, text) {
  const i = html.search(/<\/head\s*>/i);
  if (i !== -1) return html.slice(0, i) + text + '\n' + html.slice(i);
  for (const re of [/<head(\s[^>]*)?>/i, /<html(\s[^>]*)?>/i, /<!doctype[^>]*>/i]) {
    const m = re.exec(html);
    if (m) {
      const p = m.index + m[0].length;
      return html.slice(0, p) + '\n' + text + html.slice(p);
    }
  }
  return text + '\n' + html;
}

function injectBody(html, text) {
  let i = -1, m;
  let re = /<\/body\s*>/gi;
  while ((m = re.exec(html))) i = m.index;
  if (i === -1) {
    re = /<\/html\s*>/gi;
    while ((m = re.exec(html))) i = m.index;
  }
  if (i === -1) return html + '\n' + text;
  return html.slice(0, i) + text + '\n' + html.slice(i);
}

function buildOutput(tab) {
  if (!tab) return '';
  let html = tab.code || '';
  if (settings.css && tab.css && tab.css.trim()) {
    html = injectHead(html, '<style>\n' + tab.css.replace(/<\/style/gi, '<\\/style') + '\n</style>');
  }
  if (settings.js && tab.js && tab.js.trim()) {
    html = injectBody(html, '<script>\n' + tab.js.replace(/<\/script/gi, '<\\/script') + '\n<\/script>');
  }
  return html;
}

/* TAB SEARCH */
function toggleTabSearch() {
  const dd = $('tabSearchDropdown');
  if (dd.classList.toggle('open')) {
    filterTabSearch();
    $('tabSearchInput').focus();
  }
}

function filterTabSearch() {
  const q = $('tabSearchInput').value.toLowerCase();
  const list = $('tabSearchList');
  list.innerHTML = '';
  tabs.filter(t => t.name.toLowerCase().includes(q)).forEach(t => {
    const item = document.createElement('div');
    item.className = 'tab-search-item' + (t.id === activeId ? ' active-item' : '');
    item.textContent = t.name;
    item.addEventListener('click', () => {
      $('tabSearchDropdown').classList.remove('open');
      switchTab(t.id);
    });
    list.appendChild(item);
  });
  if (!list.children.length) {
    const empty = document.createElement('div');
    empty.className = 'tab-search-item';
    empty.style.color = '#475569';
    empty.textContent = 'No tabs found';
    list.appendChild(empty);
  }
}

document.addEventListener('click', e => {
  const btn = $('tabSearchBtn');
  const dd = $('tabSearchDropdown');
  if (!btn.contains(e.target) && !dd.contains(e.target)) dd.classList.remove('open');
});

/* SESSION EXPORT / IMPORT */
function exportSession() {
  flushActiveCode();
  const blob = new Blob([JSON.stringify({ tabs, activeId }, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'html-editor-session.json';
  a.click();
}

function importSession(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const bundle = JSON.parse(e.target.result);
      if (!Array.isArray(bundle.tabs) || !bundle.tabs.length) throw new Error('bad');
      tabs = bundle.tabs;
      normalizeTabs();
      activeId = bundle.activeId || tabs[0].id;
      saveTabs();
      loadActiveCode();
      renderTabs();
      updateLineNumbers();
      run();
    } catch {
      showDialog({ title: 'Import failed', message: 'That is not a valid session file.', alertOnly: true });
    }
  };
  reader.readAsText(file);
  event.target.value = '';
}

/* LINE NUMBERS */
function updateLineNumbers() {
  const lines = codeBox.value.split('\n').length;
  const ln = $('lineNumbers');
  let out = '';
  for (let i = 1; i <= lines; i++) out += i + '\n';
  ln.textContent = out;
  ln.scrollTop = codeBox.scrollTop;
  updateStats();
}

/* DRAGGABLE DIVIDER */
(function () {
  const divider = $('divider');
  const mainArea = $('mainArea');
  const leftPane = $('leftPane');
  let dragging = false, startX = 0, startLeftW = 0;

  const savedPct = parseFloat(localStorage.getItem('html_editor_split'));
  leftPane.style.width = (isNaN(savedPct) ? 50 : savedPct) + '%';

  divider.addEventListener('mousedown', e => {
    dragging = true;
    startX = e.clientX;
    startLeftW = leftPane.getBoundingClientRect().width;
    divider.classList.add('dragging');
    mainArea.classList.add('is-resizing');
    e.preventDefault();
  });

  document.addEventListener('mousemove', e => {
    if (!dragging) return;
    const totalW = mainArea.getBoundingClientRect().width;
    const minW = 80;
    const newLeftW = Math.max(minW, Math.min(totalW - minW - 5, startLeftW + e.clientX - startX));
    const pct = (newLeftW / totalW) * 100;
    leftPane.style.width = pct + '%';
    localStorage.setItem('html_editor_split', pct.toFixed(2));
  });

  document.addEventListener('mouseup', () => {
    if (!dragging) return;
    dragging = false;
    divider.classList.remove('dragging');
    mainArea.classList.remove('is-resizing');
  });
})();

/* EDITOR CORE */
let saveTimer;
function save() {
  flushActiveCode();
  clearTimeout(saveTimer);
  saveTimer = setTimeout(saveTabs, 300);
}
window.addEventListener('beforeunload', () => { flushActiveCode(); saveTabs(); });

function run() {
  save();
  const doc = iframe.contentDocument || iframe.contentWindow.document;
  doc.open();
  doc.write(buildOutput(activeTab()));
  doc.close();
}

codeBox.addEventListener('keydown', e => {
  if (e.key === 'Tab') {
    e.preventDefault();
    const s = codeBox.selectionStart;
    const v = codeBox.value;
    codeBox.value = v.slice(0, s) + '  ' + v.slice(codeBox.selectionEnd);
    codeBox.selectionStart = codeBox.selectionEnd = s + 2;
    updateLineNumbers();
    if (auto) run();
  }
});

codeBox.addEventListener('input', () => {
  updateLineNumbers();
  if (auto) run();
  else save();
});

codeBox.addEventListener('scroll', () => {
  $('lineNumbers').scrollTop = codeBox.scrollTop;
});

function openTab() {
  flushActiveCode();
  const win = window.open('about:blank', '_blank');
  if (!win) return;
  win.document.open();
  win.document.write(buildOutput(activeTab()));
  win.document.close();
}

async function resetCode() {
  if (settings.confirmReset) {
    const multi = settings.css || settings.js;
    const name = activeTab()?.name || 'this tab';
    const ok = await showDialog({
      title: multi ? `Reset ${FILES[curFile].label}?` : 'Reset this tab?',
      message: multi
        ? `This clears the ${FILES[curFile].label} code in "${name}". This can't be undone.`
        : `All the code in "${name}" will be cleared. This can't be undone.`,
      confirmText: 'Reset',
      danger: true
    });
    if (!ok) return;
  }
  codeBox.value = '';
  updateLineNumbers();
  run();
}

function toggleAuto() {
  auto = !auto;
  $('autoToggle').classList.toggle('on', auto);
}

function exportCode() {
  flushActiveCode();
  const name = (activeTab()?.name || 'index').replace(/[^a-z0-9_\-]/gi, '_');
  const blob = new Blob([buildOutput(activeTab())], { type: 'text/html' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = name + '.html';
  a.click();
}

// Import goes into whichever file (HTML/CSS/JS) is currently showing
function importCode(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    codeBox.value = e.target.result;
    updateLineNumbers();
    run();
  };
  reader.readAsText(file);
  event.target.value = '';
}

/* INIT */
loadSettings();
loadTabs();
loadActiveCode();
renderFileSwitch();
renderTabs();
updateLineNumbers();
run();
</script>
