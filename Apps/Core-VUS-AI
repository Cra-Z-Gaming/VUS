const mk = (tag, cls, props) => Object.assign(document.createElement(tag), props || {}, cls ? { className: cls } : {});

function draftFor(id) {
  if (!drafts[id]) drafts[id] = loadSavedKeys(id).map(k => ({ label: k.label, key: k.key, show: false }));
  return drafts[id];
}

// What to show under a key: [css class, text]
function draftStatus(id, d) {
  if (d.busy) return ['checking', 'Checking...'];
  const key = d.key.trim();
  if (!key) return ['', 'Paste a key above'];
  const s = ksGet(id, key);
  if (s && s.s === 'active') return ['active', 'Working. Click to check again.'];
  if (s && s.s === 'inactive') return ['inactive', 'Rejected' + (s.msg ? ': ' + s.msg : '') + '. Click to check again.'];
  return ['', d.note || 'Not checked yet. Click to check.'];
}

// One row per key: a name you can edit, the key, show/hide, remove, and its status
function renderKeyRows() {
  const id = providerSelect.value;
