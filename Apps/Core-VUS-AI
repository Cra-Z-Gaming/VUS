/* ── Pictures ──
   Attach with the 📎 button, paste with Ctrl+V (the message box doesn't need focus) or drop
   them on the page. They are shrunk first so the request stays small. */
const MAX_IMAGES   = 4;
const fileInput   = document.getElementById('fileInput');
const attachStrip = document.getElementById('attachStrip');
const attachMsg   = document.getElementById('attachMsg');
let attachments    = [];      // data URLs waiting to be sent
let attachMsgTimer = null;

function flashAttach(text) {
  attachMsg.textContent = text;
  attachMsg.classList.add('show');
  clearTimeout(attachMsgTimer);
  attachMsgTimer = setTimeout(() => attachMsg.classList.remove('show'), 4000);
}

function prepareImage(file) {
  return new Promise((resolve, reject) => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => {
      URL.revokeObjectURL(url);
      const scale = Math.min(1, 1280 / Math.max(img.naturalWidth, img.naturalHeight));
      const c = document.createElement('canvas');
      c.width  = Math.max(1, Math.round(img.naturalWidth * scale));
      c.height = Math.max(1, Math.round(img.naturalHeight * scale));
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#fff';   // transparent areas would turn black as a JPEG
      ctx.fillRect(0, 0, c.width, c.height);
      ctx.drawImage(img, 0, 0, c.width, c.height);
      resolve(c.toDataURL('image/jpeg', 0.82));
    };
    img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('unreadable')); };
    img.src = url;
  });
}

async function addImages(files) {
  const types = ['image/png', 'image/jpeg', 'image/webp', 'image/gif', 'image/bmp'];
  const pics = [...files].filter(f => types.includes(f.type));
  if (!pics.length) { flashAttach('Only PNG, JPEG, WebP, GIF or BMP pictures can be attached.'); return; }
  for (const f of pics) {
    const full = () => { flashAttach('You can attach up to ' + MAX_IMAGES + ' pictures per message.'); };
    if (attachments.length >= MAX_IMAGES) { full(); break; }
    try {
      const url = await prepareImage(f);
      if (attachments.length >= MAX_IMAGES) { full(); break; }
      attachments.push(url);
      renderAttachments();
    } catch (e) {
      flashAttach(`Could not read ${f.name || 'that picture'}.`);
    }
  }
}

function renderAttachments() {
  attachStrip.innerHTML = '';
  attachStrip.classList.toggle('has', attachments.length > 0);
  attachments.forEach((src, i) => {
    const box = mk('div', 'att');
    const im  = mk('img', '', { src, alt: 'Attached picture ' + (i + 1) });
    const x   = mk('button', '', { type: 'button', textContent: '✕', title: 'Remove' });
    x.addEventListener('click', () => { attachments.splice(i, 1); renderAttachments(); });
    box.append(im, x);
    attachStrip.appendChild(box);
  });
}

document.getElementById('attachBtn').addEventListener('click', () => fileInput.click());
fileInput.addEventListener('change', () => { addImages(fileInput.files); fileInput.value = ''; });

const isTypingTarget = t => !!t && (t.isContentEditable || (t.matches && t.matches('input, textarea, select')));
const popupOpen = () => keyModalBg.classList.contains('open') || modalBg.classList.contains('open');

function clipboardImages(cd) {
  const out = [...((cd && cd.files) || [])].filter(f => f.type.startsWith('image/'));
  if (out.length) return out;
  return [...((cd && cd.items) || [])].filter(i => i.kind === 'file' && i.type.startsWith('image/')).map(i => i.getAsFile()).filter(Boolean);
}

// Ctrl+V works anywhere on the page. A picture is attached; text pasted while nothing is focused goes into the message box.
document.addEventListener('paste', e => {
  if (popupOpen()) return;
  const cd = e.clipboardData;
  const text = cd ? cd.getData('text/plain') : '';
  const files = clipboardImages(cd);
  if (files.length && !text) { e.preventDefault(); addImages(files); return; }
  if (text && !isTypingTarget(e.target)) {
    e.preventDefault();
    inputEl.focus();
    inputEl.setRangeText(text, inputEl.selectionStart, inputEl.selectionEnd, 'end');
    inputEl.dispatchEvent(new Event('input'));
  }
});

// Drop pictures anywhere on the page
document.addEventListener('dragover', e => {
  if (e.dataTransfer && [...e.dataTransfer.types].includes('Files')) e.preventDefault();
});
document.addEventListener('drop', e => {
  if (popupOpen() || !e.dataTransfer || !e.dataTransfer.files.length) return;
  e.preventDefault();
  addImages(e.dataTransfer.files);
});

// Start typing anywhere and the letters go into the message box
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && keyModalBg.classList.contains('open')) { closeKeyModal(); return; }
  if (!e.key || e.ctrlKey || e.metaKey || e.altKey || e.key.length !== 1) return;   // plain typing only
  if (popupOpen() || isTypingTarget(e.target)) return;
  inputEl.focus();   // the key you pressed then lands in the message box
});

/* ════════════════════════════════════════
   MARKDOWN-LITE RENDERER
════════════════════════════════════════ */
function renderText(raw) {
  // Escape everything first, then add formatting. Code is stashed so it is only escaped once.
  const blocks = [];
  const stash = html => '%%VUSBLK' + (blocks.push(html) - 1) + '%%';
  let out = raw.replace(/```(\w*)\n?([\s\S]*?)```/g, (_, _lang, code) =>
    stash(`<pre><code>${escHtml(code.trim())}</code></pre>`)
  );
  out = out.replace(/`([^`]+)`/g, (_, c) => stash(`<code>${escHtml(c)}</code>`));
  out = escHtml(out);
  out = out.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
  out = out.replace(/\n/g, '<br>');
  out = out.replace(/%%VUSBLK(\d+)%%/g, (m, i) => blocks[+i] ?? m);
  return out;
}

function escHtml(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

