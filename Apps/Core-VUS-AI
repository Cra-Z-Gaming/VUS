<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VUS AI</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@700;800;900&display=swap" rel="stylesheet">
<style>
:root {
  --bg:      #0a0a0d;
  --surface: #101014;
  --panel:   #141418;
  --border:  #202026;
  --accent:  #00ff88;
  --acc-dim: rgba(0,255,136,.10);
  --text:    #dcdcee;
  --muted:   #42425a;
  --red:     #ff3355;
  --blue:    #4488ff;
  --gold:    #ffcc00;
  --mono:    'Space Mono', monospace;
  --display: 'Syne', sans-serif;
  --r:       8px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; overflow: hidden; }

body {
  font-family: var(--mono);
  background: var(--bg);
  color: var(--text);
  display: flex;
  flex-direction: column;
}

body::after {
  content: '';
  position: fixed;
  inset: 0;
  background: repeating-linear-gradient(
    0deg, transparent, transparent 3px,
    rgba(0,0,0,.04) 3px, rgba(0,0,0,.04) 4px
  );
  pointer-events: none;
  z-index: 9000;
}

/* ── Top Bar ── */
#topbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 14px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  flex-wrap: wrap;
}

.wordmark {
  font-family: var(--display);
  font-size: 20px;
  font-weight: 900;
  letter-spacing: -2px;
  color: var(--accent);
  text-shadow: 0 0 20px rgba(0,255,136,.45);
  white-space: nowrap;
}
.wordmark sup {
  font-family: var(--mono);
  font-size: 9px;
  font-weight: 700;
  color: var(--muted);
  letter-spacing: 1px;
  vertical-align: super;
}

/* ── Topbar buttons ── */
.tb-btn {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--r);
  color: var(--muted);
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 700;
  padding: 5px 11px;
  cursor: pointer;
  transition: color .15s, border-color .15s, background .15s;
  white-space: nowrap;
  letter-spacing: .3px;
}
.tb-btn:hover { color: var(--text); border-color: #42425a; }
.tb-btn.danger:hover { color: var(--red); border-color: var(--red); background: rgba(255,51,85,.06); }
.tb-btn.hub-btn:hover { color: var(--accent); border-color: var(--accent); background: var(--acc-dim); }
.tb-btn:disabled { opacity: .35; cursor: not-allowed; }

/* ── VUS AI button — red themed ── */
.tb-btn.ai-btn {
  color: var(--red);
  border-color: var(--red);
  background: rgba(255,51,85,.06);
}
.tb-btn.ai-btn:hover {
  color: #fff;
  border-color: var(--red);
  background: rgba(255,51,85,.15);
  box-shadow: 0 0 8px rgba(255,51,85,.30);
}

/* ── CHECK button — accent themed ── */
.tb-btn.check-btn {
  color: var(--accent);
  border-color: var(--accent);
  background: var(--acc-dim);
}
.tb-btn.check-btn:hover:not(:disabled) {
  background: rgba(0,255,136,.18);
  box-shadow: 0 0 8px rgba(0,255,136,.30);
}
.tb-btn.check-btn.checking {
  color: var(--gold);
  border-color: var(--gold);
  background: rgba(255,204,0,.08);
}

.tb-spacer { margin-left: auto; }

/* ── Generic Dropdown (used by both Key selector and Model selector) ── */
.dd-wrap { position: relative; }

.dd-btn {
  display: flex;
  align-items: center;
  gap: 6px;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--r);
  color: var(--text);
  font-family: var(--mono);
  font-size: 10px;
  font-weight: 700;
  padding: 5px 11px;
  cursor: pointer;
  transition: border-color .15s;
  white-space: nowrap;
  max-width: 220px;
}
.dd-btn:hover { border-color: var(--accent); }
.dd-btn .dd-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 160px;
}
.dd-btn .k-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--muted);
  flex-shrink: 0;
  transition: background .2s;
}
.dd-btn .k-dot.active    { background: var(--accent); box-shadow: 0 0 6px var(--accent); }
.dd-btn .k-dot.inactive  { background: var(--red); }
.dd-btn .k-dot.checking  { background: var(--gold); animation: pulse 1s infinite; }
.dd-btn .k-caret { font-size: 8px; color: var(--muted); flex-shrink: 0; }

@keyframes pulse {
  0%,100% { opacity: 1; }
  50%     { opacity: .35; }
}

.dd-menu {
  display: none;
  position: absolute;
  top: calc(100% + 5px);
  left: 0;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--r);
  min-width: 200px;
  max-height: 320px;
  overflow-y: auto;
  z-index: 500;
  box-shadow: 0 8px 24px rgba(0,0,0,.5);
  animation: fadeUp .12s ease;
}
.dd-menu.open { display: block; }

.km-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  font-size: 11px;
  cursor: pointer;
  color: var(--muted);
  transition: background .1s, color .1s;
  user-select: none;
}
.km-item:hover { background: var(--border); color: var(--text); }
.km-item.selected { color: var(--accent); }
.km-item.dimmed { opacity: .45; }
.km-item .km-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.km-item .km-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--muted);
  flex-shrink: 0;
}
.km-item .km-dot.active    { background: var(--accent); box-shadow: 0 0 5px var(--accent); }
.km-item .km-dot.inactive  { background: var(--red); }
.km-item .km-dot.unchecked { background: var(--muted); }
.km-item .km-dot.checking  { background: var(--gold); animation: pulse 1s infinite; }
.km-item .km-status {
  margin-left: auto;
  font-size: 9px;
  letter-spacing: .3px;
  flex-shrink: 0;
}
.km-item .km-status.active    { color: var(--accent); }
.km-item .km-status.inactive  { color: var(--red); }
.km-item .km-status.unchecked { color: var(--muted); }
.km-item .km-status.checking  { color: var(--gold); }
.km-item.km-action { color: var(--muted); font-style: normal; border-top: 1px solid var(--border); }
.km-item.km-action:hover { color: var(--accent); }

/* ── Search Bar ── */
#searchBar {
  display: none;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
#searchBar.open { display: flex; }

#searchInput {
  flex: 1;
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--r);
  color: var(--text);
  font-family: var(--mono);
  font-size: 11px;
  padding: 6px 11px;
  outline: none;
  transition: border-color .2s;
}
#searchInput:focus { border-color: var(--accent); }
#searchInput::placeholder { color: var(--muted); }

#searchCount {
  font-size: 10px;
  color: var(--muted);
  white-space: nowrap;
  min-width: 52px;
  text-align: center;
}

.srch-btn {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--r);
  color: var(--muted);
  font-size: 12px;
  width: 26px; height: 26px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: color .15s, border-color .15s;
  flex-shrink: 0;
}
.srch-btn:hover { color: var(--accent); border-color: var(--accent); }
.srch-btn:disabled { opacity: .3; cursor: not-allowed; }

#searchClose {
  background: none;
  border: none;
  color: var(--muted);
  font-size: 14px;
  cursor: pointer;
  padding: 0 3px;
  transition: color .15s;
}
#searchClose:hover { color: var(--red); }

/* search highlight */
.hl { background: rgba(255,204,0,.3); border-radius: 2px; }
.hl.current { background: rgba(255,204,0,.7); color: #000; border-radius: 2px; }

/* ── Chat Area ── */
#chat {
  flex: 1;
  overflow-y: auto;
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  scrollbar-width: thin;
  scrollbar-color: var(--border) transparent;
}
#chat::-webkit-scrollbar { width: 4px; }
#chat::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

/* ── Messages ── */
.msg {
  display: flex;
  gap: 10px;
  max-width: min(760px, 100%);
  animation: fadeUp .18s ease;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.msg.user { align-self: flex-end; flex-direction: row-reverse; }
.msg.assistant { align-self: flex-start; }

.avatar {
  width: 28px; height: 28px;
  border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  font-size: 11px; font-weight: 700;
  flex-shrink: 0; margin-top: 2px;
}
.msg.user .avatar { background: var(--blue); color: #fff; }
.msg.assistant .avatar {
  background: var(--acc-dim);
  border: 1px solid rgba(0,255,136,.25);
  color: var(--accent);
  font-family: var(--display);
  font-size: 9px; letter-spacing: .5px;
}

.bubble {
  padding: 10px 14px;
  border-radius: var(--r);
  font-size: 13px;
  line-height: 1.75;
  min-width: 0;                 /* lets the bubble shrink to the row, so only very long words wrap */
  overflow-wrap: break-word;    /* wrap long words only when they don't fit, never letter-by-letter */
  white-space: pre-wrap;
}
.msg.user .bubble { background: var(--blue); color: #fff; border-bottom-right-radius: 2px; }
.msg.assistant .bubble { background: var(--panel); border: 1px solid var(--border); color: var(--text); border-bottom-left-radius: 2px; }

.bubble code {
  font-family: var(--mono); font-size: 11px;
  background: var(--bg); border: 1px solid var(--border);
  border-radius: 4px; padding: 1px 5px; color: var(--accent);
}
.bubble pre {
  background: var(--bg); border: 1px solid var(--border);
  border-radius: var(--r); padding: 10px 12px;
  overflow-x: auto; margin: 6px 0;
  font-size: 11px; line-height: 1.6; white-space: pre;
}
.bubble pre code { background: none; border: none; padding: 0; color: var(--text); }

.typing-dots { display: flex; gap: 4px; padding: 4px 2px; align-items: center; }
.typing-dots span {
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--accent); animation: dot .9s infinite;
}
.typing-dots span:nth-child(2) { animation-delay: .15s; }
.typing-dots span:nth-child(3) { animation-delay: .3s; }
@keyframes dot {
  0%,60%,100% { opacity:.2; transform:scale(.8); }
  30% { opacity:1; transform:scale(1); }
}

/* ── Welcome ── */
#welcome {
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 14px; flex: 1; text-align: center; padding: 40px 20px;
}
.w-logo {
  font-family: var(--display); font-size: 48px;
  font-weight: 900; letter-spacing: -4px;
  color: var(--accent); text-shadow: 0 0 40px rgba(0,255,136,.4); line-height: 1;
}
.w-sub { font-size: 12px; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; }

/* ── Confirm Modal ── */
#modalBg {
  display: none;
  position: fixed; inset: 0;
  background: rgba(0,0,0,.7);
  z-index: 8000;
  align-items: center; justify-content: center;
  backdrop-filter: blur(4px);
}
#modalBg.open { display: flex; }
.modal {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 24px 22px;
  max-width: 340px; width: calc(100% - 32px);
  text-align: center;
  box-shadow: 0 20px 50px rgba(0,0,0,.6);
  animation: fadeUp .16s ease;
}
.modal h3 { font-family: var(--display); font-size: 16px; font-weight: 800; margin-bottom: 8px; color: var(--text); }
.modal p { font-size: 11px; color: var(--muted); line-height: 1.8; margin-bottom: 20px; }
.modal-btns { display: flex; gap: 8px; justify-content: center; }
.m-btn {
  padding: 8px 20px; border-radius: var(--r);
  font-family: var(--mono); font-size: 11px; font-weight: 700;
  cursor: pointer; border: 1px solid transparent; transition: all .15s;
}
.m-cancel { background: var(--surface); border-color: var(--border); color: var(--muted); }
.m-cancel:hover { color: var(--text); border-color: #42425a; }
.m-confirm { background: rgba(255,51,85,.15); border-color: var(--red); color: var(--red); }
.m-confirm:hover { background: rgba(255,51,85,.25); }

/* ── My Key ── */
.tb-btn.mykey-btn.has-key { color: var(--accent); border-color: var(--accent); }

#keyModalBg {
  display: none;
  position: fixed; inset: 0;
  background: rgba(0,0,0,.7);
  z-index: 8000;
  align-items: center; justify-content: center;
  backdrop-filter: blur(4px);
}
#keyModalBg.open { display: flex; }
.modal.key-modal { max-width: 400px; text-align: left; }
.modal.key-modal h3 { text-align: center; }
.modal.key-modal p { margin-bottom: 12px; }
.key-input {
  width: 100%;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r);
  color: var(--text);
  font-family: var(--mono);
  font-size: 11px;
  padding: 9px 11px;
  outline: none;
  margin-bottom: 10px;
  transition: border-color .2s;
}
.key-input:focus { border-color: var(--accent); }
.key-input::placeholder { color: var(--muted); }
.key-opt { display: flex; align-items: center; gap: 8px; font-size: 10px; color: var(--muted); cursor: pointer; margin-bottom: 10px; }
.key-msg { font-size: 10px; line-height: 1.6; min-height: 16px; margin-bottom: 14px; }
.key-msg.ok   { color: var(--accent); }
.key-msg.err  { color: var(--red); }
.key-msg.wait { color: var(--gold); }
.m-save { background: var(--acc-dim); border-color: var(--accent); color: var(--accent); }
.m-save:hover:not(:disabled) { background: rgba(0,255,136,.2); }
.m-save:disabled { opacity: .4; cursor: not-allowed; }

.key-link { display: inline-block; color: var(--accent); font-size: 11px; margin-bottom: 12px; }
select.key-input { cursor: pointer; }
.switch-note { color: var(--gold); font-size: 11px; margin-bottom: 6px; }

/* ── Key rows in the My Key popup ── */
.modal.key-modal { max-width: 460px; max-height: 92vh; overflow-y: auto; scrollbar-width: thin; }
.kr { margin-bottom: 8px; }
.kr-top { display: flex; gap: 6px; align-items: center; }
.kr-top .key-input { margin-bottom: 0; min-width: 0; }
.kr-label { width: 84px; flex-shrink: 0; }
.kr-key { flex: 1 1 0; width: auto; }
.kr-btn {
  width: 30px; height: 30px; flex-shrink: 0;
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--r);
  color: var(--muted); font-size: 12px; cursor: pointer; transition: color .15s, border-color .15s;
}
.kr-btn:hover { color: var(--text); border-color: #42425a; }
.kr-btn.del:hover { color: var(--red); border-color: var(--red); }
.kr-status { font-size: 10px; margin: 3px 0 0 2px; color: var(--muted); cursor: pointer; user-select: none; overflow-wrap: anywhere; }
.kr-status.active   { color: var(--accent); }
.kr-status.inactive { color: var(--red); }
.kr-status.checking { color: var(--gold); }
.kr-tools { display: flex; gap: 8px; margin: 4px 0 12px; }
.kr-tools .m-btn { flex: 1; padding: 8px 12px; }
.kr-tools .m-btn:disabled { opacity: .4; cursor: not-allowed; }

/* ── Pictures ── */
#attachMsg { display: none; font-size: 10px; color: var(--gold); margin-bottom: 6px; }
#attachMsg.show { display: block; }
#attachStrip { display: none; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
#attachStrip.has { display: flex; }
.att { position: relative; width: 56px; height: 56px; border-radius: 6px; overflow: hidden; border: 1px solid var(--border); }
.att img { width: 100%; height: 100%; object-fit: cover; display: block; }
.att button {
  position: absolute; top: 2px; right: 2px; width: 16px; height: 16px; padding: 0;
  border: none; border-radius: 50%; background: rgba(0,0,0,.75); color: #fff;
  font-size: 9px; line-height: 16px; cursor: pointer;
}
.att button:hover { background: var(--red); }
#attachBtn {
  width: 32px; height: 32px; flex-shrink: 0; border-radius: 6px;
  background: transparent; border: 1px solid var(--border); color: var(--muted);
  font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: color .15s, border-color .15s;
}
#attachBtn:hover { color: var(--accent); border-color: var(--accent); }
.bubble img.att-img { display: block; max-width: min(240px, 100%); max-height: 200px; border-radius: 6px; margin: 0 0 8px; }

/* ── Input Area ── */
#inputArea {
  padding: 12px 16px 14px;
  background: var(--surface);
  border-top: 1px solid var(--border);
  flex-shrink: 0;
}
#inputRow {
  display: flex; gap: 8px; align-items: flex-end;
  background: var(--panel); border: 1px solid var(--border);
  border-radius: 10px; padding: 8px 10px 8px 14px;
  transition: border-color .2s;
}
#inputRow:focus-within { border-color: var(--accent); }

#msgInput {
  flex: 1; background: transparent; border: none; outline: none;
  color: var(--text); font-family: var(--mono); font-size: 12px;
  resize: none; min-height: 20px; max-height: 140px;
  line-height: 1.6; scrollbar-width: none;
}
#msgInput::placeholder { color: var(--muted); }
#msgInput::-webkit-scrollbar { display: none; }

#sendBtn {
  width: 32px; height: 32px; border-radius: 6px; border: none;
  background: var(--accent); color: #000; font-size: 14px;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; transition: filter .15s, transform .1s;
}
#sendBtn:hover:not(:disabled) { filter: brightness(1.15); }
#sendBtn:active:not(:disabled) { transform: scale(.93); }
#sendBtn:disabled { opacity: .35; cursor: not-allowed; }

#hint { font-size: 9px; color: var(--muted); text-align: center; margin-top: 7px; letter-spacing: .5px; }
</style>
</head>
<body>

<div id="topbar">
  <div class="wordmark">VUS<sup>AI</sup></div>

  <!-- Model selector -->
  <div id="modelWrap" class="dd-wrap">
    <button id="modelDropBtn" class="dd-btn" onclick="toggleModelMenu()">
      <span class="k-dot unchecked" id="modelActiveDot"></span>
      <span class="dd-label" id="modelActiveLabel">Loading…</span>
      <span class="k-caret">▼</span>
    </button>
    <div id="modelMenu" class="dd-menu"></div>
  </div>

  <button id='refreshBtn' class='tb-btn' onclick='refreshAll()' title='Refresh the model list'>↻</button>

  <!-- Key selector -->
  <div id="keyWrap" class="dd-wrap">
    <button id="keyDropBtn" class="dd-btn" onclick="toggleKeyMenu()">
      <span class="k-dot unchecked" id="activeDot"></span>
      <span class="dd-label" id="activeKeyLabel">Loading…</span>
      <span class="k-caret">▼</span>
    </button>
    <div id="keyMenu" class="dd-menu"></div>
  </div>

  <!-- Check -->
  <button id="checkBtn" class="tb-btn check-btn" onclick="checkAll()" title="Refresh and test all keys and models">⟳ CHECK</button>

  <button id='myKeyBtn' class='tb-btn mykey-btn' onclick='openKeyModal()' title='Choose a provider and add your own API key'>+ My Key</button>

  <span class="tb-spacer"></span>

  <!-- Search -->
  <button class="tb-btn" onclick="toggleSearch()" title="Search chat">⌕ Search</button>

  <!-- Hub -->
  <button class="tb-btn hub-btn" onclick="openHub()" title="Back to VUS Hub">⬡ Hub</button>

  <!-- VUS AI -->
  <button class="tb-btn ai-btn" onclick="openVUSAI()" title="Open VUS AI Assistant">⬡ VUS Help</button>

  <!-- Clear -->
  <button class="tb-btn danger" onclick="promptClear()">✕ Clear</button>
</div>

<!-- Search bar (hidden until toggled) -->
<div id="searchBar">
  <input id="searchInput" type="text" placeholder="Search chat…" autocomplete="off">
  <span id="searchCount">—</span>
  <button class="srch-btn" id="srchUp"   onclick="stepSearch(-1)" title="Previous" disabled>▲</button>
  <button class="srch-btn" id="srchDown" onclick="stepSearch(1)"  title="Next"     disabled>▼</button>
  <button id="searchClose" onclick="toggleSearch()">✕</button>
</div>

<div id="chat">
  <div id="welcome">
    <div class="w-logo">AI</div>
    <div class="w-sub">Powered by Groq · VUS Hub</div>
  </div>
</div>

<!-- Confirm clear modal -->
<div id="modalBg">
  <div class="modal">
    <h3>Clear Chat?</h3>
    <p>If you confirm, your entire conversation will be deleted.<br>You cannot restore your chats.</p>
    <div class="modal-btns">
      <button class="m-btn m-cancel"  onclick="closeModal()">Cancel</button>
      <button class="m-btn m-confirm" onclick="confirmClear()">Clear</button>
    </div>
  </div>
</div>

<!-- My Key modal -->
<div id='keyModalBg'>
  <div class='modal key-modal'>
    <h3>Your API Keys</h3>
    <select id='providerSelect' class='key-input'>
