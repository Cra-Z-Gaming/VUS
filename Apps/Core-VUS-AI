    const label = mk('input', 'key-input kr-label', { value: d.label, maxLength: 24, autocomplete: 'off', spellcheck: false, title: 'Name for this key' });
    const key   = mk('input', 'key-input kr-key', { value: d.key, type: d.show ? 'text' : 'password', placeholder: p.placeholder, autocomplete: 'off', spellcheck: false });
    const eye   = mk('button', 'kr-btn', { type: 'button', textContent: '👁', title: 'Show or hide this key' });
    const del   = mk('button', 'kr-btn del', { type: 'button', textContent: '✕', title: 'Remove this key' });
