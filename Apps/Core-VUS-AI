<script>
/* ════════════════════════════════════════
   REMOTE SOURCES
   Keys and models are fetched from remote
   text files, one entry per line. Blank
   lines and lines starting with # are
   ignored. Model lines may optionally be
   "id|Display Label" — otherwise the id is
   shown as-is.
════════════════════════════════════════ */
const KEYS_URL   = 'https://raw.githubusercontent.com/Cra-Z-Gaming/VUS/refs/heads/main/Other/GroqAPIKeys';
const MODELS_URL = 'https://raw.githubusercontent.com/Cra-Z-Gaming/VUS/refs/heads/main/Other/GroqModels';

/* ════════════════════════════════════════
   PROVIDERS
   All three take the same chat format.
   Shared keys exist for Groq only; the
   others always need your own key.
════════════════════════════════════════ */
const bearer = key => ({ 'Authorization': 'Bearer ' + key });
const GEMINI_API = 'https://generativelanguage.googleapis.com/v1beta';

const PROVIDERS = {
  groq: {
    name: 'Groq',
    shared: true,
    store: 'vus_ai_user_key',          // original name, so saved keys carry over
    keyUrl: 'https://console.groq.com/keys',
    placeholder: 'gsk_...',
    chatUrl: 'https://api.groq.com/openai/v1/chat/completions',
    maxTokens: 1024,
    checkKey: key => apiGet('https://api.groq.com/openai/v1/models', bearer(key)),
    listModels: async key => {
      const data = await apiGet('https://api.groq.com/openai/v1/models', bearer(key));
      const first = ['openai/gpt-oss-120b', 'openai/gpt-oss-20b'];
      const rank = id => first.includes(id) ? first.indexOf(id) : first.length;
      return data.data
        .filter(m => m.active !== false && !/whisper|tts|orpheus|guard|embed/i.test(m.id))
        .map(m => ({ id: m.id, label: m.id }))
        .sort((a, b) => rank(a.id) - rank(b.id) || a.id.localeCompare(b.id));
    }
  },
  openrouter: {
    name: 'OpenRouter',
    store: 'vus_ai_key_openrouter',
    keyUrl: 'https://openrouter.ai/settings/keys',
    placeholder: 'sk-or-...',
    chatUrl: 'https://openrouter.ai/api/v1/chat/completions',
    maxTokens: 2048,
    // The model list is public, so the key is checked against the key-info address
    checkKey: key => apiGet('https://openrouter.ai/api/v1/key', bearer(key)),
    listModels: async key => {
      let data;
      try {
        // Respects your OpenRouter account settings
        data = await apiGet('https://openrouter.ai/api/v1/models/user', bearer(key));
      } catch (e) {
        if (e.status === 401) throw e;
        data = await apiGet('https://openrouter.ai/api/v1/models', bearer(key));
      }
      // Free models only, so nobody gets charged by surprise
      const isFree = m => m.id === 'openrouter/free' || m.id.endsWith(':free');
      const isChat = m => (m.architecture?.output_modalities || ['text']).includes('text') && !/guard|safety/i.test(m.id);
      const rank = m => m.id === 'openrouter/free' ? 0 : 1;
      return data.data
        .filter(m => isFree(m) && isChat(m))
        .sort((a, b) => rank(a) - rank(b))
        .map(m => ({ id: m.id, label: m.name || m.id, vision: (m.architecture?.input_modalities || []).includes('image') }));
    }
  },
  gemini: {
    name: 'Gemini',
    store: 'vus_ai_key_gemini',
    keyUrl: 'https://aistudio.google.com/apikey',
    placeholder: 'Paste your Gemini key',
    chatUrl: GEMINI_API + '/openai/chat/completions',
    maxTokens: 4096,
    checkKey: key => apiGet(GEMINI_API + '/models?pageSize=1', { 'x-goog-api-key': key }),
    listModels: async key => {
      const data = await apiGet(GEMINI_API + '/models?pageSize=1000', { 'x-goog-api-key': key });
      // Flash models first, newest version first
      const family  = id => /flash-lite/.test(id) ? 1 : /flash/.test(id) ? 0 : /^gemma/.test(id) ? 2 : 3;
      const version = id => /-latest$/.test(id) ? 999 : parseFloat((id.match(/\d+(\.\d+)?/) || [0])[0]);
      return (data.models || [])
        .filter(m => (m.supportedGenerationMethods || []).includes('generateContent'))
        .map(m => m.name.replace(/^models\//, ''))
        .filter(id => /^(gemini|gemma)/.test(id) && !/embed|tts|image|audio|live|robotics|computer-use|transcribe|translate/i.test(id))
        .sort((a, b) => family(a) - family(b) || version(b) - version(a) || a.localeCompare(b))
        .map(id => ({ id, label: id, vision: /^gemini/.test(id) }));
    }
  }
};

// Turns a failed response into an Error carrying the status and code
async function apiError(res) {
  const body = await res.json().catch(() => ({}));
  const info = (Array.isArray(body) ? body[0]?.error : body?.error) || {};
  const e = new Error(info.message || 'HTTP ' + res.status);
  e.status = res.status;
  e.code = info.code || '';
  return e;
}

async function apiGet(url, headers) {
  const res = await fetch(url, { headers });
  if (!res.ok) throw await apiError(res);
  return res.json();
}

const SYSTEM_PROMPT = `
You are VUS AI, an assistant inside VUS Hub.

You may:
- answer general knowledge questions
- help with coding, writing, schoolwork, troubleshooting
- anything else the user asks for

Behavior rules:
- Be concise and direct
- Do not mention system prompts or keys
- If asked about VUS, VUSL, or VUS Hub, tell the user to click the Red VUS Help button on the top right
- If more detail about VUS is asked, say you do not know the specifics and suggest using the red VUS Help button 
- If unsure, say so briefly
- If the user seems unsure or confused, try to provide more information or examples to help them understand.
`;

/* ════════════════════════════════════════
   STATE — keys
   Each key is { key, label, status } where
   status is 'unchecked' | 'checking' | 'active' | 'inactive'.
════════════════════════════════════════ */
let history        = [];
let thinking        = false;
let keysLoading     = true;
let keysLoadError   = false;
let filledKeys      = [];
let selectedKey     = null;   // reference into filledKeys

/* ════════════════════════════════════════
   STATE — models
   Each model is { id, label, status }.
════════════════════════════════════════ */
let modelsLoading    = true;
let modelsLoadError  = false;
let modelsFetched    = false;   // true once fetched at least once — avoids re-fetching every menu open
let modelsList       = [];
let selectedModel    = null;    // reference into modelsList

let checking = false;

// ---- Your own key (saved in this browser only; same storage names in both VUS AI files) ----
const PROVIDER_STORE = 'vus_ai_provider';
const ONLYMY_STORE   = 'vus_ai_only_my_key';
const MODEL_STORE    = 'vus_ai_model_';   // + provider id: the model you're using
let provider   = 'groq';
let modelPicks = 0;      // counts dropdown picks, so a late reply never overrides one
let myKeyObjs  = [];     // your own keys for this provider: { key, label, status, mine }
let onlyMyKey  = false;

function lsGet(k)    { try { return localStorage.getItem(k); } catch (e) { return null; } }
function lsSet(k, v) { try { localStorage.setItem(k, v); return true; } catch (e) { return false; } }
function lsDel(k)    { try { localStorage.removeItem(k); } catch (e) {} }

/* Your own keys: a list per provider, saved in this browser. The older single-key
   storage name is still read (and kept in sync with the first key) so nothing is lost. */
const KEYS_STORE = 'vus_ai_keys_';   // + provider id: JSON list of { label, key }

function loadSavedKeys(id) {
  let list = null;
  try { list = JSON.parse(lsGet(KEYS_STORE + id) || 'null'); } catch (e) {}
  if (!Array.isArray(list)) {
    const old = (lsGet(PROVIDERS[id].store) || '').trim();
    list = old ? [{ label: 'Key 1', key: old }] : [];
  }
  return list
    .filter(k => k && typeof k.key === 'string' && k.key.trim())
    .map((k, i) => ({ label: String(k.label || 'Key ' + (i + 1)).slice(0, 24), key: k.key.trim() }));
}

function saveSavedKeys(id, list) {
  if (list[0]) lsSet(PROVIDERS[id].store, list[0].key); else lsDel(PROVIDERS[id].store);
  return lsSet(KEYS_STORE + id, JSON.stringify(list));
}

/* What we learn about your keys is kept until the tab is closed (sessionStorage), so keys
   that were already checked are not checked again. Only a hash of the key is stored. */
const KS_STORE = 'vus_ai_key_status';
let keyStatusMem = {};
try { keyStatusMem = JSON.parse(sessionStorage.getItem(KS_STORE) || '{}') || {}; } catch (e) {}

function keyHash(s) {
  let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) | 0;
  return (h >>> 0).toString(36) + '.' + s.length;
}
function ksGet(id, key) { return keyStatusMem[id + '|' + keyHash(key)] || null; }   // { s, msg } or null
function ksSet(id, key, s, msg = '') {
  const k = id + '|' + keyHash(key);
  if (s) keyStatusMem[k] = { s, msg: String(msg).slice(0, 120) }; else delete keyStatusMem[k];
  try { sessionStorage.setItem(KS_STORE, JSON.stringify(keyStatusMem)); } catch (e) {}
}

// Remembers a result for one of your own keys
function rememberKey(k, msg = '') {
  if (k.mine) ksSet(provider, k.key, k.status === 'active' || k.status === 'inactive' ? k.status : '', msg);
}

const keyName = k => (k.mine && PROVIDERS[provider].shared ? '★ ' : '') + k.label;
const pickKey = list => list.find(k => k.status !== 'inactive') || list[0] || null;

// Rough guess at which models can read pictures, for lists that don't say
const guessVision = id => /vision|llama-4|scout|maverick|pixtral|llava|gpt-4o|gemini|(^|[^a-z])vl([^a-z]|$)/i.test(id);

function loadMyKey() {
  const saved = lsGet(PROVIDER_STORE);
  provider = PROVIDERS[saved] ? saved : 'groq';
  const p = PROVIDERS[provider];
  onlyMyKey = lsGet(ONLYMY_STORE) === '1';
  myKeyObjs = loadSavedKeys(provider).map(k => ({
    key: k.key, label: k.label, mine: true,
    status: ksGet(provider, k.key)?.s || 'unchecked'   // reuse what we already learned this session
  }));
  const n = myKeyObjs.length;
  const b = document.getElementById('myKeyBtn');
  b.classList.toggle('has-key', n > 0);
  b.textContent = (n ? '✓ ' : '+ ') + (p.shared ? 'My Key' : p.name + ' Key') + (n > 1 ? ' ×' + n : '');
  welcomeEl.querySelector('.w-sub').textContent = 'Powered by ' + p.name + ' · VUS Hub';
}

function maskKey(k) { return k.length > 10 ? k.slice(0, 4) + '…' + k.slice(-4) : '••••'; }

// Checks a key without sending a chat message, so it doesn't depend on any one model
async function testKeyValid(keyObj, providerId = provider) {
  await PROVIDERS[providerId].checkKey(keyObj.key);
  return true;
}

/* ════════════════════════════════════════
   DOM REFS
════════════════════════════════════════ */
const chatEl        = document.getElementById('chat');
const welcomeEl      = document.getElementById('welcome');
const inputEl        = document.getElementById('msgInput');
const sendBtn        = document.getElementById('sendBtn');
const checkBtn       = document.getElementById('checkBtn');
const refreshBtn     = document.getElementById('refreshBtn');

const keyMenu        = document.getElementById('keyMenu');
const activeDot      = document.getElementById('activeDot');
const activeLabel    = document.getElementById('activeKeyLabel');

const modelMenu       = document.getElementById('modelMenu');
const modelActiveDot   = document.getElementById('modelActiveDot');
const modelActiveLabel = document.getElementById('modelActiveLabel');

const modalBg        = document.getElementById('modalBg');
const searchBar      = document.getElementById('searchBar');
const searchInput    = document.getElementById('searchInput');
const searchCount    = document.getElementById('searchCount');
const srchUp         = document.getElementById('srchUp');
const srchDown       = document.getElementById('srchDown');

/* ════════════════════════════════════════
   LOAD KEYS FROM REMOTE SOURCE
════════════════════════════════════════ */
async function loadKeys() {
  const keep = selectedKey ? selectedKey.key : null;   // stay on the key you picked, if it is still there
  loadMyKey();
  if (!PROVIDERS[provider].shared || (onlyMyKey && myKeyObjs.length)) {
    filledKeys = [...myKeyObjs];
    selectedKey = filledKeys.find(k => k.key === keep) || pickKey(filledKeys);
    keysLoading = false;
    keysLoadError = false;
    buildKeyMenu();
    updateSendAvailability();
    return;
  }

  await loadSharedKeys();

  // Your own keys always work, even if the shared list failed to load
  if (myKeyObjs.length) {
    keysLoadError = false;
    filledKeys = [...myKeyObjs, ...filledKeys];
    selectedKey = filledKeys.find(k => k.key === keep) || pickKey(myKeyObjs);
  } else {
    selectedKey = filledKeys.find(k => k.key === keep) || selectedKey;
  }
  buildKeyMenu();
  updateSendAvailability();
}

async function loadSharedKeys() {
  keysLoading = true;
  keysLoadError = false;
  activeLabel.textContent = 'Loading…';
  updateSendAvailability();

  try {
    const res = await fetch(KEYS_URL + '?v=' + Date.now(), { cache: 'no-store' });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const raw = await res.text();

    filledKeys = raw
      .split('\n')
      .map(line => line.trim())
      .filter(line => line !== '' && !line.startsWith('#'))
      .map((k, i) => ({ key: k, label: 'Key ' + (i + 1), status: 'unchecked' }));

    selectedKey = filledKeys.length > 0 ? filledKeys[0] : null;
    keysLoading = false;
  } catch (e) {
    console.error('Failed to load keys from remote source:', e);
    filledKeys = [];
    selectedKey = null;
    keysLoading = false;
    keysLoadError = true;
  }

  buildKeyMenu();
  updateSendAvailability();
}

/* ════════════════════════════════════════
   LOAD MODELS FROM REMOTE SOURCE
   Fetched once per page load unless
   force=true (used by the CHECK button).
════════════════════════════════════════ */
async function loadModels(force = false) {
  if (modelsFetched && !force) {
    buildModelMenu();
    return;
  }

  modelsLoading = true;
  modelsLoadError = false;
  modelActiveLabel.textContent = 'Loading…';
  buildModelMenu();
  updateSendAvailability();

  try {
    const list = await fetchModelList();
    modelsList = list.map(m => ({
      id: m.id, label: m.label, status: 'unchecked',
      vision: m.vision !== undefined ? m.vision : guessVision(m.id)   // can it read pictures?
    }));

    // Stay on the model you were using, if it's still listed
    const wanted = lsGet(MODEL_STORE + provider);
    selectedModel = modelsList.find(m => m.id === wanted) || modelsList[0] || null;
    modelsLoading = false;
    modelsFetched = true;
  } catch (e) {
    console.error('Failed to load models from remote source:', e);
    modelsList = [];
    selectedModel = null;
    modelsLoading = false;
    modelsLoadError = true;
    modelsFetched = false;
  }

  buildModelMenu();
  updateSendAvailability();
}

// With your own key, ask the provider which models it offers. For Groq, the
// GroqModels file is used with the shared keys, or if that request fails.
async function fetchModelList() {
  const p = PROVIDERS[provider];
  // Your own keys first. A key already known to be rejected is skipped (unless every key is).
  const usable = myKeyObjs.filter(k => k.status !== 'inactive');
  let lastError = null;
  for (const k of usable.length ? usable : myKeyObjs) {
    try {
      const list = await p.listModels(k.key);
      if (list.length || !p.shared) return list;
    } catch (e) {
      lastError = e;
      if (classifyError(e) === 'key') { k.status = 'inactive'; rememberKey(k, e.message); }
      console.error('Failed to list models with your key:', e);
    }
  }
  if (!p.shared) { if (lastError) throw lastError; return []; }
  return fetchModelsFile();
}

async function fetchModelsFile() {
  const res = await fetch(MODELS_URL + '?v=' + Date.now(), { cache: 'no-store' });
  if (!res.ok) throw new Error('HTTP ' + res.status);
  const raw = await res.text();
  return raw
    .split('\n')
    .map(line => line.trim())
    .filter(line => line !== '' && !line.startsWith('#'))
    .map(line => {
      const [id, label] = line.split('|').map(s => s && s.trim());
      return { id, label: label || id };
    });
}

// Reloads keys and models without sending any test messages.
// Runs every time the page opens, and from the ↻ button.
async function refreshAll() {
  if (checking || thinking) return;
  checking = true;
  updateSendAvailability();
  await loadKeys();
  await loadModels(true);
  checking = false;
  updateSendAvailability();
}

function updateSendAvailability() {
  sendBtn.disabled = keysLoading || modelsLoading || thinking || checking;
  checkBtn.disabled = refreshBtn.disabled = thinking || checking;
}

/* ════════════════════════════════════════
   KEY SELECTOR
════════════════════════════════════════ */
function sortKeysList() {
  const rank = { active: 0, unchecked: 1, checking: 1, inactive: 2 };
  filledKeys = filledKeys
    .map((k, i) => ({ k, i }))
    .sort((a, b) => ((b.k.mine ? 1 : 0) - (a.k.mine ? 1 : 0)) || (rank[a.k.status] - rank[b.k.status]) || (a.i - b.i))
    .map(x => x.k);
}

function buildKeyMenu() {
  keyMenu.innerHTML = '';

  if (keysLoading) {
    const el = document.createElement('div');
    el.className = 'km-item';
    el.textContent = 'Loading keys…';
    keyMenu.appendChild(el);
    activeLabel.textContent = 'Loading…';
    activeDot.className = 'k-dot unchecked';
    return;
  }

  if (keysLoadError) {
    const el = document.createElement('div');
    el.className = 'km-item';
    el.textContent = 'Failed to load keys';
    keyMenu.appendChild(el);
    const retry = document.createElement('div');
    retry.className = 'km-item km-action';
    retry.textContent = '↻ Retry';
    retry.onclick = refreshAll;
    keyMenu.appendChild(retry);
    activeLabel.textContent = 'No Key';
    activeDot.className = 'k-dot inactive';
    return;
  }

  if (filledKeys.length === 0) {
    const el = document.createElement('div');
    el.className = 'km-item';
    el.textContent = PROVIDERS[provider].shared ? 'No keys configured' : '+ Add your ' + PROVIDERS[provider].name + ' key';
    el.onclick = () => { keyMenu.classList.remove('open'); openKeyModal(); };
    keyMenu.appendChild(el);
    activeLabel.textContent = 'No Key';
    activeDot.className = 'k-dot unchecked';
    return;
  }

  sortKeysList();

  filledKeys.forEach(k => {
    const el = document.createElement('div');
    const st = k.status;
    const isSelected = selectedKey === k;
    el.className = 'km-item' + (isSelected ? ' selected' : '') + (st === 'inactive' ? ' dimmed' : '');
    el.innerHTML = `
      <span class="km-dot ${st}"></span>
      <span class="km-label">${escHtml(keyName(k))}</span>
      <span class="km-status ${st}">${st === 'unchecked' ? '—' : st === 'checking' ? 'Checking…' : st === 'active' ? 'Active' : 'Inactive'}</span>
    `;
    el.onclick = () => selectKey(k);
    keyMenu.appendChild(el);
  });

  updateKeyDropBtn();
}

function selectKey(k) {
  selectedKey = k;
  buildKeyMenu();
  keyMenu.classList.remove('open');
}

function updateKeyDropBtn() {
  const st = selectedKey ? selectedKey.status : 'unchecked';
  activeDot.className = 'k-dot ' + st;
  activeLabel.textContent = selectedKey ? keyName(selectedKey) : 'No Key';
}

function toggleKeyMenu() {
  modelMenu.classList.remove('open');
  keyMenu.classList.toggle('open');
}

/* ════════════════════════════════════════
   MODEL SELECTOR
   Working models (green) sort to the top,
   failing models (red) sort to the bottom,
   untested models (grey) stay in the middle.
════════════════════════════════════════ */
function sortModelsList() {
  const rank = { active: 0, unchecked: 1, checking: 1, inactive: 2 };
  modelsList = modelsList
    .map((m, i) => ({ m, i }))
    .sort((a, b) => (rank[a.m.status] - rank[b.m.status]) || (a.i - b.i))
    .map(x => x.m);
}

function buildModelMenu() {
  modelMenu.innerHTML = '';

  if (modelsLoading) {
    const el = document.createElement('div');
    el.className = 'km-item';
    el.textContent = 'Loading models…';
    modelMenu.appendChild(el);
    modelActiveLabel.textContent = 'Loading…';
    modelActiveDot.className = 'k-dot unchecked';
    return;
  }

  if (modelsLoadError) {
    const el = document.createElement('div');
    el.className = 'km-item';
    el.textContent = 'Failed to load models';
    modelMenu.appendChild(el);
    const retry = document.createElement('div');
    retry.className = 'km-item km-action';
    retry.textContent = '↻ Retry';
    retry.onclick = refreshAll;
    modelMenu.appendChild(retry);
    modelActiveLabel.textContent = 'No Model';
    modelActiveDot.className = 'k-dot inactive';
    return;
  }

  if (modelsList.length === 0) {
    const el = document.createElement('div');
    el.className = 'km-item';
    el.textContent = !PROVIDERS[provider].shared && !myKeyObjs.length ? 'Add your key to see models' : 'No models found';
    modelMenu.appendChild(el);
    modelActiveLabel.textContent = 'No Model';
    modelActiveDot.className = 'k-dot unchecked';
    return;
  }

  sortModelsList();

  modelsList.forEach(m => {
    const el = document.createElement('div');
    const st = m.status;
    const isSelected = selectedModel === m;
    el.className = 'km-item' + (isSelected ? ' selected' : '') + (st === 'inactive' ? ' dimmed' : '');
    el.innerHTML = `
      <span class="km-dot ${st}"></span>
      <span class="km-label">${escHtml(m.label)}${m.vision ? ' <span title="Can read pictures">🖼</span>' : ''}</span>
      <span class="km-status ${st}">${st === 'unchecked' ? '—' : st === 'checking' ? 'Checking…' : st === 'active' ? 'Working' : 'Failing'}</span>
    `;
    el.onclick = () => selectModel(m);
    modelMenu.appendChild(el);
  });

  updateModelDropBtn();
}

function selectModel(m) {
  modelPicks++;
  lsSet(MODEL_STORE + provider, m.id);   // stays selected until it fails
  selectedModel = m;
  buildModelMenu();
