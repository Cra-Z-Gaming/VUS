// Checks one key from the popup (no chat message is sent) and remembers the result until the tab is closed
async function checkDraftKey(d, id) {
  const key = d.key.trim();
  if (!key || d.busy) return;
  d.busy = true;
  d.note = '';
  if (d.paint) d.paint();
  try {
    await PROVIDERS[id].checkKey(key);
    ksSet(id, key, 'active');
  } catch (e) {
    if (classifyError(e) === 'key') {
      ksSet(id, key, 'inactive', e.message);
    } else {
      ksSet(id, key, '');
      d.note = e.status ? `Could not check it right now (${e.message}). Click to try again.` : 'Could not reach the provider. Click to try again.';
    }
  }
  d.busy = false;
  if (d.paint) d.paint();
}

// Checks every key in the list that has not been checked yet this session
async function checkDraftKeys() {
  const id = providerSelect.value;
  const rows = draftFor(id).filter(d => d.key.trim());
  if (!rows.length) { setKeyMsg('Add a key first.', 'err'); return; }
  const todo = rows.filter(d => !ksGet(id, d.key.trim()));
  if (!todo.length) { setKeyMsg(`Every key was already checked this session. Click a key's status to check it again.`, 'ok'); return; }

  checkKeysBtn.disabled = true;
  setKeyMsg('Checking ' + todo.length + (todo.length === 1 ? ' key...' : ' keys...'), 'wait');
  const seen = new Set();
  for (const d of todo) {
    const k = d.key.trim();
    if (seen.has(k)) continue;   // the same key pasted twice
    seen.add(k);
    await checkDraftKey(d, id);
  }
  checkKeysBtn.disabled = false;
  rows.forEach(d => { if (d.paint) d.paint(); });
  if (providerSelect.value !== id || !keyModalBg.classList.contains('open')) return;

  const results = rows.map(d => (ksGet(id, d.key.trim()) || {}).s);
  const good = results.filter(s => s === 'active').length;
  const bad  = results.filter(s => s === 'inactive').length;
  const open = results.length - good - bad;
  setKeyMsg(good + ' working, ' + bad + ' rejected' + (open ? ', ' + open + ' could not be checked' : '') + '.', bad || open ? 'err' : 'ok');
}

function cleanDraft(list) {
  const seen = new Set();
  const out = [];
  list.forEach(d => {
    const key = d.key.trim();
    if (!key || seen.has(key)) return;
    seen.add(key);
    out.push({ label: d.label.trim() || 'Key ' + (out.length + 1), key });
  });
  return out;
}

async function saveMyKey() {
  if (checking || thinking) { setKeyMsg('Busy right now. Wait for it to finish, then save.', 'err'); return; }
  const id = providerSelect.value;
  const p = PROVIDERS[id];
  const before = loadSavedKeys(id).length;
  if (!cleanDraft(draftFor(id)).length && !before && !p.shared) { setKeyMsg('Paste your ' + p.name + ' key first.', 'err'); return; }

  // Save every provider whose list was changed in the popup
  for (const pid of Object.keys(drafts)) {
    const list = cleanDraft(drafts[pid]);
    if (JSON.stringify(list) === JSON.stringify(loadSavedKeys(pid))) continue;
    if (!saveSavedKeys(pid, list)) { setKeyMsg('Could not save: browser storage is blocked.', 'err'); return; }
  }
  if (!lsSet(PROVIDER_STORE, id)) { setKeyMsg('Could not save: browser storage is blocked.', 'err'); return; }
  if (p.shared) lsSet(ONLYMY_STORE, onlyMyKeyBox.checked ? '1' : '0');
  const after = loadSavedKeys(id).length;
  closeKeyModal();

  // The first time a key is added for a provider, run one full check. After that, just refresh.
  if (!before && after) await checkAll();
  else await refreshAll();
}

