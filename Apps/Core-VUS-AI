════════════════════════════════════════ */
function appendMsg(role, content, isTyping = false, images = []) {
  if (welcomeEl && welcomeEl.parentNode === chatEl) chatEl.removeChild(welcomeEl);

  const wrap = document.createElement('div');
  wrap.className = 'msg ' + role;

  const av = document.createElement('div');
  av.className = 'avatar';
  av.textContent = role === 'user' ? 'YOU' : 'AI';

  const bub = document.createElement('div');
  bub.className = 'bubble';

  if (isTyping) {
    bub.innerHTML = '<div class="typing-dots"><span></span><span></span><span></span></div>';
  } else {
    bub.innerHTML = role === 'assistant' ? renderText(content) : escHtml(content);
    if (images.length) {
      const frag = document.createDocumentFragment();
      images.forEach(src => frag.appendChild(mk('img', 'att-img', { src, alt: 'Attached picture' })));
      bub.prepend(frag);
    }
  }

  wrap.appendChild(av);
  wrap.appendChild(bub);
  chatEl.appendChild(wrap);
  chatEl.scrollTop = chatEl.scrollHeight;

  return { wrap, bub };
}

/* ════════════════════════════════════════
   API CALL
   test=true sends a minimal 1-token probe
   used by checkAll(); test=false sends the
   real conversation.
════════════════════════════════════════ */
// The conversation in the format the API wants. A picture is only sent with the message
// that carries it; in older messages it becomes a short note so requests stay small.
function apiMessages() {
  return history.map((h, i) => {
    if (!h.images || !h.images.length) return { role: h.role, content: h.content };
    if (i !== history.length - 1) return { role: h.role, content: (h.content + ' [picture attached earlier]').trim() };
    const parts = [];
    if (h.content) parts.push({ type: 'text', text: h.content });
    h.images.forEach(url => parts.push({ type: 'image_url', image_url: { url } }));
    return { role: h.role, content: parts };
  });
}

async function tryKey(keyObj, modelId, test = false) {
  const p = PROVIDERS[provider];
  const body = test
    ? { model: modelId, max_tokens: 1, messages: [{ role: 'user', content: 'hi' }] }
    : { model: modelId, max_tokens: p.maxTokens, messages: [{ role: 'system', content: SYSTEM_PROMPT }, ...apiMessages()] };

  const res = await fetch(p.chatUrl, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': 'Bearer ' + keyObj.key
    },
    body: JSON.stringify(body)
  });
  if (!res.ok) {
    const err = await apiError(res);
    err.hadImages = !test && !!(history[history.length - 1] || {}).images?.length;   // lets a model that can't read pictures be told apart
    throw err;
  }
  const data = await res.json();
  // Some providers report a failure inside a normal response
  if (data.error) throw Object.assign(new Error(data.error.message || 'Provider error'), { status: Number(data.error.code) || 502 });
  const choice = data.choices?.[0];
  if (!test && !choice?.message?.content) {
    throw Object.assign(new Error('The model sent back an empty reply'), { status: choice?.finish_reason === 'length' ? 413 : 502 });
  }
  return data;
}

// Works out what actually failed, so a broken model is never blamed on the key
function classifyError(e) {
  const code = String(e.code || '');
  const msg  = e.message || '';
  if (!e.status) return 'network';
  // 'quota' is a limit on the whole account, so changing model won't help
  if (e.status === 429) return /free-models-per/i.test(msg) ? 'quota' : 'limit';
  if (e.status === 402) return 'account';
  if (e.status === 401 || code === 'invalid_api_key' || code === 'organization_restricted') return 'key';
  if (/api[ _]key (not valid|expired)|api_key_invalid/i.test(msg)) return 'key';   // Gemini sends these as 400
  if (e.status === 403 && /moderation|flagged/i.test(msg)) return 'request';
  if (e.hadImages && [400, 404, 415, 422].includes(e.status) && /image|vision|multimodal|modalit|not support/i.test(msg) && !/decommission/i.test(msg)) return 'noimage';
  if (e.status === 404 || code.startsWith('model_') || /decommissioned|does not exist|blocked at the/i.test(msg)) return 'model';
  if (e.status === 403) return 'key';
  if (e.status === 498 || e.status >= 500) return 'server';
  return 'request';
}

// When several keys fail differently, report the most telling one. 'key' is last:
// the key is only blamed if every key was rejected.
function mainFailure(failures) {
  const order = ['quota', 'account', 'limit', 'model', 'server', 'network', 'noimage', 'request', 'key'];
  return [...failures].sort((a, b) => order.indexOf(a.kind) - order.indexOf(b.kind))[0];
}

// Short reasons used in the "switched model" note
const REASONS = { model: 'is unavailable', server: "couldn't answer", limit: 'hit its rate limit', request: 'rejected the request', noimage: `can't read pictures` };

// Problems where trying a different model would not help
const STOP_KINDS = ['key', 'account', 'quota', 'network'];

function failureHtml(failure, model) {
  const who = PROVIDERS[provider].name;
  const name = model.label;
  const text = {
    model:   `⚠ Model unavailable: ${name} can't be used right now. This is a model problem, not a bad key.`,
    server:  `⚠ Model down: ${who} couldn't run ${name}. Try again shortly.`,
    limit:   `⚠ Rate limit reached for ${name}. Wait a moment and try again.`,
    quota:   `⚠ ${who} free limit reached for your account. Wait for it to reset, or switch provider.`,
    account: `⚠ ${who} says your account can't make this request. Check your account or credits.`,
    network: `⚠ Connection problem: couldn't reach ${who}. Check your internet and try again.`,
    noimage: `⚠ ${name} can't read pictures. Remove the picture or try another model.`,
    request: `⚠ ${who} rejected this request. Try a shorter message or clear the chat.`,
    key:     `⚠ Key problem: ${who} rejected every key. Check your key or run CHECK.`
  }[failure.kind];
  const detail = failure.kind !== 'network' && failure.message ? '\nDetails: ' + failure.message : '';
  return escHtml(text + detail).replace(/\n/g, '<br>');
}

// The message shown when nothing answered
function failedHtml({ failed, refreshed, noVision }) {
  if (noVision) return escHtml('⚠ None of the models in the list can read pictures. Remove the picture, or switch provider.');
  const last = failed[failed.length - 1];
  if (failed.length === 1 || [...STOP_KINDS, 'request'].includes(last.failure.kind)) {
    return failureHtml(last.failure, last.model);
  }
  const text = `⚠ No model could answer (${failed.length} tried).`
    + (refreshed ? ' The model list was refreshed.' : '') + ' Try again in a moment.'
    + `\nLast error (${last.model.label}): ${last.failure.message}`;
  return escHtml(text).replace(/\n/g, '<br>');
}

// Tries one model with each key until one answers
async function askModel(model) {
  // The selected key first, then fall back through the rest
  let tryOrder = [selectedKey, ...filledKeys.filter(k => k !== selectedKey)].filter(Boolean);
  // Skip keys already known to be rejected (unless that is every key)
  const live = tryOrder.filter(k => k.status !== 'inactive');
  if (live.length) tryOrder = live;
  const failures = [];

  for (const k of tryOrder) {
    try {
      const data = await tryKey(k, model.id);
      k.status = 'active';
      rememberKey(k);
      buildKeyMenu();
      return { data, key: k };
    } catch (e) {
      const kind = classifyError(e);
      failures.push({ kind, message: e.message });
      // Only mark a key bad when the key itself was rejected
      if (kind === 'key') { k.status = 'inactive'; rememberKey(k, e.message); }
      buildKeyMenu();
      if (kind === 'noimage') break;   // every key would get the same answer
    }
  }
  return { failure: mainFailure(failures) };
}

// Most models one message will try, so a bad day can't burn through your free limit
const MAX_TRIES = 8;

// The picked model first, then the ones after it, skipping any known to be down
function modelQueue(start) {
  const i = modelsList.indexOf(start);
  const after = [...modelsList.slice(i + 1), ...modelsList.slice(0, Math.max(i, 0))];
  return [start, ...after.filter(m => m.status !== 'inactive')];
}

// Stays on the picked model unless it fails, then moves to the next available one.
// If they all fail, the list is refreshed once and anything not yet tried gets a turn
// (up to MAX_TRIES models per message).
async function askWithFailover(start, needVision = false) {
  const tried = new Set();
  const failed = [];
  const down = new Set();
  const blind = new Set();   // models that turned out not to read pictures
  const usable = m => !needVision || m.vision;
  let first = start;
  let imageSwitch = false;
  if (!usable(start)) {
    // The picked model can't read pictures: use the first one that can, for this message only
    first = modelsList.find(m => usable(m) && m.status !== 'inactive');
    if (!first) return { failed: [], refreshed: false, noVision: true };
    imageSwitch = true;
  }
  let queue = modelQueue(first).filter(usable);
  let refreshed = false;

  while (true) {
    const model = tried.size < MAX_TRIES ? queue.shift() : null;
    if (!model) {
      if (refreshed) break;
      refreshed = true;
      const old = [modelsList, selectedModel];
      await loadModels(true);
      if (modelsLoadError) {   // keep the old list if the refresh itself fails
        [modelsList, selectedModel] = old;
        modelsLoadError = false;
        modelsFetched = true;
      }
      // A refresh shouldn't forget which models just failed
      modelsList.forEach(m => { if (down.has(m.id)) m.status = 'inactive'; if (blind.has(m.id)) m.vision = false; });
      buildModelMenu();
      queue = modelsList.filter(m => !tried.has(m.id) && usable(m));
      continue;
    }

    tried.add(model.id);
    const result = await askModel(model);
    if (result.data) {
      model.status = 'active';
      return { ...result, model, failed, refreshed, imageSwitch };
    }

    const kind = result.failure.kind;
    if (kind === 'model' || kind === 'server') { model.status = 'inactive'; down.add(model.id); }
    if (kind === 'noimage') { model.vision = false; blind.add(model.id); }
    failed.push({ model, failure: result.failure });
    buildModelMenu();
    // Give up early if switching can't help, or three models rejected the same request
    if (STOP_KINDS.includes(kind) || failed.filter(f => f.failure.kind === 'request').length >= 3) break;
  }
  return { failed, refreshed };
}

async function send() {
  const text = inputEl.value.trim();
  const imgs = attachments.slice();
  if ((!text && !imgs.length) || thinking || checking) return;

  if (keysLoading || modelsLoading) {
    alert('Still loading keys/models, please wait a moment and try again.');
    return;
  }

  if (!PROVIDERS[provider].shared && !myKeyObjs.length) {
    openKeyModal();
    setKeyMsg('Add your ' + PROVIDERS[provider].name + ' key to start chatting.', 'err');
    return;
  }

  if (keysLoadError || filledKeys.length === 0) {
    alert('No API keys available. Could not load keys from the remote source, or none are configured there. You can add your own with the My Key button.');
    return;
  }

  if (modelsLoadError || modelsList.length === 0 || !selectedModel) {
    alert('No model available. Could not load the model list. Press the ↻ button to try again.');
    return;
  }

  thinking = true;
  updateSendAvailability();
  inputEl.value = '';
  inputEl.style.height = 'auto';
  clearSearch();

  appendMsg('user', text, false, imgs);
  history.push({ role: 'user', content: text, images: imgs });
  attachments = [];
  renderAttachments();

  const { bub: typingBub } = appendMsg('assistant', '', true);

  const picksBefore = modelPicks;
  const start = selectedModel;
  const result = await askWithFailover(start, imgs.length > 0);

  if (result.data) {
    const reply = result.data.choices[0].message.content;
    const first = result.failed[0];
    const note = first
      ? `<div class="switch-note">↪ Switched to ${escHtml(result.model.label)}: ${escHtml(first.model.label)} ${REASONS[first.failure.kind]}.</div>`
      : result.imageSwitch
        ? `<div class="switch-note">↪ Used ${escHtml(result.model.label)} to read the picture (${escHtml(start.label)} can't).</div>`
        : '';
    typingBub.innerHTML = note + renderText(reply);
    history.push({ role: 'assistant', content: reply });
    // Keep using the model that worked, unless you picked another while waiting
    if (modelPicks === picksBefore && (!imgs.length || start.vision)) {
      selectedModel = result.model;
      lsSet(MODEL_STORE + provider, result.model.id);
    }
    // Keep My Key selected after a one-off fallback, and never reselect a key that was removed mid-reply
    if (filledKeys.includes(result.key) && !(selectedKey?.mine && !result.key.mine)) selectedKey = result.key;
    buildKeyMenu();
  } else {
    typingBub.innerHTML = `<span style="color:var(--red)">${failedHtml(result)}</span>`;
  }
  buildModelMenu();

  chatEl.scrollTop = chatEl.scrollHeight;
  thinking = false;
  updateSendAvailability();
  inputEl.focus();
}

/* ════════════════════════════════════════
   INIT — fetch keys and models each time the page opens
════════════════════════════════════════ */
refreshAll();
</script>
